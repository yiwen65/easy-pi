+/// Metadata-only narrowing for the controlled Computer catalog. It grants no
+/// window authority and is not an extension of the legacy list_windows input.
+#[derive(Debug, Default, Clone, Serialize, Deserialize, PartialEq, uniffi::Record)]
+#[serde(deny_unknown_fields)]
+pub struct ComputerWindowQuery {
+    #[serde(default)]
+    pub app: Option<String>,
+    #[serde(default)]
+    pub title: Option<String>,
+    #[serde(default)]
+    pub focused: bool,
+}
+
+impl ComputerWindowQuery {
+    pub fn parse(value: &serde_json::Value) -> Result<Self, &'static str> {
+        // Serde's struct visitor also accepts sequences; this internal wire
+        // shape is deliberately a closed object, not positional arguments.
+        if !value.is_object() {
+            return Err("invalid_discovery_query");
+        }
+        let query: Self = serde_json::from_value(value.clone()).map_err(|_| "invalid_discovery_query")?;
+        query.validate()?;
+        Ok(query)
+    }
+
+    pub fn validate(&self) -> Result<(), &'static str> {
+        if self.app.iter().chain(self.title.iter()).any(|filter| filter.is_empty() || filter.len() > 256) {
+            return Err("invalid_discovery_query");
+        }
+        Ok(())
+    }
+
+    pub fn matches(&self, app: &str, title: &str, focused: Option<bool>) -> bool {
+        self.app.as_ref().is_none_or(|filter| app.to_lowercase().contains(&filter.to_lowercase()))
+            && self.title.as_ref().is_none_or(|filter| title.to_lowercase().contains(&filter.to_lowercase()))
+            && (!self.focused || focused == Some(true))
     }
 }

