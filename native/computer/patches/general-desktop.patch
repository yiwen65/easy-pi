--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-macos/src/tools/computer/segment.rs
@@ -0,0 +1,862 @@
+//! Native segment execution under one tracked worker and one native scheduler.
+mod confirmation;
+mod focus;
+#[cfg(test)]
+mod order_tests;
+mod readiness;
+mod target;
+mod window;
+use super::observation::{self, Native, Reader};
+use crate::ax::{bindings, cache::RetainedElement};
+use crate::input::controlled::general::Events;
+use core_foundation::{
+    base::{CFRelease, CFTypeRef, TCFType},
+    boolean::CFBoolean,
+    string::CFString,
+};
+use cua_driver_contract::computer_segment::*;
+use cua_driver_contract::{
+    ActionDelivery, ActionDeliveryMode, ActionEffect, ActionResult, ActionRoute,
+};
+use cua_driver_core::controlled::{ImageReference, Operation};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+pub struct Context {
+    pub renderer: Option<Arc<crate::computer_renderer::Channel>>,
+    pub operation: Arc<Operation>,
+    pub state: Arc<super::super::ToolState>,
+    pub observation_ref: String,
+    pub intent_ref: String,
+    pub image: Option<Arc<ImageReference>>,
+}
+
+pub struct ActionRecord {
+    pub action: Option<ActionResult>,
+    pub code: Option<String>,
+    pub committed: bool,
+    pub complete: bool,
+}
+
+pub struct Execution {
+    pub actions: Vec<ActionRecord>,
+    pub condition: Option<bool>,
+    pub cancelled: bool,
+    pub recovery_attempts: u8,
+    pub elapsed_ms: u64,
+}
+
+/// Budget includes possible exact foreground activation but counts every
+/// Unicode chunk/modifier/down/move/wheel/window write separately.
+pub fn budgets(segment: &ComputerSegment) -> Result<Vec<u32>, &'static str> {
+    use crate::input::controlled::general::{key_code, text_chunks};
+    let mut held = std::collections::BTreeSet::new();
+    let mut limits = Vec::new();
+    for action in &segment.actions {
+        let limit = match action {
+            ComputerInput::Key { key, modifiers } => {
+                let code = key_code(key)?;
+                if held.contains(&code) {
+                    return Err("input_already_held");
+                }
+                5 + modifiers.len() as u32
+            }
+            ComputerInput::KeyDown { key } => {
+                if !held.insert(key_code(key)?) {
+                    return Err("input_already_held");
+                }
+                5
+            }
+            ComputerInput::KeyUp { key } => {
+                if !held.remove(&key_code(key)?) {
+                    return Err("input_not_owned");
+                }
+                1
+            }
+            ComputerInput::TypeText { text } | ComputerInput::Fill { text, .. } => {
+                10 + text_chunks(text).len() as u32
+            }
+            ComputerInput::Drag { duration_ms, .. } => 6 + (duration_ms / 16).max(1),
+            ComputerInput::Click { count, .. } => 5 + u32::from(*count),
+            ComputerInput::Focus { .. } => 6,
+            ComputerInput::Window { .. } => 4,
+            _ => 6,
+        };
+        limits.push(limit);
+    }
+    if !held.is_empty() {
+        return Err("unreleased_input");
+    }
+    Ok(limits)
+}
+
+fn requires_semantic_boundary(action: &ComputerInput, dispatched: bool) -> bool {
+    dispatched
+        && matches!(
+            action,
+            ComputerInput::Focus { .. } | ComputerInput::Fill { .. } | ComputerInput::Window { .. }
+        )
+}
+
+impl Context {
+    pub fn foreground(&self) -> bool {
+        self.foreground_state() == Some(true)
+    }
+
+    fn foreground_state(&self) -> Option<bool> {
+        let target = self.operation.session.native_window().ok()?;
+        crate::ax::general_surface::foreground_match(
+            crate::input::skylight::front_process_matches(target.pid, target.window_id),
+            crate::ax::general_surface::keyboard_window(target.pid),
+            target.window_id,
+        )
+    }
+
+    fn keyboard_target(&self) -> bool {
+        let Ok(target) = self.operation.session.native_window() else {
+            return false;
+        };
+        crate::ax::general_surface::keyboard_window(target.pid) == Some(target.window_id)
+    }
+
+    pub fn activate(&self) -> Result<(), &'static str> {
+        self.live()?;
+        focus::activate_unless_current(self.foreground(), || self.activate_unfocused())
+    }
+
+    fn activate_unfocused(&self) -> Result<(), &'static str> {
+        let target = self.operation.session.native_window()?;
+        let accepted = crate::input::skylight::make_exact_window_key_controlled(
+            target.pid,
+            target.window_id,
+            &self.operation,
+        );
+        if !accepted {
+            return Err("foreground_activation_unknown");
+        }
+        if !self.foreground() {
+            let root = (Native {
+                operation: &self.operation,
+            })
+            .general_window()?;
+            if unsafe { bindings::perform_action(root.as_ptr() as _, "AXRaise") }
+                != bindings::kAXErrorSuccess
+            {
+                return Err("foreground_activation_unknown");
+            }
+        }
+        let until = Instant::now() + Duration::from_millis(500);
+        loop {
+            self.live()?;
+            if self.foreground() {
+                return Ok(());
+            }
+            if Instant::now() >= until {
+                return Err("foreground_focus_unproved");
+            }
+            std::thread::sleep(Duration::from_millis(10));
+        }
+    }
+
+    fn input_check(&self, foreground: bool, keyboard: bool) -> Result<(), &'static str> {
+        if let Some(renderer) = &self.renderer {
+            renderer.check()?;
+        }
+        self.live()?;
+        if foreground && !self.foreground() {
+            return Err("foreground_target_changed");
+        }
+        if keyboard && !self.keyboard_target() {
+            return Err("keyboard_target_changed");
+        }
+        Ok(())
+    }
+
+    fn point(&self, point: &ComputerPoint) -> Result<(f64, f64, f64, f64), &'static str> {
+        self.point_with_route(point).map(|(point, _)| point)
+    }
+
+    fn point_with_route(&self, point: &ComputerPoint) -> Result<((f64, f64, f64, f64), bool), &'static str> {
+        self.live()?;
+        let image = self.image.as_ref().ok_or("image_reference_required")?;
+        crate::input::controlled::revalidate(image, &self.operation)?;
+        image.addresses(&point.image_ref, point.x as u32, point.y as u32)?;
+        let target = self.operation.session.native_window()?;
+        if !image.target_matches(target.pid as u32, target.window_id as u64) {
+            return Err("stale_image_observation");
+        }
+        let g = image.geometry();
+        let windows = crate::windows::general_windows_with_space_snapshot();
+        let window = crate::windows::general_point_window_in(
+            &windows.windows, target.pid, target.window_id,
+            [g.desktop_x, g.desktop_y, g.window_width, g.window_height],
+        )?;
+        // Image addresses name pixels. Use the addressed pixel's center,
+        // including fractional model coordinates within the final edge pixel.
+        let (x, y) = g.desktop_pixel_center(point.x as u32, point.y as u32)?;
+        Ok(((x, y, x - g.desktop_x, y - g.desktop_y),
+            crate::input::controlled::popup_click::use_screen_route(window.layer, &window.title)))
+    }
+
+    fn condition(&self, condition: &ComputerPostcondition) -> Option<bool> {
+        if self.live().is_err() {
+            return None;
+        }
+        readiness::before_condition(condition, || self.prepare_accessibility()).ok()?;
+        if matches!(
+            condition,
+            ComputerPostcondition::Value { .. } | ComputerPostcondition::Present { .. }
+        ) {
+            (Native { operation: &self.operation })
+                .general_input_window()
+                .ok()?;
+        }
+        match condition {
+            ComputerPostcondition::Visual { .. } => None,
+            ComputerPostcondition::WindowFocused => self.foreground_state(),
+            ComputerPostcondition::Present { locator, present } => self
+                .locate(locator)
+                .ok()
+                .map(|value| value.is_some() == *present),
+            ComputerPostcondition::Value { target, value } => {
+                let element = self.resolve(target).ok()?;
+                if !self.native_text(&element) {
+                    return None;
+                }
+                unsafe { observation::string_attr(element.as_ptr() as _, "AXValue") }
+                    .ok()
+                    .flatten()
+                    .map(|actual| actual == *value)
+            }
+            ComputerPostcondition::WindowBounds {
+                x,
+                y,
+                width,
+                height,
+            } => self
+                .window_frame()
+                .ok()
+                .map(|actual| actual == [*x, *y, *width, *height]),
+        }
+    }
+
+    fn focus_element(
+        &self,
+        events: &mut Events,
+        element: &RetainedElement,
+        editable_without_press: bool,
+    ) -> Result<(ActionRoute, bool), &'static str> {
+        self.member(element)?;
+        let ptr = element.as_ptr() as bindings::AXUIElementRef;
+        let attribute = CFString::new("AXFocused");
+        let mut settable = 0;
+        let error = unsafe {
+            bindings::AXUIElementIsAttributeSettable(
+                ptr,
+                attribute.as_concrete_TypeRef(),
+                &mut settable,
+            )
+        };
+        // Focus is not permission to click an actionable control. Unknown
+        // capability also refuses before any activation or input mutation.
+        let semantic = focus::semantic_focus_route(match error {
+            bindings::kAXErrorSuccess => Ok(settable != 0),
+            bindings::kAXErrorAPIDisabled => Err("accessibility_permission_denied"),
+            _ => Err("focus_capability_unknown"),
+        }, editable_without_press)?;
+        if semantic {
+            if unsafe { bindings::set_bool_attr_true(ptr, "AXFocused") }
+                != bindings::kAXErrorSuccess
+            {
+                return Err("semantic_delivery_unknown");
+            }
+        } else {
+            // Preserve the existing editable-field route, never a generic
+            // enabled control or unknown/advertised press capability.
+            if events.held() {
+                return Err("route_change_with_held_input");
+            }
+            if !self.foreground() {
+                self.operation.session.recover_intent(&self.intent_ref)?;
+            }
+            self.activate()?;
+            events.foreground = true;
+            self.member(element)?;
+            let (x, y) =
+                unsafe { bindings::element_screen_center(ptr) }.ok_or("target_geometry_unknown")?;
+            let root = (Native {
+                operation: &self.operation,
+            })
+            .general_window()?;
+            let [rx, ry, _, _] = unsafe { bindings::element_screen_rect(root.as_ptr() as _) }
+                .ok_or("target_geometry_unknown")?;
+            let check = || {
+                self.input_check(true, false)?;
+                self.member(element)
+            };
+            events.move_pointer((x, y, x - rx, y - ry), &check)?;
+            events.button_down(ComputerMouseButton::Left, 1, &check)?;
+            events.button_up(ComputerMouseButton::Left)?;
+        }
+        let target = self.operation.session.native_window()?;
+        let until = Instant::now() + Duration::from_millis(500);
+        focus::confirm_focus(
+            || {
+                self.member(element)?;
+                let Some(focused) = (unsafe {
+                    crate::ax::general_surface::focused_in_window(target.pid, target.window_id)
+                }) else {
+                    return Ok(false);
+                };
+                Ok(unsafe {
+                    let owned = RetainedElement::retain(focused as usize);
+                    CFRelease(focused as CFTypeRef);
+                    (Native {
+                        operation: &self.operation,
+                    })
+                    .same(element, &owned)
+                })
+            },
+            || {
+                let remaining = until.saturating_duration_since(Instant::now());
+                if remaining.is_zero() {
+                    return false;
+                }
+                std::thread::sleep(remaining.min(Duration::from_millis(10)));
+                Instant::now() < until
+            },
+        )?;
+        Ok((
+            if semantic { ActionRoute::Accessibility } else { ActionRoute::SyntheticEvents },
+            self.foreground(),
+        ))
+    }
+
+    fn apply(
+        &self,
+        events: &mut Events,
+        action: &ComputerInput,
+    ) -> Result<(ActionRoute, bool), &'static str> {
+        self.live()?;
+        if requires_semantic_boundary(action, events.dispatched) {
+            return Err("segment_boundary_required");
+        }
+        let semantic_root = if matches!(
+            action,
+            ComputerInput::Focus { .. } | ComputerInput::Fill { .. } | ComputerInput::Window { .. }
+        ) {
+            Some((Native { operation: &self.operation }).general_input_window()?)
+        } else {
+            None
+        };
+        match action {
+            ComputerInput::Focus { target } | ComputerInput::Fill { target, .. } => {
+                let element = self.resolve(target)?;
+                let ptr = element.as_ptr() as bindings::AXUIElementRef;
+                let native = Native {
+                    operation: &self.operation,
+                };
+                let data = native.general_data(&element)?;
+                if (data.enabled != Some(true)
+                    && !(data.general_fillable() && self.native_text(&element)))
+                    || data.subrole.as_deref() == Some("AXSecureTextField")
+                {
+                    return Err("target_not_editable");
+                }
+                let editable_without_press = data.general_fillable()
+                    && !data.metadata_incomplete
+                    && !data.actions.iter().any(|action| action == "AXPress");
+                match action {
+                    ComputerInput::Focus { .. } => self.focus_element(events, &element, editable_without_press),
+                    ComputerInput::Fill { text, .. }
+                        if data.value_fillable() && self.native_text(&element) =>
+                    {
+                        self.member(&element)?;
+                        if unsafe { bindings::set_string_attr(ptr, "AXValue", text) }
+                            != bindings::kAXErrorSuccess
+                        {
+                            return Err("semantic_delivery_unknown");
+                        }
+                        Ok((ActionRoute::Accessibility, false))
+                    }
+                    ComputerInput::Fill { text, .. } => {
+                        if data.role == "AXTextArea" && !self.foreground() {
+                            self.operation.session.recover_intent(&self.intent_ref)?;
+                            self.activate()?;
+                        }
+                        let (_, foreground) = self.focus_element(events, &element, editable_without_press)?;
+                        events.foreground = foreground;
+                        let check = || {
+                            self.input_check(foreground, true)?;
+                            self.member(&element)
+                        };
+                        events.key("a", &[ComputerModifier::Command], &check)?;
+                        // Once selection is dispatched, failures never restart
+                        // replacement. Empty replacement uses one Delete key.
+                        if text.is_empty() {
+                            events.key("delete", &[], &check)?;
+                        } else {
+                            events.text(text, &check)?;
+                        }
+                        Ok((ActionRoute::SyntheticEvents, foreground))
+                    }
+                    _ => unreachable!(),
+                }
+            }
+            ComputerInput::Window { action } => {
+                if events.held() {
+                    return Err("window_change_with_held_input");
+                }
+                if matches!(action, ComputerWindowAction::Activate) {
+                    self.activate()?;
+                    return Ok((ActionRoute::SystemApi, self.foreground()));
+                }
+                let root = semantic_root.as_ref().ok_or("controlled_target_unproven")?;
+                let ptr = root.as_ptr() as bindings::AXUIElementRef;
+                let error = unsafe {
+                    match action {
+                        ComputerWindowAction::Minimize | ComputerWindowAction::Restore => {
+                            let attribute = CFString::new("AXMinimized");
+                            let value = if matches!(action, ComputerWindowAction::Minimize) {
+                                CFBoolean::true_value()
+                            } else {
+                                CFBoolean::false_value()
+                            };
+                            bindings::AXUIElementSetAttributeValue(
+                                ptr,
+                                attribute.as_concrete_TypeRef(),
+                                value.as_CFTypeRef(),
+                            )
+                        }
+                        ComputerWindowAction::Close => {
+                            let close = bindings::copy_element_attr(ptr, "AXCloseButton")
+                                .ok_or("window_close_unavailable")?;
+                            let owned = RetainedElement::retain(close as usize);
+                            CFRelease(close as CFTypeRef);
+                            self.member(&owned)?;
+                            bindings::perform_action(close, "AXPress")
+                        }
+                        ComputerWindowAction::SetBounds {
+                            x,
+                            y,
+                            width,
+                            height,
+                        } => {
+                            self.set_bounds(ptr, [*x, *y, *width, *height])?;
+                            bindings::kAXErrorSuccess
+                        }
+                        ComputerWindowAction::Activate => unreachable!(),
+                    }
+                };
+                if error != bindings::kAXErrorSuccess {
+                    return Err("window_action_unknown");
+                }
+                Ok((ActionRoute::Accessibility, false))
+            }
+            _ => {
+                if let ComputerInput::TypeText { text } = action {
+                    let target = self.operation.session.native_window()?;
+                    if !events.held() && !events.dispatched {
+                        if let Some(ptr) = unsafe {
+                            crate::ax::general_surface::focused_in_window(
+                                target.pid,
+                                target.window_id,
+                            )
+                        } {
+                            let element = unsafe {
+                                let owned = RetainedElement::retain(ptr as usize);
+                                CFRelease(ptr as CFTypeRef);
+                                owned
+                            };
+                            let data = (Native {
+                                operation: &self.operation,
+                            })
+                            .general_data(&element)?;
+                            if data.role != "AXTextArea"
+                                && (data.enabled == Some(true) || data.general_fillable())
+                                && data.subrole.as_deref() != Some("AXSecureTextField")
+                                && self.native_text(&element)
+                                && unsafe { bindings::is_attribute_settable(ptr, "AXSelectedText") }
+                            {
+                                self.member(&element)?;
+                                (Native { operation: &self.operation }).general_input_window()?;
+                                if unsafe { bindings::set_string_attr(ptr, "AXSelectedText", text) }
+                                    != bindings::kAXErrorSuccess
+                                {
+                                    return Err("semantic_delivery_unknown");
+                                }
+                                return Ok((ActionRoute::Accessibility, false));
+                            }
+                        }
+                    }
+                }
+                let keyboard = matches!(
+                    action,
+                    ComputerInput::TypeText { .. }
+                        | ComputerInput::Key { .. }
+                        | ComputerInput::KeyDown { .. }
+                        | ComputerInput::KeyUp { .. }
+                );
+                // Select a route before any requested input. Focus switching
+                // while keys/buttons are owned cannot silently retarget them.
+                let mut foreground = self.foreground();
+                if keyboard
+                    && (!self.keyboard_target()
+                        || (!foreground && self.editor_requires_foreground()?))
+                {
+                    if events.held() {
+                        return Err("route_change_with_held_input");
+                    }
+                    self.operation.session.recover_intent(&self.intent_ref)?;
+                    self.activate()?;
+                    foreground = true;
+                }
+                events.foreground = foreground;
+                let check = || self.input_check(foreground, keyboard);
+                match action {
+                    ComputerInput::TypeText { text } => events.text(text, &check)?,
+                    ComputerInput::Key { key, modifiers } => events.key(key, modifiers, &check)?,
+                    ComputerInput::KeyDown { key } => events.key_down(key, &check)?,
+                    ComputerInput::KeyUp { key } => events.key_up(key)?,
+                    ComputerInput::PointerMove { point } => {
+                        events.move_pointer(self.point(point)?, &check)?
+                    }
+                    ComputerInput::ButtonDown { button } => {
+                        events.button_down(*button, 1, &check)?
+                    }
+                    ComputerInput::ButtonUp { button } => events.button_up(*button)?,
+                    ComputerInput::Click {
+                        point,
+                        button,
+                        count,
+                    } => {
+                        let (position, screen_route) = self.point_with_route(point)?;
+                        if screen_route {
+                            if events.held() {
+                                return Err("route_change_with_held_input");
+                            }
+                            crate::input::controlled::popup_click::run(
+                                self.operation.clone(), self.renderer.clone(),
+                                self.image.as_ref().ok_or("image_reference_required")?.geometry().clone(),
+                                position, *button, *count, || self.live(),
+                            )?;
+                            events.dispatched = true;
+                            return Ok((ActionRoute::GlobalInput, true));
+                        }
+                        events.move_pointer(position, &check)?;
+                        for click in 1..=*count {
+                            events.button_down(*button, i64::from(click), &check)?;
+                            events.button_up(*button)?;
+                            events.click_feedback();
+                        }
+                    }
+                    ComputerInput::Scroll {
+                        point,
+                        delta_x,
+                        delta_y,
+                        unit,
+                    } => {
+                        events.move_pointer(self.point(point)?, &check)?;
+                        events.scroll(*delta_x, *delta_y, *unit, &check)?;
+                    }
+                    ComputerInput::Drag {
+                        from,
+                        to,
+                        duration_ms,
+                    } => {
+                        let from = self.point(from)?;
+                        let to = self.point(to)?;
+                        events.move_pointer(from, &check)?;
+                        events.button_down(ComputerMouseButton::Left, 1, &check)?;
+                        let steps = (duration_ms / 16).max(1);
+                        for index in 1..=steps {
+                            self.operation.checkpoint()?;
+                            let f = f64::from(index) / f64::from(steps);
+                            let lerp = |a, b| a + (b - a) * f;
+                            events.move_pointer(
+                                (
+                                    lerp(from.0, to.0),
+                                    lerp(from.1, to.1),
+                                    lerp(from.2, to.2),
+                                    lerp(from.3, to.3),
+                                ),
+                                &check,
+                            )?;
+                            std::thread::sleep(Duration::from_millis(u64::from(
+                                duration_ms / steps,
+                            )));
+                        }
+                        events.button_up(ComputerMouseButton::Left)?;
+                    }
+                    _ => unreachable!(),
+                }
+                Ok((ActionRoute::SyntheticEvents, foreground))
+            }
+        }
+    }
+
+    fn prepare_accessibility(&self) -> Result<(), &'static str> {
+        let native = Native {
+            operation: &self.operation,
+        };
+        if native.needs_preparation()? {
+            let readiness =
+                super::with_focus_cleanup(&self.operation, "segment_ax_readiness", || {
+                    match native.prepare() {
+                        Ok(()) => cua_driver_core::protocol::ToolResult::text("AX ready"),
+                        Err(code) => super::refusal(code),
+                    }
+                });
+            if readiness.is_error == Some(true) {
+                return Err("accessibility_readiness_unknown");
+            }
+        }
+        Ok(())
+    }
+
+    pub fn execute(
+        self,
+        segment: ComputerSegment,
+        authorize: impl Fn(&str, &serde_json::Value) -> Result<(), &'static str>,
+    ) -> Execution {
+        let started = Instant::now();
+        let mut actions = Vec::new();
+        let authorization = self
+            .operation
+            .session
+            .native_window()
+            .and_then(|target| {
+                authorize(
+                    "get_window_state",
+                    &serde_json::json!({"pid":target.pid,"window_id":target.window_id,
+                "include_accessibility_tree":true,"include_screenshot":self.image.is_some()}),
+                )
+            })
+            .and_then(|()| {
+                readiness::permission(|| {
+                    self.operation
+                        .primary(false, || unsafe { bindings::AXIsProcessTrusted() })
+                })
+            });
+        if let Err(code) = authorization {
+            return Execution {
+                actions: vec![ActionRecord {
+                    action: None,
+                    code: Some(code.into()),
+                    committed: false,
+                    complete: false,
+                }],
+                condition: None,
+                cancelled: self.operation.is_cancelled(),
+                recovery_attempts: 0,
+                elapsed_ms: 0,
+            };
+        }
+        let prior = self.operation.session.intent_state(&segment.intent_ref);
+        let mut recovery_attempts = prior.unwrap_or((0, false, false)).0;
+        if prior.is_err() || prior.is_ok_and(|(_, uncertain, confirmed)| uncertain || confirmed) {
+            // A lost reply or visual dependency from this intent is checked
+            // against current state before any possible replay. False/unknown
+            // alone never proves that previous text/submission was uncommitted.
+            let condition = self.condition(&segment.postcondition);
+            let code = if condition == Some(true) {
+                "condition_already_satisfied"
+            } else {
+                // Binding this new operation already consumed its shared retry.
+                // This read cannot authorize replay or charge that retry twice.
+                "intent_outcome_unknown"
+            };
+            let _ = self.operation.session.record_intent(
+                &segment.intent_ref,
+                false,
+                condition == Some(true),
+            );
+            return Execution {
+                actions: vec![ActionRecord {
+                    action: None,
+                    code: Some(code.into()),
+                    committed: false,
+                    complete: false,
+                }],
+                condition: if condition == Some(true) {
+                    condition
+                } else {
+                    None
+                },
+                cancelled: self.operation.is_cancelled(),
+                recovery_attempts,
+                elapsed_ms: started.elapsed().as_millis() as u64,
+            };
+        }
+        let mut events = None;
+        for (index, action) in segment.actions.iter().enumerate() {
+            let mut begun = false;
+            let attempt = (|| {
+                self.operation.begin_segment_action(index as u32)?;
+                begun = true;
+                self.live()?;
+                if index == 0 {
+                    if let Some(image) = &self.image {
+                        crate::input::controlled::revalidate(image, &self.operation)?;
+                    }
+                }
+                let target = self.operation.session.native_window()?;
+                let tool = match action {
+                    ComputerInput::Focus { .. } | ComputerInput::Fill { .. } => "set_value",
+                    ComputerInput::TypeText { .. } => "type_text",
+                    ComputerInput::Key { .. }
+                    | ComputerInput::KeyDown { .. }
+                    | ComputerInput::KeyUp { .. } => "press_key",
+                    ComputerInput::Scroll { .. } => "scroll",
+                    ComputerInput::Drag { .. } => "drag",
+                    ComputerInput::Window {
+                        action: ComputerWindowAction::Activate,
+                    } => "bring_to_front",
+                    ComputerInput::Window { .. } => "set_window_frame",
+                    _ => "click",
+                };
+                let mut args = serde_json::json!({"pid":target.pid,"window_id":target.window_id});
+                match action {
+                    ComputerInput::Fill { text, .. } => args["value"] = serde_json::json!(text),
+                    ComputerInput::TypeText { text } => args["text"] = serde_json::json!(text),
+                    ComputerInput::Key { key, modifiers } => {
+                        args["key"] = serde_json::json!(key);
+                        args["modifiers"] = serde_json::json!(modifiers
+                            .iter()
+                            .map(|modifier| match modifier {
+                                ComputerModifier::Command => "command",
+                                ComputerModifier::Control => "control",
+                                ComputerModifier::Option => "option",
+                                ComputerModifier::Shift => "shift",
+                                ComputerModifier::Function => "fn",
+                            })
+                            .collect::<Vec<_>>());
+                    }
+                    ComputerInput::KeyDown { key } | ComputerInput::KeyUp { key } => {
+                        args["key"] = serde_json::json!(key)
+                    }
+                    ComputerInput::Window {
+                        action:
+                            ComputerWindowAction::SetBounds {
+                                x,
+                                y,
+                                width,
+                                height,
+                            },
+                    } => {
+                        args["x"] = serde_json::json!(x);
+                        args["y"] = serde_json::json!(y);
+                        args["width"] = serde_json::json!(width);
+                        args["height"] = serde_json::json!(height);
+                    }
+                    _ => {}
+                }
+                authorize(tool, &args)?;
+                readiness::before_action(action, || self.prepare_accessibility())?;
+                if events.is_none() {
+                    events = Some(Events::new(self.operation.clone(), self.renderer.clone())?);
+                }
+                let mut result = self.apply(events.as_mut().unwrap(), action);
+                if self.operation.segment_action_inputs() == 0
+                    && matches!(result, Err("pointer_route_unavailable"))
+                    && !events.as_ref().unwrap().held()
+                {
+                    recovery_attempts =
+                        self.operation.session.recover_intent(&segment.intent_ref)?;
+                    self.activate()?;
+                    events.as_mut().unwrap().foreground = true;
+                    result = self.apply(events.as_mut().unwrap(), action);
+                }
+                // Only explicitly non-dispatched stale local targets may be
+                // re-read. A native error after any admitted primitive is never
+                // replayed, regardless of whether a postcondition looks false.
+                if self.operation.segment_action_inputs() == 0
+                    && matches!(result, Err("target_absent" | "target_scope_incomplete"))
+                    && recovery_attempts < 2
+                {
+                    recovery_attempts =
+                        self.operation.session.recover_intent(&segment.intent_ref)?;
+                    if self.condition(&segment.postcondition) == Some(true) {
+                        return Err("condition_already_satisfied");
+                    }
+                    self.operation.checkpoint()?;
+                    result = self.apply(events.as_mut().unwrap(), action);
+                }
+                result
+            })();
+            let count = if begun {
+                self.operation.segment_action_inputs()
+            } else {
+                0
+            };
+            match attempt {
+                Ok((route, foreground)) => actions.push(ActionRecord {
+                    committed: true,
+                    complete: true,
+                    code: None,
+                    action: Some(ActionResult {
+                        effect: ActionEffect::Unverifiable,
+                        route,
+                        delivery: Some(ActionDelivery {
+                            mode: if foreground {
+                                ActionDeliveryMode::Foreground
+                            } else {
+                                ActionDeliveryMode::Background
+                            },
+                            delivered_count: (count > 0).then_some(count),
+                        }),
+                        evidence: None,
+                        escalation: None,
+                    }),
+                }),
+                Err(code) => {
+                    actions.push(ActionRecord {
+                        committed: count > 0,
+                        complete: false,
+                        action: None,
+                        code: Some(code.into()),
+                    });
+                    break;
+                }
+            }
+        }
+        drop(events); // release obligations precede postcondition and terminal
+        let condition = confirmation::wait(
+            actions.len() == segment.actions.len() && actions.iter().all(|row| row.complete),
+            || self.condition(&segment.postcondition),
+            || {
+                if self.operation.checkpoint().is_err() {
+                    return false;
+                }
+                std::thread::sleep(Duration::from_millis(20));
+                self.operation.checkpoint().is_ok()
+            },
+        );
+        if self
+            .operation
+            .session
+            .record_intent(
+                &segment.intent_ref,
+                self.operation.input_committed(),
+                condition == Some(true),
+            )
+            .is_err()
+        {
+            self.operation.quarantine();
+        }
+        let _ = self.operation.wait_callbacks();
+        recovery_attempts = self
+            .operation
+            .session
+            .intent_state(&segment.intent_ref)
+            .map(|state| state.0)
+            .unwrap_or(recovery_attempts);
+        Execution {
+            actions,
+            condition,
+            cancelled: self.operation.is_cancelled(),
+            recovery_attempts,
+            elapsed_ms: started.elapsed().as_millis().min(u128::from(u64::MAX)) as u64,
+        }
+    }
+}
diff --git a/libs/cua-driver/rust/crates/platform-macos/src/tools/computer/segment/confirmation.rs b/libs/cua-driver/rust/crates/platform-macos/src/tools/computer/segment/confirmation.rs
