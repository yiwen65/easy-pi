+fn interrupted(revoke: bool) {
+    let (_, parent, op) = fixture(3);
+    let (entered_tx, entered_rx) = mpsc::channel();
+    let (resume_tx, resume_rx) = mpsc::channel();
+    let records = Arc::new(Mutex::new(Vec::new()));
+    let captured = records.clone();
+    let worker = op.clone();
+    let work = op.track().unwrap();
+    let thread = std::thread::spawn(move || {
+        let _work = work;
+        sequence(
+            Some(&worker),
+            42,
+            || 0,
+            |record| {
+                captured.lock().unwrap().push(record[8]);
+                if record[8] == 1 {
+                    entered_tx.send(()).unwrap();
+                    resume_rx.recv().unwrap();
+                }
+                0
+            },
+            || true,
+        )
+    });
+    entered_rx.recv().unwrap();
+    if revoke {
+        parent.revoke();
+    } else {
+        op.cancel();
+    }
+    resume_tx.send(()).unwrap();
+    let result = thread.join().unwrap();
+    op.finish();
+    assert!(op.segment_primary(|| panic!("later primary")).is_err());
+    assert_eq!(
+        *records.lock().unwrap(),
+        vec![1, 2],
+        "admitted first record must be matched; sequence={result}"
+    );
+    assert!(op.is_proven_terminal());
+    assert_eq!(op.segment_action_inputs(), 2);
