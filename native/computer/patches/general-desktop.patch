+                        Arc::get_mut(state.by_connection.get_mut(&connection.id).unwrap()).unwrap();
+                    let old = Instant::now() - Duration::from_secs(7200);
+                    if absolute {
+                        if let Some(expires) = &mut context.expires_at {
+                            *expires = old;
+                        }
+                    } else if let Some(last) = &context.last_authorized_dispatch {
+                        *last.lock().unwrap() = old;
+                    }
+                }
+                let context = registry.state.lock().unwrap().by_connection[&connection.id].clone();
+                let owned = computer && mode == PermissionMode::Unrestricted && !with_manifest;
+                assert_eq!(!context.is_expired(), owned);
+                assert_eq!(context.commit_authorized_dispatch().is_ok(), owned);
+                assert_eq!(
+                    registry
+                        .resolve_delegated(&connection, "public-a", "transport-a")
+                        .is_ok(),
+                    owned
+                );
+                if owned {
+                    assert!(crate::authorization::authorize_tool_call_with_context(
+                        "click",
+                        &serde_json::json!({}),
+                        &context,
+                    )
+                    .is_ok());
+                    registry.revoke_host(&host);
+                    assert!(context.is_revoked());
+                    assert!(context.commit_authorized_dispatch().is_err());
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn controlled_full_access_lifetime_is_owned_not_a_large_ttl() {
+        let registry = SessionAuthorizationRegistry::delegated_for_test(
+            SessionModeCeiling::delegated([PermissionMode::Unrestricted], true),
+        );
+        let (host, connection) = registry.trusted_pair_for_test(None);
+        let mut input = request(PermissionMode::Unrestricted);
+        input.ttl = Duration::from_millis(1);
+        input.idle_ttl = input.ttl;
+        registry
+            .bind_computer_session(&host, &connection, input, None)
+            .unwrap();
+        let context = registry
+            .resolve_delegated(&connection, "public-a", "transport-a")
+            .unwrap();
+        assert!(context.expires_at.is_none());
+        assert!(context.idle_ttl.is_none());
+        std::thread::sleep(Duration::from_millis(3));
+        assert!(!context.is_expired());
+        context.commit_authorized_dispatch().unwrap();
+        registry.revoke_host(&host);
+        assert!(context.is_expired());
+        assert!(context.commit_authorized_dispatch().is_err());
+    }
+
+    #[test]
+    fn controlled_manifest_and_ordinary_delegation_keep_expiry() {
+        for (computer, with_manifest) in [(false, false), (true, true)] {
+            let registry = SessionAuthorizationRegistry::delegated_for_test(
+                SessionModeCeiling::delegated([PermissionMode::Unrestricted], true),
+            );
+            let (host, connection) = registry.trusted_pair_for_test(None);
+            let mut input = request(PermissionMode::Unrestricted);
+            input.ttl = Duration::from_millis(1);
+            input.idle_ttl = input.ttl;
+            if with_manifest {
+                input.capability_manifest = Some(manifest_with_allowed_tool("click"));
+            }
+            if computer {
+                registry
+                    .bind_computer_session(&host, &connection, input, None)
+                    .unwrap();
+            } else {
+                registry
+                    .bind_delegated_session(&host, &connection, input)
+                    .unwrap();
+            }
+            let context = registry
+                .resolve_delegated(&connection, "public-a", "transport-a")
+                .unwrap();
+            assert!(context.expires_at.is_some());
+            std::thread::sleep(Duration::from_millis(3));
+            assert!(context.is_expired());
+            assert!(context.commit_authorized_dispatch().is_err());
+        }
     }

