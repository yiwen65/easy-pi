+#[tokio::test]
+async fn controlled_segment_worker_scope_cannot_resolve_foreign_runtime_cache() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let first = host();
+    let second = host();
+    let cache = Arc::new(cua_driver_core::tool::with_runtime_scope(first.runtime.runtime_scope_key(), || {
+        cua_driver_core::element_cache::ElementCacheCore::new()
+    }));
+    let token = cua_driver_core::element_token::token_for(cache.publish(42, 7, InertPayload), 0);
+    let operation = session(&second, None).new_operation().unwrap();
+    operation.core.begin().unwrap();
+    let actual = operation.segment_blocking(move || resolve_inert(&cache, &token, 7)).await.unwrap();
+    operation.core.finish();
+    assert!(!operation.terminal().await.unwrap().input_committed);
+    first.close().await.unwrap();
+    second.close().await.unwrap();
+    assert_eq!(actual, Err("generation_mismatch".into()));
+}
