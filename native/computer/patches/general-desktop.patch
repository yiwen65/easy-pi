+        ));
+        assert!(!matches_identity(42, 7206, Some(42), Some(7202), || Some(
+            7206
+        )));
+        assert!(matches_identity(42, 7202, Some(42), None, || Some(7202)));
+    }
+    #[test]
+    fn controlled_surface_current_incarnation_and_window_ownership_are_required() {
+        use crate::windows::WindowOwner;
+        assert!(current_owner(
+            Some((1, 2)),
+            Some((1, 2)),
+            WindowOwner::SamePid
+        ));
+        assert!(!current_owner(None, None, WindowOwner::SamePid));
+        assert!(!current_owner(Some((1, 2)), None, WindowOwner::SamePid));
+        assert!(!current_owner(
+            Some((1, 2)),
+            Some((1, 3)),
+            WindowOwner::SamePid
+        ));
+        assert!(!current_owner(
+            Some((1, 2)),
+            Some((1, 2)),
+            WindowOwner::Unknown
+        ));
+        assert!(!current_owner(
+            Some((1, 2)),
+            Some((1, 2)),
+            WindowOwner::ForeignPid {
+                owner_pid: 43,
+                owner_app_name: String::new()
+            }
+        ));
+    }
+
+    #[test]
+    fn controlled_surface_foreground_unknown_is_not_false_or_parent_permission() {
+        assert_eq!(foreground_match(Some(true), Some(7206), 7206), Some(true));
+        assert_eq!(foreground_match(Some(true), Some(7206), 7202), Some(false));
+        assert_eq!(foreground_match(Some(true), None, 7206), None);
+        assert_eq!(foreground_match(None, Some(7206), 7206), None);
+        assert_eq!(foreground_match(Some(false), Some(7206), 7206), Some(false));
+    }
+}
