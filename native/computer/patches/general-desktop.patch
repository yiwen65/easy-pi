+async fn renderer_stop_drains(helper_name: &str, expected: ComputerRendererStatus) {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let mut host = host();
+    let helper = std::path::PathBuf::from(std::env::var_os("CUA_RENDERER_TEST_HELPER").unwrap())
+        .with_file_name(helper_name);
+    let renderer = Arc::new(platform_macos::computer_renderer::Renderer::start(&helper).unwrap());
+    let pid = renderer.pid;
+    Arc::get_mut(&mut host).unwrap().renderer = Some(renderer);
+    host.bind_renderer_stop();
+    let session = session(&host, None);
+    let operation = session.clone().new_operation().unwrap();
+    operation.core.begin().unwrap();
+    operation.core.primary(true, || ()).unwrap(); // inert committed primitive
+    let release = operation.core.track_callback().unwrap();
+    let mut terminal = Box::pin(operation.terminal());
+    assert!(terminal
+        .as_mut()
+        .poll(&mut Context::from_waker(Waker::noop()))
+        .is_pending());
+    drop(terminal); // foreign waiter loss cannot disable emergency handling
+    tokio::time::timeout(Duration::from_secs(5), async {
+        while operation.core.checkpoint().is_ok() || session.native.computer_authority_live() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    assert!(match (&expected, host.renderer_status()) {
+        (ComputerRendererStatus::EmergencyStopped, ComputerRendererStatus::EmergencyStopped) =>
+            true,
+        (
+            ComputerRendererStatus::Failed { code: expected },
+            ComputerRendererStatus::Failed { code },
+        ) => *expected == code,
+        _ => false,
+    });
+    assert!(!session.native.computer_authority_live());
+    assert!(session.clone().new_operation().is_err());
+    assert!(operation
+        .core
+        .primary(true, || panic!("post-stop input"))
+        .is_err());
+    operation.core.finish();
+    assert!(!operation.core.is_proven_terminal());
+    // Helper EOF/reap and input release proof are independent obligations.
+    host.renderer.as_ref().unwrap().close().unwrap();
+    assert!(!platform_macos::computer_renderer::is_owned_window(pid, 42));
+    assert!(host.runtime.is_running());
+    drop(release); // simulated producer-owned release completion, no OS input
+    let receipt = operation.terminal().await.unwrap();
+    assert!(receipt.cancelled && receipt.input_committed);
+    host.clone().close().await.unwrap();
+    assert!(!host.runtime.is_running());
+    assert!(match (&expected, host.renderer_status()) {
+        (ComputerRendererStatus::EmergencyStopped, ComputerRendererStatus::EmergencyStopped) =>
+            true,
+        (
+            ComputerRendererStatus::Failed { code: expected },
+            ComputerRendererStatus::Failed { code },
+        ) => *expected == code,
+        _ => false,
+    });
+    let weak = Arc::downgrade(&host);
+    drop(operation);
+    drop(session);
+    drop(host);
+    tokio::time::timeout(Duration::from_secs(5), async {
+        while weak.upgrade().is_some() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+}
