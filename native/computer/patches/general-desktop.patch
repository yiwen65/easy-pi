+        assert!(!matches_identity(42, 7206, Some(43), Some(7206), || None));
+        assert!(!matches_identity(42, 7206, None, Some(7206), || None));
+        assert!(!matches_identity(42, 7206, Some(42), None, || None));
+    }
+    #[test]
