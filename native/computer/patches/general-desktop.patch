+    let window = general_window_in(windows, pid, id).ok_or("controlled_target_stale")?;
+    let bounds = &window.bounds;
+    if [bounds.x, bounds.y, bounds.width, bounds.height] != expected {
+        return Err("stale_image_geometry");
+    }
+    Ok(window)
+}
