+//! Foreground-only interference detection. Listen-only, never filters events;
+//! no characters, key codes, coordinates or per-event history are retained.
+use core_foundation::{
+    base::TCFType,
+    mach_port::{CFMachPort, CFMachPortInvalidate, CFMachPortRef},
+    runloop::{kCFRunLoopDefaultMode, CFRunLoop, CFRunLoopRunResult, CFRunLoopSource},
+};
+use core_graphics::event::CGEventType;
+use std::{cell::Cell, ffi::c_void, marker::PhantomData, rc::Rc, time::Duration};
+
+#[link(name = "CoreGraphics", kind = "framework")]
+unsafe extern "C" {
+    fn CGPreflightListenEventAccess() -> bool;
+    fn CGEventTapCreate(
+        tap: u32,
+        place: u32,
+        options: u32,
+        mask: u64,
+        callback: unsafe extern "C" fn(*mut c_void, u32, *mut c_void, *mut c_void) -> *mut c_void,
+        info: *mut c_void,
+    ) -> CFMachPortRef;
+    fn CGEventTapEnable(tap: CFMachPortRef, enable: bool);
+    fn CGEventTapIsEnabled(tap: CFMachPortRef) -> bool;
+    fn CGEventGetTimestamp(event: *mut c_void) -> u64;
+    fn CGEventGetIntegerValueField(event: *mut c_void, field: u32) -> i64;
+}
+
+pub(super) fn now() -> Result<u64, &'static str> {
+    let mut time = libc::timespec {
+        tv_sec: 0,
+        tv_nsec: 0,
+    };
+    if unsafe { libc::clock_gettime(libc::CLOCK_UPTIME_RAW, &mut time) } != 0
+        || time.tv_sec < 0
+        || !(0..1_000_000_000).contains(&time.tv_nsec)
+    {
+        return Err("event_clock_unavailable");
+    }
+    (time.tv_sec as u64)
+        .checked_mul(1_000_000_000)
+        .and_then(|value| value.checked_add(time.tv_nsec as u64))
+        .ok_or("event_clock_unavailable")
+}
+
+#[derive(Default)]
+struct State {
+    tag: i64,
+    active: Cell<bool>,
+    started: Cell<u64>,
+    own: Cell<u32>,
+    external: Cell<u32>,
+    unavailable: Cell<bool>,
+}
+impl State {
+    fn note(&self, timestamp: u64, tag: i64) {
+        if !self.active.get() || (timestamp != 0 && timestamp < self.started.get()) {
+            return;
+        }
+        let count = if tag == self.tag {
+            &self.own
+        } else {
+            &self.external
+        };
+        if count.get() >= 10_000 {
+            self.unavailable.set(true);
+        } else {
+            count.set(count.get() + 1);
+        }
+    }
+}
+
+unsafe extern "C" fn callback(
+    _proxy: *mut c_void,
+    kind: u32,
+    event: *mut c_void,
+    info: *mut c_void,
+) -> *mut c_void {
+    if !info.is_null() {
+        let state = unsafe { &*(info as *const State) };
+        if kind == 0xffff_fffe || kind == 0xffff_ffff || event.is_null() {
+            state.unavailable.set(true);
+        } else {
+            state.note(unsafe { CGEventGetTimestamp(event) }, unsafe {
+                CGEventGetIntegerValueField(event, 42)
+            });
+        }
+    }
+    event // Original event always passes through unchanged, including disabled/null notifications.
+}
+
+pub(super) struct Observer {
+    tap: CFMachPort,
+    source: CFRunLoopSource,
+    run_loop: CFRunLoop,
+    state: Box<State>,
+    _thread_bound: PhantomData<Rc<()>>,
+}
+impl Observer {
+    pub(super) fn new(tag: i64) -> Result<Self, &'static str> {
+        if !unsafe { CGPreflightListenEventAccess() } {
+            return Err("input_monitoring_permission_denied");
+        }
+        let state = Box::new(State {
+            tag,
+            ..State::default()
+        });
+        let kinds = [
+            CGEventType::LeftMouseDown,
+            CGEventType::LeftMouseUp,
+            CGEventType::RightMouseDown,
+            CGEventType::RightMouseUp,
+            CGEventType::OtherMouseDown,
+            CGEventType::OtherMouseUp,
+            CGEventType::MouseMoved,
+            CGEventType::LeftMouseDragged,
+            CGEventType::RightMouseDragged,
+            CGEventType::OtherMouseDragged,
+            CGEventType::ScrollWheel,
+            CGEventType::KeyDown,
+            CGEventType::KeyUp,
+            CGEventType::FlagsChanged,
+        ];
+        let mask = kinds
+            .iter()
+            .fold(0u64, |mask, kind| mask | (1u64 << (*kind as u32)));
+        // Session=1, head insert=0, listen-only=1 from the installed SDK header.
+        let raw = unsafe {
+            CGEventTapCreate(
+                1,
+                0,
+                1,
+                mask,
+                callback,
+                (&*state as *const State).cast_mut().cast(),
+            )
+        };
+        if raw.is_null() {
+            return Err("input_observer_unavailable");
+        }
+        let tap = unsafe { CFMachPort::wrap_under_create_rule(raw) };
+        let source = match tap.create_runloop_source(0) {
+            Ok(source) => source,
+            Err(()) => {
+                unsafe { CFMachPortInvalidate(raw) };
+                return Err("input_observer_unavailable");
+            }
+        };
+        let run_loop = CFRunLoop::get_current();
+        run_loop.add_source(&source, unsafe { kCFRunLoopDefaultMode });
+        let result = Self {
+            tap,
+            source,
+            run_loop,
+            state,
+            _thread_bound: PhantomData,
+        };
+        unsafe { CGEventTapEnable(raw, true) };
+        result.check()?;
+        Ok(result)
+    }
+    fn pump(&self) {
+        for _ in 0..32 {
+            if CFRunLoop::run_in_mode(unsafe { kCFRunLoopDefaultMode }, Duration::ZERO, true)
+                != CFRunLoopRunResult::HandledSource
+            {
+                return;
+            }
+        }
+        self.state.unavailable.set(true);
+    }
+    pub(super) fn arm(&self) -> Result<(), &'static str> {
+        self.check()?;
+        self.state.started.set(now()?);
+        self.state.own.set(0);
+        self.state.external.set(0);
+        self.state.active.set(true);
+        Ok(())
+    }
+    pub(super) fn check(&self) -> Result<(), &'static str> {
+        self.pump();
+        if self.state.unavailable.get()
+            || !unsafe { CGEventTapIsEnabled(self.tap.as_concrete_TypeRef()) }
+        {
+            Err("input_observer_unavailable")
+        } else if self.state.external.get() != 0 {
+            Err("foreground_input_conflict")
+        } else {
+            Ok(())
+        }
+    }
+}
+impl Drop for Observer {
+    fn drop(&mut self) {
+        self.state.active.set(false);
+        self.run_loop
+            .remove_source(&self.source, unsafe { kCFRunLoopDefaultMode });
+        // Invalidate before state/callback storage dies, on this same worker's
+        // run loop. No detached callback/observer survives operation drain.
+        unsafe { CFMachPortInvalidate(self.tap.as_concrete_TypeRef()) };
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn controlled_global_observer_counts_only_current_interval_and_never_records_contents() {
+        let state = State {
+            tag: 7,
+            ..State::default()
+        };
+        state.note(11, 3);
+        assert_eq!(state.external.get(), 0);
+        state.started.set(10);
+        state.active.set(true);
+        state.note(9, 3);
+        state.note(10, 7);
+        state.note(11, 3);
+        state.note(0, 3);
+        assert_eq!(state.own.get(), 1);
+        assert_eq!(state.external.get(), 2);
+        state.own.set(10_000);
+        state.note(12, 7);
+        assert!(state.unavailable.get());
+    }
+    #[test]
+    fn controlled_global_observer_disabled_null_callback_is_pass_through_and_unavailable() {
+        let state = State::default();
+        let event = unsafe {
+            callback(
+                std::ptr::null_mut(),
+                0xffff_fffe,
+                std::ptr::null_mut(),
+                (&state as *const State).cast_mut().cast(),
+            )
+        };
+        assert!(event.is_null());
+        assert!(state.unavailable.get());
+    }
+}
