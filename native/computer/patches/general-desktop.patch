+            assert!(general_window_metadata(&invalid).is_err());
+            assert!(general_window_in(&[invalid], 42, 9).is_none());
+        }
+    }
+    for value in [0., -1.] {
+        let mut invalid = w.clone();
+        invalid.bounds.width = value;
+        assert!(general_window_metadata(&invalid).is_err());
+        invalid = w.clone();
+        invalid.bounds.height = value;
+        assert!(general_window_metadata(&invalid).is_err());
+    }
+    for field in 0..7 {
+        let mut invalid = w.clone();
+        match field {
+            0 => invalid.pid = 0,
+            1 => invalid.window_id = 0,
+            2 => invalid.app_name = " ".into(),
+            3 => invalid.is_on_screen = false,
+            4 => invalid.on_current_space = Some(false),
+            5 => invalid.app_name = "x".repeat(257),
+            _ => invalid.title = "x".repeat(2049),
+        }
+        assert!(general_window_metadata(&invalid).is_err());
+    }
+    for space in [None, Some(true)] {
+        w.on_current_space = space;
+        assert!(general_window_metadata(&w).is_ok());
+    }
+    w.layer = 0;
+    w.is_on_screen = false;
+    w.on_current_space = Some(false);
+    assert!(
+        general_window_metadata(&w).is_ok(),
+        "legacy off-screen catalog remains available"
+    );
+}
+
+pub(crate) fn popup_budget_candidates() -> Vec<WindowInfo> {
+    (1..=315)
+        .map(|id| {
+            let mut w = tests::window(id, 42, "Fixture");
+            w.layer = if id <= 217 { 0 } else { 101 };
+            w.is_on_screen = id > 217 && id <= 241;
+            w
+        })
+        .filter(|w| admits_window(LayerFilter::General, w.layer, Some(w.is_on_screen), false))
+        .collect()
+}
+
+#[test]
+fn popup_eligibility_precedes_catalog_budget() {
+    let candidates = popup_budget_candidates();
+    assert_eq!(
+        candidates.len(),
+        241,
+        "217 normal + 24 visible accessories; 74 hidden accessories excluded before catalog budget"
+    );
+    assert_eq!(candidates.iter().filter(|w| w.layer == 0).count(), 217);
+    assert_eq!(candidates.iter().filter(|w| w.layer != 0).count(), 24);
+}
+
+#[test]
+fn popup_hidden_accessory_excluded_only_from_general() {
+    for visibility in [None, Some(false), Some(true)] {
+        for layer in [i32::MIN, -1, 0, 101, 102, i32::MAX] {
+            assert_eq!(
+                admits_window(LayerFilter::General, layer, visibility, false),
+                layer == 0 || visibility != Some(false)
+            );
+            assert!(admits_window(
+                LayerFilter::AnyLayer,
+                layer,
+                visibility,
+                false
+            ));
+            assert_eq!(
+                admits_window(LayerFilter::ZeroOnly, layer, visibility, false),
+                layer == 0
+            );
+            for mode in [
+                LayerFilter::ZeroOnly,
+                LayerFilter::General,
+                LayerFilter::AnyLayer,
+            ] {
+                assert!(!admits_window(mode, layer, visibility, true));
+            }
+        }
+    }
+}
