+use super::*;
+
+#[test]
+fn controlled_queued_input_requires_a_boundary_before_synchronous_mutations() {
+    let target = ComputerElementAddress::Reference {
+        reference: "s00000001:1".into(),
+    };
+    for action in [
+        ComputerInput::Focus {
+            target: target.clone(),
+        },
+        ComputerInput::Fill {
+            target,
+            text: "replacement".into(),
+        },
+        ComputerInput::Window {
+            action: ComputerWindowAction::Close,
+        },
+    ] {
+        assert!(!requires_semantic_boundary(&action, false));
+        assert!(requires_semantic_boundary(&action, true));
+    }
+    for action in [
+        ComputerInput::TypeText {
+            text: "ordered insertion".into(),
+        },
+        ComputerInput::Key {
+            key: "s".into(),
+            modifiers: vec![ComputerModifier::Command],
+        },
+        ComputerInput::KeyUp {
+            key: "shift".into(),
+        },
+        ComputerInput::ButtonUp {
+            button: ComputerMouseButton::Left,
+        },
+    ] {
+        assert!(!requires_semantic_boundary(&action, true));
+    }
+}
+
+#[test]
+fn controlled_document_text_never_uses_raw_ax_value_assignment() {
+    let mut data = observation::Data {
+        role: "AXTextArea".into(),
+        settable: true,
+        ..Default::default()
+    };
+    assert!(data.general_fillable());
+    assert!(!data.value_fillable());
+    data.role = "AXTextField".into();
+    assert!(data.value_fillable());
+    data.enabled = Some(false);
+    assert!(!data.value_fillable());
+}
