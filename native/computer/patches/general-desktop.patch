+    resume_tx.send(()).unwrap();
+    let terminal = next_waiter.await.unwrap();
+    assert!(terminal.cancelled && terminal.input_committed);
+    assert_eq!(*records.lock().unwrap(), vec![1, 2]);
+    assert!(!gate.is_quarantined());
+}
+
+fn unarmed_refusal(phase: u8) {
+    let (gate, _, op) = fixture(3);
+    let fronted = Cell::new(false);
+    let records = RefCell::new(Vec::new());
+    assert!(!sequence(
+        Some(&op),
+        42,
+        || { fronted.set(true); if phase == 1 { -1 } else { 0 } },
+        |record| { records.borrow_mut().push(record[8]); 0 },
+        || phase != 0 && (phase != 2 || !fronted.get()),
+    ));
+    op.finish();
+    assert!(records.borrow().is_empty(), "no first record may target stale identity");
+    assert!(!gate.is_quarantined(), "no owned pair exists before first-record admission");
+    assert!(op.is_proven_terminal());
+    assert_eq!(op.segment_action_inputs(), u32::from(phase != 0));
+}
+
+#[test]
+fn controlled_key_pair_unarmed_initial_identity_refusal_is_terminal() { unarmed_refusal(0); }
+#[test]
+fn controlled_key_pair_unarmed_front_failure_is_terminal() { unarmed_refusal(1); }
+#[test]
+fn controlled_key_pair_unarmed_identity_change_after_front_is_terminal() { unarmed_refusal(2); }
+
+#[test]
+fn uncontrolled_key_pair_retains_native_failure_early_return() {
+    for failed in [0, 1, 2, 3] {
+        let records = RefCell::new(Vec::new());
+        let result = sequence(
+            None,
+            42,
+            || if failed == 0 { -1 } else { 0 },
+            |record| {
+                records.borrow_mut().push(record[8]);
+                if failed == record[8] {
+                    -1
+                } else {
+                    0
+                }
+            },
+            || panic!("uncontrolled route must not read identity"),
+        );
+        assert_eq!(result, failed == 3);
+        assert_eq!(
+            *records.borrow(),
+            match failed {
+                0 => vec![],
+                1 => vec![1],
+                _ => vec![1, 2],
+            }
+        );
+    }
+}
