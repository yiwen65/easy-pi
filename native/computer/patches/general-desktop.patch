+    #[tokio::test]
+    async fn controlled_popup_click_owned_release_survives_cancel_revoke_and_unwind() {
+        use cua_driver_core::controlled::Gate;
+        for mode in 0..5 {
+            let gate = Gate::new();
+            let session = gate
+                .session(None, Arc::new(|| true), 42, 7, Some((1, 2)))
+                .unwrap();
+            let op = session.new_operation().unwrap();
+            op.configure_segment(vec![1], Duration::from_secs(1))
+                .unwrap();
+            op.begin().unwrap();
+            op.begin_segment_action(0).unwrap();
+            let work = op.track().unwrap();
+            let downs = AtomicUsize::new(0);
+            let ups = Arc::new(AtomicUsize::new(0));
+            let released = ups.clone();
+            let release_op = op.clone();
+            if mode == 0 {
+                op.cancel();
+            }
+            let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                let mut owned = None;
+                let release = Box::new(move |_: ()| {
+                    released.fetch_add(1, Ordering::SeqCst);
+                    if mode == 4 {
+                        release_op.quarantine();
+                        Err("release_failure")
+                    } else {
+                        Ok(())
+                    }
+                });
+                let result = admit_down(&op, &mut owned, (), release, || {
+                    downs.fetch_add(1, Ordering::SeqCst);
+                    if mode == 1 {
+                        op.cancel();
+                    }
+                    if mode == 2 {
+                        session.revoke();
+                    }
+                    if mode == 3 {
+                        panic!("after admitted down");
+                    }
+                });
+                assert_eq!(result.is_ok(), mode != 0);
+                if mode == 1 || mode == 2 {
+                    assert!(op
+                        .segment_primary(|| panic!("new input after stop"))
+                        .is_err());
+                }
+            }));
+            assert_eq!(outcome.is_err(), mode == 3);
+            assert_eq!(downs.load(Ordering::SeqCst), usize::from(mode != 0));
+            assert_eq!(ups.load(Ordering::SeqCst), usize::from(mode != 0));
+            drop(work);
+            op.finish();
+            if mode == 4 {
+                assert_eq!(op.terminal().await, Err("quarantined"));
+            } else {
+                assert_eq!(op.terminal().await.unwrap().input_committed, mode != 0);
+            }
+        }
+    }
