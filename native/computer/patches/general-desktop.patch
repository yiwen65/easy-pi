@@ -0,0 +1,416 @@
+use super::{NativeWindowTarget, Operation, Session};
+use std::time::{Duration, Instant};
+
+#[derive(Default)]
+pub(super) struct IntentState {
+    attempts: u8,
+    uncertain: bool,
+    confirmed: bool,
+    drag_destination: Option<NativeWindowTarget>,
+    time: Option<IntentTime>,
+    preparation_continuation: Option<NativeWindowTarget>,
+}
+
+struct IntentTime {
+    remaining: Duration,
+    active: Option<(String, Instant)>,
+}
+
+impl IntentTime {
+    fn remaining_at(&self, now: Instant) -> Duration {
+        self.remaining.saturating_sub(
+            self.active.as_ref().map_or(Duration::ZERO, |(_, started)| now.saturating_duration_since(*started)),
+        )
+    }
+}
+
+impl IntentState {
+    fn charge_retry(&mut self) -> Result<u8, &'static str> {
+        if self.attempts >= 2 {
+            return Err("recovery_exhausted");
+        }
+        self.attempts += 1;
+        Ok(self.attempts)
+    }
+}
+
+impl Session {
+    pub fn intent_state(&self, intent: &str) -> Result<(u8, bool, bool), &'static str> {
+        let mut states = self
+            .recovery
+            .lock()
+            .map_err(|_| "recovery_state_poisoned")?;
+        if intent.is_empty() || intent.len() > 128 {
+            return Err("invalid_intent_reference");
+        }
+        if !states.contains_key(intent) && states.len() >= 256 {
+            return Err("unresolved_intent_limit");
+        }
+        let state = states.entry(intent.into()).or_default();
+        Ok((state.attempts, state.uncertain, state.confirmed))
+    }
+
+    pub fn recover_intent(&self, intent: &str) -> Result<u8, &'static str> {
+        self.intent_state(intent)?;
+        let mut states = self
+            .recovery
+            .lock()
+            .map_err(|_| "recovery_state_poisoned")?;
+        let state = states.get_mut(intent).ok_or("invalid_intent_reference")?;
+        if state.time.as_ref().is_some_and(|time| time.remaining_at(Instant::now()).is_zero()) {
+            return Err("recovery_exhausted");
+        }
+        state.charge_retry()
+    }
+
+    fn reserve_intent_time(
+        &self,
+        intent: &str,
+        operation: &str,
+        destination: Option<NativeWindowTarget>,
+        started: Instant,
+        timeout: Duration,
+        now: Instant,
+    ) -> Result<Instant, &'static str> {
+        let mut states = self.recovery.lock().map_err(|_| "recovery_state_poisoned")?;
+        let state = states.get_mut(intent).ok_or("invalid_intent_reference")?;
+        if state.time.as_ref().is_some_and(|time| time.active.is_some()) {
+            return Err("native_busy");
+        }
+        let remaining = state.time.as_ref().map_or(timeout, |time| time.remaining);
+        if remaining <= now.saturating_duration_since(started) {
+            state.time = Some(IntentTime { remaining: Duration::ZERO, active: None });
+            return Err("recovery_exhausted");
+        }
+        let continuation = destination.is_some() && state.preparation_continuation == destination;
+        if state.time.is_some() && !continuation {
+            state.charge_retry()?;
+        }
+        state.preparation_continuation = None;
+        state.time = Some(IntentTime { remaining, active: Some((operation.into(), started)) });
+        Ok(started + remaining)
+    }
+
+    // Called only at genuine terminal settlement, after all owned work drained.
+    pub(super) fn finish_intent_time(
+        &self,
+        intent: &str,
+        operation: &str,
+        now: Instant,
+    ) -> Result<(), &'static str> {
+        let mut states = self.recovery.lock().map_err(|_| "recovery_state_poisoned")?;
+        let time = states.get_mut(intent).and_then(|state| state.time.as_mut()).ok_or("invalid_segment_intent")?;
+        if !time.active.as_ref().is_some_and(|(id, _)| id == operation) {
+            return Err("invalid_segment_intent");
+        }
+        time.remaining = time.remaining_at(now);
+        time.active = None;
+        Ok(())
+    }
+
+    pub fn record_intent(
+        &self,
+        intent: &str,
+        committed: bool,
+        confirmed: bool,
+    ) -> Result<(), &'static str> {
+        let mut states = self
+            .recovery
+            .lock()
+            .map_err(|_| "recovery_state_poisoned")?;
+        let state = states.get_mut(intent).ok_or("invalid_intent_reference")?;
+        state.uncertain |= committed;
+        state.confirmed |= confirmed;
+        Ok(())
+    }
+
+    fn bind_intent_destination(
+        &self,
+        intent: &str,
+        destination: Option<NativeWindowTarget>,
+    ) -> Result<(), &'static str> {
+        let mut states = self
+            .recovery
+            .lock()
+            .map_err(|_| "recovery_state_poisoned")?;
+        let state = states.get_mut(intent).ok_or("invalid_intent_reference")?;
+        if state.drag_destination.is_some() && state.drag_destination != destination
+            || state.drag_destination.is_none()
+                && destination.is_some()
+                && (state.uncertain || state.confirmed)
+        {
+            return Err("intent_target_mismatch");
+        }
+        state.drag_destination = destination;
+        Ok(())
+    }
+}
+
+impl Operation {
+    /// Counts native work only. Time outside an operation (including model or
+    /// user judgement and separate captures) cannot expire session authority or
+    /// renew the remaining allowance. This does not mark requested input sent.
+    pub fn bind_recovery_budget(&self, intent: &str) -> Result<(), &'static str> {
+        self.session.intent_state(intent)?;
+        let closed = self.session.gate.guard();
+        let mut state = self.state();
+        if *closed || !self.dependencies_live(&state) || state.producer_done {
+            return Err("cancelled");
+        }
+        // A worker may first run after its configured deadline. Account that
+        // elapsed work instead of allowing the next operation a fresh budget;
+        // this accounting never reopens cancelled primary admission.
+        if state.cancelled && !state.deadline.is_some_and(|deadline| Instant::now() >= deadline) {
+            return Err("cancelled");
+        }
+        self.bind_recovery_budget_locked(&mut state, intent)
+    }
+
+    fn bind_recovery_budget_locked(&self, state: &mut super::State, intent: &str) -> Result<(), &'static str> {
+        if let Some(bound) = &state.segment_recovery_intent {
+            return if bound == intent { Ok(()) } else { Err("invalid_segment_intent") };
+        }
+        if state.segment_limits.is_none() || state.next_step != 0 {
+            return Err("invalid_segment_intent");
+        }
+        let started = state.segment_started.ok_or("invalid_segment_intent")?;
+        let deadline = state.deadline.ok_or("invalid_segment_intent")?;
+        let destination = state.drag_destination.as_ref().map(|session| session.native_window()).transpose()?;
+        let shared = self.session.reserve_intent_time(
+            intent, &self.id, destination, started, deadline.saturating_duration_since(started), Instant::now(),
+        )?;
+        state.deadline = Some(deadline.min(shared));
+        state.segment_recovery_intent = Some(intent.into());
+        self.session.gate.notify();
+        Ok(())
+    }
+
+    /// Activation-only cross-window preparation already consumed a recovery
+    /// attempt. Its one fresh-pair continuation is that attempt, not a new one.
+    pub fn continue_after_drag_preparation(&self) -> Result<(), &'static str> {
+        let closed = self.session.gate.guard();
+        let state = self.state();
+        if *closed || !self.dependencies_live(&state) || state.cancelled || state.producer_done {
+            return Err("cancelled");
+        }
+        if state.drag_destination.is_none() || state.segment_intent.is_some() || state.next_step != 1 {
+            return Err("invalid_segment_intent");
+        }
+        let intent = state.segment_recovery_intent.as_ref().ok_or("invalid_segment_intent")?;
+        let mut states = self.session.recovery.lock().map_err(|_| "recovery_state_poisoned")?;
+        let recovery = states.get_mut(intent).ok_or("invalid_intent_reference")?;
+        if recovery.uncertain || recovery.confirmed || recovery.attempts == 0
+            || !recovery.time.as_ref().and_then(|time| time.active.as_ref()).is_some_and(|(id, _)| id == &self.id)
+        {
+            return Err("invalid_segment_intent");
+        }
+        recovery.preparation_continuation = Some(state.drag_destination.as_ref().ok_or("invalid_drag_destination")?.native_window()?);
+        Ok(())
+    }
+
+    pub fn recovery_remaining_ms(&self) -> Result<u32, &'static str> {
+        let state = self.state();
+        let intent = state.segment_recovery_intent.as_ref().ok_or("invalid_segment_intent")?;
+        let states = self.session.recovery.lock().map_err(|_| "recovery_state_poisoned")?;
+        let time = states.get(intent).and_then(|state| state.time.as_ref()).ok_or("invalid_segment_intent")?;
+        Ok(time.remaining_at(Instant::now()).as_millis().min(30_000) as u32)
+    }
+
+    pub fn bind_segment_intent(&self, intent: &str) -> Result<(), &'static str> {
+        self.session.intent_state(intent)?;
+        let closed = self.session.gate.guard();
+        let mut state = self.state();
+        if *closed || !self.dependencies_live(&state) || state.cancelled || state.producer_done {
+            return Err("cancelled");
+        }
+        if state.segment_limits.is_none() || state.next_step != 0 || state.segment_intent.is_some()
+        {
+            return Err("invalid_segment_intent");
+        }
+        let destination = state
+            .drag_destination
+            .as_ref()
+            .map(|session| session.native_window())
+            .transpose()?;
+        self.session.bind_intent_destination(intent, destination)?;
+        self.bind_recovery_budget_locked(&mut state, intent)?;
+        state.segment_intent = Some(intent.into());
+        Ok(())
+    }
+
+    /// Distinct compound budget; never widens ordinary primary/pointer/plan
+    /// limits. Each entry is the maximum admitted OS calls for one action.
+    pub fn configure_segment(
+        &self,
+        limits: Vec<u32>,
+        timeout: Duration,
+    ) -> Result<(), &'static str> {
+        let closed = self.session.gate.guard();
+        let mut state = self.state();
+        if *closed || !self.dependencies_live(&state) || state.cancelled || state.producer_done {
+            return Err("cancelled");
+        }
+        if state.started
+            || state.plan_steps.is_some()
+            || state.segment_limits.is_some()
+            || limits.is_empty()
+            || limits.len() > 64
+            || limits.iter().any(|limit| *limit == 0 || *limit > 2048)
+            || limits.iter().sum::<u32>() > 8192
+            || timeout.is_zero()
+            || timeout > Duration::from_secs(30)
+        {
+            return Err("invalid_segment_budget");
+        }
+        let started = Instant::now();
+        state.segment_limits = Some(limits);
+        state.segment_started = Some(started);
+        state.deadline = Some(started + timeout);
+        Ok(())
+    }
+
+    pub fn is_segment(&self) -> bool {
+        self.state().segment_limits.is_some()
+    }
+
+    /// Serial executor only, including while its one tracked worker owns held
+    /// releases. A step cannot be restarted to reset a consumed allowance.
+    pub fn begin_segment_action(&self, index: u32) -> Result<(), &'static str> {
+        let closed = self.session.gate.guard();
+        let mut state = self.state();
+        if *closed || !self.dependencies_live(&state) || state.cancelled || state.producer_done {
+            return Err("cancelled");
+        }
+        if !state.started
+            || index != state.next_step
+            || !state
+                .segment_limits
+                .as_ref()
+                .is_some_and(|limits| (index as usize) < limits.len())
+        {
+            return Err("invalid_segment_action");
+        }
+        state.next_step += 1;
+        state.step_inputs = 0;
+        state.step_input_limit = None;
+        Ok(())
+    }
+
+    pub fn segment_primary<T>(&self, call: impl FnOnce() -> T) -> Result<T, &'static str> {
+        let limit = {
+            let state = self.state();
+            state
+                .next_step
+                .checked_sub(1)
+                .and_then(|index| state.segment_limits.as_ref()?.get(index as usize).copied())
+                .ok_or("invalid_segment_action")?
+        };
+        self.primary_with_limit(true, limit, call)
+    }
+
+    pub fn segment_action_inputs(&self) -> u32 {
+        self.state().step_inputs
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::controlled::Gate;
+    use std::sync::Arc;
+
+    #[tokio::test]
+    async fn controlled_segment_budget_orders_actions_and_counts_every_event() {
+        let gate = Gate::new();
+        let session = gate.session(None, Arc::new(|| true), 1, 2, None).unwrap();
+        let op = session.new_operation().unwrap();
+        op.configure_segment(vec![3; 64], Duration::from_secs(30))
+            .unwrap();
+        assert!(op.configure_plan(8, Duration::from_secs(1)).is_err());
+        op.begin().unwrap();
+        assert!(op.segment_primary(|| panic!("before action")).is_err());
+        for index in 0..64 {
+            assert!(op.begin_segment_action(index + 1).is_err());
+            op.begin_segment_action(index).unwrap();
+            assert!(op.begin_segment_action(index).is_err());
+            for _ in 0..3 {
+                op.segment_primary(|| ()).unwrap();
+            }
+            assert!(op.segment_primary(|| panic!("over budget")).is_err());
+        }
+        op.cancel();
+        assert!(op.segment_primary(|| panic!("cancelled")).is_err());
+        op.finish();
+        assert!(op.terminal().await.unwrap().input_committed);
+    }
+
+    #[test]
+    fn controlled_segment_budget_keeps_legacy_caps_and_total_bound() {
+        let gate = Gate::new();
+        let session = gate.session(None, Arc::new(|| true), 1, 2, None).unwrap();
+        for limits in [vec![], vec![1; 65], vec![0], vec![2049], vec![2048; 5]] {
+            assert!(session
+                .new_operation()
+                .unwrap()
+                .configure_segment(limits, Duration::from_secs(1))
+                .is_err());
+        }
+        let op = session.new_operation().unwrap();
+        assert!(op.configure_plan(9, Duration::from_secs(1)).is_err());
+        op.begin().unwrap();
+        op.primary(true, || ()).unwrap();
+        assert!(op.primary(true, || panic!("legacy widened")).is_err());
+        assert!(op.pointer_primary(|| panic!("mixed budgets")).is_err());
+        op.finish();
+    }
+
+    #[test]
+    fn controlled_segment_recovery_budget_survives_operations_and_retains_unknown_input() {
+        let gate = Gate::new();
+        let session = gate.session(None, Arc::new(|| true), 1, 2, None).unwrap();
+        assert_eq!(session.intent_state("task"), Ok((0, false, false)));
+        session.record_intent("task", true, false).unwrap();
+        assert_eq!(session.recover_intent("task"), Ok(1));
+        drop(session.new_operation().unwrap());
+        assert_eq!(session.intent_state("task"), Ok((1, true, false)));
+        assert_eq!(session.recover_intent("task"), Ok(2));
+        assert_eq!(session.recover_intent("task"), Err("recovery_exhausted"));
+        session.record_intent("task", false, false).unwrap();
+        assert_eq!(session.intent_state("task"), Ok((2, true, false)));
+        session.record_intent("task", false, true).unwrap();
+        assert_eq!(
+            session.intent_state("task"),
+            Ok((2, true, true)),
+            "confirmed result loss must not enable replay"
+        );
+    }
+
+    #[test]
+    fn controlled_segment_admission_records_intent_before_an_unwind() {
+        let gate = Gate::new();
+        let session = gate.session(None, Arc::new(|| true), 1, 2, None).unwrap();
+        for cancelled in [false, true] {
+            let intent = if cancelled { "cancelled" } else { "unwind" };
+            let op = session.new_operation().unwrap();
+            op.configure_segment(vec![1], Duration::from_secs(1))
+                .unwrap();
+            op.bind_segment_intent(intent).unwrap();
+            op.begin().unwrap();
+            op.begin_segment_action(0).unwrap();
+            if cancelled {
+                op.cancel();
+            }
+            let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                op.segment_primary(|| panic!("after admitted input"))
+            }));
+            assert_eq!(outcome.is_err(), !cancelled);
+            assert_eq!(session.intent_state(intent), Ok((0, !cancelled, false)));
+            op.finish();
+        }
+    }
+}
