+fn readiness_settle(error: AXError) -> Result<bool, &'static str> {
+    if error == kAXErrorSuccess {
+        Ok(true)
+    } else if error == kAXErrorAttributeUnsupported || error == kAXErrorNotImplemented {
+        // Native Cocoa apps need no Chromium enablement and may implement
+        // readable AX while not implementing the optional attribute setter.
+        Ok(false)
+    } else if error == kAXErrorAPIDisabled {
+        Err("accessibility_permission_denied")
+    } else {
+        Err("accessibility_readiness_unknown")
+    }
+}
