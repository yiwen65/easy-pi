+use super::Data;
+
+/// Only the selected root's attached surfaces, never all windows of its PID.
+pub(super) fn require_clear(
+    sheets: impl FnOnce() -> Result<bool, &'static str>,
+    children: impl FnOnce() -> Result<Vec<Data>, &'static str>,
+) -> Result<(), &'static str> {
+    // AXSheets is optional even on AppKit windows with a real attached sheet.
+    // Their immediate AXChildren expose the relation and AXSheet role instead.
+    if sheets()? || children()?.iter().any(Data::unexpected_surface) {
+        Err("unexpected_modal_surface")
+    } else {
+        Ok(())
+    }
+}
