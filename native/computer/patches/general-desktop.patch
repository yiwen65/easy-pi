+        let input = segment(vec![ComputerInput::TypeText { text: "x".into() }]);
+        for fault in 0..8 {
+            let mut output = result();
+            let row = &mut output.actions[0];
+            match fault {
+                0 => row.action = None,
+                1 => row.dispatch = ComputerDispatch::NotDispatched,
+                2 => row.action.as_mut().unwrap().effect = ActionEffect::Confirmed,
+                3 => row.action.as_mut().unwrap().effect = ActionEffect::Refused,
+                4 => row.action.as_mut().unwrap().route = ActionRoute::GlobalInput,
+                5 => row.action.as_mut().unwrap().delivery = None,
