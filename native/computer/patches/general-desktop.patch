+        panic!("browser scope entered native capture route")
+    });
+    assert_eq!(result.structured_content.unwrap()["code"], "unsupported_route");
     operation.finish();
     assert!(!operation.terminal().await.unwrap().input_committed);
 }
+
+#[tokio::test]
+async fn controlled_capture_cleanup_preserves_result_without_input() {
+    let gate = Gate::new();
+    let session = gate.session(None, Arc::new(|| true), 42, 7, Some((1, 0))).unwrap();
+    let operation = session.new_operation().unwrap();
+    operation.begin().unwrap();
+    let calls = std::cell::Cell::new(0);
+    let result = with_capture_cleanup(&operation, || {
+        calls.set(calls.get() + 1);
+        ToolResult::text("capture result").with_structured(json!({"capture":true}))
+    });
+    assert_eq!(calls.get(), 1);
+    assert_eq!(result.structured_content.unwrap()["capture"], true);
+    operation.finish();
+    assert!(!operation.terminal().await.unwrap().input_committed);
+}
+
+#[tokio::test]
+async fn controlled_capture_cleanup_precancel_never_calls_capture() {
+    let gate = Gate::new();
+    let session = gate.session(None, Arc::new(|| true), 42, 7, Some((1, 0))).unwrap();
+    let operation = session.new_operation().unwrap();
+    operation.begin().unwrap();
+    operation.cancel();
+    let result = with_capture_cleanup(&operation, || panic!("capture after cancellation"));
+    assert_eq!(result.structured_content.unwrap()["code"], "controlled_cancelled");
+    operation.finish();
+    let terminal = operation.terminal().await.unwrap();
+    assert!(terminal.cancelled);
+    assert!(!terminal.input_committed);
+}
+
+#[tokio::test]
+async fn controlled_capture_cleanup_reports_quarantine_instead_of_result() {
+    let gate = Gate::new();
+    let session = gate.session(None, Arc::new(|| true), 42, 7, Some((1, 0))).unwrap();
+    let operation = session.new_operation().unwrap();
+    operation.begin().unwrap();
+    let result = with_capture_cleanup(&operation, || {
+        operation.quarantine();
+        ToolResult::text("must not publish successful capture")
+    });
+    assert_eq!(result.structured_content.unwrap()["code"], "controlled_quarantined");
+    operation.finish();
+    assert!(operation.terminal().await.is_err());
+}
