+    }
+    #[test]
+    fn controlled_cross_drag_trajectory_crosses_threshold_then_skips_unrelated_gap() {
+        for gap in [0.0, 100.0, 5000.0] {
+            let source = geometry(-400.0);
+            let destination = geometry(-120.0 + gap);
+            let from = (-260.0, 90.0);
+            let to = (20.0 + gap, 90.0);
+            let points = trajectory(from, to, &source, &destination, 240).unwrap();
+            assert!(contains(&source, points[0]));
+            assert!((points[0].0 - from.0).hypot(points[0].1 - from.1) >= 4.0);
+            assert_eq!(points.last(), Some(&to));
+            assert!(points
+                .iter()
+                .all(|p| contains(&source, *p) || contains(&destination, *p)));
+            assert!(points.len() <= 17);
+        }
+    }
+    #[test]
+    fn controlled_cross_drag_trajectory_edges_and_budget_refuse_before_events() {
+        let source = geometry(0.0);
+        let destination = geometry(500.0);
+        let points = trajectory((279.5, 90.0), (640.0, 90.0), &source, &destination, 1).unwrap();
+        assert!(points[0].0 < 279.5);
+        assert_eq!(points.last(), Some(&(640.0, 90.0)));
+        assert!(trajectory((0.0, 0.0), (640.0, 90.0), &source, &destination, 0).is_err());
+        assert!(trajectory((-1.0, 0.0), (640.0, 90.0), &source, &destination, 5001).is_err());
+    }
+}
