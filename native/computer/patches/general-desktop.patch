+use super::{key_window_call, make_key_window_record};
+use cua_driver_core::controlled::Operation;
+
+pub(super) fn same_identity(
+    captured: cua_driver_core::controlled::NativeWindowTarget,
+    stamp: Option<(u64, u64)>,
+    owner: crate::windows::WindowOwner,
+) -> bool {
+    captured.process_stamp.is_some()
+        && captured.process_stamp == stamp
+        && matches!(owner, crate::windows::WindowOwner::SamePid)
+}
+
+pub(super) fn sequence(
+    operation: Option<&Operation>,
+    window_id: u32,
+    front: impl FnOnce() -> i32,
+    post: impl Fn(&[u8; 0xF8]) -> i32,
+    identity: impl Fn() -> bool,
+) -> bool {
+    // The uncontrolled route retains its original status/early-return behavior.
+    if let Some(operation) = operation {
+        // Both bytes and the post closure's destination are prepared before
+        // admission. No allocation or destination lookup is needed to arm.
+        let first = make_key_window_record(window_id, 0x01);
+        let matching = make_key_window_record(window_id, 0x02);
+        let mut completion = Completion {
+            operation,
+            armed: false,
+            pending: Some(|| identity() && post(&matching) == 0),
+        };
+        if !identity() {
+            return false;
+        }
+        match operation.segment_primary(front) {
+            Ok(0) => {}
+            Ok(_) | Err(_) => return false,
+        }
+        // No pair is owned yet. Ordinary target loss or front-request failure
+        // is a refused/unknown effect, not an undrained cleanup obligation.
+        if !identity() {
+            return false;
+        }
+        // Two primaries: front request and first record. Matching cleanup is
+        // excluded from segment_action_inputs (and its delivered_count view).
+        let first_ok = match operation.segment_primary(|| {
+            completion.armed = true;
+            post(&first)
+        }) {
+            Ok(0) => true,
+            Ok(_) => {
+                // Nonzero is not proof that nothing reached WindowServer.
+                operation.quarantine();
+                false
+            }
+            Err(_) => return false,
+        };
+        let completed = completion.run();
+        return first_ok && completed;
+    }
+    if !key_window_call(operation, front) {
+        return false;
+    }
+    for kind in [0x01, 0x02] {
+        let record = make_key_window_record(window_id, kind);
+        if !key_window_call(operation, || post(&record)) {
+            return false;
+        }
+    }
+    true
+}
+
+/// Stack-owned by the existing tracked worker. Take before invoking so an
+/// ambiguous failure or unwind cannot cause a second matching post.
+struct Completion<'a, F: FnOnce() -> bool> {
+    operation: &'a Operation,
+    armed: bool,
+    pending: Option<F>,
+}
+
+impl<F: FnOnce() -> bool> Completion<'_, F> {
+    fn run(&mut self) -> bool {
+        if !self.armed {
+            return true;
+        }
+        let Some(complete) = self.pending.take() else {
+            return true;
+        };
+        let ok = std::panic::catch_unwind(std::panic::AssertUnwindSafe(complete)).unwrap_or(false);
+        if !ok {
+            self.operation.quarantine();
+        }
+        ok
+    }
+}
+
+impl<F: FnOnce() -> bool> Drop for Completion<'_, F> {
+    fn drop(&mut self) {
+        if self.armed && std::thread::panicking() {
+            self.operation.quarantine();
+        }
+        self.run();
+    }
+}
