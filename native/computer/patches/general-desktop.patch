+use super::*;
+use cua_driver_core::element_token::ResolvedElement;
+
+impl Context {
+    pub(super) fn editor_requires_foreground(&self) -> Result<bool, &'static str> {
+        self.live()?;
+        let target = self.operation.session.native_window()?;
+        let Some(ptr) = (unsafe {
+            crate::ax::general_surface::focused_in_window(target.pid, target.window_id)
+        }) else {
+            return Ok(false);
+        };
+        let element = unsafe {
+            let owned = RetainedElement::retain(ptr as usize);
+            core_foundation::base::CFRelease(ptr as core_foundation::base::CFTypeRef);
+            owned
+        };
+        let role = unsafe { bindings::copy_string_attr(element.as_ptr() as _, "AXRole") };
+        Ok(role.as_deref() == Some("AXTextArea") || !self.native_text(&element))
+    }
+
+    pub(super) fn native_text(&self, element: &RetainedElement) -> bool {
+        let mut element = element.clone();
+        for _ in 0..40 {
+            if self.operation.checkpoint().is_err() {
+                return false;
+            }
+            let ptr = element.as_ptr() as bindings::AXUIElementRef;
+            let role = unsafe { bindings::copy_string_attr(ptr, "AXRole") };
+            match role.as_deref() {
+                Some("AXWindow") => return true,
+                Some("AXWebArea" | "AXDocumentWeb" | "AXDocument" | "AXApplication") | None => {
+                    return false
+                }
+                _ => {}
+            }
+            let Some(parent) = (unsafe { bindings::copy_element_attr(ptr, "AXParent") }) else {
+                return false;
+            };
+            element = unsafe {
+                let owned = RetainedElement::retain(parent as usize);
+                core_foundation::base::CFRelease(parent as core_foundation::base::CFTypeRef);
+                owned
+            };
+        }
+        false
+    }
+
+    pub(super) fn live(&self) -> Result<(), &'static str> {
+        if let Some(renderer) = &self.renderer {
+            renderer.check()?;
+        }
+        self.operation.checkpoint()?;
+        let target = self.operation.session.native_window()?;
+        if target.process_stamp.is_none()
+            || crate::tools::computer_process_stamp(target.pid) != target.process_stamp
+            || !matches!(
+                crate::windows::resolve_window_owner(target.pid, target.window_id),
+                crate::windows::WindowOwner::SamePid
+            )
+        {
+            return Err("controlled_target_stale");
+        }
+        Ok(())
+    }
+
+    pub(super) fn reference(&self, reference: &str) -> Result<RetainedElement, &'static str> {
+        let target = self.operation.session.native_window()?;
+        if !reference.starts_with(&format!("{}:", self.observation_ref)) {
+            return Err("stale_session_observation");
+        }
+        match self.state.element_cache.resolve_element_args(
+            target.pid,
+            None,
+            Some(reference),
+            None,
+            Some(u64::from(target.window_id)),
+            "click",
+        ) {
+            Ok(ResolvedElement::Element { element, .. }) if element.as_ptr() != 0 => Ok(element),
+            _ => Err("stale_session_observation"),
+        }
+    }
+
+    pub(super) fn member(&self, element: &RetainedElement) -> Result<(), &'static str> {
+        self.live()?;
+        let target = self.operation.session.native_window()?;
+        if !unsafe {
+            crate::ax::general_surface::member(
+                element.as_ptr() as bindings::AXUIElementRef,
+                target.pid,
+                target.window_id,
+            )
+        } {
+            return Err("target_membership_unknown");
+        }
+        Ok(())
+    }
+
+    pub(super) fn locate(
+        &self,
+        locator: &ComputerLocator,
+    ) -> Result<Option<RetainedElement>, &'static str> {
+        self.live()?;
+        let native = Native {
+            operation: &self.operation,
+        };
+        let root = if let Some(reference) = &locator.within {
+            let root = self.reference(reference)?;
+            self.member(&root)?;
+            root
+        } else {
+            native.general_window()?
+        };
+        let tree = observation::scan_general(&native, root);
+        let matches = tree
+            .rows
+            .iter()
+            .filter(|row| matches_locator(&row.data, locator))
+            .collect::<Vec<_>>();
+        // Missing descriptive metadata does not hide a known role, but can
+        // never prove absence/uniqueness for a label or identifier predicate.
+        let complete = if locator.label.is_none() && locator.identifier.is_none() {
+            tree.structurally_complete()
+        } else {
+            tree.complete()
+        };
+        unique_match(matches, complete).map(|row| row.map(|row| row.element.clone()))
+    }
+
+    pub(super) fn resolve(
+        &self,
+        address: &ComputerElementAddress,
+    ) -> Result<RetainedElement, &'static str> {
+        let element = match address {
+            ComputerElementAddress::Reference { reference } => self.reference(reference)?,
+            ComputerElementAddress::Locator { locator } => {
+                self.locate(locator)?.ok_or("target_absent")?
+            }
+        };
+        self.member(&element)?;
+        Ok(element)
+    }
+}
+
+fn unique_match<T>(mut matches: Vec<T>, complete: bool) -> Result<Option<T>, &'static str> {
+    if matches.len() > 1 {
+        return Err("target_ambiguous");
+    }
+    if !complete {
+        return Err("target_scope_incomplete");
+    }
+    Ok(matches.pop())
+}
+
+fn matches_locator(data: &observation::Data, locator: &ComputerLocator) -> bool {
+    locator.role.as_ref().is_none_or(|role| role == &data.role)
+        && locator
+            .label
+            .as_ref()
+            .is_none_or(|label| data.label.as_ref() == Some(label))
+        && locator
+            .identifier
+            .as_ref()
+            .is_none_or(|id| data.identifier.as_ref() == Some(id))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn controlled_segment_partial_tree_never_proves_absence_or_uniqueness() {
+        assert_eq!(
+            unique_match::<u8>(vec![], false),
+            Err("target_scope_incomplete")
+        );
+        assert_eq!(unique_match(vec![1], false), Err("target_scope_incomplete"));
+        assert_eq!(unique_match(vec![1, 2], false), Err("target_ambiguous"));
+        assert_eq!(unique_match(vec![1, 2], true), Err("target_ambiguous"));
+        assert_eq!(unique_match::<u8>(vec![], true), Ok(None));
+        assert_eq!(unique_match(vec![1], true), Ok(Some(1)));
+    }
+    #[test]
+    fn controlled_segment_locator_keeps_identifier_distinct_from_label() {
+        let data = observation::Data {
+            role: "AXTextField".into(),
+            label: Some("Name".into()),
+            identifier: Some("person.name".into()),
+            ..Default::default()
+        };
+        let mut locator = ComputerLocator {
+            role: Some("AXTextField".into()),
+            label: Some("Name".into()),
+            identifier: Some("person.name".into()),
+            within: None,
+        };
+        assert!(matches_locator(&data, &locator));
+        locator.identifier = Some("Name".into());
+        assert!(!matches_locator(&data, &locator));
+        locator.identifier = None;
+        locator.role = Some("AXButton".into());
+        assert!(!matches_locator(&data, &locator));
+    }
+}
