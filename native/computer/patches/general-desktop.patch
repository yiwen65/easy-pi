+#[tokio::test]
+async fn controlled_drag_dependency_terminal_waits_owned_cleanup_after_revoke() {
+    let (_, source, destination) = endpoints();
+    let op = source.new_operation().unwrap();
+    op.bind_drag_destination(destination.clone()).unwrap();
+    op.begin().unwrap();
+    let work = op.track().unwrap();
+    let held = AtomicBool::new(false);
+    op.primary(true, || held.store(true, Ordering::SeqCst))
+        .unwrap();
+    destination.revoke();
+    // Cleanup registration remains legal; it cannot create another primary.
+    let callback = op.track_callback().unwrap();
+    op.finish();
+    let mut terminal = Box::pin(op.terminal());
+    assert!(terminal
+        .as_mut()
+        .poll(&mut Context::from_waker(Waker::noop()))
+        .is_pending());
+    assert!(held.swap(false, Ordering::SeqCst));
+    drop(callback);
+    drop(work);
+    assert_eq!(
+        terminal.await.unwrap(),
+        Terminal {
+            cancelled: true,
+            input_committed: true
+        }
+    );
+    assert!(!held.load(Ordering::SeqCst));
+}
