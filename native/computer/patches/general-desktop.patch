+fn image(window: u64, id: &str) -> Arc<ImageReference> {
+    Arc::new(
+        ImageReference::from_image(&ComputerImage {
+            image_id: id.into(),
+            pid: 42,
+            window_id: window,
+            geometry: ComputerImageGeometry {
+                desktop_x: 0.0,
+                desktop_y: 0.0,
+                window_width: 1.0,
+                window_height: 1.0,
+                source_width: 1,
+                source_height: 1,
+                crop_x: 0,
+                crop_y: 0,
+                crop_width: 1,
+                crop_height: 1,
+                output_width: 1,
+                output_height: 1,
+            },
+            png: cua_driver_core::image_utils::encode_rgba_to_png(&[1, 2, 3, 255], 1, 1).unwrap(),
+        })
+        .unwrap(),
+    )
+}
