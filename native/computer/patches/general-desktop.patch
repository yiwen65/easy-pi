+struct InertPayload;
+impl cua_driver_core::element_cache::SnapshotPayload for InertPayload {
+    type Element = u8;
+    fn len(&self) -> usize { 1 }
+    fn retain(&self, index: usize) -> Option<u8> { (index == 0).then_some(7) }
+}
+
+fn resolve_inert(
+    cache: &cua_driver_core::element_cache::ElementCacheCore<InertPayload>,
+    token: &str,
+    window: u64,
+) -> Result<u8, String> {
+    match cache.resolve_element_args(42, None, Some(token), None, Some(window), "click") {
+        Ok(cua_driver_core::element_token::ResolvedElement::Element { element, .. }) => Ok(element),
+        Ok(_) => Err("missing_element".into()),
+        Err(result) => Err(result.structured_content
+            .and_then(|value| value["refusal"]["code"].as_str().map(str::to_owned))
+            .unwrap_or_else(|| "unknown_refusal".into())),
+    }
+}
