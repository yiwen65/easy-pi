+//! Inert private runtime fixtures only. No native host constructor or OS call.
+use super::*;
+use crate::computer::segment::*;
+
+fn input() -> ComputerSegment {
+    ComputerSegment {
+        intent_ref: "intent".into(),
+        observation_ref: "s00000001".into(),
+        actions: vec![ComputerInput::TypeText {
+            text: "你好🦀\n</tool_call>".into(),
+        }],
+        postcondition: ComputerPostcondition::Visual {
+            description: "text visible".into(),
+        },
+        max_duration_ms: 1000,
+    }
+}
+
+#[tokio::test]
+async fn controlled_segment_busy_missing_ref_and_preabort_never_reach_platform() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let host = host();
+    let session = session(&host, None);
+    let operation = session.clone().new_operation().unwrap();
+    let lane = host.scheduler.clone().try_lock_owned().unwrap();
+    assert!(
+        matches!(operation.clone().start_segment(input()),Err(ComputerError::Refused { reason }) if reason=="native_busy")
+    );
+    drop(lane);
+    operation.clone().start_segment(input()).unwrap();
+    assert!(
+        matches!(operation.result().await,Err(ComputerError::Refused { reason }) if reason=="stale_session_observation")
+    );
+    assert!(!operation.terminal().await.unwrap().input_committed);
+    let cancelled = session.new_operation().unwrap();
+    cancelled.cancel();
+    assert!(cancelled.clone().start_segment(input()).is_err());
+    assert!(!cancelled.terminal().await.unwrap().input_committed);
+    host.close().await.unwrap();
+}
+
+#[tokio::test]
+async fn controlled_segment_cancelled_terminal_keeps_prefix_route_and_unknown_result() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let host = host();
+    let operation = session(&host, None).new_operation().unwrap();
+    operation
+        .core
+        .configure_segment(vec![2], Duration::from_secs(1))
+        .unwrap();
+    operation.core.begin().unwrap();
+    operation.core.begin_segment_action(0).unwrap();
+    operation.core.segment_primary(|| ()).unwrap();
+    let result = ComputerSegmentResult {
+        status: ComputerSegmentStatus::OutcomeUnknown,
+        actions: vec![ComputerInputResult {
+            index: 0,
+            dispatch: ComputerDispatch::Unknown,
+            action: None,
+            code: Some("lost_reply".into()),
+        }],
+        condition: ComputerCondition::Unknown,
+        first_unfinished_action: Some(0),
+        recovery_attempts: 1,
+        remaining_duration_ms: 999,
+        elapsed_ms: 1,
+    };
+    validate_result(&input(), &result).unwrap();
+    *operation.outcome.lock().unwrap() = Some(Ok(ComputerResult::Segment { value: result }));
+    operation.cancel();
+    operation.core.finish();
+    assert!(operation.terminal().await.unwrap().cancelled);
+    let ComputerResult::Segment { value } = operation.result().await.unwrap() else {
+        panic!("segment erased");
+    };
+    assert_eq!(value.status, ComputerSegmentStatus::OutcomeUnknown);
+    assert_eq!(value.first_unfinished_action, Some(0));
+    assert_eq!(value.actions[0].dispatch, ComputerDispatch::Unknown);
+    host.close().await.unwrap();
+}
