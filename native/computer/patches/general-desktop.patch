+use super::*;
+
+fn frame_matches(actual: [f64; 4], expected: [f64; 4], position_only: bool) -> bool {
+    actual[..if position_only { 2 } else { 4 }] == expected[..if position_only { 2 } else { 4 }]
+}
+
+impl Context {
+    pub(super) fn window_frame(&self) -> Result<[f64; 4], &'static str> {
+        self.live()?;
+        let target = self.operation.session.native_window()?;
+        let bounds = crate::windows::window_bounds_by_id(target.window_id)
+            .ok_or("target_geometry_unknown")?;
+        Ok([bounds.x, bounds.y, bounds.width, bounds.height])
+    }
+
+    fn await_frame(&self, expected: [f64; 4], position_only: bool) -> Result<(), &'static str> {
+        let deadline = Instant::now() + Duration::from_millis(500);
+        loop {
+            if frame_matches(self.window_frame()?, expected, position_only) {
+                return Ok(());
+            }
+            if Instant::now() >= deadline {
+                return Err("window_bounds_unconfirmed");
+            }
+            std::thread::sleep(Duration::from_millis(10));
+        }
+    }
+
+    pub(super) fn set_bounds(
+        &self,
+        window: bindings::AXUIElementRef,
+        frame: [f64; 4],
+    ) -> Result<(), &'static str> {
+        self.live()?;
+        if unsafe { bindings::set_point_attr(window, "AXPosition", frame[0], frame[1]) }
+            != bindings::kAXErrorSuccess
+        {
+            return Err("window_bounds_partial");
+        }
+        // AX writes enqueue AppKit frame animations. A size write made before
+        // the move lands can cancel it and keep the old origin (C259/C264).
+        // Wait on WindowServer, not AX's write echo, before the dependent size.
+        // No mutation is replayed and cancellation remains checked while waiting.
+        self.await_frame(frame, true)?;
+        if unsafe { bindings::set_size_attr(window, "AXSize", frame[2], frame[3]) }
+            != bindings::kAXErrorSuccess
+        {
+            return Err("window_bounds_partial");
+        }
+        self.await_frame(frame, false)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn controlled_window_size_waits_for_the_requested_position_not_ax_success() {
+        let desired = [900.0, 200.0, 600.0, 580.0];
+        assert!(!frame_matches([1000.0, 246.0, 600.0, 580.0], desired, true));
+        assert!(!frame_matches([901.0, 200.0, 560.0, 552.0], desired, true));
+        assert!(frame_matches([900.0, 200.0, 560.0, 552.0], desired, true));
+        assert!(!frame_matches([900.0, 200.0, 560.0, 552.0], desired, false));
+        assert!(frame_matches(desired, desired, false));
+    }
+}
