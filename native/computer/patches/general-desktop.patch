+//! One additional immutable capability for a dedicated cross-window drag.
+//! This binds lifetime only; it neither changes window scope nor authorizes input.
+use super::{NativeWindowTarget, Operation, Session, State};
+use std::sync::Arc;
+
+impl Operation {
+    /// Bind before configuration/start, under the SDK operation registry lock.
+    /// The common gate orders this with endpoint/ancestor revocation.
+    pub fn bind_drag_destination(&self, destination: Arc<Session>) -> Result<(), &'static str> {
+        if !Arc::ptr_eq(&self.session.gate, &destination.gate) {
+            return Err("foreign_drag_destination");
+        }
+        let closed = self.session.gate.guard();
+        let mut state = self.state();
+        if *closed
+            || !self.dependencies_live(&state)
+            || !destination.live()
+            || state.cancelled
+            || state.producer_done
+            || state.quarantine
+        {
+            return Err("cancelled");
+        }
+        if state.started
+            || state.active != 0
+            || state.drag_destination.is_some()
+            || state.plan_steps.is_some()
+            || state.segment_limits.is_some()
+        {
+            return Err("drag_destination_already_bound_or_started");
+        }
+        let source = self.session.native_window()?;
+        let target = destination.native_window()?;
+        if source.process_stamp.is_none()
+            || target.process_stamp.is_none()
+            || source.window_id == target.window_id
+            || (source.pid == target.pid && source.process_stamp != target.process_stamp)
+        {
+            return Err("invalid_drag_destination");
+        }
+        state.drag_destination = Some(destination);
+        Ok(())
+    }
+
+    /// Exact immutable endpoint membership for capture/geometry producers.
+    /// Membership alone is not admission; each producer still checkpoints and
+    /// enters primary under both live dependencies before any platform call.
+    pub fn owns_native_window(&self, target: NativeWindowTarget) -> bool {
+        self.session
+            .native_window()
+            .is_ok_and(|source| source == target)
+            || self
+                .state()
+                .drag_destination
+                .as_ref()
+                .is_some_and(|destination| {
+                    destination
+                        .native_window()
+                        .is_ok_and(|bound| bound == target)
+                })
+    }
+
+    /// Called with the common gate AND this operation's state already held.
+    pub(super) fn dependencies_live(&self, state: &State) -> bool {
+        self.session.live()
+            && state
+                .drag_destination
+                .as_ref()
+                .is_none_or(|session| session.live())
+    }
+
+    /// Revoke/close must drain a dependent operation before retiring either
+    /// subtree's resources. A dependency is not a fabricated parent relation.
+    pub fn depends_on_subtree(&self, ancestor: &Arc<Session>) -> bool {
+        self.session.descends_from(ancestor)
+            || self
+                .state()
+                .drag_destination
+                .as_ref()
+                .is_some_and(|session| session.descends_from(ancestor))
+    }
+}
