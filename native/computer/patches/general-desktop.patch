+#[tokio::test]
+async fn controlled_segment_direct_sdk_missing_evidence_does_not_reset_recovery() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let host = host();
+    let session = session(&host, None);
+    for attempt in 0..4 {
+        let operation = session.clone().new_operation().unwrap();
+        operation.clone().start_segment(input()).unwrap();
+        let expected = if attempt < 3 { "stale_session_observation" } else { "recovery_exhausted" };
+        assert!(matches!(operation.result().await, Err(ComputerError::Refused { reason }) if reason == expected));
+        assert!(!operation.terminal().await.unwrap().input_committed);
+        // Observe the real native lane release, not an arbitrary delay. No
+        // input is queued on this test-only wait.
+        drop(host.scheduler.clone().lock_owned().await);
+    }
+    assert_eq!(session.gate.intent_state("intent"), Ok((2, false, false)));
+    host.close().await.unwrap();
+}
