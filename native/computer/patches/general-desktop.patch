+    type Element = u8;
+    fn checkpoint(&self) -> Result<(), &'static str> { Ok(()) }
+    fn same(&self, a: &u8, b: &u8) -> bool { a == b }
+    fn data(&self, element: &u8) -> Result<Data, &'static str> {
+        if *element == 1 { return Err(self.error); }
+        Ok(Data { role: "AXTextField".into(), ..Data::default() })
+    }
+    fn children(&self, element: &u8) -> Result<Vec<u8>, &'static str> {
+        match element { 0 => Ok(vec![1, 2]), 1 => panic!("foreign surface children must not be read"), _ => Ok(vec![]) }
+    }
+}
