+#[tokio::test]
+async fn controlled_drag_dependency_native_authority_and_panic_keep_guards() {
+    let (gate, source, _) = endpoints();
+    let live = Arc::new(AtomicBool::new(true));
+    let authority = live.clone();
+    let destination = gate
+        .session(
+            None,
+            Arc::new(move || authority.load(Ordering::Acquire)),
+            43,
+            9,
+            Some((1, 2)),
+        )
+        .unwrap();
+    let op = source.new_operation().unwrap();
+    op.bind_drag_destination(destination).unwrap();
+    op.begin().unwrap();
+    live.store(false, Ordering::Release);
+    assert!(op
+        .primary(false, || panic!("dead canonical authority"))
+        .is_err());
+    op.finish();
+    assert!(op.terminal().await.unwrap().cancelled);
+    let (_, source, destination) = endpoints();
+    let op = source.new_operation().unwrap();
+    op.bind_drag_destination(destination).unwrap();
+    op.begin().unwrap();
+    assert!(std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        let _work = op.track().unwrap();
+        panic!("owned producer unwind");
+    }))
+    .is_err());
+    op.finish();
+    assert_eq!(op.terminal().await, Err("quarantined"));
+}
+
+#[test]
+fn controlled_drag_dependency_endpoint_membership_does_not_grant_foreign_capture() {
+    let (_, source, destination) = endpoints();
+    let op = source.new_operation().unwrap();
+    let target = destination.native_window().unwrap();
+    assert!(op.owns_native_window(source.native_window().unwrap()));
+    assert!(!op.owns_native_window(target));
+    op.bind_drag_destination(destination.clone()).unwrap();
+    assert!(op.owns_native_window(target));
+    assert!(!op.owns_native_window(NativeWindowTarget {
+        process_stamp: Some((2, 2)),
+        ..target
+    }));
+    assert!(!op.owns_native_window(NativeWindowTarget {
+        window_id: 9,
+        ..target
+    }));
+    destination.revoke();
+    assert!(
+        op.owns_native_window(target),
+        "immutable membership is not liveness"
+    );
+    assert!(op.checkpoint().is_err());
+    op.cancel();
+}
+
+#[test]
+fn controlled_drag_dependency_consumption_clears_both_snapshot_tokens() {
+    let (_, source, destination) = endpoints();
+    *source.snapshot.lock().unwrap() = Some(1);
+    *destination.snapshot.lock().unwrap() = Some(2);
+    let op = source.new_operation().unwrap();
+    op.bind_drag_destination(destination.clone()).unwrap();
+    op.reset_snapshot();
+    assert!(source.snapshot.lock().unwrap().is_none());
+    assert!(destination.snapshot.lock().unwrap().is_none());
+    op.cancel();
+}
