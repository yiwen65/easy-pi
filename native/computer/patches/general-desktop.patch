+use super::*;
+use std::sync::atomic::AtomicUsize;
+
+fn endpoint(
+    host: &Arc<ComputerHost>,
+    parent: Option<&Arc<ComputerSession>>,
+    window: u32,
+) -> Arc<ComputerSession> {
+    session_target(host, parent, window, Some((1, 2)))
+}
+
+#[tokio::test]
+async fn controlled_drag_dependency_sdk_rejects_foreign_and_keeps_single_window_scope() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let host = host();
+    let foreign = super::host();
+    let source = endpoint(&host, None, 7);
+    let destination = endpoint(&host, None, 8);
+    let op = source.clone().new_operation().unwrap();
+    for invalid in [
+        endpoint(&foreign, None, 9),
+        source.clone(),
+        session_target(&host, None, 9, None),
+        host.clone().open_discovery_session(None).unwrap(),
+    ] {
+        assert!(matches!(
+            op.bind_drag_destination(invalid),
+            Err(ComputerError::Refused { .. })
+        ));
+    }
+    op.bind_drag_destination(destination.clone()).unwrap();
+    assert!(op.bind_drag_destination(destination.clone()).is_err());
+    assert_eq!(op.core.session.native_window().unwrap().window_id, 7);
+    assert!(!op.core.session.descends_from(&destination.gate));
+    assert!(destination
+        .dependent_operations()
+        .unwrap()
+        .iter()
+        .any(|candidate| Arc::ptr_eq(candidate, &op.core)));
+    op.cancel();
+    op.terminal().await.unwrap();
+    host.close().await.unwrap();
+    foreign.close().await.unwrap();
+}
+
+#[tokio::test]
+async fn controlled_drag_dependency_sdk_retains_destination_facade_without_cycle() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let host = host();
+    let source = endpoint(&host, None, 7);
+    let destination = endpoint(&host, None, 8);
+    let weak = Arc::downgrade(&destination);
+    let native = destination.native.clone();
+    let op = source.new_operation().unwrap();
+    op.bind_drag_destination(destination).unwrap();
+    assert!(weak.upgrade().is_some() && native.computer_authority_live());
+    op.cancel();
+    assert!(op.terminal().await.unwrap().cancelled);
+    weak.upgrade().unwrap().close().await.unwrap();
+    drop(op);
+    assert!(weak.upgrade().is_none());
+    host.close().await.unwrap();
+}
+
+#[tokio::test]
+async fn controlled_drag_dependency_sdk_destination_close_waits_owned_work_and_snapshot_drain() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let host = host();
+    let source = endpoint(&host, None, 7);
+    let destination = endpoint(&host, None, 8);
+    let op = source.clone().new_operation().unwrap();
+    op.bind_drag_destination(destination.clone()).unwrap();
+    let retired = Arc::new(AtomicUsize::new(0));
+    let count = retired.clone();
+    destination
+        .gate
+        .snapshots
+        .replace(move || {
+            count.fetch_add(1, Ordering::SeqCst);
+        })
+        .unwrap();
+    op.core.begin().unwrap();
+    let work = op.core.track_callback().unwrap();
+    op.core.primary(true, || ()).unwrap();
+    op.core.finish();
+    // The production close snapshot includes this op even though its source is
+    // outside the destination subtree. Terminal is pending while work exists.
+    assert_eq!(destination.dependent_operations().unwrap().len(), 1);
+    let mut terminal = Box::pin(op.core.terminal());
+    assert!(terminal
+        .as_mut()
+        .poll(&mut Context::from_waker(Waker::noop()))
+        .is_pending());
+    let mut closer = Box::pin(destination.clone().close());
+    assert!(closer
+        .as_mut()
+        .poll(&mut Context::from_waker(Waker::noop()))
+        .is_pending());
+    assert!(op.core.is_cancelled());
+    assert!(!destination.closed.load(Ordering::Acquire));
+    assert_eq!(retired.load(Ordering::SeqCst), 0);
+    // Dropping this foreign waiter does not own the independent close producer.
+    drop(closer);
+    drop(work);
+    let receipt = terminal.await.unwrap();
+    assert!(receipt.cancelled && receipt.input_committed);
+    destination.close().await.unwrap();
+    assert_eq!(retired.load(Ordering::SeqCst), 1);
+    assert!(source.native.computer_authority_live());
+    let next = source.new_operation().unwrap();
+    next.cancel();
+    next.terminal().await.unwrap();
+    host.close().await.unwrap();
+}
+
+#[tokio::test]
+async fn controlled_drag_dependency_sdk_either_ancestor_revoke_cancels_only_dependents() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    for close_source in [true, false] {
+        let host = host();
+        let a = endpoint(&host, None, 7);
+        let b = endpoint(&host, None, 8);
+        let source = endpoint(&host, Some(&a), 7);
+        let destination = endpoint(&host, Some(&b), 8);
+        let sibling = endpoint(&host, None, 9);
+        let unrelated = sibling.new_operation().unwrap();
+        let op = source.new_operation().unwrap();
+        op.bind_drag_destination(destination).unwrap();
+        if close_source {
+            a.revoke();
+        } else {
+            b.revoke();
+        }
+        let receipt = op.terminal().await.unwrap();
+        assert!(receipt.cancelled && !receipt.input_committed);
+        assert!(!unrelated.core.is_cancelled());
+        unrelated.cancel();
+        host.close().await.unwrap();
+    }
+}
+
+#[tokio::test]
+async fn controlled_drag_dependency_sdk_close_wins_attachment_at_registry_boundary() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let host = host();
+    let source = endpoint(&host, None, 7);
+    let destination = endpoint(&host, None, 8);
+    let op = source.new_operation().unwrap();
+    let registry = host.operations.lock().unwrap();
+    let (ready_tx, ready_rx) = std::sync::mpsc::channel();
+    let binder_op = op.clone();
+    let binder_destination = destination.clone();
+    let binder = std::thread::spawn(move || {
+        ready_tx.send(()).unwrap();
+        binder_op.bind_drag_destination(binder_destination)
+    });
+    ready_rx.recv().unwrap();
+    // Exact first phase of ComputerSession::revoke; binding is blocked on the
+    // registry and cannot retroactively join a subtree whose gate is revoked.
+    destination.gate.revoke();
+    drop(registry);
+    assert!(matches!(
+        binder.join().unwrap(),
+        Err(ComputerError::Refused { .. })
+    ));
+    assert!(op.drag_destination.lock().unwrap().is_none());
+    destination.close().await.unwrap();
+    op.cancel();
+    op.terminal().await.unwrap();
+    host.close().await.unwrap();
+}
+
+#[tokio::test]
+async fn controlled_drag_dependency_sdk_unproven_producer_keeps_close_quarantined() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let host = host();
+    let source = endpoint(&host, None, 7);
+    let destination = endpoint(&host, None, 8);
+    let op = source.new_operation().unwrap();
+    op.bind_drag_destination(destination.clone()).unwrap();
+    op.core.begin().unwrap();
+    drop(op); // Deliberately lose the synthetic producer; no terminal invention.
+    assert!(matches!(
+        destination.close().await,
+        Err(ComputerError::Quarantined)
+    ));
+    assert!(matches!(
+        host.close().await,
+        Err(ComputerError::Quarantined)
+    ));
+}
