+    #[tokio::test]
+    async fn controlled_cross_drag_owned_up_survives_stop_destination_revoke_and_unwind() {
+        use cua_driver_core::controlled::Gate;
+        for mode in 0..5 {
+            let gate = Gate::new();
+            let source = gate
+                .session(None, Arc::new(|| true), 42, 7, Some((1, 2)))
+                .unwrap();
+            let destination = gate
+                .session(None, Arc::new(|| true), 42, 8, Some((1, 2)))
+                .unwrap();
+            let op = source.new_operation().unwrap();
+            op.bind_drag_destination(destination.clone()).unwrap();
+            op.configure_segment(vec![2], Duration::from_secs(1))
+                .unwrap();
+            op.begin().unwrap();
+            op.begin_segment_action(0).unwrap();
+            let work = op.track().unwrap();
+            let downs = AtomicUsize::new(0);
+            let ups = Arc::new(AtomicUsize::new(0));
+            let released = ups.clone();
+            let release_op = op.clone();
+            let release = Box::new(move |_: ()| {
+                released.fetch_add(1, Ordering::SeqCst);
+                if mode == 4 {
+                    release_op.quarantine();
+                    Err("release_failure")
+                } else {
+                    Ok(())
+                }
+            });
+            if mode == 0 {
+                op.cancel();
+            }
+            let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                let mut owned = None;
+                let result = admit_down(&op, &mut owned, (), release, || {
+                    downs.fetch_add(1, Ordering::SeqCst);
+                    if mode == 1 {
+                        destination.revoke();
+                    }
+                    if mode == 2 {
+                        op.cancel();
+                    }
+                    if mode == 3 {
