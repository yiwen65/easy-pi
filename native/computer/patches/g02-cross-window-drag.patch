+//! Dedicated global drag transport. Two retained capabilities, one tracked
+//! worker, no PID/global double-post, and only owned matching-up cleanup.
+mod observer;
+use super::general::OwnedRelease;
+use crate::computer_renderer::{Channel, Cue, Kind};
+use core_graphics::{
+    event::{CGEvent, CGEventFlags, CGEventTapLocation, CGEventType, CGMouseButton, EventField},
+    event_source::{CGEventSource, CGEventSourceStateID},
+    geometry::CGPoint,
+};
+use cua_driver_contract::{computer_image::ComputerImageGeometry, computer_segment::ComputerPoint};
+use cua_driver_core::controlled::{ImageReference, NativeWindowTarget, Operation};
+use foreign_types::ForeignType;
+use std::{cell::Cell, ffi::c_void, rc::Rc, sync::Arc, time::Duration};
+
+#[link(name = "CoreGraphics", kind = "framework")]
+unsafe extern "C" {
+    fn CGEventSetTimestamp(event: *mut c_void, timestamp: u64);
+    fn CGEventSourceSetLocalEventsSuppressionInterval(source: *mut c_void, seconds: f64);
+    fn CGEventSourceGetLocalEventsSuppressionInterval(source: *mut c_void) -> f64;
+    fn CGEventSourceSetLocalEventsFilterDuringSuppressionState(
+        source: *mut c_void,
+        mask: u32,
+        state: u32,
+    );
+    fn CGEventSourceGetLocalEventsFilterDuringSuppressionState(
+        source: *mut c_void,
+        state: u32,
+    ) -> u32;
+}
+
+type Point = (f64, f64);
+pub struct Endpoint {
+    pub target: NativeWindowTarget,
+    pub image: Arc<ImageReference>,
+    pub point: ComputerPoint,
+}
+
+pub struct Prepared {
+    endpoints: [Endpoint; 2],
+    points: [Point; 2],
+}
+fn admit_down<T>(
+    operation: &Operation,
+    owned: &mut Option<OwnedRelease<T>>,
+    up: T,
+    release: Box<dyn Fn(T) -> Result<(), &'static str>>,
+    down: impl FnOnce(),
+) -> Result<(), &'static str> {
+    operation.segment_primary(|| {
+        *owned = Some(OwnedRelease {
+            value: Some(up),
+            release,
+        });
+        down();
+    })
+}
+
+fn contains(g: &ComputerImageGeometry, p: Point) -> bool {
+    p.0 >= g.desktop_x
+        && p.1 >= g.desktop_y
+        && p.0 < g.desktop_x + g.window_width
+        && p.1 < g.desktop_y + g.window_height
+}
+
+/// Called after both endpoints' canonical capture/drag policy admission, inside
+/// the same operation's blocking worker. Opaque Prepared cannot replace a ref
+/// with caller-supplied geometry or bypass fresh image checks.
+pub fn prepare(operation: &Operation, endpoints: [Endpoint; 2]) -> Result<Prepared, &'static str> {
+    operation.checkpoint()?;
+    if !operation.primary(false, || unsafe {
+        crate::ax::bindings::AXIsProcessTrusted()
+    })? {
+        return Err("accessibility_permission_denied");
+    }
+    let mut points = [(0.0, 0.0); 2];
+    for (index, endpoint) in endpoints.iter().enumerate() {
+        if !operation.owns_native_window(endpoint.target)
+            || !endpoint.image.target_matches(
+                endpoint.target.pid as u32,
+                u64::from(endpoint.target.window_id),
+            )
+            || ![endpoint.point.x, endpoint.point.y]
+                .iter()
+                .all(|n| n.is_finite() && (0.0..2048.0).contains(n))
+        {
+            return Err("controlled_target_stale");
+        }
+        endpoint.image.addresses(
+            &endpoint.point.image_ref,
+            endpoint.point.x as u32,
+            endpoint.point.y as u32,
+        )?;
+        let g = endpoint.image.geometry();
+        let fresh = crate::capture::controlled::capture_bound(
+            operation,
+            g.output_width.max(g.output_height),
+            endpoint.target,
+        )?;
+        if !endpoint.image.matches(&fresh) {
+            return Err("stale_image_observation");
+        }
+        points[index] = g.desktop_pixel_center(endpoint.point.x as u32, endpoint.point.y as u32)?;
+    }
+    if endpoints[0].target.window_id == endpoints[1].target.window_id {
+        return Err("invalid_drag_destination");
+    }
+    Ok(Prepared { endpoints, points })
+}
+
+fn trajectory(
+    from: Point,
+    to: Point,
+    source: &ComputerImageGeometry,
+    destination: &ComputerImageGeometry,
+    duration_ms: u32,
+) -> Result<Vec<Point>, &'static str> {
+    if !(1..=5000).contains(&duration_ms)
+        || !contains(source, from)
+        || !contains(destination, to)
+        || source.window_width < 10.0
+        || source.window_height < 10.0
+    {
+        return Err("invalid_drag_geometry");
+    }
+    // Start movement inside source so a normal AppKit drag threshold is crossed
+    // before jumping a gap. No sampled event is sent over an unrelated window.
+    let delta = (to.0 - from.0, to.1 - from.1);
+    let length = delta.0.hypot(delta.1);
+    if !length.is_finite() || length < 1.0 {
+        return Err("invalid_drag_geometry");
+    }
+    let offset = (delta.0 * 8.0 / length, delta.1 * 8.0 / length);
+    let clamp = |sign: f64| {
+        (
+            (from.0 + sign * offset.0).clamp(
+                source.desktop_x + 1.0,
+                source.desktop_x + source.window_width - 1.0,
+            ),
+            (from.1 + sign * offset.1).clamp(
+                source.desktop_y + 1.0,
+                source.desktop_y + source.window_height - 1.0,
+            ),
+        )
+    };
+    let mut kickoff = clamp(1.0);
+    if (kickoff.0 - from.0).hypot(kickoff.1 - from.1) < 4.0 {
+        kickoff = clamp(-1.0);
+    }
+    if (kickoff.0 - from.0).hypot(kickoff.1 - from.1) < 4.0 {
+        return Err("invalid_drag_geometry");
+    }
+    let steps = (duration_ms / 16).max(1);
+    let mut result = Vec::new();
+    result
+        .try_reserve(steps as usize + 1)
+        .map_err(|_| "event_allocation_failed")?;
+    result.push(kickoff);
+    for index in 1..=steps {
+        let f = f64::from(index) / f64::from(steps);
+        let point = (from.0 + delta.0 * f, from.1 + delta.1 * f);
+        if contains(source, point) || contains(destination, point) {
+            result.push(point);
+        }
+    }
+    if result.last() != Some(&to) {
+        result.push(to);
+    }
+    Ok(result)
+}
+
+impl Prepared {
+    fn live(&self, operation: &Operation) -> Result<(), &'static str> {
+        operation.checkpoint()?;
+        let windows = crate::windows::general_windows_with_space_snapshot();
+        for endpoint in &self.endpoints {
+            if crate::tools::computer_process_stamp(endpoint.target.pid)
+                != endpoint.target.process_stamp
+            {
+                return Err("controlled_target_stale");
+            }
+            let g = endpoint.image.geometry();
+            crate::windows::general_point_window_in(
+                &windows.windows,
+                endpoint.target.pid,
+                endpoint.target.window_id,
+                [g.desktop_x, g.desktop_y, g.window_width, g.window_height],
+            )?;
+        }
+        Ok(())
+    }
+    fn hit(&self, point: Point, exact: Option<usize>) -> Result<usize, &'static str> {
+        let hit = crate::input::skylight::hit_test::window_at(point.0, point.1)?;
+        self.endpoints
+            .iter()
+            .enumerate()
+            .find_map(|(index, endpoint)| {
+                (exact.is_none_or(|expected| expected == index)
+                    && endpoint.target.pid == hit.pid
+                    && endpoint.target.window_id == hit.window_id
+                    && contains(endpoint.image.geometry(), point))
+                .then_some(index)
+            })
+            .ok_or("drag_target_occluded")
+    }
+    fn cue(&self, point: Point, endpoint: usize, kind: Kind) -> Cue {
+        let target = &self.endpoints[endpoint];
+        let g = target.image.geometry();
+        Cue {
+            target_pid: target.target.pid,
+            window_id: target.target.window_id,
+            x: point.0 - g.desktop_x,
+            y: point.1 - g.desktop_y,
+            kind,
+        }
+    }
+    /// Source must already be exactly foreground. A preparatory activation
+    /// invalidates image evidence and exits to fresh model-visible observations.
+    pub fn run(
+        self,
+        operation: Arc<Operation>,
+        renderer: Option<Arc<Channel>>,
+        duration_ms: u32,
+    ) -> Result<(), &'static str> {
+        self.live(&operation)?;
+        let target = self.endpoints[0].target;
+        if crate::input::skylight::front_process_matches(target.pid, target.window_id) != Some(true)
+        {
+            return Err("foreground_target_changed");
+        }
+        let route = trajectory(
+            self.points[0],
+            self.points[1],
+            self.endpoints[0].image.geometry(),
+            self.endpoints[1].image.geometry(),
+            duration_ms,
+        )?;
+        self.hit(self.points[0], Some(0))?;
+        self.hit(self.points[1], Some(1))?;
+        self.hit(route[0], Some(0))?;
+        for code in 0..128 {
+            if code != 57 && unsafe { super::CGEventSourceKeyState(0, code) } {
+                return Err("physical_input_held_at_target");
+            }
+        }
+        if (0..3).any(|button| unsafe { super::CGEventSourceButtonState(0, button) }) {
+            return Err("physical_input_held_at_target");
+        }
+        let source = CGEventSource::new(CGEventSourceStateID::Private)
+            .map_err(|_| "event_source_unavailable")?;
+        let source_ptr = source.as_ptr() as *mut c_void;
+        unsafe {
+            CGEventSourceSetLocalEventsSuppressionInterval(source_ptr, 0.0);
+            for state in [0, 1] {
+                CGEventSourceSetLocalEventsFilterDuringSuppressionState(source_ptr, 7, state);
+            }
+            if CGEventSourceGetLocalEventsSuppressionInterval(source_ptr) != 0.0
+                || [0, 1].iter().any(|state| {
+                    CGEventSourceGetLocalEventsFilterDuringSuppressionState(source_ptr, *state) != 7
+                })
+            {
+                return Err("local_input_policy_unproved");
+            }
+        }
+        let tag = (uuid::Uuid::new_v4().as_u128() as i64) | 1;
+        let make = |kind, point: Point, count| {
+            let event = CGEvent::new_mouse_event(
+                source.clone(),
+                kind,
+                CGPoint::new(point.0, point.1),
+                CGMouseButton::Left,
+            )
+            .map_err(|_| "event_allocation_failed")?;
+            event.set_flags(CGEventFlags::empty());
+            event.set_integer_value_field(EventField::MOUSE_EVENT_CLICK_STATE, count);
+            event.set_integer_value_field(EventField::EVENT_SOURCE_USER_DATA, tag);
+            Ok::<_, &'static str>(event)
+        };
+        let down = make(CGEventType::LeftMouseDown, self.points[0], 1)?;
+        let up = make(CGEventType::LeftMouseUp, self.points[0], 1)?;
+        let last_up = up.clone();
+        let moves = route
+            .iter()
+            .map(|point| make(CGEventType::LeftMouseDragged, *point, 0))
+            .collect::<Result<Vec<_>, _>>()?;
+        let observer = observer::Observer::new(tag)?;
+        let last_cue = Rc::new(Cell::new(Some(self.cue(self.points[0], 0, Kind::Down))));
+        let release_operation = operation.clone();
+        let release_renderer = renderer.clone();
+        let release_cue = last_cue.clone();
+        let release: Box<dyn Fn(CGEvent) -> Result<(), &'static str>> = Box::new(move |up| {
+            // Matching cleanup never depends on target/process existence,
+            // foreground, observer health, cancellation or new primary admission.
+            let timestamp = observer::now();
+            if let Ok(timestamp) = timestamp {
+                unsafe { CGEventSetTimestamp(up.as_ptr() as _, timestamp) };
+            }
+            up.post(CGEventTapLocation::HID);
+            if let (Some(renderer), Some(mut cue)) = (&release_renderer, release_cue.get()) {
+                cue.kind = Kind::Up;
+                renderer.publish(cue);
+            }
+            if timestamp.is_err() {
+                release_operation.quarantine();
+                return Err("event_clock_unavailable");
+            }
+            Ok(())
+        });
+        let check = || {
+            if let Some(renderer) = &renderer {
+                renderer.check()?;
+            }
+            self.live(&operation)?;
+            observer.check()?;
+            if !self.endpoints.iter().any(|endpoint| {
+                crate::input::skylight::front_process_matches(
+                    endpoint.target.pid,
+                    endpoint.target.window_id,
+                ) == Some(true)
+            }) {
+                return Err("foreground_target_changed");
+            }
+            Ok(())
+        };
+        observer.arm()?;
+        check()?;
+        self.hit(self.points[0], Some(0))?;
+        unsafe { CGEventSetTimestamp(down.as_ptr() as _, observer::now()?) };
+        let mut owned = None;
+        admit_down(&operation, &mut owned, up, release, || {
+            down.post(CGEventTapLocation::HID);
+            if let (Some(renderer), Some(cue)) = (&renderer, last_cue.get()) {
+                renderer.publish(cue);
+            }
+        })?;
+        let delay = Duration::from_millis(u64::from(duration_ms)) / moves.len() as u32;
+        let mut previous = self.points[0];
+        for (index, (point, event)) in route.iter().zip(&moves).enumerate() {
+            std::thread::sleep(delay);
+            check()?;
+            let endpoint = self.hit(
+                *point,
+                if index == 0 {
+                    Some(0)
+                } else if index + 1 == moves.len() {
+                    Some(1)
+                } else {
+                    None
+                },
+            )?;
+            event.set_integer_value_field(
+                EventField::MOUSE_EVENT_DELTA_X,
+                (point.0.round() - previous.0.round()) as i64,
+            );
+            event.set_integer_value_field(
+                EventField::MOUSE_EVENT_DELTA_Y,
+                (point.1.round() - previous.1.round()) as i64,
+            );
+            unsafe { CGEventSetTimestamp(event.as_ptr() as _, observer::now()?) };
+            operation.segment_primary(|| {
+                unsafe { super::CGEventSetLocation(last_up.as_ptr() as _, point.0, point.1) };
+                event.post(CGEventTapLocation::HID);
+                let cue = self.cue(*point, endpoint, Kind::Move);
+                last_cue.set(Some(cue));
+                if let Some(renderer) = &renderer {
+                    renderer.publish(cue);
+                }
+            })?;
+            previous = *point;
+        }
+        check()?;
+        self.hit(self.points[1], Some(1))?;
+        owned.as_mut().expect("admitted down owns release").run()?;
+        observer.check()?;
+        Ok(())
+    }
+}
