+use super::*;
+use crate::controlled::Gate;
+use std::sync::Arc;
+
+fn configured(
+    source: &Arc<Session>,
+    destination: Option<Arc<Session>>,
+    intent: &str,
+) -> Result<Arc<Operation>, &'static str> {
+    let op = source.new_operation()?;
+    if let Some(destination) = destination {
+        op.bind_drag_destination(destination)?;
+    }
+    op.configure_segment(vec![2], Duration::from_secs(1))?;
+    op.bind_segment_intent(intent)?;
+    Ok(op)
+}
+
+#[test]
+fn controlled_drag_intent_binds_destination_incarnation_not_image_versions() {
+    let gate = Gate::new();
+    let source = gate
+        .session(None, Arc::new(|| true), 42, 7, Some((1, 2)))
+        .unwrap();
+    let b = gate
+        .session(None, Arc::new(|| true), 42, 8, Some((1, 2)))
+        .unwrap();
+    let c = gate
+        .session(None, Arc::new(|| true), 42, 9, Some((1, 2)))
+        .unwrap();
+    configured(&source, Some(b.clone()), "same")
+        .unwrap()
+        .cancel();
+    configured(&source, Some(b), "same").unwrap().cancel();
+    assert!(matches!(
+        configured(&source, Some(c.clone()), "same"),
+        Err("intent_target_mismatch")
+    ));
+    assert!(matches!(
+        configured(&source, None, "same"),
+        Err("intent_target_mismatch")
+    ));
+    configured(&source, Some(c), "new").unwrap().cancel();
+    assert_eq!(source.intent_state("same"), Ok((0, false, false)));
+}
+
+#[tokio::test]
+async fn controlled_drag_intent_cannot_relabel_uncertain_single_target_input() {
+    let gate = Gate::new();
+    let source = gate
+        .session(None, Arc::new(|| true), 42, 7, Some((1, 2)))
+        .unwrap();
+    let destination = gate
+        .session(None, Arc::new(|| true), 42, 8, Some((1, 2)))
+        .unwrap();
+    let prior = configured(&source, None, "used").unwrap();
+    prior.begin().unwrap();
+    prior.begin_segment_action(0).unwrap();
+    prior.segment_primary(|| ()).unwrap();
+    prior.finish();
+    assert!(prior.terminal().await.unwrap().input_committed);
+    assert!(matches!(
+        configured(&source, Some(destination), "used"),
+        Err("intent_target_mismatch")
+    ));
+    assert_eq!(source.intent_state("used"), Ok((0, true, false)));
+}
+
+#[tokio::test]
+async fn controlled_drag_intent_keeps_unknown_and_recovery_across_pair_operations() {
+    let gate = Gate::new();
+    let source = gate
+        .session(None, Arc::new(|| true), 42, 7, Some((1, 2)))
+        .unwrap();
+    let destination = gate
+        .session(None, Arc::new(|| true), 42, 8, Some((1, 2)))
+        .unwrap();
+    let prior = configured(&source, Some(destination.clone()), "pair").unwrap();
+    prior.begin().unwrap();
+    prior.begin_segment_action(0).unwrap();
+    prior.segment_primary(|| ()).unwrap();
+    prior.finish();
+    assert!(prior.terminal().await.unwrap().input_committed);
+    source.recover_intent("pair").unwrap();
+    configured(&source, Some(destination), "pair")
+        .unwrap()
+        .cancel();
+    assert_eq!(
+        source.intent_state("pair"),
+        Ok((1, true, false)),
+        "binding does not clear uncertain effects or budget"
+    );
+}
