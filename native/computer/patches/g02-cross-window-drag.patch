+                if mode == 1 || mode == 2 {
+                    assert!(op
+                        .segment_primary(|| panic!("new input after stop"))
+                        .is_err());
+                }
+            }));
+            assert_eq!(outcome.is_err(), mode == 3);
+            assert_eq!(downs.load(Ordering::SeqCst), usize::from(mode != 0));
+            assert_eq!(ups.load(Ordering::SeqCst), usize::from(mode != 0));
+            drop(work);
+            op.finish();
+            if mode == 4 {
+                assert_eq!(op.terminal().await, Err("quarantined"));
+            } else {
+                assert_eq!(op.terminal().await.unwrap().input_committed, mode != 0);
+            }
