+//! Default topmost WindowServer hit query. Never skip an external surface by
+//! process name, layer or connection. Qualified against intercept/pass-through
+//! owned panels in T-070; unavailable SPI or uncertain ownership fails closed.
+use core_graphics::geometry::CGPoint;
+use std::sync::OnceLock;
+
+// ABI from yabai src/misc/extern.h; actual local default query was qualified.
+type Find =
+    unsafe extern "C" fn(u32, i32, i32, i32, *mut CGPoint, *mut CGPoint, *mut u32, *mut u32) -> i32;
+type GetPid = unsafe extern "C" fn(u32, *mut libc::pid_t) -> i32;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct WindowHit {
+    pub pid: libc::pid_t,
+    pub window_id: u32,
+}
+
+fn decoded(
+    status: i32,
+    window: u32,
+    pid_status: i32,
+    pid: libc::pid_t,
+) -> Result<WindowHit, &'static str> {
+    if status != 0 || pid_status != 0 || window == 0 || pid <= 0 {
+        return Err("pointer_hit_unknown");
+    }
+    Ok(WindowHit {
+        pid,
+        window_id: window,
+    })
+}
+
+pub(crate) fn window_at(x: f64, y: f64) -> Result<WindowHit, &'static str> {
+    if !x.is_finite() || !y.is_finite() {
+        return Err("invalid_pointer_position");
+    }
+    static FIND: OnceLock<Option<Find>> = OnceLock::new();
+    static PID: OnceLock<Option<GetPid>> = OnceLock::new();
+    let find = FIND
+        .get_or_init(|| {
+            super::find_sym(b"SLSFindWindowAndOwner\0").map(|p| unsafe { super::as_fn(p) })
+        })
+        .ok_or("pointer_hit_unavailable")?;
+    let get_pid = PID
+        .get_or_init(|| {
+            super::find_sym(b"SLSConnectionGetPID\0").map(|p| unsafe { super::as_fn(p) })
+        })
+        .ok_or("pointer_hit_unavailable")?;
+    let connection = super::main_connection_id()
+        .filter(|id| *id != 0)
+        .ok_or("pointer_hit_unavailable")?;
+    let mut screen = CGPoint::new(x, y);
+    let mut local = CGPoint::new(0.0, 0.0);
+    let mut window = 0;
+    let mut owner = 0;
+    let mut pid = 0;
+    let status = unsafe {
+        find(
+            connection,
+            0,
+            1,
+            0,
+            &mut screen,
+            &mut local,
+            &mut window,
+            &mut owner,
+        )
+    };
+    let pid_status = if status == 0 && window != 0 && owner != 0 {
+        unsafe { get_pid(owner, &mut pid) }
+    } else {
+        -1
+    };
+    decoded(status, window, pid_status, pid)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn controlled_hit_test_unknown_is_not_an_empty_or_owned_target() {
+        assert_eq!(
+            decoded(0, 42, 0, 9),
+            Ok(WindowHit {
+                pid: 9,
+                window_id: 42
+            })
+        );
+        for (status, window, pid_status, pid) in [
+            (-1, 42, 0, 9),
+            (0, 42, -1, 9),
+            (0, 0, 0, 9),
+            (0, 42, 0, 0),
+            (0, 42, 0, -1),
+        ] {
+            assert_eq!(
+                decoded(status, window, pid_status, pid),
+                Err("pointer_hit_unknown")
+            );
+        }
+        assert_eq!(window_at(f64::NAN, 0.0), Err("invalid_pointer_position"));
+        assert_eq!(
+            window_at(0.0, f64::INFINITY),
+            Err("invalid_pointer_position")
+        );
