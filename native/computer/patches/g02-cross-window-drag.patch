@@ -0,0 +1,361 @@
+//! A dedicated two-capability entry; ordinary segments remain single-window.
+use super::{
+    refused, segment::*, ComputerCondition, ComputerDispatch, ComputerError, ComputerOperation,
+    ComputerResult, ComputerSession,
+};
+use std::{
+    sync::Arc,
+    time::{Duration, Instant},
+};
+
+fn shape(segment: &ComputerSegment) -> Result<(&ComputerPoint, &ComputerPoint, u32), &'static str> {
+    super::segment::validate(segment)?;
+    let [ComputerInput::Drag {
+        from,
+        to,
+        duration_ms,
+    }] = segment.actions.as_slice()
+    else {
+        return Err("invalid_cross_window_drag");
+    };
+    if !matches!(segment.postcondition, ComputerPostcondition::Visual { .. })
+        || from.image_ref != segment.observation_ref
+        || from.image_ref == to.image_ref
+    {
+        return Err("invalid_cross_window_drag");
+    }
+    Ok((from, to, *duration_ms))
+}
+
+#[uniffi::export]
+impl ComputerOperation {
+    /// Exactly one drag, bound to two genuine selected sessions/current images.
+    /// A necessary activation posts no drag: it returns fresh-evidence-required
+    /// facts instead of carrying old pixel coordinates across focus changes.
+    pub fn start_cross_window_drag(
+        self: Arc<Self>,
+        destination: Arc<ComputerSession>,
+        segment: ComputerSegment,
+    ) -> Result<(), ComputerError> {
+        let (_, _, duration_ms) = shape(&segment).map_err(refused)?;
+        #[cfg(not(target_os = "macos"))]
+        {
+            let _ = (destination, duration_ms);
+            Err(refused("unsupported_platform"))
+        }
+        #[cfg(target_os = "macos")]
+        {
+            self.bind_drag_destination(destination.clone())?;
+            let timeout = Duration::from_millis(u64::from(segment.max_duration_ms));
+            let limits = vec![8 + (duration_ms / 16).max(1)];
+            let worker = self.clone();
+            self.launch_bounded(None, Some((limits, timeout)), async move {
+                worker.execute_cross_window_drag(destination, segment).await
+            })
+        }
+    }
+}
+
+#[cfg(target_os = "macos")]
+impl ComputerOperation {
+    pub(super) fn take_drag_images(
+        &self,
+        destination: &ComputerSession,
+        from: &ComputerPoint,
+        to: &ComputerPoint,
+    ) -> Result<[Arc<cua_driver_core::controlled::ImageReference>; 2], ComputerError> {
+        // Consume BOTH slots before checking either ref; never restore a half
+        // pair on refusal. The common scheduler owns this operation, and close
+        // waits its core dependency before retiring either session's caches.
+        let source = self
+            .session
+            .image_reference
+            .lock()
+            .map_err(|_| self.session.host.quarantine())?
+            .take();
+        let target = destination
+            .image_reference
+            .lock()
+            .map_err(|_| self.session.host.quarantine())?
+            .take();
+        *self
+            .session
+            .observation
+            .lock()
+            .map_err(|_| self.session.host.quarantine())? = None;
+        *destination
+            .observation
+            .lock()
+            .map_err(|_| self.session.host.quarantine())? = None;
+        self.core.reset_snapshot();
+        let source = source.ok_or_else(|| refused("stale_image_observation"))?;
+        let target = target.ok_or_else(|| refused("stale_image_observation"))?;
+        source
+            .addresses(&from.image_ref, from.x as u32, from.y as u32)
+            .map_err(refused)?;
+        target
+            .addresses(&to.image_ref, to.x as u32, to.y as u32)
+            .map_err(refused)?;
+        Ok([source, target])
+    }
+
+    async fn execute_cross_window_drag(
+        &self,
+        destination: Arc<ComputerSession>,
+        segment: ComputerSegment,
+    ) -> Result<ComputerResult, ComputerError> {
+        use platform_macos::input::controlled::cross_drag::{self, Endpoint};
+        let started = Instant::now();
+        let (from, to, duration_ms) = shape(&segment).map_err(refused)?;
+        let [source_image, destination_image] = self.take_drag_images(&destination, from, to)?;
+        let source_target = self.session.gate.native_window().map_err(refused)?;
+        let destination_target = destination.gate.native_window().map_err(refused)?;
+        for (native, target) in [
+            (&self.session.native, source_target),
+            (&destination.native, destination_target),
+        ] {
+            native.computer_segment_authorize("get_window_state", &serde_json::json!({"pid":target.pid,"window_id":target.window_id,"include_accessibility_tree":false,"include_screenshot":true})).map_err(refused)?;
+            native
+                .computer_segment_authorize(
+                    "drag",
+                    &serde_json::json!({"pid":target.pid,"window_id":target.window_id}),
+                )
+                .map_err(refused)?;
+        }
+        let prior = self
+            .core
+            .session
+            .intent_state(&segment.intent_ref)
+            .map_err(refused)?;
+        if prior.1 || prior.2 {
+            let code = self
+                .core
+                .session
+                .recover_intent(&segment.intent_ref)
+                .map(|_| "intent_outcome_unknown")
+                .unwrap_or_else(|code| code);
+            let value = result(
+                &segment,
+                Some(code),
+                false,
+                false,
+                self.core.is_cancelled(),
+                0,
+                self.core
+                    .session
+                    .intent_state(&segment.intent_ref)
+                    .map(|state| state.0)
+                    .unwrap_or(prior.0),
+                started.elapsed().as_millis() as u64,
+            )?;
+            return Ok(ComputerResult::Segment { value });
+        }
+        let state = self
+            .session
+            .native
+            .computer_state()
+            .ok_or_else(|| refused("controlled_state_unavailable"))?;
+        let renderer = self
+            .session
+            .host
+            .renderer
+            .as_ref()
+            .map(|renderer| renderer.channel.clone());
+        let context = platform_macos::tools::computer::segment::Context {
+            renderer: renderer.clone(),
+            operation: self.core.clone(),
+            state,
+            observation_ref: segment.observation_ref.clone(),
+            intent_ref: segment.intent_ref.clone(),
+            image: Some(source_image.clone()),
+        };
+        let endpoints = [
+            Endpoint {
+                target: source_target,
+                image: source_image,
+                point: from.clone(),
+            },
+            Endpoint {
+                target: destination_target,
+                image: destination_image,
+                point: to.clone(),
+            },
+        ];
+        let core = self.core.clone();
+        let native = self.session.native.clone();
+        let intent = segment.intent_ref.clone();
+        let attempt = self.segment_blocking(move || -> Result<bool, &'static str> {
+            let prepared = cross_drag::prepare(&core, endpoints)?;
+            if !context.foreground() {
+                core.session.recover_intent(&intent)?;
+                native.computer_segment_authorize("bring_to_front", &serde_json::json!({"pid":source_target.pid,"window_id":source_target.window_id}))?;
+                core.begin_segment_action(0)?;
+                // Preparation is distinct from requested drag input. A successful
+                // activation requires NEW images/points, not an automatic replay.
+                if let Err(code) = context.activate() {
+                    if core.input_committed() && core.session.record_intent(&intent, true, false).is_err() { core.quarantine(); }
+                    return Err(code);
+                }
+                return Ok(false);
+            }
+            core.bind_segment_intent(&intent)?; // records the ordered target pair
+            core.begin_segment_action(0)?;
+            prepared.run(core, renderer, duration_ms)?;
+            Ok(true)
+        }).await.map_err(|_| ComputerError::Quarantined)?;
+        let delivered = matches!(attempt, Ok(true));
+        let preparation = matches!(attempt, Ok(false));
+        let code = match attempt {
+            Ok(true) => None,
+            Ok(false) => Some("drag_foreground_prepared"),
+            Err(code) => Some(code),
+        };
+        let value = result(
+            &segment,
+            code,
+            delivered,
+            !preparation && self.core.input_committed(),
+            self.core.is_cancelled(),
+            self.core.segment_action_inputs(),
+            self.core
+                .session
+                .intent_state(&segment.intent_ref)
+                .map(|state| state.0)
+                .unwrap_or(prior.0),
+            started.elapsed().as_millis() as u64,
+        )?;
+        Ok(ComputerResult::Segment { value })
+    }
+}
+
+fn result(
+    segment: &ComputerSegment,
+    code: Option<&'static str>,
+    delivered: bool,
+    committed: bool,
+    cancelled: bool,
+    count: u32,
+    attempts: u8,
+    elapsed_ms: u64,
+) -> Result<ComputerSegmentResult, ComputerError> {
+    use cua_driver_contract::{
+        ActionDelivery, ActionDeliveryMode, ActionEffect, ActionResult, ActionRoute,
+    };
+    let value = ComputerSegmentResult {
+        status: if cancelled {
+            ComputerSegmentStatus::Cancelled
+        } else if committed && !delivered {
+            ComputerSegmentStatus::OutcomeUnknown
+        } else {
+            ComputerSegmentStatus::NeedsObservation
+        },
+        actions: vec![ComputerInputResult {
+            index: 0,
+            dispatch: if delivered {
+                ComputerDispatch::Dispatched
+            } else if committed {
+                ComputerDispatch::Unknown
+            } else {
+                ComputerDispatch::NotDispatched
+            },
+            action: delivered.then_some(ActionResult {
+                effect: ActionEffect::Unverifiable,
+                route: ActionRoute::GlobalInput,
+                delivery: Some(ActionDelivery {
+                    mode: ActionDeliveryMode::Foreground,
+                    delivered_count: Some(count),
+                }),
+                evidence: None,
+                escalation: None,
+            }),
+            code: code.map(str::to_owned),
+        }],
+        condition: ComputerCondition::Unknown,
+        first_unfinished_action: (!delivered).then_some(0),
+        recovery_attempts: attempts,
+        elapsed_ms,
+    };
+    super::segment::validate_result(segment, &value).map_err(refused)?;
+    Ok(value)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn input() -> ComputerSegment {
+        ComputerSegment {
+            intent_ref: "intent".into(),
+            observation_ref: "source".into(),
+            actions: vec![ComputerInput::Drag {
+                from: ComputerPoint {
+                    image_ref: "source".into(),
+                    x: 1.0,
+                    y: 1.0,
+                },
+                to: ComputerPoint {
+                    image_ref: "destination".into(),
+                    x: 2.0,
+                    y: 2.0,
+                },
+                duration_ms: 240,
+            }],
+            postcondition: ComputerPostcondition::Visual {
+                description: "Verify the dedicated drop".into(),
+            },
+            max_duration_ms: 30_000,
+        }
+    }
+    #[test]
+    fn controlled_cross_drag_shape_is_one_visual_two_image_action() {
+        assert!(shape(&input()).is_ok());
+        for mode in 0..5 {
+            let mut input = input();
+            match mode {
+                0 => input.actions.push(input.actions[0].clone()),
+                1 => input.postcondition = ComputerPostcondition::WindowFocused,
+                2 => input.observation_ref = "wrong".into(),
+                3 => {
+                    if let ComputerInput::Drag { from, to, .. } = &mut input.actions[0] {
+                        to.image_ref = from.image_ref.clone();
+                    }
+                }
+                _ => {
+                    if let ComputerInput::Drag { from, .. } = &mut input.actions[0] {
+                        from.x = f64::NAN;
+                    }
+                }
+            }
+            assert!(shape(&input).is_err());
+        }
+    }
+    #[test]
+    fn controlled_cross_drag_preparation_is_not_drag_delivery_or_confirmation() {
+        let segment = input();
+        let prepared = result(
+            &segment,
+            Some("drag_foreground_prepared"),
+            false,
+            false,
+            false,
+            2,
+            1,
+            10,
+        )
+        .unwrap();
+        assert_eq!(
+            prepared.actions[0].dispatch,
+            ComputerDispatch::NotDispatched
+        );
+        assert!(prepared.actions[0].action.is_none());
+        assert_eq!(prepared.first_unfinished_action, Some(0));
+        let delivered = result(&segment, None, true, true, false, 14, 1, 250).unwrap();
+        assert_eq!(delivered.status, ComputerSegmentStatus::NeedsObservation);
+        assert_eq!(
+            delivered.actions[0].action.as_ref().unwrap().route,
+            cua_driver_contract::ActionRoute::GlobalInput
+        );
+        let interrupted = result(&segment, Some("cancelled"), false, true, true, 3, 0, 20).unwrap();
+        assert_eq!(interrupted.status, ComputerSegmentStatus::Cancelled);
+        assert_eq!(interrupted.actions[0].dispatch, ComputerDispatch::Unknown);
+    }
+}
