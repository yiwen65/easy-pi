+async fn controlled_cross_drag_consumes_both_images_even_when_one_reference_fails() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    for mode in 0..4 {
+        let host = host();
+        let source = session_target(&host, None, 7, Some((1, 2)));
+        let destination = session_target(&host, None, 8, Some((1, 2)));
+        if mode != 0 {
+            *source.image_reference.lock().unwrap() = Some(image(7, "source"));
+        }
+        *destination.image_reference.lock().unwrap() = Some(image(8, "destination"));
+        for target in [&source, &destination] {
+            *target.observation.lock().unwrap()=Some(serde_json::from_value(serde_json::json!({"pid":42,"window_id":target.gate.native_window().unwrap().window_id})).unwrap());
+        }
+        let op = source.clone().new_operation().unwrap();
+        op.bind_drag_destination(destination.clone()).unwrap();
+        op.core.begin().unwrap();
+        let from = ComputerPoint {
+            image_ref: if mode == 1 { "wrong" } else { "source" }.into(),
+            x: 0.0,
+            y: 0.0,
+        };
+        let to = ComputerPoint {
+            image_ref: if mode == 2 { "wrong" } else { "destination" }.into(),
+            x: 0.0,
+            y: 0.0,
+        };
+        let result = op.take_drag_images(&destination, &from, &to);
+        assert_eq!(result.is_ok(), mode == 3);
+        assert!(source.image_reference.lock().unwrap().is_none());
+        assert!(destination.image_reference.lock().unwrap().is_none());
+        assert!(source.observation.lock().unwrap().is_none());
+        assert!(destination.observation.lock().unwrap().is_none());
+        op.core.finish();
+        assert!(!op.terminal().await.unwrap().input_committed);
+        host.close().await.unwrap();
+    }
+}
