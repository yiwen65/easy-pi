@@ -0,0 +1,91 @@
+use super::Data;
+
+/// Only the selected root's attached surfaces, never all windows of its PID.
+pub(super) fn require_clear(
+    sheets: impl FnOnce() -> Result<bool, &'static str>,
+    children: impl FnOnce() -> Result<Vec<Data>, &'static str>,
+) -> Result<(), &'static str> {
+    // AXSheets is optional even on AppKit windows with a real attached sheet.
+    // Their immediate AXChildren expose the relation and AXSheet role instead.
+    if sheets()? || children()?.iter().any(Data::unexpected_surface) {
+        Err("unexpected_modal_surface")
+    } else {
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn controlled_selected_surface_explicit_sheet_blocks_before_children() {
+        assert_eq!(
+            require_clear(|| Ok(true), || panic!("unnecessary content read")),
+            Err("unexpected_modal_surface")
+        );
+    }
+
+    #[test]
+    fn controlled_selected_surface_children_detect_sheet_when_axsheets_unsupported() {
+        for data in [
+            Data {
+                role: "AXSheet".into(),
+                ..Default::default()
+            },
+            Data {
+                role: "AXWindow".into(),
+                subrole: Some("AXDialog".into()),
+                ..Default::default()
+            },
+            Data {
+                role: "AXGroup".into(),
+                modal: true,
+                ..Default::default()
+            },
+        ] {
+            assert_eq!(
+                require_clear(|| Ok(false), || Ok(vec![data])),
+                Err("unexpected_modal_surface")
+            );
+        }
+    }
+
+    #[test]
+    fn controlled_selected_surface_unknown_queries_are_not_empty() {
+        for code in [
+            "cancelled",
+            "accessibility_permission_denied",
+            "observation_read_failed",
+        ] {
+            assert_eq!(
+                require_clear(|| Err(code), || panic!("read after failure")),
+                Err(code)
+            );
+            assert_eq!(require_clear(|| Ok(false), || Err(code)), Err(code));
+        }
+    }
+
+    #[test]
+    fn controlled_selected_surface_normal_children_and_explicit_child_root_are_allowed() {
+        // Do not test the selected root's own modal role: explicitly selecting
+        // a sheet/menu grants that surface, not its blocked parent.
+        assert_eq!(require_clear(|| Ok(false), || Ok(vec![])), Ok(()));
+        assert_eq!(
+            require_clear(
+                || Ok(false),
+                || Ok(vec![
+                    Data {
+                        role: "AXTextField".into(),
+                        ..Default::default()
+                    },
+                    Data {
+                        role: "AXGroup".into(),
+                        ..Default::default()
+                    },
+                ])
+            ),
+            Ok(())
+        );
+    }
+}
