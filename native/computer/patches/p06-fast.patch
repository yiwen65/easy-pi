+        }
+
+        async fn invoke_tool(
+            &self,
+            _name: &str,
+            arguments: serde_json::Value,
+        ) -> Result<serde_json::Value, String> {
+            self.arguments.lock().unwrap().replace(arguments);
+            Ok(serde_json::json!({"content": [], "isError": false}))
+        }
+    }
