+        let arguments = provider.arguments.lock().unwrap().clone().unwrap();
+        assert_eq!(arguments["_session_id"], "mcp-trusted-lease");
+        assert_eq!(arguments["_transport_session_id"], "mcp-trusted-lease");
+    }
