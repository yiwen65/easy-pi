diff --git a/libs/cua-driver/rust/crates/platform-macos/src/cursor/inactive_overlay.rs b/libs/cua-driver/rust/crates/platform-macos/src/cursor/inactive_overlay.rs
new file mode 100644
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-macos/src/cursor/inactive_overlay.rs
@@ -0,0 +1,49 @@
+//! Compile-time absent visual facility for the controlled Computer profile.
+//!
+//! These are the existing uninitialised-channel semantics: visual cues are
+//! discarded and readbacks never claim visibility. No AppKit renderer, window,
+//! thread, input event, animation waiter or fallback is constructed. This is
+//! not an actuator or an input/terminal receipt. Explicit cursor controls are
+//! refused by the existing `cursor_overlay_available` facility gate.
+
+use cursor_overlay::{CursorKey, CursorVisualState, MotionConfig, OverlayCommand};
+
+pub(crate) fn is_overlay_window(_window_id: u32) -> bool {
+    false
+}
+pub fn send_command(_key: CursorKey, _command: OverlayCommand) {}
+pub fn send_command_default(_command: OverlayCommand) {}
+pub fn is_visible_for_session(_key: &str) -> bool {
+    false
+}
+pub fn remove_cursor(_key: CursorKey) {}
+pub fn revive_cursor(_key: CursorKey) {}
+pub fn current_motion(_key: &str) -> MotionConfig {
+    MotionConfig::default()
+}
+pub fn current_theme_state(
+    _key: &str,
+) -> Option<(String, String, String, Option<String>, CursorVisualState)> {
+    None
+}
+pub async fn animate_cursor_to(_key: CursorKey, _x: f64, _y: f64) {}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn controlled_absent_renderer_never_reports_a_visual_effect_or_waits() {
+        let key = "no-renderer".to_owned();
+        send_command(key.clone(), OverlayCommand::SetEnabled(true));
+        send_command_default(OverlayCommand::PinAbove(42));
+        animate_cursor_to(key.clone(), 10.0, 20.0).await;
+        assert!(!is_visible_for_session(&key));
+        assert!(!is_overlay_window(42));
+        assert!(current_theme_state(&key).is_none());
+        assert_eq!(current_motion(&key), MotionConfig::default());
+        remove_cursor(key.clone());
+        revive_cursor(key.clone());
+        assert!(!is_visible_for_session(&key));
+    }
+}
