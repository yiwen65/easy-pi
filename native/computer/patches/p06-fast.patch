+#[cfg(test)]
+mod observation_tests {
+    use super::*;
+    use std::sync::Mutex;
+
+    struct CapturingProvider {
+        arguments: Mutex<Option<serde_json::Value>>,
+    }
+
+    #[async_trait::async_trait]
+    impl ToolProvider for CapturingProvider {
+        fn tools_list(&self) -> serde_json::Value {
