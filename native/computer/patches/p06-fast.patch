+//! Transport-independent completion classification; contains no worker execution.
+
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, uniffi::Enum)]
+#[serde(rename_all = "snake_case")]
+pub enum ActionCompletion {
+    NotStarted,
+    Completed,
+    Unknown,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn completion_classification_remains_transport_independent() {
+        for (completion, value) in [
+            (ActionCompletion::NotStarted, "not_started"),
+            (ActionCompletion::Completed, "completed"),
+            (ActionCompletion::Unknown, "unknown"),
+        ] {
+            assert_eq!(serde_json::to_value(completion).unwrap(), value);
+            assert_eq!(
+                serde_json::from_value::<ActionCompletion>(value.into()).unwrap(),
+                completion
+            );
+        }
+        assert!(serde_json::from_str::<ActionCompletion>("\"timed_out_means_done\"").is_err());
+    }
+}
