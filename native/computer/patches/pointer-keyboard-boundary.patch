 use super::*;
 
 #[test]
+fn controlled_pointer_press_requires_boundary_for_new_keyboard_input_only() {
+    let point = ComputerPoint {
+        image_ref: "image".into(),
+        x: 1.0,
+        y: 1.0,
+    };
+    let target = ComputerElementAddress::Reference {
+        reference: "s1:1".into(),
+    };
+    let keyboard = [
+        ComputerInput::TypeText {
+            text: "new input".into(),
+        },
+        ComputerInput::Key {
+            key: "a".into(),
+            modifiers: vec![],
+        },
+        ComputerInput::KeyDown {
+            key: "shift".into(),
+        },
+    ];
+    for pointer in [
+        ComputerInput::Click {
+            point: point.clone(),
+            button: ComputerMouseButton::Left,
+            count: 1,
+        },
+        ComputerInput::Drag {
+            from: point.clone(),
+            to: point.clone(),
+            duration_ms: 200,
+        },
+        ComputerInput::ButtonDown {
+            button: ComputerMouseButton::Left,
+        },
+    ] {
+        let mut previous = vec![pointer];
+        for action in &keyboard {
+            assert!(requires_pointer_keyboard_boundary(&previous, action));
+            assert!(!requires_pointer_keyboard_boundary(&[], action));
+        }
+        // A release must neither be blocked nor erase the boundary.
+        for release in [
+            ComputerInput::KeyUp {
+                key: "shift".into(),
+            },
+            ComputerInput::ButtonUp {
+                button: ComputerMouseButton::Left,
+            },
+        ] {
+            assert!(!requires_pointer_keyboard_boundary(&previous, &release));
+            previous.push(release);
+        }
+        assert!(requires_pointer_keyboard_boundary(&previous, &keyboard[0]));
+    }
+    for prior in [
+        ComputerInput::Focus {
+            target: target.clone(),
+        },
+        ComputerInput::Fill {
+            target: target.clone(),
+            text: "value".into(),
+        },
+        ComputerInput::PointerMove {
+            point: point.clone(),
+        },
+        ComputerInput::Scroll {
+            point,
+            delta_x: 0.0,
+            delta_y: 1.0,
+            unit: ComputerScrollUnit::Line,
+        },
+        keyboard[0].clone(),
+    ] {
+        for action in &keyboard {
+            assert!(!requires_pointer_keyboard_boundary(
+                std::slice::from_ref(&prior),
+                action
+            ));
+        }
+    }
+}
