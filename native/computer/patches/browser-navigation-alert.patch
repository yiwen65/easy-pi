+#[tokio::test]
+async fn controlled_cdp_dialog_ends_pending_read_and_joins_transport() {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let port = listener.local_addr().unwrap().port();
+    let peer = tokio::spawn(async move {
+        let (socket, _) = listener.accept().await.unwrap();
+        let mut socket = tokio_tungstenite::accept_async(socket).await.unwrap();
+        let Some(Ok(Message::Text(text))) = socket.next().await else {
+            panic!("missing read")
+        };
+        let call: Value = serde_json::from_str(&text).unwrap();
+        assert_eq!(call["method"], "Page.getFrameTree");
+        socket
+            .send(Message::Text(
+                serde_json::json!({
+                    "method":"Page.javascriptDialogOpening", "sessionId":"page-session",
+                    "params":{"type":"alert"}
+                })
+                .to_string(),
+            ))
+            .await
+            .unwrap();
+        // Real Chrome blocks this reply while alert is open. No dismissal or
+        // retry is permitted; the caller must close and join its transport.
+        let mut extra = 0;
+        while let Some(Ok(Message::Text(_))) = socket.next().await {
+            extra += 1;
+        }
+        extra
+    });
+    let gate = Gate::new();
+    let session = session(&gate);
+    let pool = CdpPool::new_controlled(&session).unwrap();
+    let op = session.new_operation().unwrap();
+    op.begin().unwrap();
+    let (conn, timely, reason) = controlled::scope(op.clone(), async {
+        let conn = pool
+            .get(&format!("ws://127.0.0.1:{port}/devtools/browser/dialog"))
+            .await
+            .unwrap();
+        conn.register_dialog_session("page-session", "page-target");
+        let mut call = Box::pin(conn.call(
+            Some("page-session"),
+            "Page.getFrameTree",
+            serde_json::json!({}),
+        ));
+        let (timely, result) = tokio::select! {
+            result = &mut call => (true, result),
+            _ = tokio::time::sleep(Duration::from_millis(500)) => {
+                conn.shutdown().await.unwrap();
+                (false, call.await)
+            }
+        };
+        let reason = result.unwrap_err().to_string();
+        (conn.clone(), timely, reason)
+    })
+    .await;
+    op.finish();
+    let receipt = op.terminal().await.unwrap();
+    let joined = conn.reader.lock().await.is_none() && conn.writer.lock().await.is_none();
+    session.revoke();
+    session.resources.close().await.unwrap();
+    assert_eq!(peer.await.unwrap(), 0, "input/retry appeared after dialog");
+    assert!(!receipt.input_committed);
+    assert!(!gate.is_quarantined());
+    assert!(timely, "dialog did not interrupt pending CDP read");
+    assert!(joined, "return preceded transport drain proof");
+    assert_eq!(reason, "unexpected_modal_surface");
+}
