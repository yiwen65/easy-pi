+        MockReply::ok(serde_json::json!({"frameTree":{}})).with_events(vec![MockEvent {
+            method: "Page.javascriptDialogOpening".into(),
+            session_id: Some("foreign-session".into()),
+            params: serde_json::json!({"type":"alert"}),
+        }])
+    }))
+    .await;
+    let gate = Gate::new();
+    let session = session(&gate);
+    let pool = CdpPool::new_controlled(&session).unwrap();
+    let op = session.new_operation().unwrap();
