+#[tokio::test]
+async fn controlled_drag_dependency_sdk_either_ancestor_revoke_cancels_only_dependents() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    for close_source in [true, false] {
+        let host = host();
+        let a = endpoint(&host, None, 7);
+        let b = endpoint(&host, None, 8);
+        let source = endpoint(&host, Some(&a), 7);
+        let destination = endpoint(&host, Some(&b), 8);
+        let sibling = endpoint(&host, None, 9);
+        let unrelated = sibling.new_operation().unwrap();
+        let op = source.new_operation().unwrap();
+        op.bind_drag_destination(destination).unwrap();
+        if close_source {
+            a.revoke();
+        } else {
+            b.revoke();
+        }
+        let receipt = op.terminal().await.unwrap();
+        assert!(receipt.cancelled && !receipt.input_committed);
+        assert!(!unrelated.core.is_cancelled());
+        unrelated.cancel();
+        host.close().await.unwrap();
+    }
+}
