+#[tokio::test]
+async fn controlled_drag_dependency_sdk_retains_destination_facade_without_cycle() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let host = host();
+    let source = endpoint(&host, None, 7);
+    let destination = endpoint(&host, None, 8);
+    let weak = Arc::downgrade(&destination);
+    let native = destination.native.clone();
+    let op = source.new_operation().unwrap();
+    op.bind_drag_destination(destination).unwrap();
+    assert!(weak.upgrade().is_some() && native.computer_authority_live());
+    op.cancel();
+    assert!(op.terminal().await.unwrap().cancelled);
+    weak.upgrade().unwrap().close().await.unwrap();
+    drop(op);
+    assert!(weak.upgrade().is_none());
+    host.close().await.unwrap();
+}
