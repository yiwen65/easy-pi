+use super::*;
+use std::future::Future;
+use std::task::{Context, Waker};
+use std::time::Duration;
+
+fn endpoints() -> (Arc<Gate>, Arc<Session>, Arc<Session>) {
+    let gate = Gate::new();
+    let source = gate
+        .session(None, Arc::new(|| true), 42, 7, Some((1, 2)))
+        .unwrap();
+    let destination = gate
+        .session(None, Arc::new(|| true), 42, 8, Some((1, 2)))
+        .unwrap();
+    (gate, source, destination)
+}
+
+// Kept as the original production-seam counterexample. Unbound windows remain
+// unrelated; the new API must not silently expand an ordinary operation.
+#[tokio::test]
+async fn controlled_unbound_destination_is_not_a_dependency_legacy_counterexample() {
+    let (_, source, destination) = endpoints();
+    let op = source.new_operation().unwrap();
+    op.begin().unwrap();
+    assert!(destination.new_operation().is_ok());
+    destination.revoke();
+    assert!(!op.session.descends_from(&destination));
+    assert!(!op.depends_on_subtree(&destination));
+    assert_eq!(op.primary(true, || "admitted"), Ok("admitted"));
+    op.finish();
+    assert_eq!(
+        op.terminal().await.unwrap(),
+        Terminal {
+            cancelled: false,
+            input_committed: true
+        }
+    );
+}
+
+#[test]
+fn controlled_drag_dependency_rejects_scope_identity_and_rebinding() {
+    let (gate, source, destination) = endpoints();
+    let op = source.new_operation().unwrap();
+    let foreign = Gate::new()
+        .session(None, Arc::new(|| true), 43, 9, Some((1, 2)))
+        .unwrap();
+    let discovery = gate.discovery_session(None, Arc::new(|| true)).unwrap();
+    let browser = gate.browser_session(Arc::new(|| true)).unwrap();
+    let missing = gate.session(None, Arc::new(|| true), 43, 9, None).unwrap();
+    let changed = gate
+        .session(None, Arc::new(|| true), 42, 9, Some((2, 2)))
+        .unwrap();
+    for invalid in [
+        source.clone(),
+        foreign,
+        discovery.clone(),
+        browser.clone(),
+        missing,
+        changed,
+    ] {
+        assert!(op.bind_drag_destination(invalid).is_err());
+    }
+    for invalid_source in [discovery, browser] {
+        let invalid = invalid_source.new_operation().unwrap();
+        assert!(invalid.bind_drag_destination(destination.clone()).is_err());
+        invalid.cancel();
+    }
+    op.bind_drag_destination(destination.clone()).unwrap();
+    assert!(!op.session.descends_from(&destination));
+    assert!(op.depends_on_subtree(&destination));
+    assert_eq!(op.session.native_window().unwrap().window_id, 7);
+    assert!(op.bind_drag_destination(destination).is_err());
+    op.cancel();
+}
+
+#[test]
+fn controlled_drag_dependency_must_bind_before_configuration_or_start() {
+    for configured in 0..3 {
+        let (_, source, destination) = endpoints();
+        let op = source.new_operation().unwrap();
+        match configured {
+            0 => op.begin().unwrap(),
+            1 => op.configure_plan(1, Duration::from_secs(1)).unwrap(),
+            _ => op
+                .configure_segment(vec![1], Duration::from_secs(1))
+                .unwrap(),
+        }
+        assert!(op.bind_drag_destination(destination).is_err());
+        op.cancel();
+        op.finish();
+    }
+}
+
+#[tokio::test]
+async fn controlled_drag_dependency_revocation_between_validation_and_primary() {
+    let (_, source, destination) = endpoints();
+    let op = source.new_operation().unwrap();
+    op.bind_drag_destination(destination.clone()).unwrap();
+    op.begin().unwrap();
+    let worker = op.clone();
+    let (ready_tx, ready_rx) = std::sync::mpsc::channel();
+    let (resume_tx, resume_rx) = std::sync::mpsc::channel();
+    let thread = std::thread::spawn(move || {
+        worker.checkpoint().unwrap();
+        ready_tx.send(()).unwrap();
+        resume_rx.recv().unwrap();
+        worker.primary(true, || panic!("destination revoked after validation"))
+    });
+    ready_rx.recv().unwrap();
+    destination.revoke();
+    resume_tx.send(()).unwrap();
+    assert_eq!(thread.join().unwrap(), Err("cancelled"));
+    op.finish();
+    assert_eq!(
+        op.terminal().await.unwrap(),
+        Terminal {
+            cancelled: true,
+            input_committed: false
+        }
+    );
+}
+
+#[tokio::test]
+async fn controlled_drag_dependency_both_ancestors_wake_and_cancel_without_sdk_cancel() {
+    for revoke_source in [true, false] {
+        let (gate, source_parent, destination_parent) = endpoints();
+        let source = gate
+            .session(
+                Some(source_parent.clone()),
+                Arc::new(|| true),
+                42,
+                7,
+                Some((1, 2)),
+            )
+            .unwrap();
+        let destination = gate
+            .session(
+                Some(destination_parent.clone()),
+                Arc::new(|| true),
+                42,
+                8,
+                Some((1, 2)),
+            )
+            .unwrap();
+        let op = source.new_operation().unwrap();
+        op.bind_drag_destination(destination).unwrap();
+        assert!(op.depends_on_subtree(&source_parent));
+        assert!(op.depends_on_subtree(&destination_parent));
+        op.begin().unwrap();
+        let mut cancelled = Box::pin(op.cancelled());
+        assert!(cancelled
+            .as_mut()
+            .poll(&mut Context::from_waker(Waker::noop()))
+            .is_pending());
+        if revoke_source {
+            source_parent.revoke();
+        } else {
+            destination_parent.revoke();
+        }
+        assert!(cancelled
+            .as_mut()
+            .poll(&mut Context::from_waker(Waker::noop()))
+            .is_ready());
+        assert!(op.checkpoint().is_err());
+        op.finish();
+        assert!(op.terminal().await.unwrap().cancelled);
+    }
+}
+
+#[tokio::test]
+async fn controlled_drag_dependency_unstarted_and_action_admission_cancel() {
+    for stage in 0..4 {
+        let (_, source, destination) = endpoints();
+        let op = source.new_operation().unwrap();
+        op.bind_drag_destination(destination.clone()).unwrap();
+        if stage == 1 {
+            op.configure_plan(1, Duration::from_secs(1)).unwrap();
+            op.begin().unwrap();
+        }
+        if stage == 2 {
+            op.configure_segment(vec![1], Duration::from_secs(1))
+                .unwrap();
+            op.begin().unwrap();
+        }
+        destination.revoke();
+        match stage {
+            0 => assert!(op.begin().is_err()),
+            1 => assert!(op.begin_step(0).is_err()),
+            2 => assert!(op.begin_segment_action(0).is_err()),
+            _ => {
+                assert!(op.configure_plan(1, Duration::from_secs(1)).is_err());
+                assert!(op
+                    .configure_segment(vec![1], Duration::from_secs(1))
+                    .is_err());
+            }
+        }
+        if stage == 1 || stage == 2 {
+            op.finish();
+        }
+        assert!(op.terminal().await.unwrap().cancelled);
+    }
+}
+
+#[tokio::test]
+async fn controlled_drag_dependency_terminal_waits_owned_cleanup_after_revoke() {
+    let (_, source, destination) = endpoints();
+    let op = source.new_operation().unwrap();
+    op.bind_drag_destination(destination.clone()).unwrap();
+    op.begin().unwrap();
+    let work = op.track().unwrap();
+    let held = AtomicBool::new(false);
+    op.primary(true, || held.store(true, Ordering::SeqCst))
+        .unwrap();
+    destination.revoke();
+    // Cleanup registration remains legal; it cannot create another primary.
+    let callback = op.track_callback().unwrap();
+    op.finish();
+    let mut terminal = Box::pin(op.terminal());
+    assert!(terminal
+        .as_mut()
+        .poll(&mut Context::from_waker(Waker::noop()))
+        .is_pending());
+    assert!(held.swap(false, Ordering::SeqCst));
+    drop(callback);
+    drop(work);
+    assert_eq!(
+        terminal.await.unwrap(),
+        Terminal {
+            cancelled: true,
+            input_committed: true
+        }
+    );
+    assert!(!held.load(Ordering::SeqCst));
+}
+
+#[tokio::test]
+async fn controlled_drag_dependency_native_authority_and_panic_keep_guards() {
+    let (gate, source, _) = endpoints();
+    let live = Arc::new(AtomicBool::new(true));
+    let authority = live.clone();
+    let destination = gate
+        .session(
+            None,
+            Arc::new(move || authority.load(Ordering::Acquire)),
+            43,
+            9,
+            Some((1, 2)),
+        )
+        .unwrap();
+    let op = source.new_operation().unwrap();
+    op.bind_drag_destination(destination).unwrap();
+    op.begin().unwrap();
+    live.store(false, Ordering::Release);
+    assert!(op
+        .primary(false, || panic!("dead canonical authority"))
+        .is_err());
+    op.finish();
+    assert!(op.terminal().await.unwrap().cancelled);
+    let (_, source, destination) = endpoints();
+    let op = source.new_operation().unwrap();
+    op.bind_drag_destination(destination).unwrap();
+    op.begin().unwrap();
+    assert!(std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        let _work = op.track().unwrap();
+        panic!("owned producer unwind");
+    }))
+    .is_err());
+    op.finish();
+    assert_eq!(op.terminal().await, Err("quarantined"));
+}
