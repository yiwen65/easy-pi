+#[tokio::test]
+async fn controlled_drag_dependency_sdk_unproven_producer_keeps_close_quarantined() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let host = host();
+    let source = endpoint(&host, None, 7);
+    let destination = endpoint(&host, None, 8);
+    let op = source.new_operation().unwrap();
+    op.bind_drag_destination(destination.clone()).unwrap();
+    op.core.begin().unwrap();
+    drop(op); // Deliberately lose the synthetic producer; no terminal invention.
+    assert!(matches!(
+        destination.close().await,
+        Err(ComputerError::Quarantined)
+    ));
+    assert!(matches!(
+        host.close().await,
+        Err(ComputerError::Quarantined)
+    ));
+}
