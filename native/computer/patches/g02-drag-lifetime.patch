+#[tokio::test]
+async fn controlled_drag_dependency_sdk_destination_close_waits_owned_work_and_snapshot_drain() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let host = host();
+    let source = endpoint(&host, None, 7);
+    let destination = endpoint(&host, None, 8);
+    let op = source.clone().new_operation().unwrap();
+    op.bind_drag_destination(destination.clone()).unwrap();
+    let retired = Arc::new(AtomicUsize::new(0));
+    let count = retired.clone();
+    destination
+        .gate
+        .snapshots
+        .replace(move || {
+            count.fetch_add(1, Ordering::SeqCst);
+        })
+        .unwrap();
+    op.core.begin().unwrap();
+    let work = op.core.track_callback().unwrap();
+    op.core.primary(true, || ()).unwrap();
+    op.core.finish();
+    // The production close snapshot includes this op even though its source is
+    // outside the destination subtree. Terminal is pending while work exists.
+    assert_eq!(destination.dependent_operations().unwrap().len(), 1);
+    let mut terminal = Box::pin(op.core.terminal());
+    assert!(terminal
+        .as_mut()
+        .poll(&mut Context::from_waker(Waker::noop()))
+        .is_pending());
+    let mut closer = Box::pin(destination.clone().close());
+    assert!(closer
+        .as_mut()
+        .poll(&mut Context::from_waker(Waker::noop()))
+        .is_pending());
+    assert!(op.core.is_cancelled());
+    assert!(!destination.closed.load(Ordering::Acquire));
+    assert_eq!(retired.load(Ordering::SeqCst), 0);
+    // Dropping this foreign waiter does not own the independent close producer.
+    drop(closer);
+    drop(work);
+    let receipt = terminal.await.unwrap();
+    assert!(receipt.cancelled && receipt.input_committed);
+    destination.close().await.unwrap();
+    assert_eq!(retired.load(Ordering::SeqCst), 1);
+    assert!(source.native.computer_authority_live());
+    let next = source.new_operation().unwrap();
+    next.cancel();
+    next.terminal().await.unwrap();
+    host.close().await.unwrap();
+}
