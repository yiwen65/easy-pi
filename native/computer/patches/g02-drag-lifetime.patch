+#[tokio::test]
+async fn controlled_drag_dependency_sdk_rejects_foreign_and_keeps_single_window_scope() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let host = host();
+    let foreign = super::host();
+    let source = endpoint(&host, None, 7);
+    let destination = endpoint(&host, None, 8);
+    let op = source.clone().new_operation().unwrap();
+    for invalid in [
+        endpoint(&foreign, None, 9),
+        source.clone(),
+        session_target(&host, None, 9, None),
+        host.clone().open_discovery_session(None).unwrap(),
+    ] {
+        assert!(matches!(
+            op.bind_drag_destination(invalid),
+            Err(ComputerError::Refused { .. })
+        ));
+    }
+    op.bind_drag_destination(destination.clone()).unwrap();
+    assert!(op.bind_drag_destination(destination.clone()).is_err());
+    assert_eq!(op.core.session.native_window().unwrap().window_id, 7);
+    assert!(!op.core.session.descends_from(&destination.gate));
+    assert!(destination
+        .dependent_operations()
+        .unwrap()
+        .iter()
+        .any(|candidate| Arc::ptr_eq(candidate, &op.core)));
+    op.cancel();
+    op.terminal().await.unwrap();
+    host.close().await.unwrap();
+    foreign.close().await.unwrap();
+}
