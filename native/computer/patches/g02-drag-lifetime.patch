@@ -0,0 +1,37 @@
+//! Rust-only lifetime attachment. No new foreign entry or input route.
+use super::{refused, ComputerError, ComputerOperation, ComputerSession};
+use std::sync::Arc;
+
+impl ComputerOperation {
+    /// Attach a genuine destination before launch. Neither this method nor the
+    /// core dependency changes either endpoint's single-window authority.
+    pub fn bind_drag_destination(
+        &self,
+        destination: Arc<ComputerSession>,
+    ) -> Result<(), ComputerError> {
+        if !Arc::ptr_eq(&self.session.host, &destination.host) {
+            return Err(refused("foreign_drag_destination"));
+        }
+        // Registry -> gate/state ordering matches close's dependency snapshot.
+        // If close revoked first, core rejects; otherwise close observes this
+        // dependency and must await the already-registered operation.
+        let _operations = self
+            .session
+            .host
+            .operations
+            .lock()
+            .map_err(|_| self.session.host.quarantine())?;
+        let mut retained = self
+            .drag_destination
+            .lock()
+            .map_err(|_| self.session.host.quarantine())?;
+        if retained.is_some() {
+            return Err(refused("drag_destination_already_bound_or_started"));
+        }
+        self.core
+            .bind_drag_destination(destination.gate.clone())
+            .map_err(refused)?;
+        *retained = Some(destination);
+        Ok(())
+    }
+}
