+#[test]
+fn controlled_browser_page_selected_state_preserves_false_without_inventing_values() {
+    for role in ["tab", "option"] {
+        for selected in [
+            json!(true),
+            json!(false),
+            json!(null),
+            json!("true"),
+            json!(0),
+        ] {
+            let mut raw = tree();
+            raw["nodes"][1]["role"]["value"] = json!(role);
+            raw["nodes"][1]["properties"] = json!([{"name":"selected","value":{"value":selected}}]);
+            let (rows, _) = ax_snapshot(&raw, &frame(), 512, 32).unwrap();
+            assert_eq!(rows[1]["selected"].as_bool(), selected.as_bool());
+            assert_eq!(
+                rows[1]["value"], "Ada",
+                "selection is not a value postcondition"
+            );
+            raw["nodes"][1]["ignored"] = json!(true);
+            assert!(ax_snapshot(&raw, &frame(), 512, 32).unwrap().0[1]["selected"].is_null());
+            raw["nodes"][1]["ignored"] = json!(false);
+            raw["nodes"][1]["properties"]
+                .as_array_mut()
+                .unwrap()
+                .push(json!({"name":"protected","value":{"value":true}}));
+            assert!(ax_snapshot(&raw, &frame(), 512, 32).unwrap().0[1]["selected"].is_null());
+        }
+    }
+    assert!(ax_snapshot(&tree(), &frame(), 512, 32).unwrap().0[1]["selected"].is_null());
+}
