+#[test]
+fn controlled_browser_preflight_unreadable_catalog_has_no_creation_effect() {
+    for code in ["image_path_unavailable", "image_catalog_unavailable", "cancelled"] {
+        let mut created = false;
+        assert_eq!(with_image_preflight(|| Err(code), || {
+            created = true;
+            Ok(())
+        }), Err(code));
+        assert!(!created);
+    }
+}
+
+#[test]
+fn controlled_browser_preflight_transient_read_retries_without_replaying_creation() {
+    let mut observations = [Err("image_catalog_changed"), Ok(true)].into_iter();
+    let mut creates = 0;
+    assert_eq!(with_image_preflight(|| observations.next().unwrap(), || {
+        creates += 1;
+        Err::<(), _>("original_create_failure")
+    }), Err("original_create_failure"));
+    assert_eq!(creates, 1);
+    assert!(observations.next().is_none());
+}
