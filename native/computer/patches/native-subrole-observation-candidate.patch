 use super::*;
 
+#[test]
+fn controlled_general_observation_preserves_secure_subrole_without_a_value() {
+    let tree = Scan {
+        rows: vec![Row {
+            element: 1usize, depth: 0, parent: None, web: true,
+            data: Data { role: "AXTextField".into(),
+                subrole: Some("AXSecureTextField".into()), enabled: Some(true),
+                ..Default::default() },
+        }],
+        truncated: false, failure: None,
+    };
+    let rows = tree.general_elements(1);
+    assert_eq!(rows[0]["subrole"], "AXSecureTextField");
+    assert!(rows[0].get("value").is_none());
+    assert!(!tree.rows[0].data.general_fillable());
+    assert!(rows[0].get("element_token").is_some());
+}
