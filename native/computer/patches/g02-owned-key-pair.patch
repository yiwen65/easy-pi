+#[test]
+fn controlled_key_pair_unwind_consumes_matching_obligation() {
+    for panic_kind in [1, 2] {
+        let (gate, _, op) = fixture(3);
+        let records = RefCell::new(Vec::new());
+        let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _work = op.track().unwrap();
+            sequence(
+                Some(&op),
+                42,
+                || 0,
+                |record| {
+                    records.borrow_mut().push(record[8]);
+                    assert_ne!(record[8], panic_kind, "native callback panic");
+                    0
+                },
+                || true,
+            )
+        }));
+        assert_eq!(outcome.is_err(), panic_kind == 1);
+        if let Ok(result) = outcome {
+            assert!(!result);
+        }
+        assert_eq!(*records.borrow(), vec![1, 2]);
+        assert!(gate.is_quarantined());
+        op.finish();
+        assert!(!op.is_proven_terminal());
+    }
+}
