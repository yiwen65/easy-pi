+#[test]
+fn controlled_key_pair_normal_and_exhausted_budget_complete_once() {
+    for limit in [2, 3] {
+        let (gate, _, op) = fixture(limit);
+        let records = RefCell::new(Vec::new());
+        assert!(sequence(
+            Some(&op),
+            42,
+            || 0,
+            |record| {
+                records.borrow_mut().push(*record);
+                0
+            },
+            || true
+        ));
+        assert_eq!(
+            *records.borrow(),
+            vec![make_key_window_record(42, 1), make_key_window_record(42, 2)]
+        );
+        assert_eq!(op.segment_action_inputs(), 2);
+        if limit == 2 {
+            assert!(op.segment_primary(|| panic!("budget exhausted")).is_err());
+        }
+        assert!(!gate.is_quarantined());
+        op.finish();
+        assert!(op.is_proven_terminal());
+    }
+}
