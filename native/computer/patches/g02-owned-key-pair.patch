+#[test]
+fn controlled_key_pair_stale_identity_never_retargets() {
+    use crate::windows::WindowOwner;
+    for (stamp, owner) in [
+        (None, WindowOwner::SamePid),
+        (Some((9, 9)), WindowOwner::SamePid),
+        (Some((1, 2)), WindowOwner::Unknown),
+        (
+            Some((1, 2)),
+            WindowOwner::ForeignPid {
+                owner_pid: 202,
+                owner_app_name: "private mock".into(),
+            },
+        ),
+    ] {
+        let (gate, _, op) = fixture(3);
+        let target = op.session.native_window().unwrap();
+        let entered = Cell::new(false);
+        let records = RefCell::new(Vec::new());
+        assert!(!sequence(
+            Some(&op),
+            42,
+            || 0,
+            |record| {
+                entered.set(true);
+                records.borrow_mut().push(*record);
+                0
+            },
+            || !entered.get() || same_identity(target, stamp, owner.clone())
+        ));
+        assert_eq!(*records.borrow(), vec![make_key_window_record(42, 1)]);
+        assert!(gate.is_quarantined());
+        op.finish();
+        assert!(!op.is_proven_terminal());
+    }
+}
