+#[test]
+fn uncontrolled_key_pair_retains_native_failure_early_return() {
+    for failed in [0, 1, 2, 3] {
+        let records = RefCell::new(Vec::new());
+        let result = sequence(
+            None,
+            42,
+            || if failed == 0 { -1 } else { 0 },
+            |record| {
+                records.borrow_mut().push(record[8]);
+                if failed == record[8] {
+                    -1
+                } else {
+                    0
+                }
+            },
+            || panic!("uncontrolled route must not read identity"),
+        );
+        assert_eq!(result, failed == 3);
+        assert_eq!(
+            *records.borrow(),
+            match failed {
+                0 => vec![],
+                1 => vec![1],
+                _ => vec![1, 2],
+            }
+        );
+    }
+}
