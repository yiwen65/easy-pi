+#[test]
+fn controlled_key_pair_native_failures_quarantine_without_retry() {
+    for failed in [1, 2] {
+        let (gate, _, op) = fixture(3);
+        let records = RefCell::new(Vec::new());
+        assert!(!sequence(
+            Some(&op),
+            42,
+            || 0,
+            |record| {
+                records.borrow_mut().push(record[8]);
+                if failed == record[8] {
+                    -1
+                } else {
+                    0
+                }
+            },
+            || true
+        ));
+        assert_eq!(*records.borrow(), vec![1, 2]);
+        assert!(gate.is_quarantined());
+        assert!(op.segment_primary(|| panic!("after failure")).is_err());
+        op.finish();
+        assert!(!op.is_proven_terminal());
+    }
+}
