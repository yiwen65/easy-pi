+#[tokio::test]
+async fn controlled_key_pair_blocked_cleanup_outlives_dropped_waiter() {
+    let (gate, _, op) = fixture(3);
+    let (entered_tx, entered_rx) = tokio::sync::oneshot::channel();
+    let entered_tx = RefCell::new(Some(entered_tx));
+    let (resume_tx, resume_rx) = mpsc::channel();
+    let records = Arc::new(Mutex::new(Vec::new()));
+    let captured = records.clone();
+    let worker = op.clone();
+    let waiter = tokio::spawn(async move {
+        let native = worker.clone();
+        worker
+            .blocking(move || {
+                sequence(
+                    Some(&native),
+                    42,
+                    || 0,
+                    |record| {
+                        captured.lock().unwrap().push(record[8]);
+                        if record[8] == 2 {
+                            entered_tx.borrow_mut().take().unwrap().send(()).unwrap();
+                            resume_rx.recv().unwrap();
+                        }
+                        0
+                    },
+                    || true,
+                )
+            })
+            .await
+    });
+    entered_rx.await.unwrap();
+    op.cancel();
+    op.finish();
+    let mut terminal = Box::pin(op.terminal());
+    assert!(matches!(
+        terminal
+            .as_mut()
+            .poll(&mut Context::from_waker(Waker::noop())),
+        Poll::Pending
+    ));
+    drop(terminal);
+    waiter.abort();
+    assert!(waiter.await.unwrap_err().is_cancelled());
+    assert!(!op.is_proven_terminal());
+    let mut next_waiter = Box::pin(op.terminal());
+    assert!(matches!(
+        next_waiter
+            .as_mut()
+            .poll(&mut Context::from_waker(Waker::noop())),
+        Poll::Pending
+    ));
+    resume_tx.send(()).unwrap();
+    let terminal = next_waiter.await.unwrap();
+    assert!(terminal.cancelled && terminal.input_committed);
+    assert_eq!(*records.lock().unwrap(), vec![1, 2]);
+    assert!(!gate.is_quarantined());
+}
