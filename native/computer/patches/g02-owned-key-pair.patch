+#[test]
+fn controlled_key_pair_cancel_after_first_entry() {
+    interrupted(false);
+}
+
+#[test]
+fn controlled_key_pair_ancestor_revoke_after_first_entry() {
+    interrupted(true);
+}
+
+fn interrupted(revoke: bool) {
+    let (_, parent, op) = fixture(3);
+    let (entered_tx, entered_rx) = mpsc::channel();
+    let (resume_tx, resume_rx) = mpsc::channel();
+    let records = Arc::new(Mutex::new(Vec::new()));
+    let captured = records.clone();
+    let worker = op.clone();
+    let work = op.track().unwrap();
+    let thread = std::thread::spawn(move || {
+        let _work = work;
+        sequence(
+            Some(&worker),
+            42,
+            || 0,
+            |record| {
+                captured.lock().unwrap().push(record[8]);
+                if record[8] == 1 {
+                    entered_tx.send(()).unwrap();
+                    resume_rx.recv().unwrap();
+                }
+                0
+            },
+            || true,
+        )
+    });
+    entered_rx.recv().unwrap();
+    if revoke {
+        parent.revoke();
+    } else {
+        op.cancel();
+    }
+    resume_tx.send(()).unwrap();
+    let result = thread.join().unwrap();
+    op.finish();
+    assert!(op.segment_primary(|| panic!("later primary")).is_err());
+    assert_eq!(
+        *records.lock().unwrap(),
+        vec![1, 2],
+        "admitted first record must be matched; sequence={result}"
+    );
+    assert!(op.is_proven_terminal());
+    assert_eq!(op.segment_action_inputs(), 2);
+}
+
+#[test]
+fn controlled_key_pair_pre_first_rejection_never_arms() {
+    for before_front in [true, false] {
+        let (gate, _, op) = fixture(3);
+        if before_front {
+            op.cancel();
+        }
+        assert!(!sequence(
+            Some(&op),
+            42,
+            || {
+                op.cancel();
+                0
+            },
+            |_| panic!("no record may enter"),
+            || true
+        ));
+        assert_eq!(op.segment_action_inputs(), u32::from(!before_front));
+        assert!(!gate.is_quarantined());
+        op.finish();
+        assert!(op.is_proven_terminal());
+    }
+}
