+use super::*;
+use cua_driver_core::controlled::{Gate, Session};
+use std::cell::{Cell, RefCell};
+use std::future::Future;
+use std::sync::{mpsc, Arc, Mutex};
+use std::task::{Context, Poll, Waker};
+use std::time::Duration;
+
+fn fixture(limit: u32) -> (Arc<Gate>, Arc<Session>, Arc<Operation>) {
+    fixture_timeout(limit, Duration::from_secs(30))
+}
+
+fn fixture_timeout(limit: u32, timeout: Duration) -> (Arc<Gate>, Arc<Session>, Arc<Operation>) {
+    let gate = Gate::new();
+    let parent = gate
+        .session(None, Arc::new(|| true), 101, 42, Some((1, 2)))
+        .unwrap();
+    let child = gate
+        .session(
+            Some(parent.clone()),
+            Arc::new(|| true),
+            101,
+            42,
+            Some((1, 2)),
+        )
+        .unwrap();
+    let op = child.new_operation().unwrap();
+    op.configure_segment(vec![limit], timeout).unwrap();
+    op.begin().unwrap();
+    op.begin_segment_action(0).unwrap();
+    (gate, parent, op)
+}
