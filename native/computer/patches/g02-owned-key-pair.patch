+#[test]
+fn controlled_key_pair_deadline_after_first_entry_still_completes() {
+    let (_, _, op) = fixture_timeout(3, Duration::from_secs(1));
+    let (entered_tx, entered_rx) = mpsc::channel();
+    let (resume_tx, resume_rx) = mpsc::channel();
+    let records = Arc::new(Mutex::new(Vec::new()));
+    let captured = records.clone();
+    let worker = op.clone();
+    let work = op.track().unwrap();
+    let thread = std::thread::spawn(move || {
+        let _work = work;
+        sequence(
+            Some(&worker),
+            42,
+            || 0,
+            |record| {
+                captured.lock().unwrap().push(record[8]);
+                if record[8] == 1 {
+                    entered_tx.send(()).unwrap();
+                    resume_rx.recv().unwrap();
+                }
+                0
+            },
+            || true,
+        )
+    });
+    entered_rx.recv().unwrap();
+    // Observe the real configured deadline, never sleep to schedule a race.
+    while !op.deadline_expired() {
+        std::thread::yield_now();
+    }
+    assert!(op.is_cancelled());
+    assert!(!op.is_proven_terminal());
+    resume_tx.send(()).unwrap();
+    assert!(thread.join().unwrap());
+    assert!(op.segment_primary(|| panic!("after deadline")).is_err());
+    assert_eq!(*records.lock().unwrap(), vec![1, 2]);
+    op.finish();
+    assert!(op.is_proven_terminal());
+}
