+#[test]
+fn controlled_browser_page_identical_duplicate_ax_records_keep_one_identity() {
+    let original = tree();
+    let expected = ax_snapshot(&original, &frame(), 512, 32).unwrap();
+    let mut repeated = original.clone();
+    repeated["nodes"]
+        .as_array_mut()
+        .unwrap()
+        .extend(original["nodes"].as_array().unwrap().clone());
+    let (rows, snapshot) = ax_snapshot(&repeated, &frame(), 512, 32).unwrap();
+    assert_eq!(rows, expected.0);
+    assert_eq!(snapshot.nodes.len(), 2);
+    assert_eq!(snapshot.nodes[1].backend, Some(9));
+    assert!(snapshot.nodes[1].fillable);
+    assert!(
+        matches!(
+            ax_snapshot(&repeated, &frame(), 2, 32),
+            Err("browser_observation_bounds")
+        ),
+        "raw record count is still bounded before normalization"
+    );
+    let mut oversized = tree();
+    oversized["nodes"][1]["value"]["value"] = json!("x".repeat(16 * 1024));
+    let record = oversized["nodes"][1].clone();
+    oversized["nodes"]
+        .as_array_mut()
+        .unwrap()
+        .extend(vec![record; 3]);
+    assert!(
+        matches!(
+            ax_snapshot(&oversized, &frame(), 512, 32),
+            Err("browser_observation_bounds")
+        ),
+        "duplicates still consume the text budget"
+    );
+}
