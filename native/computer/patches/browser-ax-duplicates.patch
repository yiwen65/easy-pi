+#[test]
+fn controlled_browser_page_duplicate_list_marker_capture_is_observable() {
+    // Minimized from Chrome's repeated records for a visible unordered-list marker.
+    let inline = json!({"nodeId":"-1000000003","ignored":false,
+        "role":{"type":"internalRole","value":"InlineTextBox"},
+        "chromeRole":{"type":"internalRole","value":101},
+        "name":{"type":"computedString","value":"• "},
+        "properties":[],"parentId":"2","childIds":[]});
+    let mut raw = tree();
+    raw["nodes"][1] = json!({"nodeId":"2","ignored":false,"role":{"value":"StaticText"},"name":{"value":"• "},"childIds":["-1000000003"]});
+    raw["nodes"]
+        .as_array_mut()
+        .unwrap()
+        .extend([inline.clone(), inline]);
+    let (rows, snapshot) = ax_snapshot(&raw, &frame(), 512, 32).unwrap();
+    assert_eq!(rows.len(), 3);
+    assert_eq!(rows[2]["label"], "• ");
+    assert_eq!(rows[2]["parent_index"], 1);
+    assert_eq!(snapshot.nodes[2].backend, None);
+    assert!(!snapshot.nodes[2].pressable && !snapshot.nodes[2].fillable);
+}
+
+#[test]
+fn controlled_browser_page_duplicate_conflicts_and_invalid_graphs_still_refuse() {
+    for (key, value) in [
+        ("name", json!({"value":"Other"})),
+        ("value", json!({"value":"Changed"})),
+        ("role", json!({"value":"button"})),
+        ("backendDOMNodeId", json!(10)),
+        ("ignored", json!(true)),
+        ("parentId", json!("unexpected")),
+        ("properties", json!([])),
+        ("frameId", json!("foreign")),
+    ] {
+        let mut raw = tree();
+        let mut conflict = raw["nodes"][1].clone();
+        conflict[key] = value;
+        raw["nodes"].as_array_mut().unwrap().push(conflict);
+        assert!(
+            matches!(
+                ax_snapshot(&raw, &frame(), 512, 32),
+                Err("browser_observation_unproved")
+            ),
+            "conflicting {key}"
+        );
+    }
+    let mut multiple_parents = tree();
+    multiple_parents["nodes"][0]["childIds"] = json!(["2", "2"]);
+    let duplicate = multiple_parents["nodes"][1].clone();
+    multiple_parents["nodes"]
+        .as_array_mut()
+        .unwrap()
+        .push(duplicate);
+    assert!(matches!(
+        ax_snapshot(&multiple_parents, &frame(), 512, 32),
+        Err("browser_observation_unproved")
+    ));
+}
