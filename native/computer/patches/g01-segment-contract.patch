+/// Pure protocol validation also exercises the genuine FFI codecs without
+/// acquiring a desktop owner. Execution calls the same Rust validator directly;
+/// the product hot path does not add a separate validation round-trip.
+#[uniffi::export]
+pub fn validate_computer_segment(segment: segment::ComputerSegment) -> Result<(), ComputerError> {
+    segment::validate(&segment).map_err(refused)
+}
