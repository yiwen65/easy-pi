+#[test]
+fn controlled_browser_page_generic_control_keeps_visible_direct_text_identity() {
+    let raw = json!({"nodes":[
+        {"nodeId":"1","ignored":false,"role":{"value":"RootWebArea"},"childIds":["2"],"frameId":"frame"},
+        {"nodeId":"2","ignored":false,"role":{"value":"generic"},"name":{"value":""},"backendDOMNodeId":20,"childIds":["3"]},
+        {"nodeId":"3","ignored":false,"role":{"value":"StaticText"},"name":{"value":"Tempor"},"backendDOMNodeId":21}
+    ]});
+    let (rows, snapshot) = ax_snapshot(&raw, &frame(), 512, 32).unwrap();
+    assert_eq!(rows[1]["label"], "Tempor");
+    assert_eq!(snapshot.nodes[1].backend, Some(20));
+    assert!(
+        !snapshot.nodes[1].pressable,
+        "AX text alone is not input authority"
+    );
+    assert!(snapshot.nodes[1].listener_required);
+    for tag in ["INPUT", "TEXTAREA", "IFRAME"] {
+        let mut node = snapshot.nodes[1].clone();
+        describe_input(
+            &json!({"node":{"backendNodeId":20,"nodeName":tag,"attributes":[]}}),
+            &mut node,
+        )
+        .unwrap();
+        assert!(!node.listener_required && !node.pressable);
+    }
+    for attrs in [json!(["disabled", ""]), json!(["type", "password"])] {
+        let mut node = snapshot.nodes[1].clone();
+        describe_input(
+            &json!({"node":{"backendNodeId":20,"nodeName":"SPAN","attributes":attrs}}),
+            &mut node,
+        )
+        .unwrap();
+        assert!(!node.listener_required && !node.pressable);
+    }
+    let mut hidden = raw;
+    hidden["nodes"][2]["ignored"] = json!(true);
+    assert_eq!(
+        ax_snapshot(&hidden, &frame(), 512, 32).unwrap().0[1]["label"],
+        ""
+    );
 }
 
 #[test]
+fn controlled_browser_page_click_listener_proof_is_bounded_and_exact() {
+    assert!(has_direct_click_listener(
+        &json!({"listeners":[{"type":"click","backendNodeId":20}]}),
+        20
+    )
+    .unwrap());
+    for raw in [
+        json!({"listeners":[]}),
+        json!({"listeners":[{"type":"keydown","backendNodeId":20}]}),
+        json!({"listeners":[{"type":"click","backendNodeId":21}]}),
+        json!({"listeners":[{"type":"click"}]}),
+    ] {
+        assert!(!has_direct_click_listener(&raw, 20).unwrap());
+    }
+    assert!(has_direct_click_listener(&json!({}), 20).is_err());
+    assert!(has_direct_click_listener(&json!({"listeners":vec![json!({});65]}), 20).is_err());
+}
