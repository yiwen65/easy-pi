 #[test]
+fn controlled_browser_page_options_require_metadata_and_keep_select_context() {
+    let raw = json!({"nodes":[
+        {"nodeId":"1","ignored":false,"role":{"value":"RootWebArea"},"childIds":["2"],"frameId":"frame"},
+        {"nodeId":"2","ignored":false,"role":{"value":"combobox"},"name":{"value":"Plan"},"backendDOMNodeId":20,"childIds":["3"]},
+        {"nodeId":"3","ignored":false,"role":{"value":"option"},"name":{"value":"Pro"},"backendDOMNodeId":21}
+    ]});
+    let (rows, snapshot) = ax_snapshot(&raw, &frame(), 512, 32).unwrap();
+    assert!(snapshot.nodes[2].needs_metadata);
+    assert!(!snapshot.nodes[2].fillable && !snapshot.nodes[2].pressable);
+    assert_eq!(rows[2]["value_description"], "Plan");
+    let mut option = snapshot.nodes[2].clone();
+    describe_input(
+        &json!({"node":{"backendNodeId":21,"nodeName":"OPTION","attributes":["value","pro"]}}),
+        &mut option,
+    )
+    .unwrap();
+    assert!(option.selectable);
+    assert_eq!(option.option_value.as_deref(), Some("pro"));
+    assert_eq!(option.select_parent, Some(20));
+    for name in ["DIV", "INPUT"] {
+        let mut custom = snapshot.nodes[2].clone();
+        describe_input(
+            &json!({"node":{"backendNodeId":21,"nodeName":name,"attributes":[]}}),
+            &mut custom,
+        )
+        .unwrap();
+        assert!(!custom.selectable);
+    }
+    for attrs in [json!(["disabled", ""]), json!(["multiple", ""])] {
+        assert!(!describe_select(
+            &json!({"node":{"backendNodeId":20,"nodeName":"SELECT","attributes":attrs}}),
+            20
+        )
+        .unwrap());
+    }
+    assert!(describe_select(
+        &json!({"node":{"backendNodeId":20,"nodeName":"SELECT","attributes":[]}}),
+        20
+    )
+    .unwrap());
+    assert!(!describe_select(
+        &json!({"node":{"backendNodeId":20,"nodeName":"DIV","attributes":[]}}),
+        20
+    )
+    .unwrap());
+}
