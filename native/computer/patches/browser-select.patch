+fn describe_select(raw: &Value, backend: i64) -> Result<bool, &'static str> {
+    let node = &raw["node"];
+    if node["backendNodeId"].as_i64() != Some(backend) {
+        return Err("browser_node_stale");
+    }
+    let attributes = node["attributes"]
+        .as_array()
+        .ok_or("browser_node_unproved")?;
+    if attributes.len() > 128
+        || attributes.len() % 2 != 0
+        || !attributes
+            .iter()
+            .all(|v| v.as_str().is_some_and(|v| v.len() <= 16 * 1024))
+    {
+        return Err("browser_node_unproved");
+    }
+    Ok(node["nodeName"] == "SELECT"
+        && !attributes
+            .chunks_exact(2)
+            .any(|pair| matches!(pair[0].as_str(), Some("disabled" | "multiple"))))
+}
