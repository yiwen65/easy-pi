@@ -0,0 +1,298 @@
+use super::*;
+use cua_driver_contract::computer_segment::*;
+use std::cell::{Cell, RefCell};
+
+fn image_actions() -> Vec<ComputerInput> {
+    let point = ComputerPoint {
+        image_ref: "image:1".into(),
+        x: 10.0,
+        y: 20.0,
+    };
+    vec![
+        ComputerInput::PointerMove {
+            point: point.clone(),
+        },
+        ComputerInput::ButtonDown {
+            button: ComputerMouseButton::Left,
+        },
+        ComputerInput::ButtonUp {
+            button: ComputerMouseButton::Left,
+        },
+        ComputerInput::Click {
+            point: point.clone(),
+            button: ComputerMouseButton::Left,
+            count: 1,
+        },
+        ComputerInput::Scroll {
+            point: point.clone(),
+            delta_x: 0.0,
+            delta_y: 1.0,
+            unit: ComputerScrollUnit::Line,
+        },
+        ComputerInput::Drag {
+            from: point.clone(),
+            to: point,
+            duration_ms: 32,
+        },
+    ]
+}
+
+fn structural_actions() -> Vec<ComputerInput> {
+    let target = ComputerElementAddress::Reference {
+        reference: "observation:1".into(),
+    };
+    vec![
+        ComputerInput::Focus {
+            target: target.clone(),
+        },
+        ComputerInput::Fill {
+            target,
+            text: "replacement".into(),
+        },
+        ComputerInput::TypeText {
+            text: "insert".into(),
+        },
+        ComputerInput::Key {
+            key: "a".into(),
+            modifiers: vec![],
+        },
+        ComputerInput::KeyDown {
+            key: "shift".into(),
+        },
+        ComputerInput::KeyUp {
+            key: "shift".into(),
+        },
+        ComputerInput::Window {
+            action: ComputerWindowAction::Activate,
+        },
+        ComputerInput::Window {
+            action: ComputerWindowAction::Minimize,
+        },
+        ComputerInput::Window {
+            action: ComputerWindowAction::Restore,
+        },
+        ComputerInput::Window {
+            action: ComputerWindowAction::Close,
+        },
+        ComputerInput::Window {
+            action: ComputerWindowAction::SetBounds {
+                x: 1.0,
+                y: 2.0,
+                width: 100.0,
+                height: 100.0,
+            },
+        },
+    ]
+}
+
+#[test]
+fn controlled_image_readiness_failure_does_not_block_image_input() {
+    for action in image_actions() {
+        let prepares = Cell::new(0);
+        let inputs = Cell::new(0);
+        let result = permission(|| Ok(true)).and_then(|()| {
+            before_action(&action, || {
+                prepares.set(prepares.get() + 1);
+                Err("accessibility_readiness_unknown")
+            })?;
+            inputs.set(inputs.get() + 1);
+            Ok(())
+        });
+        assert_eq!(
+            (result, prepares.get(), inputs.get()),
+            (Ok(()), 0, 1),
+            "{action:?}"
+        );
+    }
+}
+
+#[test]
+fn controlled_image_readiness_structure_still_requires_preparation() {
+    for action in structural_actions() {
+        let prepares = Cell::new(0);
+        let inputs = Cell::new(0);
+        let result = before_action(&action, || {
+            prepares.set(prepares.get() + 1);
+            Err("accessibility_readiness_unknown")
+        })
+        .map(|()| inputs.set(inputs.get() + 1));
+        assert_eq!(
+            (result, prepares.get(), inputs.get()),
+            (Err("accessibility_readiness_unknown"), 1, 0),
+            "{action:?}"
+        );
+    }
+}
+
+#[test]
+fn controlled_image_readiness_mixed_sequence_prepares_at_first_structural_consumer() {
+    let mut sequence = image_actions();
+    sequence.push(ComputerInput::TypeText {
+        text: "insert after pointer".into(),
+    });
+    sequence.extend(image_actions());
+    let trace = RefCell::new(Vec::new());
+    let result = sequence.iter().enumerate().try_for_each(|(index, action)| {
+        before_action(action, || {
+            trace.borrow_mut().push((index, "prepare"));
+            Err("accessibility_readiness_unknown")
+        })?;
+        trace.borrow_mut().push((index, "input"));
+        Ok(())
+    });
+    assert_eq!(result, Err("accessibility_readiness_unknown"));
+    assert_eq!(
+        *trace.borrow(),
+        vec![
+            (0, "input"),
+            (1, "input"),
+            (2, "input"),
+            (3, "input"),
+            (4, "input"),
+            (5, "input"),
+            (6, "prepare")
+        ]
+    );
+}
+
+#[test]
+fn controlled_image_readiness_os_denial_and_unknown_stop_before_prepare_or_input() {
+    for trust in [
+        Ok(false),
+        Err("controlled_cancelled"),
+        Err("controlled_quarantined"),
+    ] {
+        for action in image_actions().into_iter().chain(structural_actions()) {
+            let result: Result<(), &'static str> = permission(|| trust).and_then(|()| {
+                before_action(&action, || panic!("permission must precede preparation"))?;
+                panic!("permission must precede input")
+            });
+            assert_eq!(
+                result,
+                Err(trust.err().unwrap_or("accessibility_permission_denied"))
+            );
+        }
+    }
+}
+
+#[test]
+fn controlled_image_readiness_skip_never_creates_cached_success() {
+    let prepared = Cell::new(false);
+    let checks = Cell::new(0);
+    let prepares = Cell::new(0);
+    let prepare = || {
+        checks.set(checks.get() + 1);
+        if !prepared.get() {
+            prepares.set(prepares.get() + 1);
+            prepared.set(true);
+        }
+        Ok(())
+    };
+    for action in image_actions() {
+        assert_eq!(before_action(&action, prepare), Ok(()));
+    }
+    assert_eq!(
+        (checks.get(), prepares.get(), prepared.get()),
+        (0, 0, false)
+    );
+    for action in structural_actions() {
+        assert_eq!(before_action(&action, prepare), Ok(()));
+    }
+    assert_eq!(
+        (checks.get(), prepares.get(), prepared.get()),
+        (11, 1, true)
+    );
+}
+
+#[test]
+fn controlled_image_readiness_failed_structure_is_not_retried_or_cached() {
+    let prepares = Cell::new(0);
+    for code in [
+        "controlled_target_stale",
+        "controlled_cancelled",
+        "accessibility_readiness_unknown",
+    ] {
+        let action = ComputerInput::TypeText {
+            text: "insert".into(),
+        };
+        assert_eq!(
+            before_action(&action, || {
+                prepares.set(prepares.get() + 1);
+                Err(code)
+            }),
+            Err(code)
+        );
+    }
+    assert_eq!(prepares.get(), 3);
+}
+
+#[test]
+fn controlled_image_readiness_structural_condition_prepares_after_image_prefix() {
+    for condition in [
+        ComputerPostcondition::Present {
+            locator: ComputerLocator {
+                role: Some("AXButton".into()),
+                label: None,
+                identifier: None,
+                within: None,
+            },
+            present: true,
+        },
+        ComputerPostcondition::Value {
+            target: ComputerElementAddress::Reference {
+                reference: "observation:1".into(),
+            },
+            value: "expected".into(),
+        },
+    ] {
+        for action in image_actions() {
+            assert_eq!(
+                before_action(&action, || panic!("image must not prepare")),
+                Ok(())
+            );
+        }
+        let reads = Cell::new(0);
+        let result = before_condition(&condition, || Err("accessibility_readiness_unknown"))
+            .map(|()| reads.set(reads.get() + 1));
+        assert_eq!(
+            (result, reads.get()),
+            (Err("accessibility_readiness_unknown"), 0)
+        );
+    }
+}
+
+#[test]
+fn controlled_image_readiness_visual_and_window_identity_conditions_do_not_prepare() {
+    for condition in [
+        ComputerPostcondition::Visual {
+            description: "inspect fresh image".into(),
+        },
+        ComputerPostcondition::WindowFocused,
+        ComputerPostcondition::WindowBounds {
+            x: 1.0,
+            y: 2.0,
+            width: 100.0,
+            height: 100.0,
+        },
+    ] {
+        assert_eq!(
+            before_condition(&condition, || panic!("no prepared tree consumer")),
+            Ok(())
+        );
+    }
+}
+
+#[test]
+fn controlled_image_readiness_does_not_remove_the_existing_semantic_boundary() {
+    for action in structural_actions() {
+        let semantic = matches!(
+            action,
+            ComputerInput::Focus { .. } | ComputerInput::Fill { .. } | ComputerInput::Window { .. }
+        );
+        assert_eq!(before_action(&action, || Ok(())), Ok(()));
+        assert_eq!(
+            super::super::requires_semantic_boundary(&action, true),
+            semantic
+        );
+    }
+}
