+use cua_driver_contract::computer_segment::{ComputerInput, ComputerPostcondition};
+
+pub(super) fn permission(
+    trusted: impl FnOnce() -> Result<bool, &'static str>,
+) -> Result<(), &'static str> {
+    if trusted()? {
+        Ok(())
+    } else {
+        Err("accessibility_permission_denied")
+    }
+}
+
+pub(super) fn before_action(
+    action: &ComputerInput,
+    prepare: impl FnOnce() -> Result<(), &'static str>,
+) -> Result<(), &'static str> {
+    match action {
+        // Image addressing and owned button delivery need OS trust and live
+        // target checks, but do not consume the optional prepared AX tree.
+        ComputerInput::PointerMove { .. }
+        | ComputerInput::ButtonDown { .. }
+        | ComputerInput::ButtonUp { .. }
+        | ComputerInput::Click { .. }
+        | ComputerInput::Scroll { .. }
+        | ComputerInput::Drag { .. } => Ok(()),
+        // Keyboard routing reads the focused editor; TypeText can write AX
+        // selected text. Window activation can fall back to an AX window root.
+        ComputerInput::Focus { .. }
+        | ComputerInput::Fill { .. }
+        | ComputerInput::TypeText { .. }
+        | ComputerInput::Key { .. }
+        | ComputerInput::KeyDown { .. }
+        | ComputerInput::KeyUp { .. }
+        | ComputerInput::Window { .. } => prepare(),
+    }
+}
+
+pub(super) fn before_condition(
+    condition: &ComputerPostcondition,
+    prepare: impl FnOnce() -> Result<(), &'static str>,
+) -> Result<(), &'static str> {
+    match condition {
+        // An image prefix may be followed by a structural read. Prepare only
+        // here, after owned input release, before resolving that condition.
+        ComputerPostcondition::Present { .. } | ComputerPostcondition::Value { .. } => prepare(),
+        ComputerPostcondition::Visual { .. }
+        | ComputerPostcondition::WindowFocused
+        | ComputerPostcondition::WindowBounds { .. } => Ok(()),
+    }
+}
