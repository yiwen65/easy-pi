+//! Controlled-only branches of canonical observe/click, downstream of the
+//! unchanged registry authorization. One tracked blocking owner includes focus
+//! cleanup; no old timeout, overlay, screenshot, selection or pixel fallback.
+use super::ToolState;
+use crate::ax::{bindings, cache::CachedSnapshot};
+use cua_driver_core::{controlled::Operation, protocol::ToolResult};
+use serde_json::{json, Value};
+use std::sync::Arc;
+
+fn refusal(reason: &str) -> ToolResult {
+    ToolResult::error(reason).with_structured(json!({"code": reason}))
+}
+
+fn target_matches(args: &Value, operation: &Operation) -> bool {
+    args["pid"].as_i64() == Some(i64::from(operation.session.pid))
+        && args["window_id"].as_u64() == Some(u64::from(operation.session.window_id))
+        && operation.session.process_stamp.is_some()
+        && super::computer_process_stamp(operation.session.pid) == operation.session.process_stamp
+        && operation.checkpoint().is_ok()
+}
+
+fn with_focus_cleanup(operation: &Operation, call: impl FnOnce() -> ToolResult) -> ToolResult {
+    let setup = operation.primary(false, || {
+        let prior = crate::apps::frontmost_pid();
+        let snapshot = crate::window_change_detector::WindowChangeDetector::snapshot(prior);
+        let targeted = prior
+            .filter(|pid| *pid != operation.session.pid)
+            .map(|prior| {
+                crate::focus_steal::begin_suppression(
+                    Some(operation.session.pid),
+                    prior,
+                    "pi.computer",
+                )
+            });
+        (snapshot, targeted)
+    });
+    let Ok((snapshot, targeted)) = setup else {
+        return refusal("controlled_cancelled");
+    };
+    let result = call();
+    // Same bounded post-action settle as FocusGuard. This is behavior, NOT
+    // terminal evidence. Registered callbacks, not this sleep, prove drain.
+    if targeted.is_some() {
+        std::thread::sleep(std::time::Duration::from_millis(50));
+    }
+    drop(targeted);
+    let _ = snapshot.detect();
+    if operation.wait_callbacks().is_err() {
+        return refusal("controlled_quarantined");
+    }
+    result
+}
+
+pub(super) async fn observe(
+    state: Arc<ToolState>,
+    args: Value,
+    operation: Arc<Operation>,
+) -> ToolResult {
+    if !target_matches(&args, &operation)
+        || args["include_screenshot"] != false
+        || args
+            .get("screenshot_out_file")
+            .is_some_and(|value| !value.is_null())
+    {
+        return refusal("controlled_observation_refused");
+    }
+    let max_elements = args["max_elements"]
+        .as_u64()
+        .filter(|n| (1..=512).contains(n));
+    let max_depth = args["max_depth"].as_u64().filter(|n| (1..=32).contains(n));
+    let (Some(max_elements), Some(max_depth)) = (max_elements, max_depth) else {
+        return refusal("controlled_observation_bounds");
+    };
+    operation.reset_snapshot();
+    let worker = operation.clone();
+    match operation
+        .blocking(move || {
+            if !target_matches(&args, &worker) {
+                return refusal("controlled_target_stale");
+            }
+            let pid = worker.session.pid;
+            let window_id = worker.session.window_id;
+            with_focus_cleanup(&worker, || {
+                if !matches!(
+                    crate::windows::resolve_window_owner(pid, window_id),
+                    crate::windows::WindowOwner::SamePid
+                ) {
+                    return refusal("controlled_target_stale");
+                }
+                let tree = crate::ax::tree::walk_tree_bounded(
+                    pid,
+                    Some(window_id),
+                    None,
+                    max_elements as usize,
+                    max_depth as usize,
+                );
+                // Take ownership of every retained actionable node even on refusal.
+                let payload = CachedSnapshot::from_nodes(&tree.nodes);
+                if !tree
+                    .window_scope
+                    .as_ref()
+                    .is_some_and(|scope| scope.is_matched())
+                    || !target_matches(&args, &worker)
+                {
+                    return refusal("controlled_target_stale");
+                }
+                let published = worker.primary(false, || {
+                    state
+                        .element_cache
+                        .publish(pid, u64::from(window_id), payload)
+                });
+                let Ok(id) = published else {
+                    return refusal("controlled_cancelled");
+                };
+                let retirement_cache = state.element_cache.clone();
+                if worker
+                    .remember_snapshot(id, move || {
+                        retirement_cache.remove_snapshot(pid, u64::from(window_id), id)
+                    })
+                    .is_err()
+                {
+                    // Host lane is still exclusively held; no successor can have
+                    // replaced this isolated runtime's snapshot in the meantime.
+                    state
+                        .element_cache
+                        .remove_snapshot(pid, u64::from(window_id), id);
+                    return refusal("controlled_cancelled");
+                }
+                let elements =
+                    super::get_window_state::build_elements_array_with_token(&tree.nodes, Some(id));
+                ToolResult::text(tree.tree_markdown.clone()).with_structured(json!({
+                    "pid": pid, "window_id": window_id, "snapshot_id": format!("s{id:08x}"),
+                    "tree_markdown": tree.tree_markdown, "element_count": elements.len(),
+                    "total_element_count": elements.len(), "returned_element_count": elements.len(),
+                    "elements_complete": false, "truncated": tree.truncated, "elements": elements,
+                }))
+            })
+        })
+        .await
+    {
+        Ok(result) => result,
+        Err(_) => refusal("controlled_quarantined"),
+    }
+}
+
+fn advertised_enabled_press(enabled: Option<bool>, actions: &[String]) -> bool {
+    enabled == Some(true) && actions.iter().any(|action| action == "AXPress")
+}
+
+pub(super) async fn click(
+    state: Arc<ToolState>,
+    args: Value,
+    operation: Arc<Operation>,
+) -> ToolResult {
+    if !target_matches(&args, &operation)
+        || args["action"] != "press"
+        || args["delivery_mode"] != "background"
+        || ["x", "y", "modifiers", "button", "count", "element_index"]
+            .iter()
+            .any(|key| args.get(key).is_some())
+    {
+        return refusal("controlled_click_refused");
+    }
+    let Some(token) = args["element_token"].as_str().map(str::to_owned) else {
+        return refusal("controlled_token_required");
+    };
+    if operation.consume_token(&token).is_err() {
+        return refusal("stale_session_observation");
+    }
+    // Preserve per-PID exclusion, including while focus callbacks drain. The
+    // facade's host-wide lane is fail-fast; this is the existing resource lock.
+    let mutation = super::acquire_background_mutation(operation.session.pid).await;
+    if operation.checkpoint().is_err() {
+        return refusal("controlled_cancelled");
+    }
+    let worker = operation.clone();
+    match operation
+        .blocking(move || {
+            let _mutation = mutation;
+            if !target_matches(&args, &worker) {
+                return refusal("controlled_target_stale");
+            }
+            let pid = worker.session.pid;
+            let window_id = worker.session.window_id;
+            let element = match state.element_cache.resolve_element_args(
+                pid,
+                None,
+                Some(&token),
+                None,
+                Some(u64::from(window_id)),
+                "click",
+            ) {
+                Ok(cua_driver_core::element_token::ResolvedElement::Element {
+                    element, ..
+                }) => element,
+                _ => return refusal("stale_session_observation"),
+            };
+            with_focus_cleanup(&worker, || {
+                let facts = crate::ax::exact_target::gather_background_facts(
+                    pid,
+                    window_id,
+                    Some(element.as_ptr()),
+                );
+                let decision = cua_driver_core::background_input::decide_background_input(
+                    cua_driver_core::background_input::ExactWindowTarget { pid, window_id },
+                    &facts,
+                    cua_driver_core::background_input::BackgroundAction::AxSemantic,
+                );
+                if !decision.is_execute() || !target_matches(&args, &worker) {
+                    return refusal("controlled_target_unproven");
+                }
+                let element = element.as_ptr() as bindings::AXUIElementRef;
+                let enabled = unsafe { bindings::copy_bool_attr(element, "AXEnabled") };
+                let actions = unsafe { bindings::copy_action_names(element) };
+                if !advertised_enabled_press(enabled, &actions) {
+                    return refusal("controlled_press_unavailable");
+                }
+                // The AX binding performs the atomic primary-input admission.
+                // There is no selection/coordinate/foreground fallback on error.
+                let error = unsafe { bindings::perform_action(element, "AXPress") };
+                if error != bindings::kAXErrorSuccess {
+                    return refusal("controlled_press_unconfirmed");
+                }
+                ToolResult::text("AXPress dispatched; effect unverified").with_structured(json!({
+                    "path": "ax", "verified": false, "effect": "unverifiable",
+                }))
+            })
+        })
+        .await
+    {
+        Ok(result) => result,
+        Err(_) => refusal("controlled_quarantined"),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::advertised_enabled_press;
+    #[test]
+    fn controlled_press_requires_positive_live_evidence() {
+        assert!(advertised_enabled_press(Some(true), &["AXPress".into()]));
+        assert!(!advertised_enabled_press(None, &["AXPress".into()]));
+        assert!(!advertised_enabled_press(Some(false), &["AXPress".into()]));
+        assert!(!advertised_enabled_press(Some(true), &["AXSelect".into()]));
+        assert!(!advertised_enabled_press(Some(true), &[]));
+    }
+}
