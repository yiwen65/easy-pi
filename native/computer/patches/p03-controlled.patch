+#[tokio::test]
+async fn controlled_foreign_subscribers_can_reenter_while_wake_is_pending() {
+    use std::sync::mpsc;
+    use std::task::Wake;
+
+    // The pinned N-API bridge waits for JS to finish a continuation callback.
+    // Hold that callback while the foreign thread cancels and polls the same
+    // result/terminal pair used by the generated adapter.
+    struct ForeignWake {
+        entered: mpsc::Sender<()>,
+        resume: Mutex<mpsc::Receiver<()>>,
+    }
+    impl Wake for ForeignWake {
+        fn wake(self: Arc<Self>) {
+            self.wake_by_ref();
+        }
+        fn wake_by_ref(self: &Arc<Self>) {
+            self.entered.send(()).unwrap();
+            self.resume.lock().unwrap().recv().unwrap();
+        }
+    }
+
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let host = host();
+    let operation = session(&host, None).new_operation().unwrap();
+    operation.core.begin().unwrap();
+    let (entered_tx, entered_rx) = mpsc::channel();
+    let (resume_tx, resume_rx) = mpsc::channel();
+    let waker = Waker::from(Arc::new(ForeignWake {
+        entered: entered_tx,
+        resume: Mutex::new(resume_rx),
+    }));
+    *operation.outcome.lock().unwrap() = Some(Err(refused("synthetic_no_platform_result")));
+    let terminal_operation = operation.clone();
+    let mut terminal = Box::pin(async move { terminal_operation.terminal().await });
+    let result_operation = operation.clone();
+    let mut result = Box::pin(async move { result_operation.result().await });
+    assert!(matches!(
+        terminal.as_mut().poll(&mut Context::from_waker(&waker)),
+        Poll::Pending
+    ));
+    assert!(matches!(
+        result.as_mut().poll(&mut Context::from_waker(&waker)),
+        Poll::Pending
+    ));
+    let producer_operation = operation.clone();
+    let producer = std::thread::spawn(move || producer_operation.core.finish());
+    entered_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+    let (attempting_tx, attempting_rx) = mpsc::channel();
+    let (progress_tx, progress_rx) = mpsc::channel();
+    let reentering_operation = operation.clone();
+    let reentering = std::thread::spawn(move || {
+        attempting_tx.send(()).unwrap();
+        reentering_operation.cancel();
+        let results = executor()
+            .unwrap()
+            .block_on(async { tokio::join!(terminal, result) });
+        progress_tx.send(()).unwrap();
+        results
+    });
+    attempting_rx.recv().unwrap();
+    let progressed_while_callback_blocked =
+        progress_rx.recv_timeout(Duration::from_secs(5)).is_ok();
+    // Always release both callbacks and join synthetic work before asserting.
+    // This watchdog is never a product terminal/lease decision.
+    resume_tx.send(()).unwrap();
+    resume_tx.send(()).unwrap();
+    producer.join().unwrap();
+    let (terminal, result) = reentering.join().unwrap();
+    assert!(!terminal.unwrap().cancelled);
+    assert!(
+        matches!(result, Err(ComputerError::Refused { reason }) if reason == "synthetic_no_platform_result")
+    );
+    host.close().await.unwrap();
+    assert!(
+        progressed_while_callback_blocked,
+        "foreign terminal wake held the native gate while waiting for foreign callback completion"
+    );
+}
