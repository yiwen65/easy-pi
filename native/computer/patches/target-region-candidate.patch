+        );
+        let mut scaled = geometry();
+        scaled.output_width = 50;
+        scaled.output_height = 40;
+        assert_eq!(
+            pixel_region(&scaled, [-98.0, 22.0, 4.0, 4.0]),
+            Ok([1, 1, 2, 2])
+        );
+    }
+    #[test]
+    fn image_region_refuses_partial_outside_nonfinite_empty_and_crop_without_clamping() {
+        for rect in [
+            [-101.0, 20.0, 3.0, 3.0],
+            [-1.0, 20.0, 3.0, 3.0],
+            [-99.0, 19.0, 3.0, 3.0],
