+//! Capture-time AX evidence in the existing snapshot owner, not a second cache.
+use super::observation::{self, Native, Reader, Scan};
+use crate::ax::{
+    bindings,
+    cache::{CachedSnapshot, ImageSnapshot, ImageTarget, RetainedElement},
+};
+use core_foundation::base::{CFRelease, CFTypeRef};
+use cua_driver_contract::computer_image::{ComputerImage, ComputerImageGeometry};
+use cua_driver_core::controlled::{ImageReference, Operation};
+
+pub(super) struct Prepared {
+    tree: Scan<RetainedElement>,
+    targets: Vec<ImageTarget>,
+}
+
+fn rect(native: &Native<'_>, element: &RetainedElement) -> Result<[f64; 4], &'static str> {
+    native.checkpoint()?;
+    let value = native
+        .operation
+        .primary(false, || unsafe {
+            bindings::element_screen_rect(element.as_ptr() as bindings::AXUIElementRef)
+        })?
+        .ok_or("target_geometry_unknown")?;
+    if !value.iter().all(|value| value.is_finite())
+        || value[2] <= 0.0
+        || value[3] <= 0.0
+        || !(value[0] + value[2]).is_finite()
+        || !(value[1] + value[3]).is_finite()
+    {
+        return Err("target_geometry_unknown");
+    }
+    Ok(value)
+}
+
+pub(super) fn prepare(operation: &Operation) -> Result<Prepared, &'static str> {
+    let native = Native { operation };
+    // Do not enable AX or change focus in an image-only observation.
+    let tree = observation::scan_general(&native, native.general_window()?);
+    if !tree.structurally_complete() {
+        return Err("condition_unknown");
+    }
+    let mut targets = Vec::new();
+    for (index, row) in tree.rows.iter().enumerate() {
+        if let Ok(rect) = rect(&native, &row.element) {
+            targets.push(ImageTarget {
+                index,
+                parent: row.parent,
+                role: row.data.role.clone(),
+                rect,
+            });
+        }
+        native.checkpoint()?;
+    }
+    Ok(Prepared { tree, targets })
+}
+
+impl Prepared {
+    pub(super) fn bind(
+        self,
+        operation: &Operation,
+        image: &ComputerImage,
+    ) -> Result<CachedSnapshot, &'static str> {
+        let native = Native { operation };
+        // AX and SCK are not atomic. Reject local eligibility if any retained
+        // geometry changed across capture; dispatch must still prove live hit
+        // identity, membership and ancestry before using these facts.
+        for target in &self.targets {
+            if rect(&native, &self.tree.rows[target.index].element)? != target.rect {
+                return Err("stale_image_observation");
+            }
+        }
+        let mut payload = self.tree.payload(true);
+        payload.image = Some(ImageSnapshot {
+            image_id: image.image_id.clone(),
+            geometry: image.geometry.clone(),
+            targets: self.targets,
+        });
+        Ok(payload)
+    }
+}
+
+fn pixel_region(
+    geometry: &ComputerImageGeometry,
+    rect: [f64; 4],
+) -> Result<[u32; 4], &'static str> {
+    geometry.validate()?;
+    if geometry.crop_x != 0
+        || geometry.crop_y != 0
+        || geometry.crop_width != geometry.source_width
+        || geometry.crop_height != geometry.source_height
+    {
+        return Err("target_geometry_unknown");
+    }
+    let [x, y, width, height] = rect;
+    if !rect.iter().all(|value| value.is_finite()) || width <= 0.0 || height <= 0.0 {
+        return Err("target_geometry_unknown");
+    }
+    let left = (x - geometry.desktop_x) * f64::from(geometry.output_width) / geometry.window_width;
+    let top = (y - geometry.desktop_y) * f64::from(geometry.output_height) / geometry.window_height;
+    let right =
+        (x + width - geometry.desktop_x) * f64::from(geometry.output_width) / geometry.window_width;
+    let bottom = (y + height - geometry.desktop_y) * f64::from(geometry.output_height)
+        / geometry.window_height;
+    if ![left, top, right, bottom]
+        .iter()
+        .all(|value| value.is_finite())
+        || left < 0.0
+        || top < 0.0
+        || right > f64::from(geometry.output_width)
+        || bottom > f64::from(geometry.output_height)
+    {
+        return Err("target_geometry_unknown");
+    }
+    let (left, top, right, bottom) = (
+        left.floor() as u32,
+        top.floor() as u32,
+        right.ceil() as u32,
+        bottom.ceil() as u32,
+    );
+    if right <= left || bottom <= top {
+        return Err("target_geometry_unknown");
+    }
+    Ok([left, top, right - left, bottom - top])
+}
+
+/// None means no local proof was captured, not that a failed identity check may
+/// fall back. Every observed mismatch below is a refusal, before primary input.
+pub(super) fn region(
+    cached: Option<&CachedSnapshot>,
+    reference: &ImageReference,
+    native: &Native<'_>,
+    live: &Scan<RetainedElement>,
+    x: u32,
+    y: u32,
+    scroll: bool,
+) -> Result<Option<[u32; 4]>, &'static str> {
+    let Some(cached) = cached else {
+        return Ok(None);
+    };
+    let Some(image) = &cached.image else {
+        return Ok(None);
+    };
+    reference.addresses(&image.image_id, x, y)?;
+    if reference.geometry() != &image.geometry {
+        return Err("stale_image_observation");
+    }
+    let point = image.geometry.desktop_pixel_center(x, y)?;
+    let target = native.operation.session.native_window()?;
+    let hit = native
+        .operation
+        .primary(false, || unsafe {
+            bindings::element_at_screen_position(target.pid, point.0, point.1)
+        })?
+        .ok_or("pointer_hit_unknown")?;
+    let hit = unsafe {
+        let owned = RetainedElement::retain(hit as usize);
+        CFRelease(hit as CFTypeRef);
+        owned
+    };
+    let mut index = cached
+        .elements
+        .iter()
+        .position(|ptr| {
+            *ptr != 0
+                && unsafe {
+                    core_foundation::base::CFEqual(*ptr as CFTypeRef, hit.as_ptr() as CFTypeRef)
+                        != 0
+                }
+        })
+        .ok_or("stale_image_observation")?;
+    let mut selected = None;
+    let mut ancestry = Vec::new();
+    let mut steps = 0;
+    loop {
+        steps += 1;
+        if steps > 512 {
+            return Err("controlled_target_unproven");
+        }
+        ancestry.push(index);
+        let original = image
+            .targets
+            .iter()
+            .find(|entry| entry.index == index)
+            .ok_or("target_geometry_unknown")?;
+        let ptr = *cached
+            .elements
+            .get(index)
+            .ok_or("stale_image_observation")?;
+        let row = live
+            .rows
+            .iter()
+            .find(|row| unsafe {
+                core_foundation::base::CFEqual(ptr as CFTypeRef, row.element.as_ptr() as CFTypeRef)
+                    != 0
+            })
+            .ok_or("stale_image_observation")?;
+        if row.data.role != original.role || rect(native, &row.element)? != original.rect {
+            return Err("stale_image_observation");
+        }
+        let same_parent = match (original.parent, row.parent) {
+            (None, None) => true,
