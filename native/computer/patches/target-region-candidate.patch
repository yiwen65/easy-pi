+            [-99.0, 20.0, 0.0, 3.0],
+            [-99.0, 20.0, 3.0, f64::NAN],
+        ] {
+            assert!(pixel_region(&geometry(), rect).is_err());
+        }
+        let mut cropped = geometry();
+        cropped.crop_x = 1;
+        cropped.crop_width = 199;
+        assert!(pixel_region(&cropped, [-98.0, 22.0, 4.0, 4.0]).is_err());
+    }
