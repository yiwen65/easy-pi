+            selected.role.as_str(),
+            "AXWindow" | "AXApplication" | "AXWebArea" | "AXScrollArea"
+        )
+    {
+        return Ok(None);
+    }
+    let [left, top, width, height] = selected.rect;
+    if point.0 < left || point.1 < top || point.0 >= left + width || point.1 >= top + height {
+        return Err("pointer_hit_unknown");
+    }
+    pixel_region(&image.geometry, selected.rect).map(Some)
+}
