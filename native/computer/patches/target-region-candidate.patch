+use cua_driver_contract::computer_image::{ComputerImage, ComputerImageGeometry};
+use cua_driver_core::{controlled::ImageReference, image_utils::encode_rgba_to_png};
+
+fn frame() -> ComputerImage {
+    ComputerImage {
+        image_id: "image".into(),
+        pid: 7,
+        window_id: 9,
+        geometry: ComputerImageGeometry {
+            desktop_x: -100.0,
+            desktop_y: 10.0,
+            window_width: 4.0,
+            window_height: 4.0,
+            source_width: 8,
+            source_height: 8,
+            crop_x: 0,
+            crop_y: 0,
+            crop_width: 8,
+            crop_height: 8,
+            output_width: 8,
+            output_height: 8,
+        },
+        png: encode_rgba_to_png(&vec![255; 8 * 8 * 4], 8, 8).unwrap(),
+    }
+}
+fn changed(x: usize, y: usize) -> ComputerImage {
+    let mut output = frame();
+    let mut pixels = vec![255; 8 * 8 * 4];
+    pixels[(y * 8 + x) * 4] = 0;
+    output.png = encode_rgba_to_png(&pixels, 8, 8).unwrap();
+    output
+}
+
+#[test]
+fn target_region_accepts_distant_change_but_not_target_change() {
+    let before = frame();
+    let reference = ImageReference::from_image(&before).unwrap();
+    assert_eq!(
+        reference.matches_region(&changed(7, 7), 1, 1, 3, 3),
+        Ok(true)
+    );
+    assert!(!reference.matches(&changed(7, 7)));
+    for (x, y) in [(1, 1), (3, 1), (1, 3), (3, 3), (2, 2)] {
+        assert_eq!(
+            reference.matches_region(&changed(x, y), 1, 1, 3, 3),
+            Ok(false)
+        );
+    }
+    // Both region edges are exact; no accidental full-row or next-row comparison.
+    assert_eq!(
+        reference.matches_region(&changed(4, 2), 1, 1, 3, 3),
+        Ok(true)
+    );
+    assert_eq!(
+        reference.matches_region(&changed(2, 4), 1, 1, 3, 3),
+        Ok(true)
+    );
+}
+
+#[test]
+fn target_region_rejects_empty_overflow_and_out_of_bounds_without_clamping() {
+    let image = frame();
+    let reference = ImageReference::from_image(&image).unwrap();
+    for (x, y, width, height) in [
+        (0, 0, 0, 1),
+        (0, 0, 1, 0),
+        (8, 0, 1, 1),
+        (0, 8, 1, 1),
+        (7, 7, 2, 1),
+        (7, 7, 1, 2),
+        (u32::MAX, 0, 2, 1),
+        (0, u32::MAX, 1, 2),
+        (1, 1, u32::MAX, u32::MAX),
+    ] {
+        assert_eq!(
+            reference.matches_region(&image, x, y, width, height),
+            Err("image_region_out_of_bounds")
+        );
+    }
+    assert_eq!(reference.matches_region(&image, 7, 7, 1, 1), Ok(true));
+}
+
+#[test]
+fn target_region_never_weakens_window_identity_or_geometry() {
+    let image = frame();
+    let reference = ImageReference::from_image(&image).unwrap();
+    for mutate in [
+        |v: &mut ComputerImage| v.pid += 1,
+        |v: &mut ComputerImage| v.window_id += 1,
+        |v: &mut ComputerImage| v.geometry.desktop_x += 1.0,
+        |v: &mut ComputerImage| v.geometry.window_width += 1.0,
+        |v: &mut ComputerImage| v.geometry.source_width *= 2,
+    ] {
+        let mut after = image.clone();
+        mutate(&mut after);
+        assert_eq!(reference.matches_region(&after, 1, 1, 3, 3), Ok(false));
+    }
+}
+
+#[test]
+fn target_region_rejects_invalid_png_and_redacts_retained_pixels() {
+    let image = frame();
+    let reference = ImageReference::from_image(&image).unwrap();
+    let mut invalid = image.clone();
+    invalid.png.truncate(33); // IHDR shape passes metadata validation, decode must fail.
+    assert!(ImageReference::from_image(&invalid).is_err());
+    assert!(reference.matches_region(&invalid, 1, 1, 3, 3).is_err());
+    assert!(!format!("{reference:?}").contains("255, 255"));
+}
