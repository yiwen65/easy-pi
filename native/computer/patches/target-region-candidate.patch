+    /// Compare an exact output-pixel rectangle supplied by native target geometry.
+    /// This does not establish element identity, hit target, or input authority.
+    /// Existing full-image callers deliberately keep using `matches`.
+    pub fn matches_region(
+        &self,
+        image: &ComputerImage,
+        x: u32,
+        y: u32,
+        width: u32,
+        height: u32,
+    ) -> Result<bool, &'static str> {
+        if width == 0
+            || height == 0
+            || x.checked_add(width)
+                .is_none_or(|end| end > self.geometry.output_width)
+            || y.checked_add(height)
+                .is_none_or(|end| end > self.geometry.output_height)
+        {
+            return Err("image_region_out_of_bounds");
+        }
