+}
+
+async fn image_action(args: Value, operation: Arc<Operation>, action: ImageAction) -> ToolResult {
+    let shape = match action {
+        ImageAction::Click => args["action"] == "press"
+            && ["direction", "by", "amount"].iter().all(|key| args.get(key).is_none()),
+        ImageAction::Scroll(_) => args.get("action").is_none() && args["by"] == "line" && args["amount"] == 1,
+    };
+    if !target_matches(&args, &operation)
+        || args["delivery_mode"] != "background" || !shape
+        || ["element_token", "element_index", "snapshot_id", "scope", "modifiers", "button", "count", "from_zoom", "debug_image_out"]
+            .iter().any(|key| args.get(key).is_some()) {
+        return refusal("controlled_click_refused");
+    }
+    let coordinate = |key: &str| args[key].as_f64()
+        .filter(|v| v.is_finite() && *v >= 0.0 && *v < 2048.0 && v.fract() == 0.0)
+        .map(|v| v as u32);
+    let (Some(x), Some(y), Some(reference)) = (coordinate("x"), coordinate("y"), crate::input::controlled::current()) else {
+        return refusal("image_reference_required");
+    };
+    let Ok(target) = operation.session.native_window() else { return refusal("unsupported_route"); };
+    operation.reset_snapshot();
+    let lease = super::acquire_background_mutation(target.pid).await;
+    let worker = operation.clone();
+    match operation.blocking(move || {
+        let _lease = lease;
+        if !target_matches(&args, &worker) { return refusal("controlled_target_stale"); }
+        with_focus_cleanup(&worker, match action { ImageAction::Click => "image_click", ImageAction::Scroll(_) => "image_scroll" }, || {
+            let validate = || -> Result<(), &'static str> {
+                if !target_matches(&args, &worker) { return Err("controlled_target_stale"); }
+                let facts = crate::ax::exact_target::gather_background_facts(target.pid, target.window_id, None);
+                let decision = cua_driver_core::background_input::decide_background_input(
+                    cua_driver_core::background_input::ExactWindowTarget { pid:target.pid, window_id:target.window_id },
+                    &facts, cua_driver_core::background_input::BackgroundAction::WindowPointer);
+                if !decision.is_execute() { return Err("controlled_target_unproven"); }
+                let native = Native { operation:&worker };
+                let root = native.exact_window()?;
+                let tree = observation::scan(&native, root, 512, 32);
+                if !tree.complete() { return Err(tree.failure.unwrap_or("condition_unknown")); }
+                Ok(())
+            };
+            if let Err(reason) = validate() { return refusal(reason); }
+            match crate::input::controlled::pointer(&worker, &reference, x, y, action, validate) {
+                Ok(()) => ToolResult::text("Image-bound pointer input dispatched; effect unverified")
+                    .with_structured(json!({"path":"cgevent","verified":false,"effect":"unverifiable"})),
+                Err(reason) => refusal(reason),
+            }
+        })
+    }).await {
+        Ok(result)=>result, Err(_)=>refusal("controlled_quarantined"),
+    }
 }
 
