+use super::*;
+
+#[tokio::test]
+async fn controlled_pointer_primitives_are_native_only_bounded_and_not_mixed() {
+    let gate = Gate::new();
+    let session = gate
+        .session(None, Arc::new(|| true), 1, 2, Some((3, 4)))
+        .unwrap();
+    let op = session.new_operation().unwrap();
+    assert_eq!(op.pointer_primary(|| ()), Err("invalid_primitive"));
+    op.begin().unwrap();
+    op.pointer_primary(|| ()).unwrap();
+    assert_eq!(op.primary(true, || ()), Err("invalid_primitive"));
+    assert_eq!(op.browser_primary(|| ()), Err("invalid_primitive"));
+    op.pointer_primary(|| ()).unwrap();
+    assert_eq!(op.pointer_primary(|| ()), Err("invalid_primitive"));
+    op.finish();
+    assert!(op.terminal().await.unwrap().input_committed);
+    let browser = gate.browser_session(Arc::new(|| true)).unwrap();
+    let op = browser.new_operation().unwrap();
+    op.begin().unwrap();
+    assert_eq!(
+        op.pointer_primary(|| panic!("browser pointer input")),
+        Err("unsupported_route")
+    );
+    op.finish();
+    assert!(!op.terminal().await.unwrap().input_committed);
+}
+
+#[tokio::test]
+async fn controlled_pointer_cancel_or_ancestor_revoke_prevents_next_primary() {
+    for revoke in [false, true] {
+        let gate = Gate::new();
+        let root = gate.session(None, Arc::new(|| true), 1, 2, None).unwrap();
+        let child = gate
+            .session(Some(root.clone()), Arc::new(|| true), 1, 2, None)
+            .unwrap();
+        let op = child.new_operation().unwrap();
+        op.begin().unwrap();
+        op.pointer_primary(|| ()).unwrap();
+        if revoke {
+            root.revoke();
+        } else {
+            op.cancel();
+        }
+        assert!(op.pointer_primary(|| panic!("down after revoke")).is_err());
+        op.finish();
+        let terminal = op.terminal().await.unwrap();
+        assert!(terminal.cancelled && terminal.input_committed);
+    }
+}
