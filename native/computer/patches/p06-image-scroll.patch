+//! Synthetic owned image outcomes only: no capture, native owner or canonical lease.
+use super::*;
+use cua_driver_contract::computer_image::{ComputerImage, ComputerImageGeometry};
+
+pub(super) fn image() -> ComputerImage {
+    ComputerImage {
+        image_id: "private-image-result".into(),
+        pid: 42,
+        window_id: 7,
+        geometry: ComputerImageGeometry {
+            desktop_x: 0.0,
+            desktop_y: 0.0,
+            window_width: 1.0,
+            window_height: 1.0,
+            source_width: 1,
+            source_height: 1,
+            crop_x: 0,
+            crop_y: 0,
+            crop_width: 1,
+            crop_height: 1,
+            output_width: 1,
+            output_height: 1,
+        },
+        png: cua_driver_core::image_utils::encode_rgba_to_png(&[1, 2, 3, 255], 1, 1).unwrap(),
+    }
+}
+
+#[tokio::test]
+async fn controlled_image_invalid_bounds_and_preabort_do_not_launch() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let host = host();
+    let operation = session(&host, None).new_operation().unwrap();
+    for maximum in [0, 2049, u32::MAX] {
+        assert!(matches!(operation.clone().start_capture(maximum),
+            Err(ComputerError::Refused{reason}) if reason=="invalid_capture_bounds"));
+        assert!(operation.outcome.lock().unwrap().is_none());
+    }
+    operation.cancel();
+    assert!(matches!(
+        operation.clone().start_capture(1024),
+        Err(ComputerError::Cancelled {
+            input_committed: false
+        })
+    ));
+    assert!(operation.outcome.lock().unwrap().is_none());
+    assert!(host.scheduler.clone().try_lock_owned().is_ok());
+    assert!(!operation.terminal().await.unwrap().input_committed);
+    host.close().await.unwrap();
+}
+
+#[tokio::test]
+async fn controlled_image_cancel_waits_for_drain_and_never_publishes_the_payload() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let host = host();
+    let operation = session(&host, None).new_operation().unwrap();
+    let weak = Arc::downgrade(&operation);
+    operation.core.begin().unwrap();
+    let pending = operation.core.track_callback().unwrap();
+    *operation.outcome.lock().unwrap() = Some(Ok(ComputerResult::Image { value: image() }));
+    operation.cancel();
+    operation.core.finish();
+    let mut result = Box::pin(operation.result());
+    assert!(result
+        .as_mut()
+        .poll(&mut Context::from_waker(Waker::noop()))
+        .is_pending());
+    assert!(!operation.core.is_proven_terminal());
+    drop(pending);
+    assert!(matches!(
+        result.await,
+        Err(ComputerError::Cancelled {
+            input_committed: false
+        })
+    ));
+    drop(operation);
+    assert!(
+        weak.upgrade().is_none(),
+        "proof records must not retain the image outcome owner"
+    );
+    host.close().await.unwrap();
+}
+
+#[tokio::test]
+async fn controlled_image_native_result_owner_is_reclaimed_after_foreign_handle_retirement() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let host = host();
+    let session = session(&host, None);
+    let operation = session.clone().new_operation().unwrap();
+    let weak = Arc::downgrade(&operation);
+    operation.core.begin().unwrap();
+    *operation.outcome.lock().unwrap() = Some(Ok(ComputerResult::Image { value: image() }));
+    operation.core.finish();
+    let result = operation.result().await.unwrap();
+    assert!(matches!(&result,ComputerResult::Image{value} if value.validate().is_ok()));
+    assert!(
+        session.observation.lock().unwrap().is_none(),
+        "image-only result must not grant AX refs"
+    );
+    // Returned bytes belong to the consumer; destroying the native operation
+    // releases its retained outcome without invalidating that returned copy.
+    drop(operation);
+    assert!(weak.upgrade().is_none());
+    session.close().await.unwrap();
+    host.close().await.unwrap();
+    assert!(matches!(&result,ComputerResult::Image{value} if value.validate().is_ok()));
+    drop(result);
+}
