+//! Small image freshness facts, not input authority or retained image bytes.
+use cua_driver_contract::computer_image::{ComputerImage, ComputerImageGeometry};
+use sha2::{Digest, Sha256};
+
+#[derive(Debug)]
+pub struct ImageReference {
+    id: String,
+    pid: u32,
+    window_id: u64,
+    geometry: ComputerImageGeometry,
+    digest: [u8; 32],
+}
+
+impl ImageReference {
+    pub fn from_image(image: &ComputerImage) -> Result<Self, &'static str> {
+        image.validate()?;
+        Ok(Self {
+            id: image.image_id.clone(),
+            pid: image.pid,
+            window_id: image.window_id,
+            geometry: image.geometry.clone(),
+            digest: Sha256::digest(&image.png).into(),
+        })
+    }
+
+    pub fn geometry(&self) -> &ComputerImageGeometry {
+        &self.geometry
+    }
+
+    pub fn target_matches(&self, pid: u32, window_id: u64) -> bool {
+        self.pid == pid && self.window_id == window_id
+    }
+
+    pub fn addresses(&self, id: &str, x: u32, y: u32) -> Result<(), &'static str> {
+        if self.id != id {
+            return Err("stale_image_observation");
+        }
+        self.geometry.desktop_pixel_center(x, y).map(|_| ())
+    }
+
+    pub fn matches(&self, image: &ComputerImage) -> bool {
+        self.target_matches(image.pid, image.window_id)
+            && self.geometry == image.geometry
+            && self.digest == <[u8; 32]>::from(Sha256::digest(&image.png))
+    }
+}
