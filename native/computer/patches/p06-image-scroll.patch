+pub(super) async fn scroll(args: Value, operation: Arc<Operation>) -> ToolResult {
+    let Ok(direction) = serde_json::from_value::<cua_driver_contract::ScrollDirection>(args["direction"].clone()) else {
+        return refusal("controlled_scroll_refused");
+    };
