+#[cfg(all(test, target_os = "macos"))]
+mod computer_image_wire_tests {
+    use super::*;
+    use cua_driver_contract::computer_image::{ComputerImage, ComputerImageGeometry};
+
+    fn image() -> ComputerImage {
+        ComputerImage {
+            image_id: "private-image".into(),
+            pid: 7,
+            window_id: 9,
+            geometry: ComputerImageGeometry {
+                desktop_x: 0.0,
+                desktop_y: 0.0,
+                window_width: 1.0,
+                window_height: 1.0,
+                source_width: 1,
+                source_height: 1,
+                crop_x: 0,
+                crop_y: 0,
+                crop_width: 1,
+                crop_height: 1,
+                output_width: 1,
+                output_height: 1,
+            },
+            png: crate::image_utils::encode_rgba_to_png(&[255, 0, 0, 255], 1, 1).unwrap(),
+        }
+    }
+
+    #[test]
+    fn controlled_image_bytes_are_not_copied_into_json_or_debug() {
+        let payload = image();
+        let pointer = payload.png.as_ptr();
+        let size = payload.png.len();
+        let plain = ToolResult::text("image captured");
+        let mut result = ToolResult::text("image captured")
+            .with_computer_image(payload)
+            .unwrap();
+        assert_eq!(
+            serde_json::to_value(&result).unwrap(),
+            serde_json::to_value(plain).unwrap()
+        );
+        let moved = result.computer_image.take().unwrap();
+        assert_eq!(moved.png.as_ptr(), pointer);
+        assert_eq!(moved.png.len(), size);
+        assert!(result.computer_image.is_none());
+        assert!(!format!("{moved:?}").contains("IHDR"));
+    }
+
+    #[test]
+    fn controlled_image_result_refuses_duplicate_encodings_and_failure_payloads() {
+        assert!(ToolResult::text("one")
+            .with_computer_image(image())
+            .unwrap()
+            .with_computer_image(image())
+            .is_err());
+        assert!(ToolResult::error("refused")
+            .with_computer_image(image())
+            .is_err());
+        let mut result = ToolResult::text("legacy");
+        result
+            .content
+            .push(Content::image_png("legacy-base64".into()));
+        assert!(result.with_computer_image(image()).is_err());
+    }
+}
