+//! Owned PNG output and explicit pixel/desktop mapping for controlled capture.
+//! Geometry and an image ID are facts, never an authorization capability. Input
+//! callers must separately revalidate their native session, target and image.
+
+pub const COMPUTER_IMAGE_MAX_BYTES: usize = 8 * 1024 * 1024;
+pub const COMPUTER_IMAGE_MAX_SOURCE_EDGE: u32 = 16_384;
+pub const COMPUTER_IMAGE_MAX_OUTPUT_EDGE: u32 = 2_048;
+pub const COMPUTER_IMAGE_MAX_OUTPUT_PIXELS: u64 = 4 * 1024 * 1024;
+const PNG_SIGNATURE: &[u8; 8] = b"\x89PNG\r\n\x1a\n";
+
+/// Top-left origin, x right and y down. Crop coordinates are source pixels;
+/// desktop/window dimensions are logical points, not device pixels. Separate
+/// axis ratios preserve the actual integer output dimensions after rounding.
+#[derive(Debug, Clone, PartialEq, uniffi::Record)]
+pub struct ComputerImageGeometry {
+    pub desktop_x: f64,
+    pub desktop_y: f64,
+    pub window_width: f64,
+    pub window_height: f64,
+    pub source_width: u32,
+    pub source_height: u32,
+    pub crop_x: u32,
+    pub crop_y: u32,
+    pub crop_width: u32,
+    pub crop_height: u32,
+    pub output_width: u32,
+    pub output_height: u32,
+}
+
+impl ComputerImageGeometry {
+    pub fn validate(&self) -> Result<(), &'static str> {
+        if ![
+            self.desktop_x,
+            self.desktop_y,
+            self.window_width,
+            self.window_height,
+        ]
+        .iter()
+        .all(|value| value.is_finite())
+            || self.window_width <= 0.0
+            || self.window_height <= 0.0
+            || !(self.desktop_x + self.window_width).is_finite()
+            || !(self.desktop_y + self.window_height).is_finite()
+        {
+            return Err("image_geometry_unproved");
+        }
+        if self.source_width == 0
+            || self.source_height == 0
+            || self.source_width > COMPUTER_IMAGE_MAX_SOURCE_EDGE
+            || self.source_height > COMPUTER_IMAGE_MAX_SOURCE_EDGE
+            || self.crop_width == 0
+            || self.crop_height == 0
+            || self
+                .crop_x
+                .checked_add(self.crop_width)
+                .is_none_or(|end| end > self.source_width)
+            || self
+                .crop_y
+                .checked_add(self.crop_height)
+                .is_none_or(|end| end > self.source_height)
+            || self.output_width == 0
+            || self.output_height == 0
+            || self.output_width > COMPUTER_IMAGE_MAX_OUTPUT_EDGE
+            || self.output_height > COMPUTER_IMAGE_MAX_OUTPUT_EDGE
+            || u64::from(self.output_width) * u64::from(self.output_height)
+                > COMPUTER_IMAGE_MAX_OUTPUT_PIXELS
+            || self.output_width > self.crop_width
+            || self.output_height > self.crop_height
+        {
+            return Err("image_dimensions_unproved");
+        }
+        Ok(())
+    }
+
+    /// Map the center of one output pixel. Never clamp an out-of-bounds point
+    /// into a different target. This calculation alone does not admit input.
+    pub fn desktop_pixel_center(&self, x: u32, y: u32) -> Result<(f64, f64), &'static str> {
+        self.validate()?;
+        if x >= self.output_width || y >= self.output_height {
+            return Err("image_point_out_of_bounds");
+        }
+        let source_x = f64::from(self.crop_x)
+            + (f64::from(x) + 0.5) * f64::from(self.crop_width) / f64::from(self.output_width);
+        let source_y = f64::from(self.crop_y)
+            + (f64::from(y) + 0.5) * f64::from(self.crop_height) / f64::from(self.output_height);
+        let point = (
+            self.desktop_x + source_x * self.window_width / f64::from(self.source_width),
+            self.desktop_y + source_y * self.window_height / f64::from(self.source_height),
+        );
+        if !point.0.is_finite() || !point.1.is_finite() {
+            return Err("image_geometry_unproved");
+        }
+        Ok(point)
+    }
+}
+
+/// One native-owned encoded image, transferred through genuine UniFFI bytes.
+/// Intentionally not a serde/JSON result: no Base64 or duplicate raw envelope.
+#[derive(Clone, PartialEq, uniffi::Record)]
+pub struct ComputerImage {
+    pub image_id: String,
+    pub pid: u32,
+    pub window_id: u64,
+    pub geometry: ComputerImageGeometry,
+    pub png: Vec<u8>,
+}
+
+impl std::fmt::Debug for ComputerImage {
+    fn fmt(&self, out: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        out.debug_struct("ComputerImage")
+            .field("image_id", &self.image_id)
+            .field("pid", &self.pid)
+            .field("window_id", &self.window_id)
+            .field("geometry", &self.geometry)
+            .field("png_bytes", &self.png.len())
+            .finish()
+    }
+}
+
+impl ComputerImage {
+    /// Validate bounds and the encoder's PNG header. This does not replace a
+    /// full PNG decoder or prove capture provenance; only the owned producer
+    /// supplies images and the session/target proof remains outside this record.
+    pub fn validate(&self) -> Result<(), &'static str> {
+        self.geometry.validate()?;
+        if self.pid == 0
+            || self.pid > i32::MAX as u32
+            || self.window_id == 0
+            || self.image_id.is_empty()
+            || self.image_id.len() > 64
+            || !self
+                .image_id
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_'))
+        {
+            return Err("image_identity_unproved");
+        }
+        if self.png.len() < 33
+            || self.png.len() > COMPUTER_IMAGE_MAX_BYTES
+            || &self.png[..8] != PNG_SIGNATURE
+            || self.png[8..12] != 13u32.to_be_bytes()
+            || &self.png[12..16] != b"IHDR"
+            || self.png[16..20] != self.geometry.output_width.to_be_bytes()
+            || self.png[20..24] != self.geometry.output_height.to_be_bytes()
+        {
+            return Err("image_encoding_unproved");
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn geometry() -> ComputerImageGeometry {
+        ComputerImageGeometry {
+            desktop_x: -100.0,
+            desktop_y: 40.0,
+            window_width: 400.0,
+            window_height: 300.0,
+            source_width: 800,
+            source_height: 600,
+            crop_x: 100,
+            crop_y: 80,
+            crop_width: 400,
+            crop_height: 200,
+            output_width: 200,
+            output_height: 100,
+        }
+    }
+
+    // Deliberately only a synthetic IHDR for shape tests, not a valid PNG file.
+    fn header_record() -> ComputerImage {
+        let geometry = geometry();
+        let mut png = vec![0; 33];
+        png[..8].copy_from_slice(PNG_SIGNATURE);
+        png[8..12].copy_from_slice(&13u32.to_be_bytes());
+        png[12..16].copy_from_slice(b"IHDR");
+        png[16..20].copy_from_slice(&geometry.output_width.to_be_bytes());
+        png[20..24].copy_from_slice(&geometry.output_height.to_be_bytes());
+        ComputerImage {
+            image_id: "image-fixture".into(),
+            pid: 7,
+            window_id: 9,
+            geometry,
+            png,
+        }
+    }
+
+    #[test]
+    fn controlled_image_geometry_maps_crop_scale_dpi_and_negative_desktop_origin() {
+        let geometry = geometry();
+        assert_eq!(geometry.desktop_pixel_center(0, 0), Ok((-49.5, 80.5)));
+        assert_eq!(geometry.desktop_pixel_center(199, 99), Ok((149.5, 179.5)));
+        assert_eq!(
+            geometry.desktop_pixel_center(200, 0),
+            Err("image_point_out_of_bounds")
+        );
+        assert_eq!(
+            geometry.desktop_pixel_center(0, 100),
+            Err("image_point_out_of_bounds")
+        );
+    }
+
+    #[test]
+    fn controlled_image_geometry_rejects_overflow_zero_upscale_and_nonfinite_facts() {
+        let valid = geometry();
+        for broken in [
+            ComputerImageGeometry {
+                crop_x: u32::MAX,
+                ..valid.clone()
+            },
+            ComputerImageGeometry {
+                crop_width: 0,
+                ..valid.clone()
+            },
+            ComputerImageGeometry {
+                crop_height: 601,
+                ..valid.clone()
+            },
+            ComputerImageGeometry {
+                output_width: 401,
+                ..valid.clone()
+            },
+            ComputerImageGeometry {
+                source_height: 0,
+                ..valid.clone()
+            },
+            ComputerImageGeometry {
+                source_width: COMPUTER_IMAGE_MAX_SOURCE_EDGE + 1,
+                ..valid.clone()
+            },
+            ComputerImageGeometry {
+                desktop_x: f64::NAN,
+                ..valid.clone()
+            },
+            ComputerImageGeometry {
+                desktop_y: f64::INFINITY,
+                ..valid.clone()
+            },
+            ComputerImageGeometry {
+                window_width: -1.0,
+                ..valid
+            },
+        ] {
+            assert!(broken.validate().is_err());
+            assert!(broken.desktop_pixel_center(0, 0).is_err());
+        }
+    }
+
+    #[test]
+    fn controlled_image_header_and_identity_must_match_bounded_metadata() {
+        let valid = header_record();
+        assert!(valid.validate().is_ok());
+        let mut wrong = valid.clone();
+        wrong.png[19] ^= 1;
+        assert_eq!(wrong.validate(), Err("image_encoding_unproved"));
+        let mut short = valid.clone();
+        short.png.truncate(24);
+        assert!(short.validate().is_err());
+        let mut large = valid.clone();
+        large.png.resize(COMPUTER_IMAGE_MAX_BYTES + 1, 0);
+        assert!(large.validate().is_err());
+        let mut no_pid = valid.clone();
+        no_pid.pid = 0;
+        assert!(no_pid.validate().is_err());
+        let mut injected = valid;
+        injected.image_id = "image\ncontent".into();
+        assert!(injected.validate().is_err());
+    }
+
+    #[test]
+    fn controlled_image_debug_never_duplicates_encoded_bytes() {
+        let image = header_record();
+        let debug = format!("{image:?}");
+        assert!(debug.contains("png_bytes: 33"));
+        assert!(!debug.contains("IHDR"));
+        assert!(!debug.contains("137, 80, 78, 71"));
+    }
+}
