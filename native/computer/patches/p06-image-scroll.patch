+//! Exact-window capture on the caller's tracked blocking worker. No timeout
+//! detachment, shell fallback, cached filter, display capture or input replay.
+use super::{build_window_capture_plan, current_window_capture_identity, native_capture_gate};
+use cua_driver_contract::computer_image::{
+    ComputerImage, ComputerImageGeometry, COMPUTER_IMAGE_MAX_OUTPUT_EDGE,
+    COMPUTER_IMAGE_MAX_SOURCE_EDGE,
+};
+use cua_driver_core::controlled::Operation;
+use screencapturekit::screenshot_manager::{CGImageExt, SCScreenshotManager};
+
+fn output_dimensions(width: u32, height: u32, maximum: u32) -> Result<(u32, u32), &'static str> {
+    if width == 0
+        || height == 0
+        || width > COMPUTER_IMAGE_MAX_SOURCE_EDGE
+        || height > COMPUTER_IMAGE_MAX_SOURCE_EDGE
+        || maximum == 0
+        || maximum > COMPUTER_IMAGE_MAX_OUTPUT_EDGE
+    {
+        return Err("image_dimensions_unproved");
+    }
+    let longest = width.max(height);
+    if longest <= maximum {
+        return Ok((width, height));
+    }
+    Ok((
+        (u64::from(width) * u64::from(maximum) / u64::from(longest)).max(1) as u32,
+        (u64::from(height) * u64::from(maximum) / u64::from(longest)).max(1) as u32,
+    ))
+}
+
+/// Called only after canonical get_window_state admission, inside the same
+/// Operation::blocking scope that awaits every platform call and local drop.
+pub(crate) fn capture(operation: &Operation, maximum: u32) -> Result<ComputerImage, &'static str> {
+    operation.checkpoint()?;
+    let target = operation.session.native_window()?;
+    if maximum == 0 || maximum > COMPUTER_IMAGE_MAX_OUTPUT_EDGE {
+        return Err("image_dimensions_unproved");
+    }
+    let target_live = || {
+        target.process_stamp.is_some()
+            && crate::tools::computer_process_stamp(target.pid) == target.process_stamp
+    };
+    if !target_live() {
+        return Err("controlled_target_stale");
+    }
+    let identity =
+        current_window_capture_identity(target.window_id).map_err(|_| "controlled_target_stale")?;
+    // Exact authorized floating panels are valid targets too. Keep the layer
+    // in the before/after identity proof, rather than requiring normal level.
+    if identity.pid != target.pid {
+        return Err("controlled_target_stale");
+    }
+    // The shared gate prevents overlap with legacy SCK calls without borrowing
+    // their detached timeout worker. The permit is held through image release.
+    let _permit = native_capture_gate().try_acquire().ok_or("capture_busy")?;
+    let plan = operation
+        .primary(false, || {
+            build_window_capture_plan(target.window_id, identity)
+        })?
+        .map_err(|_| "capture_window_unproved")?;
+    let mut plan = std::sync::Arc::try_unwrap(plan).map_err(|_| "capture_plan_shared")?;
+    let rect = plan.filter.content_rect();
+    let width = f64::from_bits(identity.width);
+    let height = f64::from_bits(identity.height);
+    // This first route captures the entire shadowless window. Refuse a partial
+    // content extent rather than invent its offset relative to WindowServer.
+    if rect.size.width.to_bits() != identity.width || rect.size.height.to_bits() != identity.height
+    {
+        return Err("image_geometry_unproved");
+    }
+    let source_width = plan.config.width();
+    let source_height = plan.config.height();
+    let (output_width, output_height) = output_dimensions(source_width, source_height, maximum)?;
+    let geometry = ComputerImageGeometry {
+        desktop_x: f64::from_bits(identity.x),
+        desktop_y: f64::from_bits(identity.y),
+        window_width: width,
+        window_height: height,
+        source_width,
+        source_height,
+        crop_x: 0,
+        crop_y: 0,
+        crop_width: source_width,
+        crop_height: source_height,
+        output_width,
+        output_height,
+    };
+    geometry.validate()?;
+    plan.config = plan
+        .config
+        .with_width(output_width)
+        .with_height(output_height)
+        .with_scales_to_fit(false)
+        .with_preserves_aspect_ratio(false)
+        .with_ignores_shadows_single_window(true)
+        .with_includes_child_windows(false)
+        .with_shows_cursor(false);
+    if !target_live()
+        || current_window_capture_identity(target.window_id)
+            .map_err(|_| "controlled_target_stale")?
+            != identity
+    {
+        return Err("controlled_target_stale");
+    }
+    // The dependency waits for its completion; unlike the legacy wrapper, this
+    // call does not return after a timer while a detached capture keeps running.
+    let image = operation
+        .primary(false, || {
+            SCScreenshotManager::capture_image(&plan.filter, &plan.config)
+        })?
+        .map_err(|_| "capture_unconfirmed")?;
+    operation.checkpoint()?;
+    if image.width() != output_width as usize || image.height() != output_height as usize {
+        return Err("image_dimensions_unproved");
+    }
+    if !target_live()
+        || current_window_capture_identity(target.window_id)
+            .map_err(|_| "controlled_target_stale")?
+            != identity
+    {
+        return Err("controlled_target_stale");
+    }
+    let rgba = image.rgba_data().map_err(|_| "image_pixels_unproved")?;
+    let length = u64::from(output_width) * u64::from(output_height) * 4;
+    if rgba.len() as u64 != length {
+        return Err("image_pixels_unproved");
+    }
+    operation.checkpoint()?;
+    let png = cua_driver_core::image_utils::encode_rgba_to_png(&rgba, output_width, output_height)
+        .map_err(|_| "image_encoding_unproved")?;
+    operation.checkpoint()?;
+    if !target_live()
+        || current_window_capture_identity(target.window_id)
+            .map_err(|_| "controlled_target_stale")?
+            != identity
+    {
+        return Err("controlled_target_stale");
+    }
+    let result = ComputerImage {
+        image_id: format!("i{}", uuid::Uuid::new_v4()),
+        pid: target.pid as u32,
+        window_id: u64::from(target.window_id),
+        geometry,
+        png,
+    };
+    result.validate()?;
+    Ok(result)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use cua_driver_core::controlled::Gate;
+    use std::sync::Arc;
+
+    #[test]
+    fn controlled_capture_dimensions_are_bounded_and_never_upscaled() {
+        assert_eq!(output_dimensions(1120, 1084, 1024), Ok((1024, 991)));
+        assert_eq!(output_dimensions(400, 300, 1024), Ok((400, 300)));
+        assert_eq!(output_dimensions(16384, 1, 1), Ok((1, 1)));
+        for (width, height, maximum) in [
+            (0, 1, 1),
+            (1, 0, 1),
+            (1, 1, 0),
+            (16385, 1, 1024),
+            (1, 1, 2049),
+        ] {
+            assert_eq!(
+                output_dimensions(width, height, maximum),
+                Err("image_dimensions_unproved")
+            );
+        }
+    }
+
+    #[tokio::test]
+    async fn controlled_capture_refuses_browser_scope_before_native_capture() {
+        let gate = Gate::new();
+        let session = gate.browser_session(Arc::new(|| true)).unwrap();
+        let operation = session.new_operation().unwrap();
+        operation.begin().unwrap();
+        assert_eq!(capture(&operation, 1024).unwrap_err(), "unsupported_route");
+        operation.finish();
+        assert!(!operation.terminal().await.unwrap().input_committed);
+    }
+}
