+//! No GUI calls: reference ownership, rejection and native lane tests.
+use super::*;
+use platform_macos::input::controlled::ImageReference;
+
+fn reference() -> Arc<ImageReference> {
+    Arc::new(ImageReference::from_image(&super::images::image()).unwrap())
+}
+
+#[tokio::test]
+async fn controlled_pointer_ref_is_session_local_single_use_and_bad_id_consumes_it() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let host = host();
+    let first = session(&host, None);
+    let second = session(&host, None);
+    let op = first.clone().new_operation().unwrap();
+    let foreign = second.new_operation().unwrap();
+    *first.image_reference.lock().unwrap() = Some(reference());
+    assert!(foreign
+        .take_image_reference("private-image-result", 0, 0)
+        .is_err());
+    assert!(first.image_reference.lock().unwrap().is_some());
+    assert!(op.take_image_reference("wrong", 0, 0).is_err());
+    assert!(first.image_reference.lock().unwrap().is_none());
+    *first.image_reference.lock().unwrap() = Some(reference());
+    assert!(op
+        .take_image_reference("private-image-result", 0, 0)
+        .is_ok());
+    assert!(op
+        .take_image_reference("private-image-result", 0, 0)
+        .is_err());
+    *first.image_reference.lock().unwrap() = Some(reference());
+    assert!(op
+        .take_image_reference("private-image-result", 1, 0)
+        .is_err());
+    assert!(first.image_reference.lock().unwrap().is_none());
+    op.cancel();
+    foreign.cancel();
+    host.close().await.unwrap();
+}
+
+#[tokio::test]
+async fn controlled_pointer_busy_and_preabort_do_not_consume_a_reference() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let host = host();
+    let session = session(&host, None);
+    *session.image_reference.lock().unwrap() = Some(reference());
+    let op = session.clone().new_operation().unwrap();
+    let lane = host.scheduler.clone().try_lock_owned().unwrap();
+    assert!(
+        matches!(op.clone().start_image_click("private-image-result".into(),0,0),
+        Err(ComputerError::Refused{reason}) if reason=="native_busy")
+    );
+    assert!(session.image_reference.lock().unwrap().is_some());
+    drop(lane);
+    op.cancel();
+    assert!(matches!(
+        op.clone()
+            .start_image_click("private-image-result".into(), 0, 0),
+        Err(ComputerError::Cancelled {
+            input_committed: false
+        })
+    ));
+    assert!(session.image_reference.lock().unwrap().is_some());
+    assert!(!op.terminal().await.unwrap().input_committed);
+    host.close().await.unwrap();
+    assert!(session.image_reference.lock().unwrap().is_none());
+}
+
+#[tokio::test]
+async fn controlled_pointer_missing_image_rejects_before_platform_and_other_observation_invalidates(
+) {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let host = host();
+    let session = session(&host, None);
+    let op = session.clone().new_operation().unwrap();
+    op.clone()
+        .start_image_click("missing".into(), 0, 0)
+        .unwrap();
+    assert!(
+        matches!(op.result().await,Err(ComputerError::Refused{reason}) if reason=="stale_image_observation")
+    );
+    assert!(!op.terminal().await.unwrap().input_committed);
+    *session.image_reference.lock().unwrap() = Some(reference());
+    let next = session.clone().new_operation().unwrap();
+    next.start("controlled_diagnostic_no_such_tool", serde_json::json!({}))
+        .unwrap();
+    assert!(next.result().await.is_err());
+    assert!(session.image_reference.lock().unwrap().is_none());
+    host.close().await.unwrap();
+}
+
+#[tokio::test]
+async fn controlled_pointer_subtree_close_retires_only_its_reference_facts() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let host = host();
+    let root = session(&host, None);
+    let child = session(&host, Some(&root));
+    let sibling = session(&host, None);
+    for session in [&root, &child, &sibling] {
+        *session.image_reference.lock().unwrap() = Some(reference());
+    }
+    root.clone().close().await.unwrap();
+    assert!(root.image_reference.lock().unwrap().is_none());
+    assert!(child.image_reference.lock().unwrap().is_none());
+    assert!(sibling.image_reference.lock().unwrap().is_some());
+    host.close().await.unwrap();
+    assert!(sibling.image_reference.lock().unwrap().is_none());
+}
