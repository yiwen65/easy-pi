+//! Typed image facade. The producer still enters canonical get_window_state;
+//! only the image bytes bypass its JSON/base64 presentation envelope.
+use super::{refused, ComputerError, ComputerOperation};
+use cua_driver_contract::computer_image::{ComputerImage, COMPUTER_IMAGE_MAX_OUTPUT_EDGE};
+use cua_driver_contract::{ScrollDirection, WindowStateOutput};
+use std::sync::Arc;
+
+#[uniffi::export]
+impl ComputerOperation {
+    /// One single left click at a pixel center in the last returned native
+    /// image. A fresh image/geometry comparison is required before dispatch.
+    pub fn start_image_click(
+        self: Arc<Self>,
+        image_id: String,
+        x: u32,
+        y: u32,
+    ) -> Result<(), ComputerError> {
+        self.start_image_input(image_id, x, y, None)
+    }
+
+    /// One discrete line-wheel event at a current image pixel center. No
+    /// keyboard, AX-scroll or foreground fallback; effect remains unverified.
+    pub fn start_image_scroll(
+        self: Arc<Self>,
+        image_id: String,
+        x: u32,
+        y: u32,
+        direction: ScrollDirection,
+    ) -> Result<(), ComputerError> {
+        self.start_image_input(image_id, x, y, Some(direction))
+    }
+
+    pub fn start_capture(self: Arc<Self>, max_dimension: u32) -> Result<(), ComputerError> {
+        if max_dimension == 0 || max_dimension > COMPUTER_IMAGE_MAX_OUTPUT_EDGE {
+            return Err(refused("invalid_capture_bounds"));
+        }
+        // Browser is a distinct authority scope, not permission to use native AX
+        // or a generic native window route with a reconstructed PID.
+        let target = self.session.gate.native_window().map_err(refused)?;
+        self.start(
+            "get_window_state",
+            serde_json::json!({
+                "pid":target.pid,"window_id":target.window_id,
+                "include_accessibility_tree":false,"include_screenshot":true,
+                "max_dimension":max_dimension,
+            }),
+        )
+    }
+}
+
+impl ComputerOperation {
+    fn start_image_input(
+        self: &Arc<Self>,
+        image_id: String,
+        x: u32,
+        y: u32,
+        direction: Option<ScrollDirection>,
+    ) -> Result<(), ComputerError> {
+        if image_id.is_empty()
+            || image_id.len() > 64
+            || !image_id
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'_')
+        {
+            return Err(refused("invalid_image_reference"));
+        }
+        let target = self.session.gate.native_window().map_err(refused)?;
+        #[cfg(not(target_os = "macos"))]
+        {
+            let _ = (target, x, y, direction);
+            Err(refused("unsupported_platform"))
+        }
+        #[cfg(target_os = "macos")]
+        {
+            let mut args = serde_json::json!({"pid":target.pid,"window_id":target.window_id,"x":x,"y":y,"delivery_mode":"background"});
+            let tool = if let Some(direction) = direction {
+                args["direction"] = serde_json::json!(direction.as_str());
+                args["by"] = serde_json::json!("line");
+                args["amount"] = serde_json::json!(1);
+                "scroll"
+            } else {
+                args["action"] = serde_json::json!("press");
+                "click"
+            };
+            let worker = self.clone();
+            self.launch(None, async move {
+                let reference = worker.take_image_reference(&image_id, x, y)?;
+                platform_macos::input::controlled::scope(reference, worker.invoke(tool, args)).await
+            })
+        }
+    }
+}
+
+#[cfg(target_os = "macos")]
+impl ComputerOperation {
+    pub(super) fn take_image_reference(
+        &self,
+        id: &str,
+        x: u32,
+        y: u32,
+    ) -> Result<Arc<platform_macos::input::controlled::ImageReference>, ComputerError> {
+        let reference = self
+            .session
+            .image_reference
+            .lock()
+            .map_err(|_| self.session.host.quarantine())?
+            .take()
+            .ok_or_else(|| refused("stale_image_observation"))?;
+        reference.addresses(id, x, y).map_err(refused)?;
+        Ok(reference)
+    }
+}
+
+pub(super) fn validate_result(
+    image: &ComputerImage,
+    metadata: &WindowStateOutput,
+    pid: u32,
+    window_id: u64,
+    max_dimension: u32,
+) -> Result<(), ComputerError> {
+    image.validate().map_err(refused)?;
+    let geometry = &image.geometry;
+    if image.pid != pid
+        || image.window_id != window_id
+        || metadata.pid != pid
+        || metadata.window_id != window_id
+        || metadata.snapshot_id.as_deref() != Some(image.image_id.as_str())
+        || metadata.screenshot_width != Some(geometry.output_width)
+        || metadata.screenshot_height != Some(geometry.output_height)
+        || metadata.screenshot_frame_valid != Some(true)
+        || metadata.screenshot_mime_type.as_deref() != Some("image/png")
+        || metadata.screenshot_file_path.is_some()
+        || !metadata.images.is_empty()
+        || geometry.output_width > max_dimension
+        || geometry.output_height > max_dimension
+        || metadata.window_bounds.as_ref().is_none_or(|bounds| {
+            bounds.x.to_bits() != geometry.desktop_x.to_bits()
+                || bounds.y.to_bits() != geometry.desktop_y.to_bits()
+                || bounds.width.to_bits() != geometry.window_width.to_bits()
+                || bounds.height.to_bits() != geometry.window_height.to_bits()
+        })
+    {
+        return Err(refused("image_metadata_mismatch"));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use cua_driver_contract::computer_image::ComputerImageGeometry;
+
+    fn fixture() -> (ComputerImage, WindowStateOutput) {
+        let image = ComputerImage {
+            image_id: "image-fixture".into(),
+            pid: 7,
+            window_id: 9,
+            geometry: ComputerImageGeometry {
+                desktop_x: 0.0,
+                desktop_y: 0.0,
+                window_width: 1.0,
+                window_height: 1.0,
+                source_width: 1,
+                source_height: 1,
+                crop_x: 0,
+                crop_y: 0,
+                crop_width: 1,
+                crop_height: 1,
+                output_width: 1,
+                output_height: 1,
+            },
+            png: cua_driver_core::image_utils::encode_rgba_to_png(&[1, 2, 3, 255], 1, 1).unwrap(),
+        };
+        let metadata = serde_json::from_value(serde_json::json!({
+            "pid":7,"window_id":9,"snapshot_id":"image-fixture",
+            "screenshot_width":1,"screenshot_height":1,"screenshot_frame_valid":true,
+            "screenshot_mime_type":"image/png","window_bounds":{"x":0,"y":0,"width":1,"height":1}
+        }))
+        .unwrap();
+        (image, metadata)
+    }
+
+    #[test]
+    fn controlled_image_facade_requires_matching_canonical_metadata_and_target() {
+        let (image, metadata) = fixture();
+        assert!(validate_result(&image, &metadata, 7, 9, 1).is_ok());
+        assert!(validate_result(&image, &metadata, 8, 9, 1).is_err());
+        assert!(validate_result(&image, &metadata, 7, 10, 1).is_err());
+        assert!(validate_result(&image, &metadata, 7, 9, 0).is_err());
+        for mutate in [
+            |value: &mut WindowStateOutput| value.snapshot_id = Some("another-frame".into()),
+            |value: &mut WindowStateOutput| value.screenshot_width = Some(2),
+            |value: &mut WindowStateOutput| value.screenshot_frame_valid = Some(false),
+            |value: &mut WindowStateOutput| value.window_bounds.as_mut().unwrap().x = 1.0,
+            |value: &mut WindowStateOutput| {
+                value.screenshot_file_path = Some("not-image-bytes".into())
+            },
+        ] {
+            let mut wrong = metadata.clone();
+            mutate(&mut wrong);
+            assert!(validate_result(&image, &wrong, 7, 9, 1).is_err());
+        }
+    }
+}
