@@ -0,0 +1,381 @@
+//! Image-bound native pointer input. No global HID, fallback, duplicate
+//! transport, queued event batch or authority derived from caller geometry.
+use core_graphics::{
+    event::{CGEvent, CGEventFlags, CGEventType, CGMouseButton, ScrollEventUnit},
+    event_source::{CGEventSource, CGEventSourceStateID},
+    geometry::CGPoint,
+};
+use cua_driver_contract::ScrollDirection;
+pub use cua_driver_core::controlled::ImageReference;
+use cua_driver_core::controlled::Operation;
+use foreign_types::ForeignType;
+use std::{future::Future, sync::Arc};
+
+#[link(name = "CoreGraphics", kind = "framework")]
+unsafe extern "C" {
+    // Same two-FP ABI declaration as the existing mouse/interactive modules
+    // on supported macOS arm64; CGPoint is an HFA of two doubles there.
+    fn CGEventSetLocation(event: *mut std::ffi::c_void, x: f64, y: f64);
+    fn CGEventSourceCounterForEventType(state: i32, kind: u32) -> u32;
+    fn CGEventSourceButtonState(state: i32, button: u32) -> bool;
+    fn CGEventSourceKeyState(state: i32, key: u16) -> bool;
+}
+
+fn held_input(
+    keys: impl IntoIterator<Item = (u16, bool)>,
+    buttons: impl IntoIterator<Item = bool>,
+) -> bool {
+    // kVK_CapsLock (HIToolbox Events.h) reports a toggle state, not an
+    // ordinary held modifier. It does not modify this unmodified pointer pair;
+    // concurrent toggles are still detected by the FlagsChanged counter.
+    buttons.into_iter().any(|down| down) || keys.into_iter().any(|(key, down)| key != 0x39 && down)
+}
+
+// Public Quartz HID state, not a key/event stream: no input content is retained.
+// Private PID-routed synthetic events do not use the hardware state table.
+fn hardware_stamp() -> Result<[u32; 16], &'static str> {
+    let held = held_input(
+        (0..128).map(|key| (key, unsafe { CGEventSourceKeyState(1, key) })),
+        (0..3).map(|button| unsafe { CGEventSourceButtonState(1, button) }),
+    );
+    if held {
+        return Err("user_input_conflict");
+    }
+    Ok([1, 2, 3, 4, 5, 6, 7, 10, 11, 12, 22, 23, 24, 25, 26, 27]
+        .map(|kind| unsafe { CGEventSourceCounterForEventType(1, kind) }))
+}
+
+fn revalidate(reference: &ImageReference, operation: &Operation) -> Result<(), &'static str> {
+    let target = operation.session.native_window()?;
+    if !reference.target_matches(target.pid as u32, u64::from(target.window_id)) {
+        return Err("controlled_target_stale");
+    }
+    let geometry = reference.geometry();
+    let image = crate::capture::controlled::capture(
+        operation,
+        geometry.output_width.max(geometry.output_height),
+    )?;
+    if !reference.matches(&image) {
+        return Err("stale_image_observation");
+    }
+    operation.checkpoint()
+}
+
+tokio::task_local! { static REFERENCE: Arc<ImageReference>; }
+
+pub async fn scope<T>(reference: Arc<ImageReference>, future: impl Future<Output = T>) -> T {
+    REFERENCE.scope(reference, future).await
+}
+
+pub(crate) fn current() -> Option<Arc<ImageReference>> {
+    REFERENCE.try_with(Arc::clone).ok()
+}
+
+fn checked_primary<T>(
+    operation: &Operation,
+    validate: impl FnOnce() -> Result<(), &'static str>,
+    call: impl FnOnce() -> T,
+) -> Result<T, &'static str> {
+    operation.checkpoint()?;
+    validate()?;
+    operation.pointer_primary(call)
+}
+
+/// Once a down has been admitted, its matching up is a release obligation even
+/// if cancellation arrives meanwhile. This cannot emit another down, move or
+/// click. The caller's tracked blocking stack owns the complete lifetime.
+fn press_and_release(
+    operation: &Operation,
+    validate: impl FnOnce() -> Result<(), &'static str>,
+    down: impl FnOnce(),
+    release: impl FnOnce(),
+) -> Result<(), &'static str> {
+    struct Release<F: FnOnce()>(Option<F>);
+    impl<F: FnOnce()> Drop for Release<F> {
+        fn drop(&mut self) {
+            if let Some(release) = self.0.take() {
+                release();
+            }
+        }
+    }
+    let mut pending = Some(release);
+    checked_primary(operation, validate, || {
+        let _release = Release(pending.take());
+        down();
+    })
+}
+
+#[derive(Clone, Copy)]
+pub(crate) enum ImageAction {
+    Click,
+    Scroll(ScrollDirection),
+}
+
+fn wheel_delta(direction: ScrollDirection) -> (i32, i32) {
+    match direction {
+        ScrollDirection::Up => (1, 0),
+        ScrollDirection::Down => (-1, 0),
+        ScrollDirection::Left => (0, 1),
+        ScrollDirection::Right => (0, -1),
+    }
+}
+
+pub(crate) fn pointer(
+    operation: &Operation,
+    reference: &ImageReference,
+    x: u32,
+    y: u32,
+    action: ImageAction,
+    validate_target: impl Fn() -> Result<(), &'static str>,
+) -> Result<(), &'static str> {
+    let target = operation.session.native_window()?;
+    let hardware = hardware_stamp()?;
+    let geometry = reference.geometry();
+    let point = geometry.desktop_pixel_center(x, y)?;
+    revalidate(reference, operation)?;
+    let source = CGEventSource::new(CGEventSourceStateID::Private)
+        .map_err(|_| "pointer_event_unavailable")?;
+    // Group only this move/down/up, never distinct clicks on the same window.
+    let group = (uuid::Uuid::new_v4().as_u128() & i64::MAX as u128) as i64;
+    let stamp = |event: &CGEvent| -> Result<(), &'static str> {
+        event.set_flags(CGEventFlags::empty());
+        let ptr = event.as_ptr() as *mut std::ffi::c_void;
+        if !super::skylight::set_window_location(
+            ptr,
+            point.0 - geometry.desktop_x,
+            point.1 - geometry.desktop_y,
+        ) {
+            return Err("pointer_window_route_unavailable");
+        }
+        for (field, value) in [
+            (40, i64::from(target.pid)),
+            (51, i64::from(target.window_id)),
+            (91, i64::from(target.window_id)),
+            (92, i64::from(target.window_id)),
+        ] {
+            if !super::skylight::set_integer_field(ptr, field, value) {
+                return Err("pointer_window_route_unavailable");
+            }
+        }
+        Ok(())
+    };
+    let make = |kind: CGEventType, count: i64| -> Result<CGEvent, &'static str> {
+        let event = CGEvent::new_mouse_event(
+            source.clone(),
+            kind,
+            CGPoint::new(point.0, point.1),
+            CGMouseButton::Left,
+        )
+        .map_err(|_| "pointer_event_unavailable")?;
+        stamp(&event)?;
+        let ptr = event.as_ptr() as *mut std::ffi::c_void;
+        for (field, value) in [(1, count), (3, 0), (7, 3), (58, group)] {
+            if !super::skylight::set_integer_field(ptr, field, value) {
+                return Err("pointer_window_route_unavailable");
+            }
+        }
+        Ok(event)
+    };
+    // Allocate/stamp every event before the first input; no partial allocation
+    // can strand a pressed button. Never post through both public and SPI paths.
+    let moved = make(CGEventType::MouseMoved, 0)?;
+    enum Prepared {
+        Click(CGEvent, CGEvent),
+        Scroll(CGEvent),
+    }
+    let prepared = match action {
+        ImageAction::Click => Prepared::Click(
+            make(CGEventType::LeftMouseDown, 1)?,
+            make(CGEventType::LeftMouseUp, 1)?,
+        ),
+        ImageAction::Scroll(direction) => {
+            let (dy, dx) = wheel_delta(direction);
+            // Exactly one discrete line wheel event: no momentum/gesture
+            // stream, repeated ticks, AX/key path or transport fallback.
+            let wheel =
+                CGEvent::new_scroll_event(source.clone(), ScrollEventUnit::LINE, 2, dy, dx, 0)
+                    .map_err(|_| "pointer_event_unavailable")?;
+            unsafe {
+                CGEventSetLocation(wheel.as_ptr() as *mut std::ffi::c_void, point.0, point.1);
+            }
+            stamp(&wheel)?;
+            Prepared::Scroll(wheel)
+        }
+    };
+    let live = || {
+        target.process_stamp.is_some()
+            && crate::tools::computer_process_stamp(target.pid) == target.process_stamp
+    };
+    if !live() {
+        return Err("controlled_target_stale");
+    }
+    if hardware_stamp()? != hardware {
+        return Err("user_input_conflict");
+    }
+    let check = || {
+        validate_target()?;
+        if !live() {
+            return Err("controlled_target_stale");
+        }
+        if hardware_stamp()? != hardware {
+            return Err("user_input_conflict");
+        }
+        Ok(())
+    };
+    checked_primary(operation, &check, || moved.post_to_pid(target.pid))?;
+    // Hover is itself committed input and may change the picture. Refuse that
+    // change instead of assuming a tracking move is visually inert.
+    revalidate(reference, operation)?;
+    if !live() {
+        return Err("controlled_target_stale");
+    }
+    if hardware_stamp()? != hardware {
+        return Err("user_input_conflict");
+    }
+    match prepared {
+        Prepared::Click(down, up) => press_and_release(
+            operation,
+            &check,
+            || down.post_to_pid(target.pid),
+            || {
+                if live() {
+                    up.post_to_pid(target.pid);
+                } else {
+                    operation.quarantine();
+                }
+            },
+        ),
+        Prepared::Scroll(wheel) => {
+            checked_primary(operation, &check, || wheel.post_to_pid(target.pid))
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use cua_driver_contract::computer_image::{ComputerImage, ComputerImageGeometry};
+    use cua_driver_core::controlled::Gate;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    #[tokio::test]
+    async fn controlled_pointer_rechecks_target_after_tracking_before_final_primary() {
+        use std::sync::atomic::AtomicBool;
+        let gate = Gate::new();
+        let session = gate.session(None, Arc::new(|| true), 1, 2, None).unwrap();
+        let op = session.new_operation().unwrap();
+        op.begin().unwrap();
+        let modal = AtomicBool::new(false);
+        let input = AtomicUsize::new(0);
+        let validate = || {
+            if modal.load(Ordering::SeqCst) {
+                Err("unexpected_modal_surface")
+            } else {
+                Ok(())
+            }
+        };
+        checked_primary(&op, &validate, || {
+            input.fetch_add(1, Ordering::SeqCst);
+            modal.store(true, Ordering::SeqCst);
+        })
+        .unwrap();
+        let result = checked_primary(&op, &validate, || {
+            input.fetch_add(1, Ordering::SeqCst);
+        });
+        assert_eq!(result, Err("unexpected_modal_surface"));
+        assert_eq!(input.load(Ordering::SeqCst), 1);
+        op.finish();
+        let terminal = op.terminal().await.unwrap();
+        assert!(terminal.input_committed && !terminal.cancelled);
+    }
+
+    #[test]
+    fn controlled_pointer_caps_toggle_is_not_a_held_key_but_other_keys_and_buttons_are() {
+        assert!(!held_input([(0x39, true)], [false, false, false]));
+        assert!(held_input([(0x39, true), (0, true)], [false]));
+        assert!(held_input([(0x39, false)], [true]));
+        assert!(!held_input([(0, false), (1, false)], [false]));
+    }
+
+    #[test]
+    fn controlled_scroll_is_one_line_on_one_explicit_axis() {
+        assert_eq!(wheel_delta(ScrollDirection::Up), (1, 0));
+        assert_eq!(wheel_delta(ScrollDirection::Down), (-1, 0));
+        assert_eq!(wheel_delta(ScrollDirection::Left), (0, 1));
+        assert_eq!(wheel_delta(ScrollDirection::Right), (0, -1));
+    }
+
+    fn image() -> ComputerImage {
+        ComputerImage {
+            image_id: "image-fixture".into(),
+            pid: 1,
+            window_id: 2,
+            geometry: ComputerImageGeometry {
+                desktop_x: -2.0,
+                desktop_y: 3.0,
+                window_width: 1.0,
+                window_height: 1.0,
+                source_width: 1,
+                source_height: 1,
+                crop_x: 0,
+                crop_y: 0,
+                crop_width: 1,
+                crop_height: 1,
+                output_width: 1,
+                output_height: 1,
+            },
+            png: cua_driver_core::image_utils::encode_rgba_to_png(&[0, 0, 0, 255], 1, 1).unwrap(),
+        }
+    }
+
+    #[test]
+    fn controlled_pointer_reference_binds_identity_geometry_and_pixels_not_new_frame_id() {
+        let mut image = image();
+        let reference = ImageReference::from_image(&image).unwrap();
+        assert!(reference.addresses("image-fixture", 0, 0).is_ok());
+        assert!(reference.addresses("foreign", 0, 0).is_err());
+        assert!(reference.addresses("image-fixture", 1, 0).is_err());
+        image.image_id = "fresh-frame-id".into();
+        assert!(reference.matches(&image));
+        image.geometry.desktop_x += 1.0;
+        assert!(!reference.matches(&image));
+        image.geometry.desktop_x -= 1.0;
+        image.png =
+            cua_driver_core::image_utils::encode_rgba_to_png(&[255, 0, 0, 255], 1, 1).unwrap();
+        assert!(!reference.matches(&image));
+        image = super::tests::image();
+        image.pid = 3;
+        assert!(!reference.matches(&image));
+    }
+
+    #[tokio::test]
+    async fn controlled_pointer_cancel_before_down_never_emits_release_but_committed_down_does() {
+        for before in [true, false] {
+            let gate = Gate::new();
+            let session = gate.session(None, Arc::new(|| true), 1, 2, None).unwrap();
+            let op = session.new_operation().unwrap();
+            op.begin().unwrap();
+            let calls = AtomicUsize::new(0);
+            if before {
+                op.cancel();
+            }
+            let result = press_and_release(
+                &op,
+                || Ok(()),
+                || {
+                    calls.fetch_add(1, Ordering::SeqCst);
+                    op.cancel();
+                },
+                || {
+                    calls.fetch_add(10, Ordering::SeqCst);
+                },
+            );
+            assert_eq!(result.is_ok(), !before);
+            assert_eq!(calls.load(Ordering::SeqCst), if before { 0 } else { 11 });
+            op.finish();
+            let terminal = op.terminal().await.unwrap();
+            assert!(terminal.cancelled);
+            assert_eq!(terminal.input_committed, !before);
+        }
+    }
+}
