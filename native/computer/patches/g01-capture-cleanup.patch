+
+/// ScreenCaptureKit's exact-window still capture does not activate windows or
+/// enable AX. Keep cancellation and registered callback drain, but do not arm a
+/// focus-restoration lease or poll unrelated windows for a discarded result.
+/// AX observation is deliberately not routed here: first Chromium enablement
+/// writes accessibility attributes and needs its own readiness analysis.
+fn with_capture_cleanup(operation: &Operation, call: impl FnOnce() -> ToolResult) -> ToolResult {
+    if operation.session.native_window().is_err() {
+        return refusal("unsupported_route");
+    }
+    if operation.checkpoint().is_err() {
+        return refusal("controlled_cancelled");
+    }
+    let result = call();
+    if operation.wait_callbacks().is_err() {
+        return refusal("controlled_quarantined");
+    }
+    result
 }

