+#[tokio::test]
+async fn controlled_plan_expiry_cannot_change_an_established_terminal_receipt() {
+    let op = operation();
+    op.configure_plan(1, Duration::from_secs(30)).unwrap();
+    op.begin().unwrap();
+    op.begin_step(0).unwrap();
+    op.finish();
+    let receipt = op.terminal().await.unwrap();
+    op.state.lock().unwrap().deadline = Some(Instant::now());
+    assert!(op.deadline_expired());
+    assert_eq!(op.terminal().await.unwrap(), receipt);
+    assert!(!receipt.cancelled);
+}
+
+#[tokio::test]
+async fn controlled_plan_deadline_wakes_a_cancellation_waiter_without_another_primitive() {
+    let op = operation();
+    op.configure_plan(1, Duration::from_millis(5)).unwrap();
+    op.begin().unwrap();
+    op.begin_step(0).unwrap();
+    let work = op.track().unwrap();
+    // This tests elapsed-time behavior, not a concurrency race. No native work
+    // is timed out or dropped: the synthetic worker must still drain below.
+    tokio::time::timeout(Duration::from_secs(2), op.cancelled())
+        .await
+        .unwrap();
+    assert!(op.deadline_expired());
+    assert!(op.primary(true, || panic!("late input")).is_err());
+    op.finish();
+    assert!(!op.is_proven_terminal());
+    drop(work);
+    assert_eq!(
+        op.terminal().await.unwrap(),
+        Terminal {
+            cancelled: true,
+            input_committed: false
+        }
+    );
+}
