+use super::{Data, Reader, Scan};
+use crate::ax::{
+    bindings::*,
+    cache::{CachedSnapshot, RetainedElement},
+};
+use core_foundation::{
+    array::CFArray,
+    base::{CFEqual, CFGetTypeID, CFRelease, CFRetain, CFType, CFTypeRef, TCFType},
+    boolean::CFBoolean,
+    number::CFNumber,
+    string::CFString,
+};
+use cua_driver_core::controlled::Operation;
+
+pub(in super::super) struct Native<'a> {
+    pub operation: &'a Operation,
+}
+
+// Optional/unsupported is different from an unreadable attribute. Only the
+// former may represent an absent title/value or a leaf's absent AXChildren.
+unsafe fn attribute(element: AXUIElementRef, name: &str) -> Result<Option<CFType>, &'static str> {
+    let key = CFString::new(name);
+    let mut value: CFTypeRef = std::ptr::null();
+    let error = AXUIElementCopyAttributeValue(element, key.as_concrete_TypeRef(), &mut value);
+    if error == kAXErrorSuccess && !value.is_null() {
+        return Ok(Some(CFType::wrap_under_create_rule(value)));
+    }
+    if !value.is_null() {
+        CFRelease(value);
+    }
+    if error == kAXErrorAttributeUnsupported || error == kAXErrorNoValue {
+        Ok(None)
+    } else if error == kAXErrorAPIDisabled {
+        Err("accessibility_permission_denied")
+    } else {
+        Err("observation_read_failed")
+    }
+}
+
+pub(in super::super) unsafe fn string_attr(
+    element: AXUIElementRef,
+    name: &str,
+) -> Result<Option<String>, &'static str> {
+    let Some(value) = attribute(element, name)? else {
+        return Ok(None);
+    };
+    if value.type_of() != CFString::type_id() {
+        return Err("observation_attribute_type");
+    }
+    Ok(Some(
+        CFString::wrap_under_get_rule(value.as_CFTypeRef() as _).to_string(),
+    ))
+}
+
+unsafe fn bool_attr(element: AXUIElementRef, name: &str) -> Result<Option<bool>, &'static str> {
+    let Some(value) = attribute(element, name)? else {
+        return Ok(None);
+    };
+    let ptr = value.as_CFTypeRef();
+    if value.type_of() == CFBoolean::type_id() {
+        return Ok(Some(CFBoolean::wrap_under_get_rule(ptr as _).into()));
+    }
+    if value.type_of() == CFNumber::type_id() {
+        return match CFNumber::wrap_under_get_rule(ptr as _).to_f64() {
+            Some(0.0) => Ok(Some(false)),
+            Some(1.0) => Ok(Some(true)),
+            _ => Err("observation_attribute_type"),
+        };
+    }
+    Err("observation_attribute_type")
+}
+
+unsafe fn elements(
+    element: AXUIElementRef,
+    name: &str,
+) -> Result<Vec<RetainedElement>, &'static str> {
+    let Some(value) = attribute(element, name)? else {
+        return Ok(Vec::new());
+    };
+    if value.type_of() != CFArray::<CFTypeRef>::type_id() {
+        return Err("observation_attribute_type");
+    }
+    let array = CFArray::<CFTypeRef>::wrap_under_get_rule(value.as_CFTypeRef() as _);
+    if array.len() > 512 {
+        return Err("observation_bounds");
+    }
+    let mut result = Vec::new();
+    for ptr in array.iter() {
+        if ptr.is_null() || CFGetTypeID(*ptr) != AXUIElementGetTypeID() {
+            return Err("observation_attribute_type");
+        }
+        result.push(RetainedElement::retain(*ptr as usize));
+    }
+    Ok(result)
+}
+
+unsafe fn identity(element: AXUIElementRef) -> Result<Data, &'static str> {
+    Ok(Data {
+        role: string_attr(element, "AXRole")?
+            .filter(|s| !s.is_empty())
+            .ok_or("observation_role_missing")?,
+        subrole: string_attr(element, "AXSubrole")?,
+        modal: bool_attr(element, "AXModal")?.unwrap_or(false),
+        ..Data::default()
+    })
+}
+
+impl Native<'_> {
+    fn bound(&self, element: AXUIElementRef) -> Result<(), &'static str> {
+        self.checkpoint()?;
+        let error = self.operation.primary(false, || unsafe {
+            AXUIElementSetMessagingTimeout(element, 2.0)
+        })?;
+        if error == kAXErrorSuccess {
+            Ok(())
+        } else {
+            Err("observation_timeout_unavailable")
+        }
+    }
+
+    /// Only roles/window identifiers of other top-level surfaces are read, not
+    /// their contents. A sheet, dialog or menu anywhere on this process pauses
+    /// the exact-window route instead of silently ignoring a competing surface.
+    pub fn exact_window(&self) -> Result<RetainedElement, &'static str> {
+        self.checkpoint()?;
+        let app = self.operation.primary(false, || unsafe {
+            AXUIElementCreateApplication(self.operation.session.pid)
+        })?;
+        if app.is_null() {
+            return Err("controlled_target_unproven");
+        }
+        let app = unsafe {
+            let owned = RetainedElement::retain(app as usize);
+            CFRelease(app as CFTypeRef);
+            owned
+        };
+        let ptr = app.as_ptr() as AXUIElementRef;
+        self.bound(ptr)?;
+        // The application RAII owner outlives this bounded enablement/read.
+        unsafe {
+            crate::ax::enablement::ensure_chromium_ax_enabled(self.operation.session.pid, ptr);
+        }
+        let mut roots = unsafe { elements(ptr, "AXWindows")? };
+        for element in unsafe { elements(ptr, "AXChildren")? } {
+            if !roots.iter().any(|root| self.same(root, &element)) {
+                roots.push(element);
+            }
+        }
+        if roots.len() > 512 {
+            return Err("observation_bounds");
+        }
+        let mut matched = None;
+        for root in roots {
+            let ptr = root.as_ptr() as AXUIElementRef;
+            self.bound(ptr)?;
+            let data = unsafe { identity(ptr)? };
+            if data.unexpected_surface() {
+                return Err("unexpected_modal_surface");
+            }
+            match data.role.as_str() {
+                "AXWindow" => {
+                    let id =
+                        unsafe { ax_get_window_id(ptr) }.ok_or("controlled_target_unproven")?;
+                    if id == self.operation.session.window_id {
+                        if matched.is_some() {
+                            return Err("controlled_target_ambiguous");
+                        }
+                        if !unsafe { elements(ptr, "AXSheets")? }.is_empty() {
+                            return Err("unexpected_modal_surface");
+                        }
+                        matched = Some(root);
+                    }
+                }
+                "AXMenuBar" => {}
+                _ => return Err("controlled_target_unproven"),
+            }
+        }
+        matched.ok_or("controlled_target_unproven")
+    }
+}
+
+impl Reader for Native<'_> {
+    type Element = RetainedElement;
+    fn checkpoint(&self) -> Result<(), &'static str> {
+        self.operation.checkpoint()?;
+        if self
+            .operation
+            .primary(false, || unsafe { AXIsProcessTrusted() })?
+        {
+            Ok(())
+        } else {
+            Err("accessibility_permission_denied")
+        }
+    }
+    fn same(&self, a: &RetainedElement, b: &RetainedElement) -> bool {
+        unsafe { CFEqual(a.as_ptr() as CFTypeRef, b.as_ptr() as CFTypeRef) != 0 }
+    }
+    fn data(&self, element: &RetainedElement) -> Result<Data, &'static str> {
+        let ptr = element.as_ptr() as AXUIElementRef;
+        self.bound(ptr)?;
+        unsafe {
+            let mut data = identity(ptr)?;
+            let title = string_attr(ptr, "AXTitle")?;
+            let description = string_attr(ptr, "AXDescription")?;
+            let identifier = string_attr(ptr, "AXIdentifier")?;
+            data.label = [title, description, identifier]
+                .into_iter()
+                .flatten()
+                .find(|s| !s.is_empty());
+            // Conditions in this route are string-valued only. Non-string
+            // controls remain observable, but cannot prove a string condition.
+            if data.subrole.as_deref() != Some("AXSecureTextField") {
+                if let Some(value) = attribute(ptr, "AXValue")? {
+                    if value.type_of() == CFString::type_id() {
+                        data.value = Some(
+                            CFString::wrap_under_get_rule(value.as_CFTypeRef() as _).to_string(),
+                        );
+                    }
+                }
+            }
+            data.enabled = bool_attr(ptr, "AXEnabled")?;
+            let mut actions = std::ptr::null();
+            let error = AXUIElementCopyActionNames(ptr, &mut actions);
+            if error == kAXErrorSuccess && !actions.is_null() {
+                let array = CFArray::<CFTypeRef>::wrap_under_create_rule(actions);
+                if array.len() > 64 {
+                    return Err("observation_bounds");
+                }
+                for action in array.iter() {
+                    if action.is_null() || CFGetTypeID(*action) != CFString::type_id() {
+                        return Err("observation_attribute_type");
+                    }
+                    data.actions
+                        .push(CFString::wrap_under_get_rule(*action as _).to_string());
+                }
+            } else {
+                if !actions.is_null() {
+                    CFRelease(actions as CFTypeRef);
+                }
+                if error != kAXErrorAttributeUnsupported && error != kAXErrorNoValue {
+                    return Err("observation_read_failed");
+                }
+            }
+            if matches!(data.role.as_str(), "AXTextField" | "AXTextArea") {
+                let key = CFString::new("AXValue");
+                let mut settable = 0;
+                let error =
+                    AXUIElementIsAttributeSettable(ptr, key.as_concrete_TypeRef(), &mut settable);
+                if error == kAXErrorSuccess {
+                    data.settable = settable != 0;
+                } else if error != kAXErrorAttributeUnsupported && error != kAXErrorNoValue {
+                    return Err("observation_read_failed");
+                }
+            }
+            Ok(data)
+        }
+    }
+    fn children(&self, element: &RetainedElement) -> Result<Vec<RetainedElement>, &'static str> {
+        self.checkpoint()?;
+        unsafe { elements(element.as_ptr() as AXUIElementRef, "AXChildren") }
+    }
+}
+
+impl Scan<RetainedElement> {
+    pub fn payload(&self) -> CachedSnapshot {
+        CachedSnapshot {
+            elements: self
+                .rows
+                .iter()
+                .map(|row| {
+                    if self.complete() && row.addressable() {
+                        let ptr = row.element.as_ptr();
+                        unsafe {
+                            CFRetain(ptr as CFTypeRef);
+                        }
+                        ptr
+                    } else {
+                        0
+                    }
+                })
+                .collect(),
+        }
+    }
+}
