+//! Controlled AX observations. Completeness means the bounded, reported AXChildren
+//! hierarchy was read without a cut, unreadable identity/label, cycle or modal
+//! surface. It is not a claim about pixels, hidden DOM, or an atomic app snapshot.
+use serde_json::{json, Value};
+
+mod native;
+pub(super) use native::{string_attr, Native};
+
+#[derive(Clone, Default)]
+pub(super) struct Data {
+    pub role: String,
+    pub subrole: Option<String>,
+    pub label: Option<String>,
+    pub value: Option<String>,
+    pub enabled: Option<bool>,
+    pub actions: Vec<String>,
+    pub settable: bool,
+    pub modal: bool,
+}
+
+impl Data {
+    pub fn fillable(&self) -> bool {
+        matches!(self.role.as_str(), "AXTextField" | "AXTextArea")
+            && self.subrole.as_deref() != Some("AXSecureTextField")
+            && self.enabled == Some(true)
+            && self.settable
+    }
+
+    pub fn pressable(&self) -> bool {
+        self.enabled == Some(true) && self.actions.iter().any(|action| action == "AXPress")
+    }
+
+    fn unexpected_surface(&self) -> bool {
+        self.modal
+            || matches!(
+                self.role.as_str(),
+                "AXSheet" | "AXMenu" | "AXPopover" | "AXDrawer"
+            )
+            || matches!(self.subrole.as_deref(), Some("AXDialog" | "AXSystemDialog"))
+    }
+
+    fn web(&self) -> bool {
+        let role = self
+            .role
+            .chars()
+            .filter(|c| c.is_ascii_alphanumeric())
+            .flat_map(char::to_lowercase)
+            .collect::<String>();
+        role.contains("webarea") || role.contains("documentweb") || role == "document"
+    }
+
+    fn bytes(&self) -> usize {
+        self.role.len()
+            + self.subrole.as_ref().map_or(0, String::len)
+            + self.label.as_ref().map_or(0, String::len)
+            + self.value.as_ref().map_or(0, String::len)
+            + self.actions.iter().map(String::len).sum::<usize>()
+    }
+}
+
+pub(super) trait Reader {
+    type Element: Clone;
+    fn checkpoint(&self) -> Result<(), &'static str>;
+    fn same(&self, a: &Self::Element, b: &Self::Element) -> bool;
+    fn data(&self, element: &Self::Element) -> Result<Data, &'static str>;
+    fn children(&self, element: &Self::Element) -> Result<Vec<Self::Element>, &'static str>;
+}
+
+pub(super) struct Row<E> {
+    pub element: E,
+    pub data: Data,
+    pub depth: usize,
+    pub parent: Option<usize>,
+    pub web: bool,
+}
+
+impl<E> Row<E> {
+    pub fn addressable(&self) -> bool {
+        !self.web && (self.data.pressable() || self.data.fillable())
+    }
+}
+
+pub(super) struct Scan<E> {
+    pub rows: Vec<Row<E>>,
+    pub truncated: bool,
+    pub failure: Option<&'static str>,
+}
+
+impl<E> Scan<E> {
+    pub fn complete(&self) -> bool {
+        !self.truncated && self.failure.is_none()
+    }
+
+    pub fn elements(&self, snapshot: u32) -> Vec<Value> {
+        self.rows
+            .iter()
+            .enumerate()
+            .map(|(index, row)| {
+                let mut value = json!({
+                    "element_index": index, "role": row.data.role, "depth": row.depth,
+                    "in_web_content": row.web,
+                });
+                if self.complete() && row.addressable() {
+                    value["element_token"] =
+                        json!(cua_driver_core::element_token::token_for(snapshot, index));
+                }
+                if let Some(label) = &row.data.label {
+                    value["label"] = json!(label);
+                }
+                // Preserve empty and whitespace strings exactly. No placeholder or
+                // trimmed value may become condition evidence.
+                if let Some(raw) = &row.data.value {
+                    value["value"] = json!(raw);
+                }
+                if let Some(enabled) = row.data.enabled {
+                    value["enabled"] = json!(enabled);
+                }
+                if let Some(parent) = row.parent {
+                    value["parent_index"] = json!(parent);
+                }
+                if !row.data.actions.is_empty() {
+                    value["actions"] = json!(row.data.actions);
+                }
+                value
+            })
+            .collect()
+    }
+}
+
+pub(super) fn scan<R: Reader>(
+    reader: &R,
+    root: R::Element,
+    max_elements: usize,
+    max_depth: usize,
+) -> Scan<R::Element> {
+    let mut output = Scan {
+        rows: Vec::<Row<R::Element>>::new(),
+        truncated: false,
+        failure: None,
+    };
+    let mut pending = vec![(root, 0, None, false)];
+    let mut bytes = 0;
+    while let Some((element, depth, parent, inherited_web)) = pending.pop() {
+        if depth > max_depth || output.rows.len() >= max_elements {
+            output.truncated = true;
+            break;
+        }
+        if let Err(code) = reader.checkpoint() {
+            output.failure = Some(code);
+            break;
+        }
+        if output
+            .rows
+            .iter()
+            .any(|row| reader.same(&row.element, &element))
+        {
+            output.failure = Some("observation_repeated_element");
+            break;
+        }
+        let data = match reader.data(&element) {
+            Ok(data) => data,
+            Err(code) => {
+                output.failure = Some(code);
+                break;
+            }
+        };
+        bytes += data.bytes();
+        if bytes > 64 * 1024 {
+            output.truncated = true;
+            break;
+        }
+        if data.unexpected_surface() {
+            output.failure = Some("unexpected_modal_surface");
+            break;
+        }
+        let web = inherited_web || data.web();
+        let index = output.rows.len();
+        let children = reader.children(&element);
+        output.rows.push(Row {
+            element,
+            data,
+            depth,
+            parent,
+            web,
+        });
+        match children {
+            Ok(children) => {
+                // AXChildren is a hierarchy, not a filtered list of actionable
+                // rows. Non-actionable nodes and actual depth consume the caps.
+                if output.rows.len() + pending.len() + children.len() > max_elements {
+                    output.truncated = true;
+                    break;
+                }
+                pending.extend(
+                    children
+                        .into_iter()
+                        .rev()
+                        .map(|child| (child, depth + 1, Some(index), web)),
+                );
+            }
+            Err("observation_bounds") => {
+                output.truncated = true;
+                break;
+            }
+            Err(code) => {
+                output.failure = Some(code);
+                break;
+            }
+        }
+    }
+    output
+}
