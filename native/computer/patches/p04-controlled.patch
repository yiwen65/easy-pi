+    operation.core.begin().unwrap();
+    let work = operation.core.track_callback().unwrap();
+    let mut terminal = Box::pin(operation.terminal());
+    let mut result = Box::pin(operation.result());
+    let mut context = Context::from_waker(Waker::noop());
+    assert!(terminal.as_mut().poll(&mut context).is_pending());
+    assert!(result.as_mut().poll(&mut context).is_pending());
+    drop(terminal);
+    drop(result);
+    assert!(operation.core.checkpoint().is_ok());
+    assert!(!operation.core.is_proven_terminal());
+
+    // Synthetic producer completion still cannot skip outstanding cleanup.
+    operation.core.finish();
+    let mut closer = Box::pin(host.clone().close());
+    assert!(closer.as_mut().poll(&mut context).is_pending());
+    assert!(!operation.core.is_proven_terminal());
+    assert!(host.runtime.is_running());
+    assert!(!host.gate.is_quarantined());
+    drop(work);
+    let terminal = operation.terminal().await.unwrap();
+    assert!(terminal.cancelled && !terminal.input_committed);
+    assert!(matches!(
+        operation.result().await,
+        Err(ComputerError::Cancelled {
+            input_committed: false
+        })
+    ));
+    closer.await.unwrap();
+    assert!(!host.runtime.is_running());
+    let weak_operation = Arc::downgrade(&operation);
