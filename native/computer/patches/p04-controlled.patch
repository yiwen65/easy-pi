+        assert!(op.begin_step(1).is_err());
+        assert!(op.primary(true, || panic!("revoked input")).is_err());
+        op.finish();
+        assert_eq!(
+            op.terminal().await.unwrap(),
+            Terminal {
+                cancelled: true,
+                input_committed: true
+            }
+        );
+    }
+}
