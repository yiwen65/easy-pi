+#[tokio::test]
+async fn controlled_ancestor_cancel_wakes_scheduler_waiter() {
+    let gate = Gate::new();
+    let parent = session(&gate, None);
+    let op = session(&gate, Some(parent.clone()))
+        .new_operation()
+        .unwrap();
+    op.begin().unwrap();
+    pending(op.cancelled());
+    parent.revoke();
+    op.cancelled().await;
+    op.finish();
+    assert!(op.terminal().await.unwrap().cancelled);
+}
+
+fn poison<T>(mutex: &Mutex<T>) {
+    assert!(std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        let _guard = mutex.lock().unwrap();
+        panic!("synthetic controlled poison");
+    }))
+    .is_err());
+}
+
+#[tokio::test]
+async fn controlled_poisoned_gate_never_admits_or_acknowledges() {
+    let gate = Gate::new();
+    let node = session(&gate, None);
+    let op = node.new_operation().unwrap();
+    op.begin().unwrap();
+    poison(&gate.closed);
+    assert!(op
+        .primary(true, || panic!("poison admitted input"))
+        .is_err());
+    op.finish();
+    assert_eq!(op.terminal().await, Err("quarantined"));
+    assert!(node.new_operation().is_err());
+    assert!(gate.is_quarantined());
+}
+
+#[tokio::test]
+async fn controlled_poison_detection_wakes_an_existing_terminal_waiter() {
+    struct CountWakes(AtomicUsize);
+    impl std::task::Wake for CountWakes {
+        fn wake(self: Arc<Self>) {
+            self.0.fetch_add(1, Ordering::SeqCst);
+        }
+        fn wake_by_ref(self: &Arc<Self>) {
+            self.0.fetch_add(1, Ordering::SeqCst);
+        }
+    }
+    let gate = Gate::new();
+    let op = session(&gate, None).new_operation().unwrap();
+    op.begin().unwrap();
+    let wakes = Arc::new(CountWakes(AtomicUsize::new(0)));
+    let waker = Waker::from(wakes.clone());
+    let mut terminal = Box::pin(op.terminal());
+    assert!(matches!(
+        terminal.as_mut().poll(&mut Context::from_waker(&waker)),
+        Poll::Pending
+    ));
+    poison(&op.state);
+    op.cancel();
+    assert!(wakes.0.load(Ordering::SeqCst) > 0);
+    assert_eq!(terminal.await, Err("quarantined"));
+}
+
+#[tokio::test]
+async fn controlled_poisoned_operation_state_closes_the_whole_host() {
+    let gate = Gate::new();
+    let node = session(&gate, None);
+    let op = node.new_operation().unwrap();
+    op.begin().unwrap();
+    poison(&op.state);
+    op.cancel();
+    op.finish();
+    assert_eq!(op.terminal().await, Err("quarantined"));
+    assert!(node.new_operation().is_err());
+    assert!(gate.is_quarantined());
+}
+
+#[tokio::test]
+async fn controlled_poisoned_session_state_is_not_a_cancelled_success() {
+    for snapshot in [false, true] {
+        let gate = Gate::new();
+        let node = session(&gate, None);
+        let op = node.new_operation().unwrap();
+        op.begin().unwrap();
+        if snapshot {
+            poison(&node.snapshot);
+        } else {
+            poison(&node.revoked);
+        }
+        op.finish();
+        assert_eq!(op.terminal().await, Err("quarantined"));
+        assert!(node.new_operation().is_err());
+        assert!(gate.is_quarantined());
+    }
+}
+
+#[tokio::test]
+async fn controlled_panicking_registered_worker_quarantines_without_double_panic() {
+    let gate = Gate::new();
+    let op = session(&gate, None).new_operation().unwrap();
+    op.begin().unwrap();
+    let work = op.track().unwrap();
+    assert!(
+        std::panic::catch_unwind(std::panic::AssertUnwindSafe(move || {
+            let _work = work;
+            panic!("synthetic worker panic");
+        }))
+        .is_err()
+    );
+    op.finish();
+    assert_eq!(op.terminal().await, Err("quarantined"));
+    assert!(gate.is_quarantined());
+}
+
+#[tokio::test]
+async fn controlled_abandoned_inert_handle_settles_but_lost_producer_quarantines() {
+    let gate = Gate::new();
+    let node = session(&gate, None);
+    let inert = node.new_operation().unwrap();
+    inert.abandon();
+    assert_eq!(
+        inert.terminal().await.unwrap(),
+        Terminal {
+            cancelled: true,
+            input_committed: false
+        }
+    );
+    assert!(!gate.is_quarantined());
+    let active = node.new_operation().unwrap();
+    active.begin().unwrap();
+    active.abandon();
+    assert_eq!(active.terminal().await, Err("quarantined"));
+    assert!(node.new_operation().is_err());
+}
+
+#[tokio::test]
+async fn controlled_native_authorization_rechecked_at_each_primitive() {
+    let gate = Gate::new();
+    let live = Arc::new(AtomicBool::new(true));
+    let check = live.clone();
+    let node = gate
+        .session(
+            None,
+            Arc::new(move || check.load(Ordering::Acquire)),
+            42,
+            7,
+            None,
+        )
+        .unwrap();
+    let op = node.new_operation().unwrap();
+    op.begin().unwrap();
+    op.primary(false, || ()).unwrap();
+    live.store(false, Ordering::Release);
+    assert!(op.primary(true, || panic!("expired input")).is_err());
+    op.finish();
+    assert_eq!(
+        op.terminal().await.unwrap(),
+        Terminal {
+            cancelled: true,
+            input_committed: false
+        }
+    );
+    assert!(op.remember_snapshot(1, || ()).is_err());
+}
