+#[tokio::test]
+async fn controlled_plan_expiry_blocks_next_input_but_does_not_release_active_worker() {
+    let op = operation();
+    op.configure_plan(2, Duration::from_secs(30)).unwrap();
+    op.begin().unwrap();
+    op.begin_step(0).unwrap();
+    op.primary(true, || ()).unwrap();
+    let work = op.track().unwrap();
+    // Deterministic expiry, not a timing/sleep assertion.
+    op.state.lock().unwrap().deadline = Some(Instant::now());
+    assert!(op.deadline_expired());
+    assert!(op.checkpoint().is_err());
+    assert!(op.begin_step(1).is_err());
+    assert!(op.primary(true, || panic!("late input")).is_err());
+    op.finish();
+    assert!(!op.is_proven_terminal());
+    drop(work);
+    assert_eq!(
+        op.terminal().await.unwrap(),
+        Terminal {
+            cancelled: true,
+            input_committed: true
+        }
+    );
+}
