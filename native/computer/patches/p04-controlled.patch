+impl PlanBackend for Fake {
+    fn cached(&self) -> Option<WindowStateOutput> {
+        self.cache.lock().unwrap().clone()
+    }
+    fn begin_step(&self, index: u32) -> Result<(), &'static str> {
+        if self.cancel_before_step == Some(index) {
+            self.op.cancel();
+        }
+        self.op.begin_step(index)
+    }
+    fn checkpoint(&self) -> Result<(), &'static str> {
+        self.op.checkpoint()
+    }
+    fn input_committed(&self) -> bool {
+        self.op.step_input_committed()
+    }
+    async fn observe(&self) -> Result<WindowStateOutput, &'static str> {
+        self.checkpoint()?;
+        let count = self.reads.fetch_add(1, Ordering::SeqCst) + 1;
+        let mut value = self.observation.lock().unwrap().clone();
+        let snapshot = format!("s{:08x}", count + 1);
+        value.snapshot_id = Some(snapshot.clone());
+        for element in value.elements.as_mut().unwrap() {
+            if element.element_token.is_some() {
+                element.element_token = Some(format!("{snapshot}:{}", element.element_index));
+            }
+        }
+        if self.duplicate_on_read == Some(count) {
+            let duplicate = value.elements.as_ref().unwrap()[0].clone();
+            value.elements.as_mut().unwrap().push(duplicate);
+        }
+        if let Some((read, reason)) = self.degraded_on_read {
+            if read == count {
+                value.elements_complete = Some(false);
+                value.degraded = Some(true);
+                value.degraded_reason = Some(reason.into());
+                for element in value.elements.as_mut().unwrap() {
+                    element.element_token = None;
+                }
+            }
+        }
+        *self.cache.lock().unwrap() = Some(value.clone());
+        Ok(value)
+    }
+    async fn act(&self, token: String, text: Option<String>) -> Result<ActionResult, &'static str> {
+        if self.refuse_before_input {
+            return Err("permission_denied");
+        }
+        let observation = self.cached().ok_or("stale_observation")?;
+        let target = reference(&observation, &token)?.element_index as usize;
+        let count = self
+            .op
+            .primary(true, || self.inputs.fetch_add(1, Ordering::SeqCst) + 1)?;
+        *self.cache.lock().unwrap() = None;
+        if self.lost_after_input == Some(count) {
+            return Err("native_fault");
+        }
+        let fill = text.is_some();
+        if !self.wrong_readback {
+            match text {
+                Some(text) => {
+                    self.observation.lock().unwrap().elements.as_mut().unwrap()[target].value =
+                        Some(text)
+                }
+                None => {
+                    self.observation.lock().unwrap().elements.as_mut().unwrap()[3].value =
+                        Some("saved".into())
+                }
+            }
+        }
+        if self.cancel_after_input == Some(count) {
+            self.op.cancel();
+        }
+        Ok(ActionResult {
+            effect: if fill {
+                ActionEffect::Confirmed
+            } else {
+                ActionEffect::Unverifiable
+            },
+            route: ActionRoute::Accessibility,
+            delivery: Some(ActionDelivery {
+                mode: ActionDeliveryMode::Background,
+                delivered_count: Some(1),
+            }),
+            evidence: fill.then(|| {
+                vec![ActionEvidence {
+                    kind: ActionEvidenceKind::ValueReadback,
+                }]
+            }),
+            escalation: None,
+        })
+    }
+}
