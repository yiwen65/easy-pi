+#[tokio::test]
+async fn controlled_failed_proof_never_acknowledges_terminal() {
+    let op = session(&Gate::new(), None).new_operation().unwrap();
+    op.begin().unwrap();
+    op.quarantine();
+    op.finish();
+    assert_eq!(op.terminal().await, Err("quarantined"));
+    assert!(op.primary(true, || ()).is_err());
+}
+
+#[tokio::test]
+async fn controlled_session_scopes_and_consumes_its_snapshot() {
+    let gate = Gate::new();
+    let op = session(&gate, None).new_operation().unwrap();
+    op.begin().unwrap();
+    op.remember_snapshot(7, || ()).unwrap();
+    let foreign = session(&gate, None).new_operation().unwrap();
+    assert!(foreign.consume_token("s00000007:0").is_err());
