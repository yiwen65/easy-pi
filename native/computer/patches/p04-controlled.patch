+use super::*;
+use cua_driver_contract::{ActionDelivery, ActionDeliveryMode, ActionEvidence, ActionRoute};
+use cua_driver_core::controlled::{Gate, Operation};
+use std::sync::{
+    atomic::{AtomicU32, Ordering},
+    Arc, Mutex,
+};
+use std::time::Duration;
+
+struct Fake {
+    op: Arc<Operation>,
+    observation: Mutex<WindowStateOutput>,
+    cache: Mutex<Option<WindowStateOutput>>,
+    reads: AtomicU32,
+    inputs: AtomicU32,
+    duplicate_on_read: Option<u32>,
+    degraded_on_read: Option<(u32, &'static str)>,
+    cancel_after_input: Option<u32>,
+    cancel_before_step: Option<u32>,
+    lost_after_input: Option<u32>,
+    refuse_before_input: bool,
+    wrong_readback: bool,
+}
+
+fn selector(label: &str) -> ComputerSelector {
+    ComputerSelector {
+        role: "AXTextField".into(),
+        label: label.into(),
+    }
+}
+fn address(label: &str) -> ComputerAddress {
+    ComputerAddress::Selector {
+        selector: selector(label),
+    }
+}
+fn fill(label: &str, text: &str) -> ComputerStep {
+    ComputerStep::Fill {
+        target: address(label),
+        text: text.into(),
+    }
+}
+fn plan(steps: Vec<ComputerStep>) -> ComputerPlan {
+    ComputerPlan {
+        snapshot_id: "s00000001".into(),
+        steps,
+    }
+}
+
+impl Fake {
+    fn new() -> Self {
+        let value: WindowStateOutput = serde_json::from_value(serde_json::json!({
+            "pid":42,"window_id":7,"snapshot_id":"s00000001","elements_complete":true,"truncated":false,
+            "elements":[
+                {"element_index":0,"depth":0,"role":"AXTextField","label":"Name","value":"","enabled":true,"in_web_content":false,"element_token":"s00000001:0"},
+                {"element_index":1,"depth":0,"role":"AXTextField","label":"City","value":"","enabled":true,"in_web_content":false,"element_token":"s00000001:1"},
+                {"element_index":2,"depth":0,"role":"AXButton","label":"Save","enabled":true,"in_web_content":false,"element_token":"s00000001:2"},
+                {"element_index":3,"depth":0,"role":"AXStaticText","label":"Result","value":"","in_web_content":false}
+            ]
+        })).unwrap();
+        let op = Gate::new()
+            .session(None, Arc::new(|| true), 42, 7, None)
+            .unwrap()
+            .new_operation()
+            .unwrap();
+        Self {
+            op,
+            observation: Mutex::new(value.clone()),
+            cache: Mutex::new(Some(value)),
+            reads: AtomicU32::new(0),
+            inputs: AtomicU32::new(0),
+            duplicate_on_read: None,
+            degraded_on_read: None,
+            cancel_after_input: None,
+            cancel_before_step: None,
+            lost_after_input: None,
+            refuse_before_input: false,
+            wrong_readback: false,
+        }
+    }
+    async fn run(&self, plan: ComputerPlan) -> ComputerPlanResult {
+        self.op
+            .configure_plan(
+                plan.steps.len().max(1).min(8) as u32,
+                Duration::from_secs(30),
+            )
+            .unwrap();
+        self.op.begin().unwrap();
+        let result = execute(self, plan).await;
+        self.op.finish();
+        self.op.terminal().await.unwrap();
+        result
+    }
+}
