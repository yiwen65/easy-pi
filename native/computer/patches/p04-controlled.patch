+#[tokio::test]
+async fn controlled_plan_allows_one_input_per_ordered_step_and_keeps_aggregate_receipt() {
+    let op = operation();
+    op.configure_plan(3, Duration::from_secs(30)).unwrap();
+    op.begin().unwrap();
+    assert!(op.primary(true, || panic!("no step admitted")).is_err());
+    assert!(op.begin_step(1).is_err());
+    for index in 0..3 {
+        op.begin_step(index).unwrap();
+        assert!(!op.step_input_committed());
+        if index < 2 {
+            op.primary(true, || ()).unwrap();
+            assert!(op.step_input_committed());
+            assert!(op.primary(true, || panic!("duplicate input")).is_err());
+        }
+        assert!(op.begin_step(index).is_err());
+    }
+    assert!(op.begin_step(3).is_err());
+    op.finish();
+    assert_eq!(
+        op.terminal().await.unwrap(),
+        Terminal {
+            cancelled: false,
+            input_committed: true
+        }
+    );
+}
+
+#[test]
+fn controlled_plan_configuration_is_bounded_inert_and_single_attempt() {
+    let op = operation();
+    for count in [0, 9, u32::MAX] {
+        assert!(op.configure_plan(count, Duration::from_secs(1)).is_err());
+    }
+    for timeout in [Duration::ZERO, Duration::from_secs(31)] {
+        assert!(op.configure_plan(1, timeout).is_err());
+    }
+    op.configure_plan(1, Duration::from_secs(1)).unwrap();
+    assert!(op.configure_plan(2, Duration::from_secs(1)).is_err());
+    op.begin().unwrap();
+    assert!(op.configure_plan(1, Duration::from_secs(1)).is_err());
+    assert_eq!(op.begin(), Err("already_started"));
+    op.finish();
+    assert!(op.begin_step(0).is_err());
+}
+
+#[tokio::test]
+async fn controlled_plan_cannot_advance_while_native_work_or_callbacks_are_retained() {
+    let op = operation();
+    op.configure_plan(2, Duration::from_secs(30)).unwrap();
+    op.begin().unwrap();
+    op.begin_step(0).unwrap();
+    op.primary(true, || ()).unwrap();
+    let worker = op.track().unwrap();
+    let callback = op.track_callback().unwrap();
+    assert!(op.begin_step(1).is_err());
+    drop(worker);
+    assert!(op.begin_step(1).is_err());
+    drop(callback);
+    op.begin_step(1).unwrap();
+    op.primary(true, || ()).unwrap();
+    op.finish();
+    assert!(op.terminal().await.unwrap().input_committed);
+}
