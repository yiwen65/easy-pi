+use super::*;
+use std::cell::Cell;
+
+#[test]
+fn controlled_composition_registers_fill_without_generic_script_or_keyboard_routes() {
+    let mut registry = cua_driver_core::tool::ToolRegistry::new();
+    crate::tools::register_computer(&mut registry);
+    let inventory = registry.tools_list();
+    let names: Vec<_> = inventory["tools"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|tool| tool["name"].as_str().unwrap())
+        .collect();
+    assert!(names.contains(&"set_value"));
+    assert!(names.contains(&"get_window_state"));
+    assert!(names.contains(&"click"));
+    for forbidden in [
+        "type_text",
+        "press_key",
+        "page",
+        "browser_prepare",
+        "set_config",
+    ] {
+        assert!(!names.contains(&forbidden));
+    }
+}
+
+#[derive(Clone)]
+struct Node {
+    data: Data,
+    children: Vec<usize>,
+    read_error: bool,
+    child_error: bool,
+}
+struct Fake {
+    nodes: Vec<Node>,
+    cancelled: Cell<bool>,
+}
+impl Reader for Fake {
+    type Element = usize;
+    fn checkpoint(&self) -> Result<(), &'static str> {
+        if self.cancelled.get() {
+            Err("cancelled")
+        } else {
+            Ok(())
+        }
+    }
+    fn same(&self, a: &usize, b: &usize) -> bool {
+        a == b
+    }
+    fn data(&self, element: &usize) -> Result<Data, &'static str> {
+        let node = &self.nodes[*element];
+        if node.read_error {
+            Err("observation_read_failed")
+        } else {
+            Ok(node.data.clone())
+        }
+    }
+    fn children(&self, element: &usize) -> Result<Vec<usize>, &'static str> {
+        let node = &self.nodes[*element];
+        if node.child_error {
+            Err("observation_read_failed")
+        } else {
+            Ok(node.children.clone())
+        }
+    }
+}
+fn node(role: &str, label: &str, value: Option<&str>, children: &[usize]) -> Node {
+    Node {
+        data: Data {
+            role: role.into(),
+            label: Some(label.into()),
+            value: value.map(str::to_owned),
+            enabled: Some(true),
+            settable: role == "AXTextField",
+            actions: if role == "AXButton" {
+                vec!["AXPress".into()]
+            } else {
+                vec![]
+            },
+            ..Data::default()
+        },
+        children: children.into(),
+        read_error: false,
+        child_error: false,
+    }
+}
+fn fake(nodes: Vec<Node>) -> Fake {
+    Fake {
+        nodes,
+        cancelled: Cell::new(false),
+    }
+}
+fn form() -> Fake {
+    fake(vec![
+        node("AXWindow", "Form", None, &[1, 2, 3]),
+        node("AXTextField", "Name", Some(""), &[]),
+        node("AXStaticText", "Result", Some("  exact \n"), &[]),
+        node("AXButton", "Save", None, &[]),
+    ])
+}
+fn no_tokens(scan: &Scan<usize>) {
+    assert!(scan
+        .elements(7)
+        .iter()
+        .all(|row| row.get("element_token").is_none()));
+}
+
+#[test]
+fn controlled_complete_rows_include_readonly_conditions_and_exact_empty_values() {
+    let scan = scan(&form(), 0, 4, 1);
+    assert!(scan.complete());
+    let rows = scan.elements(7);
+    assert_eq!(rows.len(), 4);
+    assert_eq!(rows[1]["value"], "");
+    assert_eq!(rows[2]["value"], "  exact \n");
+    assert_eq!(rows[2]["label"], "Result");
+    assert!(rows[2].get("element_token").is_none());
+    assert!(rows[1].get("element_token").is_some());
+    assert!(rows[3].get("element_token").is_some());
+    assert!(rows.iter().all(|row| row["in_web_content"] == false));
+}
+
+#[test]
+fn controlled_depth_and_element_cuts_never_claim_completeness_or_issue_tokens() {
+    let tree = fake(vec![
+        node("AXWindow", "", None, &[1]),
+        node("AXGroup", "", None, &[2]),
+        node("AXButton", "Go", None, &[]),
+    ]);
+    for (elements, depth) in [(3, 1), (2, 32)] {
+        let result = scan(&tree, 0, elements, depth);
+        assert!(result.truncated);
+        assert!(!result.complete());
+        no_tokens(&result);
+    }
+    assert!(scan(&tree, 0, 3, 2).complete());
+}
+
+#[test]
+fn controlled_unreadable_labels_and_children_are_not_absence_proof() {
+    for children in [false, true] {
+        let mut tree = form();
+        tree.nodes[2].read_error = !children;
+        tree.nodes[2].child_error = children;
+        let result = scan(&tree, 0, 10, 10);
+        assert_eq!(result.failure, Some("observation_read_failed"));
+        assert!(!result.complete());
+        no_tokens(&result);
+    }
+}
+
+#[test]
+fn controlled_repeated_elements_and_cycles_are_incomplete() {
+    let mut tree = form();
+    tree.nodes[2].children = vec![0];
+    let result = scan(&tree, 0, 10, 10);
+    assert_eq!(result.failure, Some("observation_repeated_element"));
+    no_tokens(&result);
+}
+
+#[test]
+fn controlled_ambiguity_is_preserved_instead_of_deduplicating_by_label() {
+    let mut tree = form();
+    tree.nodes[0].children.push(4);
+    tree.nodes.push(tree.nodes[1].clone());
+    let result = scan(&tree, 0, 10, 10);
+    assert!(result.complete());
+    let rows = result.elements(7);
+    let names: Vec<_> = rows.iter().filter(|row| row["label"] == "Name").collect();
+    assert_eq!(names.len(), 2);
+    assert_ne!(names[0]["element_token"], names[1]["element_token"]);
+}
+
+#[test]
+fn controlled_modals_menus_and_dialog_subroles_pause_the_whole_observation() {
+    for (role, subrole, modal) in [
+        ("AXSheet", None, false),
+        ("AXMenu", None, false),
+        ("AXPopover", None, false),
+        ("AXWindow", Some("AXDialog"), false),
+        ("AXWindow", Some("AXSystemDialog"), false),
+        ("AXGroup", None, true),
+    ] {
+        let mut tree = form();
+        tree.nodes[2].data.role = role.into();
+        tree.nodes[2].data.subrole = subrole.map(str::to_owned);
+        tree.nodes[2].data.modal = modal;
+        let result = scan(&tree, 0, 10, 10);
+        assert_eq!(result.failure, Some("unexpected_modal_surface"));
+        no_tokens(&result);
+    }
+}
+
+#[test]
+fn controlled_web_ancestry_never_mints_native_tokens() {
+    for role in ["AXWebArea", "AXDocumentWeb", "document"] {
+        let mut tree = form();
+        tree.nodes[0].data.role = role.into();
+        let result = scan(&tree, 0, 10, 10);
+        assert!(result.complete());
+        assert!(result.rows.iter().all(|row| row.web));
+        no_tokens(&result);
+    }
+}
+
+#[test]
+fn controlled_press_requires_positive_live_evidence() {
+    let mut data = node("AXButton", "Go", None, &[]).data;
+    assert!(data.pressable());
+    for enabled in [None, Some(false)] {
+        data.enabled = enabled;
+        assert!(!data.pressable());
+    }
+    data.enabled = Some(true);
+    for actions in [vec!["AXSelect".into()], vec![]] {
+        data.actions = actions;
+        assert!(!data.pressable());
+    }
+}
+
+#[test]
+fn controlled_fill_requires_native_enabled_settable_text_not_numeric_or_secure() {
+    let mut data = node("AXTextField", "Name", Some(""), &[]).data;
+    assert!(data.fillable());
+    for role in ["AXSlider", "AXPopUpButton", "AXComboBox", "AXStaticText"] {
+        data.role = role.into();
+        assert!(!data.fillable());
+    }
+    data.role = "AXTextArea".into();
+    assert!(data.fillable());
+    data.settable = false;
+    assert!(!data.fillable());
+    data.settable = true;
+    for enabled in [None, Some(false)] {
+        data.enabled = enabled;
+        assert!(!data.fillable());
+    }
+    data.enabled = Some(true);
+    data.subrole = Some("AXSecureTextField".into());
+    assert!(!data.fillable());
+}
+
+#[test]
+fn controlled_text_budget_and_cancellation_do_not_issue_partial_grants() {
+    let mut tree = form();
+    tree.nodes[2].data.value = Some("x".repeat(64 * 1024));
+    let result = scan(&tree, 0, 10, 10);
+    assert!(result.truncated);
+    no_tokens(&result);
+    tree.cancelled.set(true);
+    let result = scan(&tree, 0, 10, 10);
+    assert_eq!(result.failure, Some("cancelled"));
+    assert!(result.rows.is_empty());
+    no_tokens(&result);
+}
