+#[tokio::test]
+async fn controlled_callback_snapshot_drains_after_producer_closes() {
+    let op = session(&Gate::new(), None).new_operation().unwrap();
+    op.begin().unwrap();
+    let callback = op.track_callback().unwrap();
+    op.cancel();
+    op.finish();
+    assert!(
+        op.track().is_err(),
+        "closed producer admitted another callback"
+    );
+    pending(op.terminal());
+    drop(callback);
+    assert!(op.terminal().await.unwrap().cancelled);
+}
+
+#[tokio::test]
+async fn controlled_terminal_is_stable_and_close_is_idempotent() {
+    let gate = Gate::new();
+    let op = session(&gate, None).new_operation().unwrap();
+    op.begin().unwrap();
+    op.primary(true, || ()).unwrap();
+    assert!(op.primary(true, || panic!("second input")).is_err());
+    op.finish();
+    let terminal = op.terminal().await.unwrap();
+    op.cancel();
+    gate.revoke();
+    gate.revoke();
+    op.finish();
+    assert_eq!(terminal, op.terminal().await.unwrap());
+    gate.quarantine();
+    assert_eq!(terminal, op.terminal().await.unwrap());
+    assert!(!terminal.cancelled);
+}
