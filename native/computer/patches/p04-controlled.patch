+use super::*;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::task::{Context, Poll, Waker};
+
+fn session(gate: &Arc<Gate>, parent: Option<Arc<Session>>) -> Arc<Session> {
+    gate.session(parent, Arc::new(|| true), 42, 7, None)
+        .unwrap()
+}
+
+fn pending<T>(future: impl Future<Output = T>) {
+    let mut future = std::pin::pin!(future);
+    assert!(matches!(
+        future
+            .as_mut()
+            .poll(&mut Context::from_waker(Waker::noop())),
+        Poll::Pending
+    ));
+}
+
+#[tokio::test]
+async fn controlled_cancel_before_start_is_terminal_without_a_primitive() {
+    let node = session(&Gate::new(), None);
+    let operation = node.new_operation().unwrap();
+    operation.cancel();
+    assert_eq!(operation.begin(), Err("cancelled"));
+    assert_eq!(
+        operation.primary(true, || panic!("cancelled action ran")),
+        Err("cancelled")
+    );
+    assert_eq!(
+        operation.terminal().await.unwrap(),
+        Terminal {
+            cancelled: true,
+            input_committed: false
+        }
+    );
+}
+
+#[tokio::test]
+async fn controlled_parent_revocation_reaches_descendants_not_siblings() {
+    let gate = Gate::new();
+    let parent = session(&gate, None);
+    let child = session(&gate, Some(parent.clone()));
+    let grandchild = session(&gate, Some(child));
+    let sibling = session(&gate, None);
+    let op = grandchild.new_operation().unwrap();
+    op.begin().unwrap();
+    parent.revoke();
+    assert!(op.primary(true, || ()).is_err());
+    assert!(gate
+        .session(Some(parent), Arc::new(|| true), 42, 7, None)
+        .is_err());
+    assert!(sibling.new_operation().is_ok());
+    op.finish();
+    assert!(op.terminal().await.unwrap().cancelled);
+}
+
+#[test]
+fn controlled_foreign_parent_and_changed_target_are_refused() {
+    let gate = Gate::new();
+    let node = session(&gate, None);
+    assert!(Gate::new()
+        .session(Some(node.clone()), Arc::new(|| true), 42, 7, None)
+        .is_err());
+    assert!(gate
+        .session(Some(node), Arc::new(|| true), 42, 8, None)
+        .is_err());
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn controlled_queued_worker_cannot_dispatch_after_cancel() {
+    let op = session(&Gate::new(), None).new_operation().unwrap();
+    op.begin().unwrap();
+    let calls = Arc::new(AtomicUsize::new(0));
+    let (entered_tx, entered_rx) = tokio::sync::oneshot::channel();
+    let (release_tx, release_rx) = std::sync::mpsc::channel();
+    let producer = {
+        let op = op.clone();
+        let calls = calls.clone();
+        tokio::spawn(async move {
+            let result = op
+                .blocking(move || {
+                    entered_tx.send(()).unwrap();
+                    release_rx.recv().unwrap();
+                    current()
+                        .unwrap()
+                        .primary(true, || calls.fetch_add(1, Ordering::SeqCst))
+                })
+                .await
+                .unwrap();
+            assert_eq!(result, Err("cancelled"));
+            op.finish();
+        })
+    };
+    entered_rx.await.unwrap();
+    op.cancel();
+    pending(op.terminal());
+    release_tx.send(()).unwrap();
+    producer.await.unwrap();
+    assert!(op.terminal().await.unwrap().cancelled);
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn controlled_active_primitive_and_dropped_waiter_retain_work() {
+    let op = session(&Gate::new(), None).new_operation().unwrap();
+    op.begin().unwrap();
+    let (entered_tx, entered_rx) = tokio::sync::oneshot::channel();
+    let (release_tx, release_rx) = std::sync::mpsc::channel();
+    let producer = {
+        let op = op.clone();
+        tokio::spawn(async move {
+            op.blocking(move || {
+                current().unwrap().primary(true, || {
+                    entered_tx.send(()).unwrap();
+                    release_rx.recv().unwrap();
+                })
+            })
+            .await
+            .unwrap()
+            .unwrap();
+            op.finish();
+        })
+    };
+    entered_rx.await.unwrap();
+    let waiter = {
+        let op = op.clone();
+        tokio::spawn(async move { op.terminal().await })
+    };
+    waiter.abort();
+    let _ = waiter.await;
+    op.cancel(); // Must not wait for the committed primitive's barrier.
+    pending(op.terminal());
+    release_tx.send(()).unwrap();
+    producer.await.unwrap();
+    assert_eq!(
+        op.terminal().await.unwrap(),
+        Terminal {
+            cancelled: true,
+            input_committed: true
+        }
+    );
+}
