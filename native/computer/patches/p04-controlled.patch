+//! Cooperating-process ownership of the actual user's local desktop.
+//!
+//! A successful flock after process death is NOT a terminal acknowledgement. An
+//! unclean generation stays dirty and requires an out-of-band recovery decision;
+//! this module never repairs, expires, unlinks, or steals it. The native owner
+//! must retain this value until all effect-capable work and cleanup have drained.
+
+/// Native desktop ownership. There is deliberately no Clone or automatic clean
+/// release. Dropping an acquired lease quarantines its lock FD until process exit.
+/// This is an advisory protocol, not isolation from the user or other automation.
+pub struct ComputerDesktopLease {
+    #[cfg(target_os = "macos")]
+    inner: macos::Lease,
+}
+
+impl ComputerDesktopLease {
+    /// Acquire without waiting. Refuse contention, an unclean predecessor, unsafe
+    /// storage, elevated/mismatched user identity, and unsupported platforms.
+    pub fn acquire() -> anyhow::Result<Self> {
+        #[cfg(target_os = "macos")]
+        {
+            Ok(Self {
+                inner: macos::Lease::acquire(macos::Directory::canonical()?)?,
+            })
+        }
+        #[cfg(not(target_os = "macos"))]
+        anyhow::bail!("the controlled desktop lease is supported only on macOS")
+    }
+
+    /// ONLY call after explicit native terminal shutdown has proved all owned
+    /// work and cleanup drained. This method cannot establish that proof itself.
+    /// Repeated successful release is harmless. An error retains ownership.
+    pub fn release_clean(&mut self) -> anyhow::Result<()> {
+        #[cfg(target_os = "macos")]
+        {
+            self.inner.release_clean()
+        }
+        #[cfg(not(target_os = "macos"))]
+        anyhow::bail!("the controlled desktop lease is supported only on macOS")
+    }
+}
+
+#[cfg(target_os = "macos")]
+mod macos {
+    use anyhow::{bail, ensure, Context, Result};
+    use std::ffi::CStr;
+    use std::fs::{self, DirBuilder, File, Metadata, OpenOptions};
+    use std::io;
+    use std::mem::MaybeUninit;
+    use std::os::fd::{AsRawFd, IntoRawFd};
+    use std::os::unix::ffi::OsStrExt;
+    use std::os::unix::fs::{DirBuilderExt, FileExt, MetadataExt, OpenOptionsExt};
+    use std::path::{Path, PathBuf};
+
+    // Do not move this namespace to HOME/TMPDIR, agentDir, or a runtime directory.
+    // getpwuid_r identifies the actual user's persistent home, not environment
+    // overrides. A temp/cache directory can be evicted while an owner is alive.
+    const DIRECTORY: &str = ".pi-computer-desktop-v1";
+    const LOCK: &str = "desktop.lock";
+    const PREFIX: &str = "pi-computer-desktop-v1 ";
+    const MARKER_LEN: usize = PREFIX.len() + 1 + 1 + 16 + 1;
+    // Darwin rejects O_NOFOLLOW | O_NOFOLLOW_ANY together with EINVAL.
+    // ANY alone covers both the leaf and every ancestor (regression-tested).
+    const NOFOLLOW: i32 = libc::O_NOFOLLOW_ANY | libc::O_CLOEXEC;
+
+    pub(super) struct Directory {
+        path: PathBuf,
+        file: File,
+        uid: u32,
+        // Hold and revalidate the account-home inode too, not just the leaf.
+        home: Option<(PathBuf, File)>,
+    }
+
+    impl Directory {
+        pub(super) fn canonical() -> Result<Self> {
+            let uid = actual_uid()?;
+            let home_path = account_home(uid)?;
+            // The account database, system ancestors, and this user are trusted;
+            // reject group/world-writable or symlinked resolved ancestors.
+            for ancestor in home_path.ancestors() {
+                let metadata = fs::symlink_metadata(ancestor)?;
+                ensure!(
+                    metadata.is_dir()
+                        && (metadata.uid() == 0 || metadata.uid() == uid)
+                        && metadata.mode() & 0o022 == 0,
+                    "unsafe account-home ancestor"
+                );
+            }
+            let home = open_directory(&home_path)?;
+            ensure!(
+                home.metadata()?.uid() == uid,
+                "account home has another owner"
+            );
+            validate_identity(&home_path, &home)?;
+            let path = home_path.join(DIRECTORY);
+            match DirBuilder::new().mode(0o700).create(&path) {
+                Ok(()) => home.sync_all().context("sync new lease directory")?,
+                Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {}
+                Err(error) => return Err(error).context("create desktop lease directory"),
+            }
+            let file = open_directory(&path)?;
+            let directory = Self {
+                path,
+                file,
+                uid,
+                home: Some((home_path, home)),
+            };
+            directory.validate()?;
+            Ok(directory)
+        }
+
+        fn validate(&self) -> Result<()> {
+            ensure!(actual_uid()? == self.uid, "desktop lease user changed");
+            if let Some((path, file)) = &self.home {
+                validate_identity(path, file)?;
+                let metadata = file.metadata()?;
+                ensure!(
+                    metadata.is_dir() && metadata.uid() == self.uid && metadata.mode() & 0o022 == 0,
+                    "unsafe account home"
+                );
+            }
+            validate_identity(&self.path, &self.file)?;
+            let metadata = self.file.metadata()?;
+            ensure!(
+                metadata.is_dir()
+                    && metadata.uid() == self.uid
+                    && metadata.mode() & 0o7777 == 0o700,
+                "lease directory must be owned by this user and mode 0700"
+            );
+            refuse_extended_acl(&self.file)?;
+            let mut filesystem = MaybeUninit::<libc::statfs>::uninit();
+            let status = unsafe { libc::fstatfs(self.file.as_raw_fd(), filesystem.as_mut_ptr()) };
+            ensure!(
+                status == 0,
+                "inspect lease filesystem: {}",
+                io::Error::last_os_error()
+            );
+            ensure!(
+                unsafe { filesystem.assume_init() }.f_flags & libc::MNT_LOCAL as u32 != 0,
+                "desktop lease requires a local filesystem"
+            );
+            Ok(())
+        }
+
+        #[cfg(test)]
+        fn for_test(path: &Path) -> Result<Self> {
+            // The test supplies an already-private directory. Never canonicalize
+            // it here: symlinks, including ancestor symlinks, must be refused.
+            let directory = Self {
+                path: path.to_owned(),
+                file: open_directory(path)?,
+                uid: actual_uid()?,
+                home: None,
+            };
+            directory.validate()?;
+            Ok(directory)
+        }
+    }
+
+    pub(super) struct Lease {
+        directory: Directory,
+        file: Option<File>,
+        generation: u64,
+        // A failed clean-marker write must never be retried as normal release.
+        poisoned: bool,
+    }
+
+    impl Lease {
+        pub(super) fn acquire(directory: Directory) -> Result<Self> {
+            directory.validate()?;
+            let path = directory.path.join(LOCK);
+            let mut options = OpenOptions::new();
+            options
+                .read(true)
+                .write(true)
+                .mode(0o600)
+                .custom_flags(NOFOLLOW | libc::O_NONBLOCK);
+            let (file, created) = match options.create_new(true).open(&path) {
+                Ok(file) => (file, true),
+                Err(error) if error.kind() == io::ErrorKind::AlreadyExists => (
+                    options
+                        .create_new(false)
+                        .open(&path)
+                        .context("open desktop lease")?,
+                    false,
+                ),
+                Err(error) => return Err(error).context("create desktop lease"),
+            };
+            validate_file(&directory, &file)?;
+            fs2::FileExt::try_lock_exclusive(&file)
+                .context("desktop lease busy or locking unavailable")?;
+            // Validate again after flock: the path must still name this inode.
+            directory.validate()?;
+            validate_file(&directory, &file)?;
+            let generation = if created {
+                ensure!(file.metadata()?.len() == 0, "new lease inode was modified");
+                1
+            } else {
+                let (state, previous) = read_marker(&file)?;
+                ensure!(state == b'C', "desktop lease has a dirty generation; native terminality is unknown (no automatic recovery)");
+                previous
+                    .checked_add(1)
+                    .context("desktop lease generation exhausted")?
+            };
+            write_marker(&file, b'D', generation).context("persist dirty desktop generation")?;
+            // Both the marker and its directory entry must exist before dispatch.
+            directory.file.sync_all().context("sync lease directory")?;
+            directory.validate()?;
+            validate_file(&directory, &file)?;
+            Ok(Self {
+                directory,
+                file: Some(file),
+                generation,
+                poisoned: false,
+            })
+        }
+
+        pub(super) fn release_clean(&mut self) -> Result<()> {
+            let Some(file) = &self.file else {
+                return Ok(());
+            };
+            ensure!(
+                !self.poisoned,
+                "desktop lease is quarantined after release failure"
+            );
+            self.directory.validate()?;
+            validate_file(&self.directory, file)?;
+            ensure!(
+                read_marker(file)? == (b'D', self.generation),
+                "desktop lease generation changed"
+            );
+            // The caller has already proved native terminality. Never clean from
+            // Drop, acquisition failure, cancellation, a timeout, or process death.
+            if let Err(error) = write_marker(file, b'C', self.generation)
+                .and_then(|()| self.directory.validate())
+                .and_then(|()| validate_file(&self.directory, file))
+                .and_then(|()| fs2::FileExt::unlock(file).context("unlock desktop lease"))
+            {
+                self.poisoned = true;
+                // Best effort after a partial I/O failure; retain the kernel lock
+                // even if this repair also fails. No lease can recover this owner.
+                let repair = write_marker(file, b'D', self.generation);
+                return Err(error).context(format!(
+                    "desktop release failed; lock quarantined; dirty-marker repair: {repair:?}"
+                ));
+            }
+            self.file.take();
+            Ok(())
+        }
+    }
+
+    impl Drop for Lease {
+        fn drop(&mut self) {
+            if let Some(file) = self.file.take() {
+                // Deliberate fail-closed fallback for an incorrectly dropped
+                // native owner. Only OS process exit closes this quarantined FD;
+                // the dirty marker then prevents a successor from treating death
+                // as proof that an external application's work has finished.
+                let _quarantined_fd = file.into_raw_fd();
+            }
+        }
+    }
+
+    fn actual_uid() -> Result<u32> {
+        let uid = unsafe { libc::getuid() };
+        ensure!(
+            uid != 0 && uid == unsafe { libc::geteuid() },
+            "desktop lease refuses root or changed effective user"
+        );
+        Ok(uid)
+    }
+
+    fn account_home(uid: u32) -> Result<PathBuf> {
+        let mut record = MaybeUninit::<libc::passwd>::uninit();
+        let mut result = std::ptr::null_mut();
+        let mut buffer = vec![0_u8; 65536];
+        // SAFETY: all output pointers remain valid until the home is copied;
+        // bounded ERANGE is a refusal, not an environment-dependent fallback.
+        let status = unsafe {
+            libc::getpwuid_r(
+                uid,
+                record.as_mut_ptr(),
+                buffer.as_mut_ptr().cast(),
+                buffer.len(),
+                &mut result,
+            )
+        };
+        ensure!(
+            status == 0,
+            "lookup actual user's home: {}",
+            io::Error::from_raw_os_error(status)
+        );
+        ensure!(!result.is_null(), "actual user has no account home");
+        let record = unsafe { record.assume_init() };
+        ensure!(
+            record.pw_uid == uid && !record.pw_dir.is_null(),
+            "invalid account home"
+        );
+        let bytes = unsafe { CStr::from_ptr(record.pw_dir) }.to_bytes();
+        let path = Path::new(std::ffi::OsStr::from_bytes(bytes));
+        ensure!(path.is_absolute(), "account home must be absolute");
+        fs::canonicalize(path).context("resolve account home")
+    }
+
+    fn refuse_extended_acl(file: &File) -> Result<()> {
+        // Darwin's public libc ACL functions are not declared by the libc crate.
+        // Refuse all entries, including inherited ones, rather than guess which
+        // grants are compatible with a private 0700/0600 namespace.
+        unsafe extern "C" {
+            fn acl_get_fd_np(fd: libc::c_int, kind: libc::c_int) -> *mut libc::c_void;
+            fn acl_get_entry(
+                acl: *mut libc::c_void,
+                entry_id: libc::c_int,
+                entry: *mut *mut libc::c_void,
+            ) -> libc::c_int;
+            fn acl_free(acl: *mut libc::c_void) -> libc::c_int;
+        }
+        // ACL_TYPE_EXTENDED = 0x100; ACL_FIRST_ENTRY = 0 (sys/acl.h).
+        let acl = unsafe { acl_get_fd_np(file.as_raw_fd(), 0x100) };
+        if acl.is_null() {
+            let error = io::Error::last_os_error();
+            // Darwin returns NULL/ENOENT when this already-open, validated
+            // inode has no extended ACL. Other retrieval errors fail closed.
+            ensure!(
+                error.raw_os_error() == Some(libc::ENOENT),
+                "read desktop lease ACL: {error}"
+            );
+            return Ok(());
+        }
+        let mut entry = std::ptr::null_mut();
+        let status = unsafe { acl_get_entry(acl, 0, &mut entry) };
+        let error = io::Error::last_os_error();
+        let freed = unsafe { acl_free(acl) };
+        ensure!(freed == 0, "free desktop lease ACL failed");
+        // Darwin returns 0 for an entry and -1/EINVAL for an empty ACL (unlike
+        // Linux's POSIX ACL iteration convention).
+        ensure!(
+            status == -1 && error.raw_os_error() == Some(libc::EINVAL),
+            "desktop lease refuses extended ACL entries or unreadable ACLs"
+        );
+        Ok(())
+    }
+
+    fn open_directory(path: &Path) -> Result<File> {
+        OpenOptions::new()
+            .read(true)
+            .custom_flags(NOFOLLOW | libc::O_DIRECTORY)
+            .open(path)
+            .context("open desktop lease directory without symlinks")
+    }
+
+    fn same_inode(left: &Metadata, right: &Metadata) -> bool {
+        left.dev() == right.dev() && left.ino() == right.ino()
+    }
+
+    fn validate_identity(path: &Path, file: &File) -> Result<()> {
+        // Opening the absolute path with NOFOLLOW_ANY also rejects a replaced
+        // ancestor symlink; comparing only the leaf's lstat would miss that case.
+        let current = OpenOptions::new()
+            .read(true)
+            .custom_flags(NOFOLLOW | libc::O_NONBLOCK)
+            .open(path)?;
+        ensure!(
+            same_inode(&current.metadata()?, &file.metadata()?),
+            "desktop lease path/inode mismatch"
+        );
+        ensure!(
+            !fs::symlink_metadata(path)?.file_type().is_symlink(),
+            "desktop lease path is a symlink"
+        );
+        Ok(())
+    }
+
+    fn validate_file(directory: &Directory, file: &File) -> Result<()> {
+        let metadata = file.metadata()?;
+        ensure!(
+            metadata.is_file()
+                && metadata.uid() == directory.uid
+                && metadata.mode() & 0o7777 == 0o600
+                && metadata.nlink() == 1,
+            "lease inode must be a singly-linked regular file owned by this user with mode 0600"
+        );
+        ensure!(
+            metadata.dev() == directory.file.metadata()?.dev(),
+            "desktop lease filesystem changed"
+        );
+        refuse_extended_acl(file)?;
+        validate_identity(&directory.path.join(LOCK), file)
+    }
+
+    fn read_marker(file: &File) -> Result<(u8, u64)> {
+        ensure!(
+            file.metadata()?.len() == MARKER_LEN as u64,
+            "missing or malformed desktop lease marker; refuse crash recovery"
+        );
+        let mut bytes = [0; MARKER_LEN];
+        file.read_exact_at(&mut bytes, 0)?;
+        let state = bytes[PREFIX.len()];
+        ensure!(
+            bytes.starts_with(PREFIX.as_bytes())
+                && matches!(state, b'C' | b'D')
+                && bytes[PREFIX.len() + 1] == b' '
+                && bytes[MARKER_LEN - 1] == b'\n',
+            "invalid desktop lease marker; refuse crash recovery"
+        );
+        let generation = u64::from_str_radix(
+            std::str::from_utf8(&bytes[PREFIX.len() + 2..MARKER_LEN - 1])?,
+            16,
+        )?;
+        ensure!(
+            generation != 0 && bytes == marker(state, generation).as_bytes(),
+            "invalid desktop lease generation"
+        );
+        Ok((state, generation))
+    }
+
+    fn marker(state: u8, generation: u64) -> String {
+        format!("{PREFIX}{} {generation:016x}\n", state as char)
+    }
+
+    fn write_marker(file: &File, state: u8, generation: u64) -> Result<()> {
+        if !matches!(state, b'C' | b'D') {
+            bail!("invalid desktop lease state")
+        }
+        // Never truncate, rename, unlink, or replace the inode holding flock.
+        file.write_all_at(marker(state, generation).as_bytes(), 0)?;
+        file.sync_all().context("sync desktop lease marker")
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+        use std::ffi::CString;
+        use std::io::{BufRead, BufReader, Write};
+        use std::os::unix::fs::{symlink, PermissionsExt};
+        use std::process::{Child, ChildStdin, Command, Stdio};
+        use std::sync::mpsc::{self, Receiver};
+        use std::thread::{self, JoinHandle};
+        use std::time::Duration;
+        use tempfile::TempDir;
+
+        fn fixture() -> (TempDir, PathBuf) {
+            let temporary = tempfile::tempdir().unwrap();
+            fs::set_permissions(temporary.path(), fs::Permissions::from_mode(0o700)).unwrap();
+            let path = fs::canonicalize(temporary.path()).unwrap();
+            (temporary, path)
+        }
+
+        fn acquire_private(path: &Path) -> Result<Lease> {
+            Lease::acquire(Directory::for_test(path)?)
+        }
+
+        fn fixture_marker(path: &Path, contents: &[u8]) {
+            let mut file = OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .mode(0o600)
+                .open(path.join(LOCK))
+                .unwrap();
+            file.write_all(contents).unwrap();
+            file.sync_all().unwrap();
+        }
+
+        // All signals target an unreaped Child created here. Drop kills/reaps
+        // exactly that handle on assertion failure; never enumerate other PIDs.
+        struct OwnedChild {
+            child: Option<Child>,
+            stdin: ChildStdin,
+            lines: Receiver<String>,
+            reader: Option<JoinHandle<()>>,
+        }
+
+        impl OwnedChild {
+            fn spawn(path: &Path, mode: &str) -> Self {
+                let test = format!(
+                    "{}::process_fixture",
+                    module_path!().split_once("::").unwrap().1
+                );
+                let mut child = Command::new(std::env::current_exe().unwrap())
+                    .args(["--exact", &test, "--nocapture", "--test-threads=1"])
+                    .env("PI_DESKTOP_LEASE_TEST_MODE", mode)
+                    .env("PI_DESKTOP_LEASE_TEST_DIRECTORY", path)
+                    // Different cwd/config/temp namespaces must not change the
+                    // account-home resolver or an explicitly shared test inode.
+                    .env("HOME", path.join("unrelated-home"))
+                    .env("TMPDIR", path.join("unrelated-temp"))
+                    .env("TMP", path.join("unrelated-tmp"))
+                    .env("TEMP", path.join("unrelated-temp2"))
+                    .env("PI_AGENT_DIR", path.join("unrelated-agent"))
+                    .current_dir(path)
+                    .stdin(Stdio::piped())
+                    .stdout(Stdio::piped())
+                    .stderr(Stdio::inherit())
+                    .spawn()
+                    .unwrap();
+                let stdin = child.stdin.take().unwrap();
+                let stdout = child.stdout.take().unwrap();
+                let (sender, lines) = mpsc::channel();
+                let reader = thread::spawn(move || {
+                    for line in BufReader::new(stdout).lines() {
+                        let Ok(line) = line else { break };
+                        if sender.send(line).is_err() {
+                            break;
+                        }
+                    }
+                });
+                Self {
+                    child: Some(child),
+                    stdin,
+                    lines,
+                    reader: Some(reader),
+                }
+            }
+
+            fn message(&self) -> String {
+                loop {
+                    // A watchdog can only FAIL a test. It cannot certify drain,
+                    // unlock an owner, or turn a dirty marker into a clean one.
+                    let line = self
+                        .lines
+                        .recv_timeout(Duration::from_secs(20))
+                        .expect("lease child failed to reach its pipe barrier");
+                    if let Some(message) = line.strip_prefix("LEASE-TEST ") {
+                        return message.to_owned();
+                    }
+                }
+            }
+
+            fn command(&mut self, command: &str) {
+                writeln!(self.stdin, "{command}").unwrap();
+                self.stdin.flush().unwrap();
+            }
+
+            fn stop(&mut self) {
+                self.command("stop");
+                let pid = self.child.as_ref().unwrap().id() as libc::pid_t;
+                let mut status = 0;
+                let result = loop {
+                    let result = unsafe { libc::waitpid(pid, &mut status, libc::WUNTRACED) };
+                    if result != -1
+                        || io::Error::last_os_error().kind() != io::ErrorKind::Interrupted
+                    {
+                        break result;
+                    }
+                };
+                assert_eq!(result, pid);
+                assert!(libc::WIFSTOPPED(status));
+                assert_eq!(libc::WSTOPSIG(status), libc::SIGSTOP);
+            }
+
+            fn resume(&self) {
+                let pid = self.child.as_ref().unwrap().id() as libc::pid_t;
+                assert_eq!(unsafe { libc::kill(pid, libc::SIGCONT) }, 0);
+            }
+
+            fn crash(mut self) {
+                let child = self.child.as_mut().unwrap();
+                child.kill().unwrap();
+                assert!(!child.wait().unwrap().success());
+                self.child.take();
+            }
+
+            fn finish(mut self) {
+                let status = self.child.as_mut().unwrap().wait().unwrap();
+                self.child.take();
+                assert!(status.success(), "lease child failed: {status}");
+            }
+        }
+
+        impl Drop for OwnedChild {
+            fn drop(&mut self) {
+                if let Some(mut child) = self.child.take() {
+                    let _ = child.kill();
+                    let _ = child.wait();
+                }
+                if let Some(reader) = self.reader.take() {
+                    let _ = reader.join();
+                }
+            }
+        }
+
+        fn probe(path: &Path) -> String {
+            let child = OwnedChild::spawn(path, "probe");
+            let result = child.message();
+            child.finish();
+            result
+        }
+
+        fn announce(message: &str) {
+            println!("\nLEASE-TEST {message}");
+            std::io::stdout().flush().unwrap();
+        }
+
+        #[test]
+        fn process_fixture() {
+            let Ok(mode) = std::env::var("PI_DESKTOP_LEASE_TEST_MODE") else {
+                return;
+            };
+            if mode == "home" {
+                announce(&format!(
+                    "HOME {}",
+                    account_home(actual_uid().unwrap()).unwrap().display()
+                ));
+                return;
+            }
+            let path = PathBuf::from(std::env::var_os("PI_DESKTOP_LEASE_TEST_DIRECTORY").unwrap());
+            if mode == "probe" {
+                match acquire_private(&path) {
+                    Ok(mut lease) => {
+                        lease.release_clean().unwrap();
+                        announce("ACQUIRED-AND-CLEAN");
+                    }
+                    Err(error) => announce(&format!("REFUSED {error:#}")),
+                }
+                return;
+            }
+            assert_eq!(mode, "owner");
+            let mut lease = Some(acquire_private(&path).unwrap());
+            announce("READY");
+            for command in std::io::stdin().lock().lines() {
+                match command.unwrap().as_str() {
+                    "stop" => assert_eq!(unsafe { libc::raise(libc::SIGSTOP) }, 0),
+                    "clean" => {
+                        lease.as_mut().unwrap().release_clean().unwrap();
+                        announce("CLEAN");
+                        return;
+                    }
+                    "drop" => {
+                        drop(lease.take());
+                        announce("DROPPED");
+                    }
+                    "exit" => {
+                        assert!(lease.is_none());
+                        return;
+                    }
+                    command => panic!("unknown lease child command: {command}"),
+                }
+            }
+            panic!("owner pipe closed without an explicit fixture command");
+        }
+
+        #[test]
+        fn real_process_contention_stopped_owner_and_clean_handoff() {
+            let (_temporary, path) = fixture();
+            let mut owner = OwnedChild::spawn(&path, "owner");
+            assert_eq!(owner.message(), "READY");
+            let original = fs::metadata(path.join(LOCK)).unwrap();
+            assert!(probe(&path).contains("desktop lease busy"));
+            owner.stop();
+            assert!(probe(&path).contains("desktop lease busy"));
+            owner.resume();
+            owner.command("clean");
+            assert_eq!(owner.message(), "CLEAN");
+            owner.finish();
+            assert_eq!(probe(&path), "ACQUIRED-AND-CLEAN");
+            assert!(same_inode(
+                &original,
+                &fs::metadata(path.join(LOCK)).unwrap()
+            ));
+            assert_eq!(
+                read_marker(&File::open(path.join(LOCK)).unwrap()).unwrap(),
+                (b'C', 2)
+            );
+        }
+
+        #[test]
+        fn real_process_crash_refuses_even_after_kernel_lock_is_free() {
+            let (_temporary, path) = fixture();
+            let owner = OwnedChild::spawn(&path, "owner");
+            assert_eq!(owner.message(), "READY");
+            let original = fs::metadata(path.join(LOCK)).unwrap();
+            owner.crash();
+            let file = OpenOptions::new()
+                .read(true)
+                .write(true)
+                .open(path.join(LOCK))
+                .unwrap();
+            fs2::FileExt::try_lock_exclusive(&file).unwrap();
+            assert_eq!(read_marker(&file).unwrap(), (b'D', 1));
+            fs2::FileExt::unlock(&file).unwrap();
+            for _ in 0..2 {
+                assert!(probe(&path).contains("dirty generation"));
+            }
+            assert!(same_inode(
+                &original,
+                &fs::metadata(path.join(LOCK)).unwrap()
+            ));
+        }
+
+        #[test]
+        fn dropped_owner_quarantines_live_fd_and_leaves_dirty_after_exit() {
+            let (_temporary, path) = fixture();
+            let mut owner = OwnedChild::spawn(&path, "owner");
+            assert_eq!(owner.message(), "READY");
+            owner.command("drop");
+            assert_eq!(owner.message(), "DROPPED");
+            assert!(probe(&path).contains("desktop lease busy"));
+            owner.command("exit");
+            owner.finish();
+            assert!(probe(&path).contains("dirty generation"));
+        }
+
+        #[test]
+        fn account_home_ignores_environment_and_cwd_without_acquiring_real_lease() {
+            let (_temporary, path) = fixture();
+            let expected = format!(
+                "HOME {}",
+                account_home(actual_uid().unwrap()).unwrap().display()
+            );
+            let child = OwnedChild::spawn(&path, "home");
+            assert_eq!(child.message(), expected);
+            child.finish();
+        }
+
+        #[test]
+        fn clean_release_keeps_inode_generation_and_cloexec() {
+            let (_temporary, path) = fixture();
+            let mut lease = acquire_private(&path).unwrap();
+            let original = fs::metadata(path.join(LOCK)).unwrap();
+            for file in [&lease.directory.file, lease.file.as_ref().unwrap()] {
+                let flags = unsafe { libc::fcntl(file.as_raw_fd(), libc::F_GETFD) };
+                assert!(flags >= 0 && flags & libc::FD_CLOEXEC != 0);
+            }
+            assert_eq!(
+                read_marker(lease.file.as_ref().unwrap()).unwrap(),
+                (b'D', 1)
+            );
+            assert!(acquire_private(&path).is_err());
+            lease.release_clean().unwrap();
+            lease.release_clean().unwrap();
+            let mut successor = acquire_private(&path).unwrap();
+            assert_eq!(
+                read_marker(successor.file.as_ref().unwrap()).unwrap(),
+                (b'D', 2)
+            );
+            assert!(same_inode(
+                &original,
+                &fs::metadata(path.join(LOCK)).unwrap()
+            ));
+            successor.release_clean().unwrap();
+        }
+
+        #[test]
+        fn refuses_symlink_parent_and_ancestor() {
+            let (_temporary, path) = fixture();
+            let real = path.join("real");
+            DirBuilder::new().mode(0o700).create(&real).unwrap();
+            symlink(&real, path.join("link")).unwrap();
+            assert!(Directory::for_test(&path.join("link")).is_err());
+            DirBuilder::new()
+                .mode(0o700)
+                .create(real.join("nested"))
+                .unwrap();
+            assert!(Directory::for_test(&path.join("link/nested")).is_err());
+        }
+
+        #[test]
+        fn refuses_symlink_hardlink_directory_and_fifo_lock_files() {
+            for kind in ["symlink", "hardlink", "directory", "fifo"] {
+                let (_temporary, path) = fixture();
+                let lock = path.join(LOCK);
+                match kind {
+                    "symlink" | "hardlink" => {
+                        let target = path.join("unrelated");
+                        fs::write(&target, b"untouched").unwrap();
+                        fs::set_permissions(&target, fs::Permissions::from_mode(0o600)).unwrap();
+                        if kind == "symlink" {
+                            symlink(&target, &lock).unwrap();
+                        } else {
+                            fs::hard_link(&target, &lock).unwrap();
+                        }
+                    }
+                    "directory" => fs::create_dir(&lock).unwrap(),
+                    "fifo" => {
+                        let name = CString::new(lock.as_os_str().as_bytes()).unwrap();
+                        assert_eq!(unsafe { libc::mkfifo(name.as_ptr(), 0o600) }, 0);
+                    }
+                    _ => unreachable!(),
+                }
+                assert!(acquire_private(&path).is_err(), "accepted {kind}");
+                if kind == "symlink" || kind == "hardlink" {
+                    assert_eq!(fs::read(path.join("unrelated")).unwrap(), b"untouched");
+                }
+            }
+        }
+
+        #[test]
+        fn refuses_nonprivate_modes_and_wrong_owner_expectation() {
+            let (_temporary, path) = fixture();
+            fs::set_permissions(&path, fs::Permissions::from_mode(0o755)).unwrap();
+            assert!(acquire_private(&path).is_err());
+            fs::set_permissions(&path, fs::Permissions::from_mode(0o700)).unwrap();
+            fixture_marker(&path, marker(b'C', 1).as_bytes());
+            fs::set_permissions(path.join(LOCK), fs::Permissions::from_mode(0o644)).unwrap();
+            assert!(acquire_private(&path).is_err());
+            fs::set_permissions(path.join(LOCK), fs::Permissions::from_mode(0o600)).unwrap();
+            let mut directory = Directory::for_test(&path).unwrap();
+            directory.uid = directory.uid.checked_add(1).unwrap();
+            assert!(validate_file(&directory, &File::open(path.join(LOCK)).unwrap()).is_err());
+            assert!(directory.validate().is_err());
+        }
+
+        #[test]
+        fn refuses_extended_acl_even_when_posix_mode_is_private() {
+            for directory_acl in [false, true] {
+                let (_temporary, path) = fixture();
+                fixture_marker(&path, marker(b'C', 1).as_bytes());
+                let mut baseline = acquire_private(&path).unwrap();
+                baseline.release_clean().unwrap();
+                let target = if directory_acl {
+                    path.clone()
+                } else {
+                    path.join(LOCK)
+                };
+                // macOS chmod affects only the test's private fixture. No ACL on
+                // the actual account home or canonical lease is ever changed.
+                assert!(Command::new("/bin/chmod")
+                    .args(["+a", "everyone allow read"])
+                    .arg(&target)
+                    .status()
+                    .unwrap()
+                    .success());
+                assert_eq!(
+                    fs::metadata(&target).unwrap().mode() & 0o7777,
+                    if directory_acl { 0o700 } else { 0o600 }
+                );
+                let error = acquire_private(&path).err().expect("extended ACL admitted");
+                assert!(error.to_string().contains("extended ACL"), "{error:#}");
+            }
+        }
+
+        #[test]
+        fn refuses_empty_dirty_malformed_and_exhausted_markers_without_repair() {
+            for contents in [
+                Vec::new(),
+                b"malformed".to_vec(),
+                marker(b'D', 7).into_bytes(),
+                marker(b'C', 0).into_bytes(),
+                marker(b'C', u64::MAX).into_bytes(),
+                format!("{}extra", marker(b'C', 1)).into_bytes(),
+            ] {
+                let (_temporary, path) = fixture();
+                fixture_marker(&path, &contents);
+                let original = fs::metadata(path.join(LOCK)).unwrap();
+                assert!(acquire_private(&path).is_err());
+                assert_eq!(fs::read(path.join(LOCK)).unwrap(), contents);
+                assert!(same_inode(
+                    &original,
+                    &fs::metadata(path.join(LOCK)).unwrap()
+                ));
+            }
+        }
+
+        #[test]
+        fn replaced_file_or_directory_cannot_clean_the_owned_inode() {
+            for replace_directory in [false, true] {
+                let (_temporary, root) = fixture();
+                let path = root.join("lease");
+                DirBuilder::new().mode(0o700).create(&path).unwrap();
+                let mut lease = acquire_private(&path).unwrap();
+                if replace_directory {
+                    fs::rename(&path, root.join("old-directory")).unwrap();
+                    DirBuilder::new().mode(0o700).create(&path).unwrap();
+                } else {
+                    fs::rename(path.join(LOCK), path.join("old-lock")).unwrap();
+                }
+                fixture_marker(&path, marker(b'C', 9).as_bytes());
+                assert!(lease.release_clean().is_err());
+                assert_eq!(
+                    read_marker(lease.file.as_ref().unwrap()).unwrap(),
+                    (b'D', 1)
+                );
+                assert_eq!(
+                    fs::read(path.join(LOCK)).unwrap(),
+                    marker(b'C', 9).as_bytes()
+                );
+                // The old inode is still owned even after its path was replaced.
+                let old = if replace_directory {
+                    root.join("old-directory").join(LOCK)
+                } else {
+                    path.join("old-lock")
+                };
+                let competitor = OpenOptions::new().read(true).write(true).open(old).unwrap();
+                assert!(fs2::FileExt::try_lock_exclusive(&competitor).is_err());
+            }
+        }
+
+        #[test]
+        fn changed_generation_cannot_be_cleaned_by_an_old_owner() {
+            let (_temporary, path) = fixture();
+            let mut lease = acquire_private(&path).unwrap();
+            let file = lease.file.as_ref().unwrap();
+            write_marker(file, b'D', 2).unwrap();
+            assert!(lease.release_clean().is_err());
+            assert_eq!(
+                read_marker(lease.file.as_ref().unwrap()).unwrap(),
+                (b'D', 2)
+            );
+        }
+    }
+}
