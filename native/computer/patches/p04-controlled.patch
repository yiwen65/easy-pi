+++ b/libs/cua-driver/rust/crates/cua-driver-sdk/src/computer.rs
@@ -0,0 +1,654 @@
+//! Pi-owned controlled facade. Native sequential plans retain the same gate and drain proof.
+mod plan;
+mod plan_native;
+use crate::runtime::{DriverRuntime, RuntimeSession};
+use crate::ConfiguredDriverOptions;
+use cua_driver_contract::{ActionResult, WindowStateOutput};
+use cua_driver_core::computer_desktop_lease::ComputerDesktopLease;
+use cua_driver_core::controlled::{self, Gate, Operation, Session};
+use cua_driver_core::session_authorization::DelegatedSessionRequest;
+pub use plan::{
+    ComputerAddress, ComputerCondition, ComputerDispatch, ComputerPlan, ComputerPlanResult,
+    ComputerPlanStatus, ComputerSelector, ComputerStep, ComputerStepResult,
+};
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Arc, Mutex, OnceLock, Weak,
+};
+use tokio::sync::watch;
+
+#[derive(Debug, Clone, thiserror::Error, uniffi::Error)]
+pub enum ComputerError {
+    #[error("controlled operation refused: {reason}")]
+    Refused { reason: String },
+    #[error("controlled operation cancelled (input committed: {input_committed})")]
+    Cancelled { input_committed: bool },
+    #[error("native terminal proof unavailable; desktop owner retained")]
+    Quarantined,
+}
+
+fn refused(reason: &str) -> ComputerError {
+    ComputerError::Refused {
+        reason: reason.into(),
+    }
+}
+
+#[derive(Debug, Clone, uniffi::Enum)]
+pub enum ComputerResult {
+    Observation { value: WindowStateOutput },
+    Action { value: ActionResult },
+    Plan { value: ComputerPlanResult },
+}
+
+#[derive(Debug, Clone, uniffi::Record)]
+pub struct ComputerTerminal {
+    pub operation_id: String,
+    pub cancelled: bool,
+    pub input_committed: bool,
+}
+
+type Closing = watch::Sender<Option<Result<(), ComputerError>>>;
+
+fn executor() -> Result<&'static tokio::runtime::Runtime, ComputerError> {
+    static EXECUTOR: OnceLock<Result<tokio::runtime::Runtime, std::io::Error>> = OnceLock::new();
+    EXECUTOR
+        .get_or_init(|| {
+            tokio::runtime::Builder::new_multi_thread()
+                .worker_threads(2)
+                .enable_all()
+                .thread_name("pi-computer")
+                .build()
+        })
+        .as_ref()
+        .map_err(|_| refused("executor_unavailable"))
+}
+
+// This strong native owner is deliberate: foreign GC or a failed terminal
+// subscriber cannot release the FD. Cleared only by successful close.
+fn owner() -> &'static Mutex<Option<Arc<ComputerHost>>> {
+    static OWNER: OnceLock<Mutex<Option<Arc<ComputerHost>>>> = OnceLock::new();
+    OWNER.get_or_init(|| Mutex::new(None))
+}
+
+#[derive(uniffi::Object)]
+pub struct ComputerHost {
+    runtime: Arc<DriverRuntime>,
+    gate: Arc<Gate>,
+    lease: Mutex<Option<ComputerDesktopLease>>,
+    template: DelegatedSessionRequest,
+    sessions: Mutex<Vec<Weak<ComputerSession>>>,
+    // Only native proof state is retained, never foreign results/facades.
+    operations: Mutex<Vec<Arc<Operation>>>,
+    scheduler: Arc<tokio::sync::Mutex<()>>,
+    closing: OnceLock<Closing>,
+}
+
+#[uniffi::export]
+impl ComputerHost {
+    #[uniffi::constructor]
+    pub fn create(options: ConfiguredDriverOptions) -> Result<Arc<Self>, ComputerError> {
+        if !cfg!(all(target_os = "macos", target_arch = "aarch64")) {
+            return Err(refused("unsupported_platform"));
+        }
+        executor()?;
+        let native_options = crate::abi::computer_runtime_options(options.clone())
+            .map_err(|_| refused("authorization_configuration_refused"))?;
+        let (mode, manifest) = native_options
+            .compatibility_authorization
+            .clone()
+            .ok_or_else(|| refused("explicit_authorization_required"))?;
+        let mut slot = owner().lock().map_err(|_| ComputerError::Quarantined)?;
+        if slot.is_some() {
+            return Err(refused("host_already_exists"));
+        }
+        let mut lease =
+            ComputerDesktopLease::acquire().map_err(|_| refused("desktop_lease_unavailable"))?;
+        let runtime = match DriverRuntime::create_computer(native_options) {
+            Ok(runtime) => runtime,
+            Err(_) => {
+                // The narrow constructor has no actuator or callback facility.
+                if lease.release_clean().is_err() {
+                    std::mem::forget(lease);
+                }
+                return Err(refused("runtime_creation_failed"));
+            }
+        };
+        let host = Arc::new(Self {
+            runtime,
+            gate: Gate::new(),
+            lease: Mutex::new(Some(lease)),
+            template: DelegatedSessionRequest {
+                public_session: String::new(),
+                transport_session: String::new(),
+                mode,
+                ttl: std::time::Duration::from_secs(options.authorization.max_session_ttl_seconds),
+                idle_ttl: std::time::Duration::from_secs(
+                    options.authorization.max_idle_ttl_seconds,
+                ),
+                capability_manifest: manifest,
+            },
+            sessions: Mutex::new(Vec::new()),
+            operations: Mutex::new(Vec::new()),
+            scheduler: Arc::new(tokio::sync::Mutex::new(())),
+            closing: OnceLock::new(),
+        });
+        *slot = Some(host.clone());
+        Ok(host)
+    }
+
+    pub fn open_session(
+        self: Arc<Self>,
+        pid: u32,
+        window_id: u64,
+        parent: Option<Arc<ComputerSession>>,
+    ) -> Result<Arc<ComputerSession>, ComputerError> {
+        let pid = i32::try_from(pid)
+            .ok()
+            .filter(|pid| *pid > 0)
+            .ok_or_else(|| refused("invalid_target"))?;
+        let window_id = u32::try_from(window_id)
+            .ok()
+            .filter(|id| *id > 0)
+            .ok_or_else(|| refused("invalid_target"))?;
+        if parent
+            .as_ref()
+            .is_some_and(|parent| !Arc::ptr_eq(&parent.host, &self))
+        {
+            return Err(refused("foreign_parent"));
+        }
+        #[cfg(target_os = "macos")]
+        let process_stamp = Some(
+            platform_macos::tools::computer_process_stamp(pid)
+                .ok_or_else(|| refused("target_process_unavailable"))?,
+        );
+        #[cfg(not(target_os = "macos"))]
+        let process_stamp = None;
+        let mut sessions = self.sessions.lock().map_err(|_| self.quarantine())?;
+        let label = format!("pi-computer-{}", uuid::Uuid::new_v4());
+        let native = self
+            .runtime
+            .create_computer_session(
+                DelegatedSessionRequest {
+                    public_session: label.clone(),
+                    transport_session: label,
+                    mode: self.template.mode,
+                    ttl: self.template.ttl,
+                    idle_ttl: self.template.idle_ttl,
+                    capability_manifest: self.template.capability_manifest.clone(),
+                },
+                parent.as_ref().map(|parent| parent.native.as_ref()),
+            )
+            .map_err(|_| refused("session_authorization_refused"))?;
+        let authority = native.clone();
+        let gate = self
+            .gate
+            .session(
+                parent.map(|parent| parent.gate.clone()),
+                Arc::new(move || authority.computer_authority_live()),
+                pid,
+                window_id,
+                process_stamp,
+            )
+            .map_err(refused)?;
+        if !native.computer_bind_snapshots(gate.snapshots.clone()) {
+            return Err(self.quarantine());
+        }
+        let session = Arc::new(ComputerSession {
+            host: self.clone(),
+            native,
+            gate,
+            observation: Mutex::new(None),
+            closing: OnceLock::new(),
+            closed: AtomicBool::new(false),
+            #[cfg(test)]
+            drop_barrier: Mutex::new(None),
+        });
+        sessions.retain(|session| session.strong_count() > 0);
+        sessions.push(Arc::downgrade(&session));
+        Ok(session)
+    }
+
+    pub fn revoke(&self) {
+        self.gate.revoke();
+        if let Ok(sessions) = self.sessions.lock() {
+            for session in sessions.iter().filter_map(Weak::upgrade) {
+                session.native.computer_revoke();
+            }
+        } else {
+            self.gate.quarantine();
+        }
+        if let Ok(operations) = self.operations.lock() {
+            for operation in operations.iter() {
+                operation.cancel();
+            }
+        } else {
+            self.gate.quarantine();
+        }
+    }
+}
+
+#[uniffi::export(async_runtime = "tokio")]
+impl ComputerHost {
+    pub async fn close(self: Arc<Self>) -> Result<(), ComputerError> {
+        self.revoke();
+        let sender = self.closing.get_or_init(|| {
+            let sender = watch::channel(None).0;
+            let task_sender = sender.clone();
+            let host = self.clone();
+            executor()
+                .expect("executor was created before host")
+                .spawn(async move {
+                    let worker_host = host.clone();
+                    let result = tokio::spawn(async move { worker_host.close_owned().await })
+                        .await
+                        .unwrap_or(Err(ComputerError::Quarantined));
+                    if result.is_err() {
+                        host.gate.quarantine();
+                    }
+                    task_sender.send_replace(Some(result));
+                });
+            sender
+        });
+        wait_close(sender).await
+    }
+}
+
+impl ComputerHost {
+    fn quarantine(&self) -> ComputerError {
+        self.gate.quarantine();
+        ComputerError::Quarantined
+    }
+
+    async fn close_owned(self: Arc<Self>) -> Result<(), ComputerError> {
+        if self.gate.is_quarantined() {
+            return Err(ComputerError::Quarantined);
+        }
+        let operations = self
+            .operations
+            .lock()
+            .map_err(|_| self.quarantine())?
+            .clone();
+        for operation in operations {
+            operation.terminal().await.map_err(|_| self.quarantine())?;
+        }
+        // Runtime-owned IDs include sessions whose last foreign facade is
+        // currently dropping; cleanup is serialized independently of Weak.
+        self.runtime
+            .computer_shutdown()
+            .await
+            .map_err(|_| self.quarantine())?;
+        let mut lease = self.lease.lock().map_err(|_| self.quarantine())?;
+        let mut operations = self.operations.lock().map_err(|_| self.quarantine())?;
+        let mut sessions = self.sessions.lock().map_err(|_| self.quarantine())?;
+        let mut slot = owner().lock().map_err(|_| self.quarantine())?;
+        if self.gate.is_quarantined() {
+            return Err(ComputerError::Quarantined);
+        }
+        for session in sessions.iter().filter_map(Weak::upgrade) {
+            *session.observation.lock().map_err(|_| self.quarantine())? = None;
+            session.closed.store(true, Ordering::Release);
+        }
+        operations.clear();
+        sessions.clear();
+        // All fallible lock/cleanup checks precede clean-marker publication.
+        if let Some(lease) = lease.as_mut() {
+            lease.release_clean().map_err(|_| self.quarantine())?;
+        }
+        *lease = None;
+        if slot.as_ref().is_some_and(|host| Arc::ptr_eq(host, &self)) {
+            *slot = None;
+        }
+        Ok(())
+    }
+}
+
+#[derive(uniffi::Object)]
+pub struct ComputerSession {
+    host: Arc<ComputerHost>,
+    native: Arc<RuntimeSession>,
+    gate: Arc<Session>,
+    observation: Mutex<Option<WindowStateOutput>>,
+    closing: OnceLock<Closing>,
+    closed: AtomicBool,
+    #[cfg(test)]
+    drop_barrier: Mutex<Option<(std::sync::mpsc::Sender<()>, std::sync::mpsc::Receiver<()>)>>,
+}
+
+#[uniffi::export]
+impl ComputerSession {
+    pub fn new_operation(self: Arc<Self>) -> Result<Arc<ComputerOperation>, ComputerError> {
+        let mut operations = self
+            .host
+            .operations
+            .lock()
+            .map_err(|_| self.host.quarantine())?;
+        let core = self.gate.new_operation().map_err(refused)?;
+        let operation = Arc::new(ComputerOperation {
+            core: core.clone(),
+            session: self.clone(),
+            outcome: Mutex::new(None),
+        });
+        operations.retain(|operation| !operation.is_proven_terminal());
+        operations.push(core);
+        Ok(operation)
+    }
+
+    pub fn revoke(&self) {
+        self.gate.revoke();
+        if let Ok(sessions) = self.host.sessions.lock() {
+            for session in sessions
+                .iter()
+                .filter_map(Weak::upgrade)
+                .filter(|session| session.gate.descends_from(&self.gate))
+            {
+                session.native.computer_revoke();
+            }
+        } else {
+            self.host.gate.quarantine();
+        }
+        if let Ok(operations) = self.host.operations.lock() {
+            for operation in operations
+                .iter()
+                .filter(|op| op.session.descends_from(&self.gate))
+            {
+                operation.cancel();
+            }
+        } else {
+            self.host.gate.quarantine();
+        }
+    }
+}
+
+#[uniffi::export(async_runtime = "tokio")]
+impl ComputerSession {
+    pub async fn close(self: Arc<Self>) -> Result<(), ComputerError> {
+        self.revoke();
+        let sender = self.closing.get_or_init(|| {
+            let sender = watch::channel(None).0;
+            let task_sender = sender.clone();
+            let session = self.clone();
+            executor().expect("executor exists").spawn(async move {
+                let host = session.host.clone();
+                let result = tokio::spawn(async move {
+                    if session.host.gate.is_quarantined() {
+                        return Err(ComputerError::Quarantined);
+                    }
+                    let operations = session
+                        .host
+                        .operations
+                        .lock()
+                        .map_err(|_| session.host.quarantine())?
+                        .iter()
+                        .filter(|op| op.session.descends_from(&session.gate))
+                        .cloned()
+                        .collect::<Vec<_>>();
+                    for operation in operations {
+                        operation
+                            .terminal()
+                            .await
+                            .map_err(|_| session.host.quarantine())?;
+                    }
+                    if !session.native.computer_close_subtree()
+                        || session.host.gate.is_quarantined()
+                    {
+                        return Err(session.host.quarantine());
+                    }
+                    let sessions = session
+                        .host
+                        .sessions
+                        .lock()
+                        .map_err(|_| session.host.quarantine())?
+                        .iter()
+                        .filter_map(Weak::upgrade)
+                        .filter(|child| child.gate.descends_from(&session.gate))
+                        .collect::<Vec<_>>();
+                    for child in sessions {
+                        *child
+                            .observation
+                            .lock()
+                            .map_err(|_| session.host.quarantine())? = None;
+                        child.closed.store(true, Ordering::Release);
+                    }
+                    session
+                        .host
+                        .operations
+                        .lock()
+                        .map_err(|_| session.host.quarantine())?
+                        .retain(|operation| !operation.is_proven_terminal());
+                    session
+                        .host
+                        .sessions
+                        .lock()
+                        .map_err(|_| session.host.quarantine())?
+                        .retain(|child| {
+                            child
+                                .upgrade()
+                                .is_some_and(|child| !child.closed.load(Ordering::Acquire))
+                        });
+                    Ok(())
+                })
+                .await
+                .unwrap_or(Err(ComputerError::Quarantined));
+                if result.is_err() {
+                    host.gate.quarantine();
+                }
+                task_sender.send_replace(Some(result));
+            });
+            sender
+        });
+        wait_close(sender).await
+    }
+}
+
+impl Drop for ComputerSession {
+    fn drop(&mut self) {
+        // No facade-registry locks here: Weak upgrades can lose their last
+        // owner while the registry is being pruned. Runtime cleanup has its
+        // own native ownership lock and retains failed session IDs.
+        #[cfg(test)]
+        if let Some((entered, resume)) = self.drop_barrier.get_mut().unwrap().take() {
+            entered.send(()).unwrap();
+            resume.recv().unwrap();
+        }
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            self.gate.revoke();
+            self.closed.swap(true, Ordering::AcqRel) || self.native.computer_close()
+        }));
+        if !matches!(result, Ok(true)) {
+            self.host.gate.quarantine();
+        }
+    }
+}
+
+async fn wait_close(sender: &Closing) -> Result<(), ComputerError> {
+    let mut receiver = sender.subscribe();
+    loop {
+        if let Some(result) = receiver.borrow().clone() {
+            return result;
+        }
+        receiver
+            .changed()
+            .await
+            .map_err(|_| ComputerError::Quarantined)?;
+    }
+}
+
+#[derive(uniffi::Object)]
+pub struct ComputerOperation {
+    core: Arc<Operation>,
+    session: Arc<ComputerSession>,
+    outcome: Mutex<Option<Result<ComputerResult, ComputerError>>>,
+}
+
+#[uniffi::export]
+impl ComputerOperation {
+    pub fn cancel(&self) {
+        self.core.cancel();
+    }
+
+    pub fn start_observe(
+        self: Arc<Self>,
+        max_elements: u32,
+        max_depth: u32,
+    ) -> Result<(), ComputerError> {
+        if !(1..=512).contains(&max_elements) || !(1..=32).contains(&max_depth) {
+            return Err(refused("invalid_observation_bounds"));
+        }
+        self.start(
+            "get_window_state",
+            serde_json::json!({
+                "pid": self.session.gate.pid, "window_id": self.session.gate.window_id,
+                "include_accessibility_tree": true, "include_screenshot": false,
+                "max_elements": max_elements, "max_depth": max_depth,
+            }),
+        )
+    }
+
+    pub fn start_plan(self: Arc<Self>, plan: ComputerPlan) -> Result<(), ComputerError> {
+        plan::validate(&plan).map_err(refused)?;
+        let steps = plan.steps.len() as u32;
+        let worker = self.clone();
+        self.launch(Some(steps), async move {
+            Ok(ComputerResult::Plan {
+                value: plan::execute(worker.as_ref(), plan).await,
+            })
+        })
+    }
+
+    pub fn start_click(self: Arc<Self>, element_token: String) -> Result<(), ComputerError> {
+        if element_token.is_empty() || element_token.len() > 128 {
+            return Err(refused("invalid_element_token"));
+        }
+        self.start(
+            "click",
+            serde_json::json!({
+                "pid": self.session.gate.pid, "window_id": self.session.gate.window_id,
+                "element_token": element_token, "action": "press", "delivery_mode": "background",
+            }),
+        )
+    }
+}
+
+impl ComputerOperation {
+    fn start(
+        self: &Arc<Self>,
+        tool: &'static str,
+        args: serde_json::Value,
+    ) -> Result<(), ComputerError> {
+        let worker = self.clone();
+        self.launch(None, async move { worker.invoke(tool, args).await })
+    }
+
+    fn launch(
+        self: &Arc<Self>,
+        plan_steps: Option<u32>,
+        future: impl std::future::Future<Output = Result<ComputerResult, ComputerError>>
+            + Send
+            + 'static,
+    ) -> Result<(), ComputerError> {
+        // Fail fast; never queue a stale observation/plan behind another
+        // operation. The owned guard spans all callback/cleanup drain.
+        let serial = self
+            .session
+            .host
+            .scheduler
+            .clone()
+            .try_lock_owned()
+            .map_err(|_| refused("native_busy"))?;
+        if let Some(steps) = plan_steps {
+            self.core
+                .configure_plan(steps, std::time::Duration::from_secs(30))
+                .map_err(refused)?;
+        }
+        self.core.begin().map_err(|reason| {
+            if reason == "cancelled" {
+                ComputerError::Cancelled {
+                    input_committed: self.core.input_committed(),
+                }
+            } else {
+                refused(reason)
+            }
+        })?;
+        let operation = self.clone();
+        executor()?.spawn(async move {
+            let result = tokio::spawn(controlled::scope(operation.core.clone(), future)).await;
+            let result = match result {
+                Ok(result) => result,
+                Err(_) => {
+                    operation.core.quarantine();
+                    Err(ComputerError::Quarantined)
+                }
+            };
+            match operation.outcome.lock() {
+                Ok(mut outcome) => *outcome = Some(result),
+                Err(_) => operation.core.quarantine(),
+            }
+            operation.core.finish();
+            // Keep the host input lane through callback/cleanup drain, not
+            // merely until the tool's value or its async worker returns.
+            let _ = operation.core.terminal().await;
+            drop(serial);
+        });
+        Ok(())
+    }
+}
+
+impl Drop for ComputerOperation {
+    fn drop(&mut self) {
+        self.core.abandon();
+    }
+}
+
+#[uniffi::export(async_runtime = "tokio")]
+impl ComputerOperation {
+    pub async fn result(&self) -> Result<ComputerResult, ComputerError> {
+        let terminal = self.terminal().await?;
+        let outcome = self
+            .outcome
+            .lock()
+            .map_err(|_| self.session.host.quarantine())?
+            .clone();
+        // Cancellation is terminal metadata, not permission to erase an
+        // already fulfilled canonical ActionResult (including Unverifiable).
+        if let Some(Ok(ComputerResult::Action { value })) = &outcome {
+            return Ok(ComputerResult::Action {
+                value: value.clone(),
+            });
+        }
+        // Preserve the exact completed prefix and per-step delivery facts even
+        // when cancellation arrives after a committed part of the plan.
+        if let Some(Ok(ComputerResult::Plan { value })) = &outcome {
+            return Ok(ComputerResult::Plan {
+                value: value.clone(),
+            });
+        }
+        if terminal.cancelled {
+            return Err(ComputerError::Cancelled {
+                input_committed: terminal.input_committed,
+            });
+        }
+        outcome.unwrap_or(Err(ComputerError::Quarantined))
+    }
+
+    pub async fn terminal(&self) -> Result<ComputerTerminal, ComputerError> {
+        // The pinned foreign bridge can block inside wake until JS returns.
+        // Keep that waker off the core channel: notifications may hold the
+        // admission gate needed by synchronous foreign cancel/revoke calls.
+        // Dropping a foreign waiter detaches this native proof monitor, not
+        // the independently owned producer. Retain only core proof state.
+        let core = self.core.clone();
+        let terminal = executor()?
+            .spawn(async move { core.terminal().await })
+            .await
+            .map_err(|_| self.session.host.quarantine())?
+            .map_err(|_| ComputerError::Quarantined)?;
+        Ok(ComputerTerminal {
+            operation_id: self.core.id.clone(),
+            cancelled: terminal.cancelled,
+            input_committed: terminal.input_committed,
+        })
+    }
+}
