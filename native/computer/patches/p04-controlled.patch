diff --git a/libs/cua-driver/rust/crates/cua-driver-core/src/controlled.rs b/libs/cua-driver/rust/crates/cua-driver-core/src/controlled.rs
new file mode 100644
--- /dev/null
+++ b/libs/cua-driver/rust/crates/cua-driver-core/src/controlled.rs
@@ -0,0 +1,678 @@
+//! Pi's narrow controlled-operation lifetime. Not a generic tool capability.
+//!
+//! A foreign waiter never owns the producer. Cancellation closes primary
+//! admission, not already committed calls; terminal means driver-owned work
+//! drained, not that another application has processed all submitted input.
+
+use std::cell::RefCell;
+use std::future::Future;
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Arc, Condvar, Mutex, MutexGuard,
+};
+use tokio::sync::watch;
+
+fn lock<T>(value: &Mutex<T>) -> MutexGuard<'_, T> {
+    value.lock().unwrap_or_else(|error| error.into_inner())
+}
+
+pub struct Gate {
+    closed: Mutex<bool>,
+    quarantined: AtomicBool,
+    changed: watch::Sender<u64>,
+}
+
+impl Gate {
+    pub fn new() -> Arc<Self> {
+        Arc::new(Self {
+            closed: Mutex::new(false),
+            quarantined: AtomicBool::new(false),
+            changed: watch::channel(0).0,
+        })
+    }
+
+    fn guard(&self) -> MutexGuard<'_, bool> {
+        let mut closed = lock(&self.closed);
+        if self.closed.is_poisoned() || self.is_quarantined() {
+            self.quarantined.store(true, Ordering::Release);
+            *closed = true;
+            self.notify();
+        }
+        closed
+    }
+
+    fn notify(&self) {
+        self.changed
+            .send_modify(|value| *value = value.wrapping_add(1));
+    }
+
+    pub fn revoke(&self) {
+        *self.guard() = true;
+        self.notify();
+    }
+
+    pub fn quarantine(&self) {
+        self.quarantined.store(true, Ordering::Release);
+        self.revoke();
+    }
+
+    pub fn is_quarantined(&self) -> bool {
+        self.quarantined.load(Ordering::Acquire)
+    }
+
+    pub fn session(
+        self: &Arc<Self>,
+        parent: Option<Arc<Session>>,
+        authority_live: Arc<dyn Fn() -> bool + Send + Sync>,
+        pid: i32,
+        window_id: u32,
+        process_stamp: Option<(u64, u64)>,
+    ) -> Result<Arc<Session>, &'static str> {
+        let closed = self.guard();
+        if *closed {
+            return Err("host_closed");
+        }
+        if let Some(parent) = &parent {
+            if !Arc::ptr_eq(self, &parent.gate)
+                || !parent.live()
+                || parent.pid != pid
+                || parent.window_id != window_id
+                || parent.process_stamp != process_stamp
+            {
+                return Err("invalid_parent");
+            }
+        }
+        if !authority_live() {
+            return Err("authorization_unavailable");
+        }
+        Ok(Arc::new(Session {
+            gate: self.clone(),
+            parent,
+            revoked: Mutex::new(false),
+            authority_live,
+            pid,
+            window_id,
+            process_stamp,
+            snapshot: Mutex::new(None),
+            snapshots: Arc::new(SnapshotOwner::default()),
+        }))
+    }
+}
+
+pub struct Session {
+    gate: Arc<Gate>,
+    parent: Option<Arc<Session>>,
+    revoked: Mutex<bool>,
+    authority_live: Arc<dyn Fn() -> bool + Send + Sync>,
+    pub pid: i32,
+    pub window_id: u32,
+    pub process_stamp: Option<(u64, u64)>,
+    snapshot: Mutex<Option<u32>>,
+    pub snapshots: Arc<SnapshotOwner>,
+}
+
+/// Native cleanup ownership, independent of a foreign session facade and of
+/// token validity. Callbacks may only retire retained observation resources.
+#[derive(Default)]
+pub struct SnapshotOwner(Mutex<Option<Box<dyn FnOnce() + Send>>>);
+
+impl SnapshotOwner {
+    pub fn replace(&self, cleanup: impl FnOnce() + Send + 'static) -> Result<(), &'static str> {
+        let mut slot = self.0.lock().map_err(|_| "snapshot_cleanup_poisoned")?;
+        if let Some(previous) = slot.take() {
+            previous();
+        }
+        *slot = Some(Box::new(cleanup));
+        Ok(())
+    }
+
+    pub fn retire(&self) -> Result<(), &'static str> {
+        let mut slot = self.0.lock().map_err(|_| "snapshot_cleanup_poisoned")?;
+        if let Some(cleanup) = slot.take() {
+            cleanup();
+        }
+        Ok(())
+    }
+}
+
+impl Session {
+    // Only while the common gate is held. The checker is native authorization
+    // state, never a foreign-language callback.
+    fn live(&self) -> bool {
+        if self.revoked.is_poisoned() || self.snapshot.is_poisoned() {
+            self.gate.quarantined.store(true, Ordering::Release);
+            self.gate.notify();
+        }
+        !self.gate.is_quarantined()
+            && !*lock(&self.revoked)
+            && (self.authority_live)()
+            && self.parent.as_ref().is_none_or(|parent| parent.live())
+    }
+
+    pub fn revoke(&self) {
+        let _gate = self.gate.guard();
+        *lock(&self.revoked) = true;
+        *lock(&self.snapshot) = None;
+        self.gate.notify();
+    }
+
+    pub fn descends_from(&self, ancestor: &Arc<Self>) -> bool {
+        std::ptr::eq(self, Arc::as_ptr(ancestor))
+            || self
+                .parent
+                .as_ref()
+                .is_some_and(|parent| parent.descends_from(ancestor))
+    }
+
+    pub fn new_operation(self: &Arc<Self>) -> Result<Arc<Operation>, &'static str> {
+        let closed = self.gate.guard();
+        if *closed || !self.live() {
+            return Err("session_closed");
+        }
+        Ok(Arc::new(Operation {
+            id: uuid::Uuid::new_v4().to_string(),
+            session: self.clone(),
+            state: Mutex::new(State::default()),
+            cleanup_changed: Condvar::new(),
+        }))
+    }
+}
+
+#[derive(Default)]
+struct State {
+    started: bool,
+    cancelled: bool,
+    producer_done: bool,
+    active: usize,
+    callbacks: usize,
+    quarantine: bool,
+    input_committed: bool,
+    step_input_committed: bool,
+    plan_steps: Option<u32>,
+    next_step: u32,
+    deadline: Option<std::time::Instant>,
+    terminal: Option<Terminal>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Terminal {
+    pub cancelled: bool,
+    pub input_committed: bool,
+}
+
+pub struct Operation {
+    pub id: String,
+    pub session: Arc<Session>,
+    state: Mutex<State>,
+    cleanup_changed: Condvar,
+}
+
+impl Operation {
+    fn state(&self) -> MutexGuard<'_, State> {
+        let mut state = lock(&self.state);
+        if self.state.is_poisoned() {
+            self.session.gate.quarantined.store(true, Ordering::Release);
+            state.quarantine = true;
+            self.session.gate.notify();
+            self.cleanup_changed.notify_all();
+        }
+        if state.terminal.is_none()
+            && state
+                .deadline
+                .is_some_and(|deadline| std::time::Instant::now() >= deadline)
+        {
+            state.cancelled = true;
+        }
+        state
+    }
+
+    /// Configure an inert bounded plan, never a running operation. The deadline
+    /// gates future primitives; it cannot terminate a committed blocking OS call.
+    pub fn configure_plan(
+        &self,
+        steps: u32,
+        timeout: std::time::Duration,
+    ) -> Result<(), &'static str> {
+        let closed = self.session.gate.guard();
+        let mut state = self.state();
+        if *closed || !self.session.live() || state.cancelled || state.producer_done {
+            return Err("cancelled");
+        }
+        if state.started
+            || state.plan_steps.is_some()
+            || !(1..=8).contains(&steps)
+            || timeout.is_zero()
+            || timeout > std::time::Duration::from_secs(30)
+        {
+            return Err("invalid_plan");
+        }
+        state.plan_steps = Some(steps);
+        state.deadline = Some(std::time::Instant::now() + timeout);
+        self.session.gate.notify();
+        Ok(())
+    }
+
+    /// Only the serial Rust executor advances steps, after the preceding native
+    /// worker and focus callbacks drained. No permit escapes to a queued worker.
+    pub fn begin_step(&self, index: u32) -> Result<(), &'static str> {
+        let closed = self.session.gate.guard();
+        let mut state = self.state();
+        if *closed || !self.session.live() || state.cancelled || state.producer_done {
+            return Err("cancelled");
+        }
+        if !state.started
+            || state.active != 0
+            || index != state.next_step
+            || !state.plan_steps.is_some_and(|count| index < count)
+        {
+            return Err("invalid_step");
+        }
+        state.next_step += 1;
+        state.step_input_committed = false;
+        Ok(())
+    }
+
+    pub fn step_input_committed(&self) -> bool {
+        self.state().step_input_committed
+    }
+
+    pub fn deadline_expired(&self) -> bool {
+        self.state()
+            .deadline
+            .is_some_and(|deadline| std::time::Instant::now() >= deadline)
+    }
+
+    pub fn begin(&self) -> Result<(), &'static str> {
+        let closed = self.session.gate.guard();
+        let mut state = self.state();
+        if state.started {
+            return Err("already_started");
+        }
+        if *closed || !self.session.live() || state.cancelled || state.producer_done {
+            state.cancelled = true;
+            state.producer_done = true;
+            self.session.gate.notify();
+            return Err("cancelled");
+        }
+        state.started = true;
+        Ok(())
+    }
+
+    pub fn cancel(&self) {
+        let closed = self.session.gate.guard();
+        let mut state = self.state();
+        if state.terminal.is_some() {
+            return;
+        }
+        state.cancelled = true;
+        if !state.started {
+            state.producer_done = true;
+        }
+        self.settle(&mut state, *closed);
+        self.session.gate.notify();
+    }
+
+    /// Last facade-owner destruction is not cancellation of a running task.
+    /// The independent supervisor normally keeps that owner alive through
+    /// drain; losing it early makes proof unavailable and quarantines the host.
+    pub fn abandon(&self) {
+        let closed = self.session.gate.guard();
+        let mut state = self.state();
+        if state.terminal.is_some() {
+            return;
+        }
+        if !state.started && state.active == 0 {
+            state.cancelled = true;
+            state.producer_done = true;
+            self.settle(&mut state, *closed);
+        } else {
+            state.quarantine = true;
+            self.session.gate.quarantined.store(true, Ordering::Release);
+        }
+        self.session.gate.notify();
+        self.cleanup_changed.notify_all();
+    }
+
+    fn settle(&self, state: &mut State, closed: bool) {
+        if state.terminal.is_none()
+            && state.producer_done
+            && state.active == 0
+            && !state.quarantine
+            && !self.session.gate.is_quarantined()
+        {
+            let live = self.session.live();
+            let cancelled = closed || !live || state.cancelled;
+            if !self.session.gate.is_quarantined() {
+                state.terminal = Some(Terminal {
+                    cancelled,
+                    input_committed: state.input_committed,
+                });
+            }
+        }
+    }
+
+    pub fn checkpoint(&self) -> Result<(), &'static str> {
+        let closed = self.session.gate.guard();
+        let state = self.state();
+        if *closed
+            || !self.session.live()
+            || state.cancelled
+            || state.producer_done
+            || state.quarantine
+        {
+            Err("cancelled")
+        } else {
+            Ok(())
+        }
+    }
+
+    /// Commit and immediately invoke one primary primitive on this stack.
+    /// No permit is returned or queued. The common gate is NOT held across
+    /// the OS call, so Stop remains prompt. A committed call must drain.
+    pub fn primary<T>(&self, input: bool, call: impl FnOnce() -> T) -> Result<T, &'static str> {
+        {
+            let closed = self.session.gate.guard();
+            let mut state = self.state();
+            if *closed
+                || !self.session.live()
+                || state.cancelled
+                || state.producer_done
+                || state.quarantine
+            {
+                return Err("cancelled");
+            }
+            if !state.started
+                || (input
+                    && (state.step_input_committed
+                        || (state.plan_steps.is_some() && state.next_step == 0)))
+            {
+                return Err("invalid_primitive");
+            }
+            if input {
+                state.input_committed = true;
+                state.step_input_committed = true;
+            }
+        }
+        Ok(call())
+    }
+
+    pub fn reset_snapshot(&self) {
+        let _gate = self.session.gate.guard();
+        *lock(&self.session.snapshot) = None;
+    }
+
+    pub fn remember_snapshot(
+        &self,
+        id: u32,
+        cleanup: impl FnOnce() + Send + 'static,
+    ) -> Result<(), &'static str> {
+        // Resource retirement never holds the admission gate across native
+        // releases. Session close waits the independently retained producer.
+        if self.session.snapshots.replace(cleanup).is_err() {
+            self.quarantine();
+            return Err("snapshot_cleanup_poisoned");
+        }
+        let closed = self.session.gate.guard();
+        let state = self.state();
+        if *closed
+            || !self.session.live()
+            || state.cancelled
+            || state.producer_done
+            || state.quarantine
+        {
+            return Err("cancelled");
+        }
+        *lock(&self.session.snapshot) = Some(id);
+        Ok(())
+    }
+
+    pub fn consume_token(&self, token: &str) -> Result<(), &'static str> {
+        let closed = self.session.gate.guard();
+        let state = self.state();
+        if *closed
+            || !self.session.live()
+            || state.cancelled
+            || state.producer_done
+            || state.quarantine
+        {
+            return Err("cancelled");
+        }
+        let mut snapshot = lock(&self.session.snapshot);
+        if !snapshot.is_some_and(|id| token.starts_with(&format!("s{id:08x}:"))) {
+            return Err("stale_session_observation");
+        }
+        *snapshot = None;
+        Ok(())
+    }
+
+    /// Register before spawning or snapshotting a callback. Cleanup is allowed
+    /// after cancellation, but never after the supervisor closes producers.
+    pub fn track(self: &Arc<Self>) -> Result<Work, &'static str> {
+        self.track_kind(false)
+    }
+
+    pub fn track_callback(self: &Arc<Self>) -> Result<Work, &'static str> {
+        self.track_kind(true)
+    }
+
+    fn track_kind(self: &Arc<Self>, callback: bool) -> Result<Work, &'static str> {
+        let _gate = self.session.gate.guard();
+        let mut state = self.state();
+        if !state.started
+            || state.producer_done
+            || state.quarantine
+            || self.session.gate.is_quarantined()
+        {
+            return Err("producer_closed");
+        }
+        state.active += 1;
+        if callback {
+            state.callbacks += 1;
+        }
+        Ok(Work(self.clone(), callback))
+    }
+
+    /// Called only after all this operation's focus entries have been removed.
+    /// Retains the blocking worker and per-PID lane while matched callbacks
+    /// finish. No cancellation gate is held while a foreign callback runs.
+    pub fn wait_callbacks(&self) -> Result<(), &'static str> {
+        let mut state = self.state();
+        while state.callbacks > 0 {
+            state = match self.cleanup_changed.wait(state) {
+                Ok(state) => state,
+                Err(error) => {
+                    self.session.gate.quarantined.store(true, Ordering::Release);
+                    let mut state = error.into_inner();
+                    state.quarantine = true;
+                    state
+                }
+            };
+        }
+        if state.quarantine {
+            Err("quarantined")
+        } else {
+            Ok(())
+        }
+    }
+
+    pub fn quarantine(&self) {
+        let mut closed = self.session.gate.guard();
+        *closed = true;
+        self.session.gate.quarantined.store(true, Ordering::Release);
+        self.state().quarantine = true;
+        self.session.gate.notify();
+        self.cleanup_changed.notify_all();
+    }
+
+    pub fn finish(&self) {
+        let closed = self.session.gate.guard();
+        let mut state = self.state();
+        state.producer_done = true;
+        self.settle(&mut state, *closed);
+        self.session.gate.notify();
+    }
+
+    pub fn is_proven_terminal(&self) -> bool {
+        let state = self.state();
+        state.terminal.is_some() && !state.quarantine && !self.session.gate.is_quarantined()
+    }
+
+    pub fn input_committed(&self) -> bool {
+        self.state().input_committed
+    }
+
+    pub fn is_cancelled(&self) -> bool {
+        let closed = self.session.gate.guard();
+        *closed || !self.session.live() || self.state().cancelled
+    }
+
+    pub async fn cancelled(&self) {
+        let mut changed = self.session.gate.changed.subscribe();
+        loop {
+            if self.is_cancelled() {
+                return;
+            }
+            let deadline = {
+                let state = self.state();
+                if state.terminal.is_none() {
+                    state.deadline
+                } else {
+                    None
+                }
+            };
+            tokio::select! {
+                result = changed.changed() => { if result.is_err() { return; } }
+                _ = async {
+                    match deadline {
+                        Some(deadline) => tokio::time::sleep_until(deadline.into()).await,
+                        None => std::future::pending::<()>().await,
+                    }
+                } => {
+                    // A timer closes future admission, never the producer,
+                    // blocking worker, terminal proof or desktop lease.
+                    self.cancel();
+                }
+            }
+        }
+    }
+
+    pub async fn terminal(&self) -> Result<Terminal, &'static str> {
+        let mut changed = self.session.gate.changed.subscribe();
+        loop {
+            {
+                let closed = self.session.gate.guard();
+                let mut state = self.state();
+                if state.quarantine {
+                    return Err("quarantined");
+                }
+                // A different operation's later quarantine cannot invalidate
+                // this operation's already established immutable proof.
+                if let Some(terminal) = state.terminal {
+                    return Ok(terminal);
+                }
+                if self.session.gate.is_quarantined() {
+                    return Err("quarantined");
+                }
+                if !state.started && (*closed || !self.session.live()) {
+                    state.cancelled = true;
+                    state.producer_done = true;
+                }
+                self.settle(&mut state, *closed);
+                if self.session.gate.is_quarantined() {
+                    return Err("quarantined");
+                }
+                if let Some(terminal) = state.terminal {
+                    return Ok(terminal);
+                }
+            }
+            changed.changed().await.map_err(|_| "quarantined")?;
+        }
+    }
+
+    pub async fn blocking<T: Send + 'static>(
+        self: &Arc<Self>,
+        call: impl FnOnce() -> T + Send + 'static,
+    ) -> Result<T, &'static str> {
+        let work = self.track()?;
+        let operation = self.clone();
+        let runtime_scope = crate::tool::current_dispatch_runtime_scope();
+        match tokio::task::spawn_blocking(move || {
+            let _work = work;
+            on_thread(operation, || match runtime_scope {
+                Some(scope) => crate::tool::with_runtime_scope(scope, call),
+                None => call(),
+            })
+        })
+        .await
+        {
+            Ok(value) => Ok(value),
+            Err(_) => {
+                self.quarantine();
+                Err("quarantined")
+            }
+        }
+    }
+}
+
+pub struct Work(Arc<Operation>, bool);
+
+impl Drop for Work {
+    fn drop(&mut self) {
+        let mut closed = self.0.session.gate.guard();
+        let mut state = self.0.state();
+        if state.active == 0 {
+            state.quarantine = true;
+        } else {
+            state.active -= 1;
+        }
+        if self.1 {
+            if state.callbacks == 0 {
+                state.quarantine = true;
+            } else {
+                state.callbacks -= 1;
+            }
+        }
+        state.quarantine |= std::thread::panicking();
+        *closed |= state.quarantine;
+        if state.quarantine {
+            self.0
+                .session
+                .gate
+                .quarantined
+                .store(true, Ordering::Release);
+        }
+        self.0.settle(&mut state, *closed);
+        self.0.session.gate.notify();
+        self.0.cleanup_changed.notify_all();
+    }
+}
+
+tokio::task_local! { static CURRENT: Arc<Operation>; }
+thread_local! { static THREAD: RefCell<Option<Arc<Operation>>> = const { RefCell::new(None) }; }
+
+pub fn current() -> Option<Arc<Operation>> {
+    CURRENT
+        .try_with(Arc::clone)
+        .ok()
+        .or_else(|| THREAD.with(|value| value.borrow().clone()))
+}
+
+pub async fn scope<T>(operation: Arc<Operation>, future: impl Future<Output = T>) -> T {
+    CURRENT.scope(operation, future).await
+}
+
+fn on_thread<T>(operation: Arc<Operation>, call: impl FnOnce() -> T) -> T {
+    struct Restore(Option<Arc<Operation>>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            THREAD.with(|value| *value.borrow_mut() = self.0.take());
+        }
+    }
+    let _restore = Restore(THREAD.with(|value| value.replace(Some(operation))));
+    call()
+}
