+/// Narrow local qualification composition: no overlay, browser, recording,
+/// permission UX, global hooks or administrative dispatch surface.
+pub fn register_computer(registry: &mut ToolRegistry) {
+    let state = Arc::new(ToolState::new(false, true, None));
+    cua_driver_core::element_cache::register_runtime_cache(&state.element_cache);
+    registry.register(Box::new(list_apps::ListAppsTool));
+    // Only its protected-resource fingerprint method is used by registry
+    // authorization. Controlled ingress accepts only guarded observation/input.
+    registry.register(Box::new(kill_app::KillAppTool));
+    registry.register(Box::new(get_window_state::GetWindowStateTool::new(state.clone())));
+    registry.register(Box::new(click::ClickTool::new(state.clone())));
+    registry.register(Box::new(set_value::SetValueTool::new(state)));
+}
