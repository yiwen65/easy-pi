+//! Production executor adapter: every read/action still enters canonical native
+//! authorization and the controlled platform branch, never a bare AX invocation.
+use super::{plan::PlanBackend, refused, ComputerError, ComputerOperation, ComputerResult};
+use cua_driver_contract::{ActionResult, WindowStateOutput};
+use serde_json::{json, Value};
+
+fn plan_code(error: ComputerError) -> &'static str {
+    match error {
+        ComputerError::Cancelled { .. } => "cancelled",
+        ComputerError::Quarantined => "quarantined",
+        ComputerError::Refused { reason } => match reason.as_str() {
+            "permission_denied"
+            | "accessibility_permission_denied"
+            | "authorization_revoked"
+            | "authorization_suspended"
+            | "session_ended"
+            | "bounded_resource_outside_manifest" => "permission_denied",
+            "unexpected_modal_surface" => "unexpected_modal_surface",
+            "stale_session_observation" => "stale_observation",
+            "controlled_target_stale" | "controlled_target_unproven" => "target_unproven",
+            "controlled_fill_unavailable" | "controlled_press_unavailable" => "action_unavailable",
+            _ => "native_action_unconfirmed",
+        },
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn controlled_plan_projects_permissions_modals_and_stale_refs_without_free_text() {
+        for (code, expected) in [
+            ("permission_denied", "permission_denied"),
+            ("accessibility_permission_denied", "permission_denied"),
+            ("authorization_revoked", "permission_denied"),
+            ("unexpected_modal_surface", "unexpected_modal_surface"),
+            ("stale_session_observation", "stale_observation"),
+            ("untrusted application content", "native_action_unconfirmed"),
+        ] {
+            let result = crate::normalize_result(
+                "set_value",
+                json!({
+                    "isError": true, "structuredContent": {"refusal": {"code": code}},
+                    "content": [{"type":"text","text":"not condition evidence"}],
+                }),
+            )
+            .unwrap();
+            assert!(result.is_error);
+            assert_eq!(
+                plan_code(refused(result.error_code.as_deref().unwrap())),
+                expected
+            );
+        }
+    }
+}
+
+impl ComputerOperation {
+    pub(super) async fn invoke(
+        &self,
+        tool: &'static str,
+        args: Value,
+    ) -> Result<ComputerResult, ComputerError> {
+        self.core
+            .checkpoint()
+            .map_err(|_| ComputerError::Cancelled {
+                input_committed: self.core.input_committed(),
+            })?;
+        // Both a mutation and a replacement observation invalidate the prior
+        // grant, even when their result is lost/refused. Never return a stale
+        // last_snapshot_id or reinterpret a consumed ref using a later tree.
+        *self
+            .session
+            .observation
+            .lock()
+            .map_err(|_| self.session.host.quarantine())? = None;
+        let raw = self
+            .session
+            .native
+            .invoke(tool, args)
+            .await
+            .ok_or_else(|| refused("runtime_closed"))?;
+        let result = crate::normalize_result(
+            tool,
+            serde_json::to_value(raw).map_err(|_| refused("invalid_native_result"))?,
+        )
+        .map_err(|_| refused("invalid_native_result"))?;
+        if result.is_error {
+            return Err(refused(
+                result.error_code.as_deref().unwrap_or("native_refused"),
+            ));
+        }
+        if tool == "get_window_state" {
+            let value = result
+                .window_state_success()
+                .map_err(|_| refused("native_observation_refused"))?;
+            *self
+                .session
+                .observation
+                .lock()
+                .map_err(|_| self.session.host.quarantine())? = Some(value.clone());
+            Ok(ComputerResult::Observation { value })
+        } else {
+            result
+                .typed_success(tool)
+                .map(|value| ComputerResult::Action { value })
+                .map_err(|_| refused("native_action_unconfirmed"))
+        }
+    }
+}
+
+impl PlanBackend for ComputerOperation {
+    fn cached(&self) -> Option<WindowStateOutput> {
+        match self.session.observation.lock() {
+            Ok(value) => value.clone(),
+            Err(_) => {
+                self.session.host.quarantine();
+                None
+            }
+        }
+    }
+
+    fn begin_step(&self, index: u32) -> Result<(), &'static str> {
+        self.checkpoint()?;
+        self.core.begin_step(index)
+    }
+
+    fn checkpoint(&self) -> Result<(), &'static str> {
+        if self.core.deadline_expired() {
+            return Err("deadline_expired");
+        }
+        self.core.checkpoint()
+    }
+
+    fn input_committed(&self) -> bool {
+        self.core.step_input_committed()
+    }
+
+    async fn observe(&self) -> Result<WindowStateOutput, &'static str> {
+        let result = self
+            .invoke(
+                "get_window_state",
+                json!({
+                    "pid": self.session.gate.pid, "window_id": self.session.gate.window_id,
+                    "include_accessibility_tree": true, "include_screenshot": false,
+                    "max_elements": 512, "max_depth": 32,
+                }),
+            )
+            .await;
+        match result {
+            Ok(ComputerResult::Observation { value }) => Ok(value),
+            Err(error) => {
+                self.checkpoint()?;
+                Err(plan_code(error))
+            }
+            _ => Err("condition_unknown"),
+        }
+    }
+
+    async fn act(&self, token: String, text: Option<String>) -> Result<ActionResult, &'static str> {
+        let (tool, args) = match text {
+            Some(value) => (
+                "set_value",
+                json!({
+                    "pid": self.session.gate.pid, "window_id": self.session.gate.window_id,
+                    "element_token": token, "value": value,
+                }),
+            ),
+            None => (
+                "click",
+                json!({
+                    "pid": self.session.gate.pid, "window_id": self.session.gate.window_id,
+                    "element_token": token, "action": "press", "delivery_mode": "background",
+                }),
+            ),
+        };
+        match self.invoke(tool, args).await {
+            Ok(ComputerResult::Action { value }) => Ok(value),
+            Err(error) => {
+                self.checkpoint()?;
+                Err(plan_code(error))
+            }
+            _ => Err("native_action_unconfirmed"),
+        }
+    }
+}
