+        let gate = Gate::new();
+        let parent = gate.session(None, Arc::new(|| true), 42, 7, None).unwrap();
+        let child = gate
+            .session(Some(parent.clone()), Arc::new(|| true), 42, 7, None)
+            .unwrap();
+        let op = child.new_operation().unwrap();
+        op.configure_plan(2, Duration::from_secs(30)).unwrap();
+        op.begin().unwrap();
+        op.begin_step(0).unwrap();
+        op.primary(true, || ()).unwrap();
+        if revoke {
