+//! Bounded sequential execution. No retry, scripting, model, or implicit rebinding.
+use cua_driver_contract::{
+    ActionEffect, ActionEvidenceKind, ActionResult, WindowElement, WindowStateOutput,
+};
+use std::{future::Future, time::Instant};
+
+#[derive(Debug, Clone, PartialEq, Eq, uniffi::Record)]
+pub struct ComputerSelector {
+    pub role: String,
+    pub label: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, uniffi::Enum)]
+pub enum ComputerAddress {
+    Ref { token: String },
+    Selector { selector: ComputerSelector },
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, uniffi::Enum)]
+pub enum ComputerStep {
+    Fill {
+        target: ComputerAddress,
+        text: String,
+    },
+    Press {
+        target: ComputerAddress,
+        expect: ComputerSelector,
+        value: String,
+    },
+    AssertValue {
+        selector: ComputerSelector,
+        value: String,
+    },
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, uniffi::Record)]
+pub struct ComputerPlan {
+    pub snapshot_id: String,
+    pub steps: Vec<ComputerStep>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, uniffi::Enum)]
+pub enum ComputerPlanStatus {
+    Completed,
+    Paused,
+    Cancelled,
+    OutcomeUnknown,
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq, uniffi::Enum)]
+pub enum ComputerDispatch {
+    NotDispatched,
+    Dispatched,
+    Unknown,
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq, uniffi::Enum)]
+pub enum ComputerCondition {
+    Satisfied,
+    Unsatisfied,
+    Unknown,
+}
+
+#[derive(Debug, Clone, uniffi::Record)]
+pub struct ComputerStepResult {
+    pub index: u32,
+    pub dispatch: ComputerDispatch,
+    pub action: Option<ActionResult>,
+    pub condition: ComputerCondition,
+    pub code: Option<String>,
+    pub elapsed_ms: u64,
+}
+
+#[derive(Debug, Clone, uniffi::Record)]
+pub struct ComputerPlanResult {
+    pub status: ComputerPlanStatus,
+    pub completed_steps: u32,
+    pub first_unfinished_step: Option<u32>,
+    pub steps: Vec<ComputerStepResult>,
+    pub last_snapshot_id: Option<String>,
+    pub elapsed_ms: u64,
+}
+
+pub(super) fn validate(plan: &ComputerPlan) -> Result<(), &'static str> {
+    if plan.steps.is_empty()
+        || plan.steps.len() > 8
+        || plan.snapshot_id.is_empty()
+        || plan.snapshot_id.len() > 128
+    {
+        return Err("invalid_plan");
+    }
+    fn selector(value: &ComputerSelector) -> bool {
+        !value.role.is_empty()
+            && value.role.len() <= 64
+            && !value.label.is_empty()
+            && value.label.len() <= 256
+    }
+    fn address(value: &ComputerAddress) -> bool {
+        match value {
+            ComputerAddress::Ref { token } => !token.is_empty() && token.len() <= 128,
+            ComputerAddress::Selector { selector: value } => selector(value),
+        }
+    }
+    let mut bytes = 0;
+    for step in &plan.steps {
+        let valid = match step {
+            ComputerStep::Fill { target, text } => {
+                bytes += text.len();
+                address(target)
+            }
+            ComputerStep::Press {
+                target,
+                expect,
+                value,
+            } => {
+                bytes += value.len();
+                address(target) && selector(expect)
+            }
+            ComputerStep::AssertValue {
+                selector: target,
+                value,
+            } => {
+                bytes += value.len();
+                selector(target)
+            }
+        };
+        if !valid || bytes > 16 * 1024 {
+            return Err("invalid_plan");
+        }
+    }
+    Ok(())
+}
+
+/// Only native-owned implementations are used in production; mocks replace the
+/// desktop below the executor, not the executor or its cancellation decisions.
+pub(super) trait PlanBackend: Sync {
+    fn cached(&self) -> Option<WindowStateOutput>;
+    fn begin_step(&self, index: u32) -> Result<(), &'static str>;
+    fn checkpoint(&self) -> Result<(), &'static str>;
+    fn input_committed(&self) -> bool;
+    fn observe(&self) -> impl Future<Output = Result<WindowStateOutput, &'static str>> + Send;
+    fn act(
+        &self,
+        token: String,
+        text: Option<String>,
+    ) -> impl Future<Output = Result<ActionResult, &'static str>> + Send;
+}
+
+fn select<'a>(
+    observation: &'a WindowStateOutput,
+    selector: &ComputerSelector,
+) -> Result<&'a WindowElement, &'static str> {
+    // A missing row in a bounded/degraded observation is never absence proof.
+    if observation.elements_complete != Some(true)
+        || observation.truncated != Some(false)
+        || observation.degraded == Some(true)
+    {
+        // Keep a native-recognized branch boundary; never pass arbitrary
+        // degraded_reason text through as an executor error code.
+        return Err(
+            match (observation.degraded, observation.degraded_reason.as_deref()) {
+                (Some(true), Some("unexpected_modal_surface")) => "unexpected_modal_surface",
+                _ => "condition_unknown",
+            },
+        );
+    }
+    let mut matches = observation
+        .elements
+        .as_ref()
+        .ok_or("condition_unknown")?
+        .iter()
+        .filter(|element| {
+            element.role == selector.role
+                && element.label.as_deref() == Some(selector.label.as_str())
+        });
+    let element = matches.next().ok_or("target_missing")?;
+    if matches.next().is_some() {
+        return Err("target_ambiguous");
+    }
+    // Web content belongs to the separately authorized typed browser route.
+    if element.in_web_content != Some(false) {
+        return Err("unsupported_route");
+    }
+    Ok(element)
+}
+
+fn reference<'a>(
+    observation: &'a WindowStateOutput,
+    token: &str,
+) -> Result<&'a WindowElement, &'static str> {
+    observation
+        .elements
+        .as_ref()
+        .and_then(|elements| {
+            elements
+                .iter()
+                .find(|element| element.element_token.as_deref() == Some(token))
+        })
+        .filter(|element| element.in_web_content == Some(false))
+        .ok_or("stale_observation")
+}
+
+fn granted(observation: &WindowStateOutput, step: &ComputerStep) -> Result<(), &'static str> {
+    let target = match step {
+        ComputerStep::Fill { target, .. } => target,
+        ComputerStep::Press { target, expect, .. } => {
+            select(observation, expect)?;
+            target
+        }
+        ComputerStep::AssertValue { selector, .. } => {
+            select(observation, selector)?;
+            return Ok(());
+        }
+    };
+    match target {
+        ComputerAddress::Ref { token } => {
+            reference(observation, token)?;
+        }
+        ComputerAddress::Selector { selector } => {
+            select(observation, selector)?;
+        }
+    }
+    Ok(())
+}
+
+async fn resolve(
+    backend: &impl PlanBackend,
+    snapshot: &str,
+    target: &ComputerAddress,
+) -> Result<String, &'static str> {
+    backend.checkpoint()?;
+    let observation = match target {
+        ComputerAddress::Ref { .. } => {
+            let current = backend.cached().ok_or("stale_observation")?;
+            if current.snapshot_id.as_deref() != Some(snapshot) {
+                return Err("stale_observation");
+            }
+            current
+        }
+        ComputerAddress::Selector { .. } => backend.observe().await?,
+    };
+    backend.checkpoint()?;
+    let element = match target {
+        ComputerAddress::Ref { token } => reference(&observation, token)?,
+        ComputerAddress::Selector { selector } => select(&observation, selector)?,
+    };
+    if element.enabled != Some(true) {
+        return Err("target_disabled");
+    }
+    element.element_token.clone().ok_or("stale_observation")
+}
+
+async fn assert_value(
+    backend: &impl PlanBackend,
+    selector: &ComputerSelector,
+    value: &str,
+) -> Result<(), &'static str> {
+    backend.checkpoint()?;
+    let observation = backend.observe().await?;
+    backend.checkpoint()?;
+    match select(&observation, selector)?.value.as_deref() {
+        Some(actual) if actual == value => Ok(()),
+        Some(_) => Err("condition_unsatisfied"),
+        None => Err("condition_unknown"),
+    }
+}
+
+fn elapsed(start: Instant) -> u64 {
+    start.elapsed().as_millis().min(u128::from(u64::MAX)) as u64
+}
+
+pub(super) async fn execute(backend: &impl PlanBackend, plan: ComputerPlan) -> ComputerPlanResult {
+    let start = Instant::now();
+    let mut result = ComputerPlanResult {
+        status: ComputerPlanStatus::Completed,
+        completed_steps: 0,
+        first_unfinished_step: None,
+        steps: Vec::new(),
+        last_snapshot_id: None,
+        elapsed_ms: 0,
+    };
+    // Validate all grants before the first effect, rather than learning midway
+    // through a form that a later selector never belonged to an observation.
+    let admission = validate(&plan).and_then(|()| {
+        let observation = backend.cached().ok_or("stale_observation")?;
+        if observation.snapshot_id.as_deref() != Some(plan.snapshot_id.as_str()) {
+            return Err("stale_observation");
+        }
+        for step in &plan.steps {
+            granted(&observation, step)?;
+        }
+        Ok(())
+    });
+    if plan.steps.is_empty() {
+        result.status = ComputerPlanStatus::Paused;
+        result.first_unfinished_step = Some(0);
+        result.steps.push(ComputerStepResult {
+            index: 0,
+            dispatch: ComputerDispatch::NotDispatched,
+            action: None,
+            condition: ComputerCondition::Unknown,
+            code: Some("invalid_plan".into()),
+            elapsed_ms: 0,
+        });
+    }
+    for (index, step) in plan.steps.iter().enumerate() {
+        let step_start = Instant::now();
+        let mut entry = ComputerStepResult {
+            index: index as u32,
+            dispatch: ComputerDispatch::NotDispatched,
+            action: None,
+            condition: ComputerCondition::Unknown,
+            code: None,
+            elapsed_ms: 0,
+        };
+        let begin = admission.and_then(|()| backend.begin_step(index as u32));
+        let outcome = match begin {
+            Err(code) => Err(code),
+            Ok(()) => {
+                let outcome = async {
+                    match step {
+                        ComputerStep::AssertValue { selector, value } => {
+                            assert_value(backend, selector, value).await
+                        }
+                        ComputerStep::Fill { target, text }
+                        | ComputerStep::Press {
+                            target,
+                            value: text,
+                            ..
+                        } => {
+                            let token = resolve(backend, &plan.snapshot_id, target).await?;
+                            backend.checkpoint()?;
+                            let fill = matches!(step, ComputerStep::Fill { .. });
+                            let action = backend.act(token, fill.then(|| text.clone())).await?;
+                            let effect = action.effect;
+                            let value_proven = action.evidence.as_ref().is_some_and(|items| {
+                                items
+                                    .iter()
+                                    .any(|e| e.kind == ActionEvidenceKind::ValueReadback)
+                            });
+                            let escalation = action.escalation.is_some();
+                            entry.action = Some(action);
+                            if escalation
+                                || matches!(
+                                    effect,
+                                    ActionEffect::Refused
+                                        | ActionEffect::Partial
+                                        | ActionEffect::SuspectedNoop
+                                )
+                            {
+                                return Err("native_action_unconfirmed");
+                            }
+                            backend.checkpoint()?;
+                            match step {
+                                ComputerStep::Press { expect, value, .. } => {
+                                    assert_value(backend, expect, value).await
+                                }
+                                ComputerStep::Fill {
+                                    target: ComputerAddress::Selector { selector },
+                                    text,
+                                } => assert_value(backend, selector, text).await,
+                                ComputerStep::Fill { .. }
+                                    if effect == ActionEffect::Confirmed && value_proven =>
+                                {
+                                    Ok(())
+                                }
+                                _ => Err("condition_unknown"),
+                            }
+                        }
+                    }
+                }
+                .await;
+                if backend.input_committed() {
+                    entry.dispatch = if entry
+                        .action
+                        .as_ref()
+                        .is_some_and(|action| action.effect != ActionEffect::Refused)
+                    {
+                        ComputerDispatch::Dispatched
+                    } else {
+                        ComputerDispatch::Unknown
+                    };
+                }
+                outcome
+            }
+        };
+        entry.elapsed_ms = elapsed(step_start);
+        match outcome {
+            Ok(()) => {
+                entry.condition = ComputerCondition::Satisfied;
+                result.completed_steps += 1;
+            }
+            Err(code) => {
+                entry.code = Some(code.into());
+                if code == "condition_unsatisfied" {
+                    entry.condition = ComputerCondition::Unsatisfied;
+                }
+                result.first_unfinished_step = Some(index as u32);
+                result.status = if entry.dispatch == ComputerDispatch::Unknown
+                    || (entry.dispatch == ComputerDispatch::Dispatched
+                        && entry.condition == ComputerCondition::Unknown)
+                {
+                    ComputerPlanStatus::OutcomeUnknown
+                } else if matches!(code, "cancelled" | "deadline_expired") {
+                    ComputerPlanStatus::Cancelled
+                } else {
+                    ComputerPlanStatus::Paused
+                };
+            }
+        }
+        result.steps.push(entry);
+        if result.first_unfinished_step.is_some() {
+            break;
+        }
+    }
+    result.last_snapshot_id = backend
+        .cached()
+        .and_then(|observation| observation.snapshot_id);
+    result.elapsed_ms = elapsed(start);
+    result
+}
