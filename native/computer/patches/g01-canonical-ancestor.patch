+                let mut input = request(mode);
+                if with_manifest {
+                    input.capability_manifest = Some(manifest_with_allowed_tool("click"));
+                }
+                if computer {
+                    registry
+                        .bind_computer_session(&host, &connection, input, None)
+                        .unwrap();
+                } else {
+                    registry
+                        .bind_delegated_session(&host, &connection, input)
+                        .unwrap();
+                }
+                // Move only existing timers into the past. Owned contexts have
+                // no timer to age; this never introduces a test-only exemption.
+                {
+                    let mut state = registry.state.lock().unwrap();
+                    let context =
+                        Arc::get_mut(state.by_connection.get_mut(&connection.id).unwrap()).unwrap();
+                    let old = Instant::now() - Duration::from_secs(7200);
+                    if absolute {
+                        if let Some(expires) = &mut context.expires_at {
+                            *expires = old;
+                        }
+                    } else if let Some(last) = &context.last_authorized_dispatch {
+                        *last.lock().unwrap() = old;
+                    }
+                }
