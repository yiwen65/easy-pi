     #[tokio::test]
+    async fn controlled_full_access_parent_revocation_reaches_canonical_dispatch() {
+        let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+        let ceiling = SessionModeCeiling::for_trusted_sessions(
+            [PermissionMode::Unrestricted],
+            true,
+            Duration::from_secs(3600),
+            Duration::from_secs(600),
+        )
+        .unwrap();
+        let runtime = DriverRuntime::create_computer(RuntimeOptions::embedded_with_ceiling(
+            false,
+            ceiling,
+            PermissionMode::Unrestricted,
+            None,
+        ))
+        .unwrap();
+        let request = |name: &str| DelegatedSessionRequest {
+            public_session: name.into(),
+            transport_session: format!("transport-{name}"),
+            mode: PermissionMode::Unrestricted,
+            ttl: Duration::from_secs(3600),
+            idle_ttl: Duration::from_secs(600),
+            capability_manifest: None,
+        };
+        let parent = runtime
+            .create_computer_session(request("parent"), None)
+            .unwrap();
+        let child = runtime
+            .create_computer_session(request("child"), Some(&parent))
+            .unwrap();
+        let grandchild = runtime
+            .create_computer_session(request("grandchild"), Some(&child))
+            .unwrap();
+        let sibling = runtime
+            .create_computer_session(request("independent"), None)
+            .unwrap();
+        grandchild.context.commit_authorized_dispatch().unwrap();
+        parent.computer_revoke();
+        assert!(
+            grandchild.context.commit_authorized_dispatch().is_err(),
+            "canonical dispatch must reject an ancestor revoked outside the facade gate"
+        );
+        assert!(!child.computer_authority_live());
+        assert!(!grandchild.computer_authority_live());
+        assert!(
+            cua_driver_core::authorization::authorize_tool_call_with_context(
+                "click",
+                &serde_json::json!({}),
+                &grandchild.context,
+            )
+            .is_err()
+        );
+        assert!(runtime
+            .authorization_registry
+            .resolve_delegated(&grandchild.connection, "grandchild", "transport-grandchild",)
+            .is_err());
+        assert!(sibling.computer_authority_live());
+        assert!(runtime
+            .create_computer_session(request("late"), Some(&child))
+            .is_err());
+        runtime.computer_shutdown().await.unwrap();
+    }
