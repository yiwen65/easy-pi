+use super::*;
+use crate::controlled::Gate;
+use std::sync::Arc;
+
+#[tokio::test]
+async fn controlled_recovery_deadline_cannot_be_renewed_by_a_new_operation() {
+    let gate = Gate::new();
+    let session = gate.session(None, Arc::new(|| true), 1, 2, None).unwrap();
+    let first = session.new_operation().unwrap();
+    first
+        .configure_segment(vec![1], Duration::from_millis(50))
+        .unwrap();
+    first.bind_segment_intent("same-intent").unwrap();
+    // Native deadline notification is the stimulus, not an arbitrary sleep or
+    // an assumed timeout receipt. Begin may already observe that real deadline.
+    if let Err(code) = first.begin() {
+        assert_eq!(code, "cancelled");
+    }
+    first.cancelled().await;
+    first.finish();
+    assert!(first.terminal().await.unwrap().cancelled);
+    let next = session.new_operation().unwrap();
+    next.configure_segment(vec![1], Duration::from_secs(30))
+        .unwrap();
+    assert_eq!(
+        next.bind_segment_intent("same-intent"),
+        Err("recovery_exhausted")
+    );
+    next.cancel();
+    assert!(!next.terminal().await.unwrap().input_committed);
+}
+
+#[tokio::test]
+async fn controlled_recovery_expiry_before_worker_binding_still_spends_the_first_budget() {
+    let gate = Gate::new();
+    let session = gate.session(None, Arc::new(|| true), 1, 2, None).unwrap();
+    let first = session.new_operation().unwrap();
+    first.configure_segment(vec![1], Duration::from_millis(50)).unwrap();
+    if let Err(code) = first.begin() { assert_eq!(code, "cancelled"); }
+    first.cancelled().await;
+    let _ = first.bind_recovery_budget("late-worker");
+    first.finish();
+    first.terminal().await.unwrap();
+    let next = session.new_operation().unwrap();
+    next.configure_segment(vec![1], Duration::from_secs(30)).unwrap();
+    assert_eq!(next.bind_recovery_budget("late-worker"), Err("recovery_exhausted"));
+    next.cancel();
+    next.terminal().await.unwrap();
+}
+
+#[tokio::test]
+async fn controlled_recovery_no_progress_operations_share_the_two_retry_limit() {
+    let gate = Gate::new();
+    let session = gate.session(None, Arc::new(|| true), 1, 2, None).unwrap();
+    for attempt in 0..4 {
+        let operation = session.new_operation().unwrap();
+        operation
+            .configure_segment(vec![1], Duration::from_secs(30))
+            .unwrap();
+        let bound = operation.bind_segment_intent("unchanged-missing-target");
+        if attempt < 3 {
+            assert_eq!(bound, Ok(()));
+            operation.begin().unwrap();
+            // Models/native callers may supply fresh observations, but a
+            // refused action that makes no progress must not spin forever.
+            operation.finish();
+        } else {
+            assert_eq!(bound, Err("recovery_exhausted"));
+            operation.cancel();
+        }
+        assert!(!operation.terminal().await.unwrap().input_committed);
+    }
+}
+
+#[tokio::test]
+async fn controlled_recovery_budget_is_not_available_until_real_work_drains() {
+    let gate = Gate::new();
+    let session = gate.session(None, Arc::new(|| true), 1, 2, None).unwrap();
+    let first = session.new_operation().unwrap();
+    first
+        .configure_segment(vec![1], Duration::from_secs(30))
+        .unwrap();
+    first.bind_segment_intent("draining").unwrap();
+    first.begin().unwrap();
+    let work = first.track().unwrap();
+    first.finish();
+    assert!(!first.is_proven_terminal());
+    let next = session.new_operation().unwrap();
+    next.configure_segment(vec![1], Duration::from_secs(30))
+        .unwrap();
+    assert_eq!(next.bind_segment_intent("draining"), Err("native_busy"));
+    drop(work);
+    first.terminal().await.unwrap();
+    assert_eq!(next.bind_segment_intent("draining"), Ok(()));
+    next.cancel();
+    next.terminal().await.unwrap();
+}
+
+#[test]
+fn controlled_recovery_only_native_work_spends_time_and_later_timeouts_cannot_expand_it() {
+    let gate = Gate::new();
+    let session = gate.session(None, Arc::new(|| true), 1, 2, None).unwrap();
+    session.intent_state("time").unwrap();
+    let start = Instant::now();
+    assert_eq!(
+        session.reserve_intent_time("time", "a", None, start, Duration::from_secs(30), start),
+        Ok(start + Duration::from_secs(30))
+    );
+    session
+        .finish_intent_time("time", "a", start + Duration::from_secs(12))
+        .unwrap();
+    // An hour spent outside native execution (e.g. model/user judgement) is not
+    // an authorization TTL and does not restore the already spent 12 seconds.
+    let later = start + Duration::from_secs(3600);
+    assert_eq!(
+        session.reserve_intent_time("time", "b", None, later, Duration::from_secs(30), later),
+        Ok(later + Duration::from_secs(18))
+    );
+    session
+        .finish_intent_time("time", "b", later + Duration::from_secs(18))
+        .unwrap();
+    assert_eq!(
+        session.reserve_intent_time("time", "c", None, later, Duration::from_secs(30), later),
+        Err("recovery_exhausted")
+    );
+    assert!(
+        session.new_operation().is_ok(),
+        "work budget does not revoke session authority"
+    );
+}
+
+#[tokio::test]
+async fn controlled_recovery_internal_route_and_external_retry_use_one_counter() {
+    let gate = Gate::new();
+    let session = gate.session(None, Arc::new(|| true), 1, 2, None).unwrap();
+    let first = session.new_operation().unwrap();
+    first
+        .configure_segment(vec![1], Duration::from_secs(30))
+        .unwrap();
+    first.bind_segment_intent("shared").unwrap();
+    first.begin().unwrap();
+    assert_eq!(session.recover_intent("shared"), Ok(1));
+    first.finish();
+    first.terminal().await.unwrap();
+    let next = session.new_operation().unwrap();
+    next.configure_segment(vec![1], Duration::from_secs(30))
+        .unwrap();
+    next.bind_segment_intent("shared").unwrap();
+    assert_eq!(session.intent_state("shared"), Ok((2, false, false)));
+    assert_eq!(session.recover_intent("shared"), Err("recovery_exhausted"));
+    next.cancel();
+    next.terminal().await.unwrap();
+}
+
+#[tokio::test]
+async fn controlled_recovery_prepared_pair_continues_one_attempt_without_marking_drag_sent() {
+    let gate = Gate::new();
+    let source = gate.session(None, Arc::new(|| true), 1, 2, Some((1, 2))).unwrap();
+    let destination = gate.session(None, Arc::new(|| true), 1, 3, Some((1, 2))).unwrap();
+    let first = source.new_operation().unwrap();
+    first.bind_drag_destination(destination.clone()).unwrap();
+    first
+        .configure_segment(vec![2], Duration::from_secs(30))
+        .unwrap();
+    first.bind_recovery_budget("prepared").unwrap();
+    first.begin().unwrap();
+    first.begin_segment_action(0).unwrap();
+    assert_eq!(source.recover_intent("prepared"), Ok(1));
+    first.segment_primary(|| ()).unwrap(); // activation, not requested drag
+    first.continue_after_drag_preparation().unwrap();
+    first.finish();
+    assert!(first.terminal().await.unwrap().input_committed);
+    assert_eq!(source.intent_state("prepared"), Ok((1, false, false)));
+    let next = source.new_operation().unwrap();
+    next.bind_drag_destination(destination).unwrap();
+    next.configure_segment(vec![2], Duration::from_secs(30))
+        .unwrap();
+    next.bind_recovery_budget("prepared").unwrap();
+    next.bind_segment_intent("prepared").unwrap();
+    assert_eq!(source.intent_state("prepared"), Ok((1, false, false)));
+    assert!(next.recovery_remaining_ms().unwrap() <= 30_000);
+    next.begin().unwrap();
+    next.begin_segment_action(0).unwrap();
+    next.segment_primary(|| ()).unwrap();
+    assert_eq!(source.intent_state("prepared"), Ok((1, true, false)));
+    next.finish();
+    next.terminal().await.unwrap();
+}
+
+#[tokio::test]
+async fn controlled_recovery_cancelled_or_quarantined_work_cannot_renew_its_binding() {
+    let gate = Gate::new();
+    let session = gate.session(None, Arc::new(|| true), 1, 2, None).unwrap();
+    let cancelled = session.new_operation().unwrap();
+    cancelled
+        .configure_segment(vec![1], Duration::from_secs(30))
+        .unwrap();
+    cancelled.cancel();
+    assert_eq!(
+        cancelled.bind_recovery_budget("cancelled"),
+        Err("cancelled")
+    );
+    assert_eq!(cancelled.bind_segment_intent("cancelled"), Err("cancelled"));
+    let unknown = session.new_operation().unwrap();
+    unknown
+        .configure_segment(vec![1], Duration::from_secs(30))
+        .unwrap();
+    unknown.bind_recovery_budget("unknown").unwrap();
+    unknown.begin().unwrap();
+    unknown.quarantine();
+    unknown.finish();
+    assert!(unknown.terminal().await.is_err());
+    assert!(session.recovery.lock().unwrap()["unknown"]
+        .time
+        .as_ref()
+        .unwrap()
+        .active
+        .is_some());
+}
