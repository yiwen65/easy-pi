+    /// Counts native work only. Time outside an operation (including model or
+    /// user judgement and separate captures) cannot expire session authority or
+    /// renew the remaining allowance. This does not mark requested input sent.
+    pub fn bind_recovery_budget(&self, intent: &str) -> Result<(), &'static str> {
+        self.session.intent_state(intent)?;
+        let closed = self.session.gate.guard();
+        let mut state = self.state();
+        if *closed || !self.dependencies_live(&state) || state.producer_done {
+            return Err("cancelled");
+        }
+        // A worker may first run after its configured deadline. Account that
+        // elapsed work instead of allowing the next operation a fresh budget;
+        // this accounting never reopens cancelled primary admission.
+        if state.cancelled && !state.deadline.is_some_and(|deadline| Instant::now() >= deadline) {
+            return Err("cancelled");
+        }
+        self.bind_recovery_budget_locked(&mut state, intent)
+    }
+
+    fn bind_recovery_budget_locked(&self, state: &mut super::State, intent: &str) -> Result<(), &'static str> {
+        if let Some(bound) = &state.segment_recovery_intent {
+            return if bound == intent { Ok(()) } else { Err("invalid_segment_intent") };
+        }
+        if state.segment_limits.is_none() || state.next_step != 0 {
+            return Err("invalid_segment_intent");
+        }
+        let started = state.segment_started.ok_or("invalid_segment_intent")?;
+        let deadline = state.deadline.ok_or("invalid_segment_intent")?;
+        let destination = state.drag_destination.as_ref().map(|session| session.native_window()).transpose()?;
+        let shared = self.session.reserve_intent_time(
+            intent, &self.id, destination, started, deadline.saturating_duration_since(started), Instant::now(),
+        )?;
+        state.deadline = Some(deadline.min(shared));
+        state.segment_recovery_intent = Some(intent.into());
+        self.session.gate.notify();
+        Ok(())
+    }
