+// Chromium's synchronous hit can initially be the button itself while its
+// renderer resolves the hidden text child. Only that pending case may wait.
+// An exhausted budget preserves the last read, never fabricates child evidence.
+fn settle_button_hit<T>(
+    mut read: impl FnMut() -> Result<(T, bool), &'static str>,
+    mut pause: impl FnMut() -> Result<bool, &'static str>,
+) -> Result<T, &'static str> {
+    loop {
+        let (hit, pending) = read()?;
+        if !pending || !pause()? {
+            return Ok(hit);
+        }
+    }
+}
