+/// Occlusion needs the visible stacking order, not the all-window catalog order.
+/// Keep accessory layers and per-window Space metadata in this snapshot.
+pub(crate) fn general_visible_windows_with_space_snapshot() -> WindowEnumeration {
+    enumerate_windows(
+        kCGWindowListOptionOnScreenOnly | kCGWindowListExcludeDesktopElements,
+        LayerFilter::General,
+    )
+}
