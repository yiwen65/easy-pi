+++ b/rust/crates/platform-macos/src/tools/computer/segment/target_click.rs
@@ -0,0 +1,206 @@
+//! Exact observed native target; no pixel fallback or identity reconstruction.
+use super::*;
+use crate::ax::cache::{CachedSnapshot, ObservedTarget};
+use cua_driver_core::element_token::parse_token;
+
+fn center(target: [f64; 4], window: [f64; 4]) -> Result<(f64, f64, f64, f64), &'static str> {
+    if !ObservedTarget::valid_rect(target) || !ObservedTarget::valid_rect(window)
+        || target[0] < window[0] || target[1] < window[1]
+        || target[0] + target[2] > window[0] + window[2]
+        || target[1] + target[3] > window[1] + window[3]
+    {
+        return Err("target_geometry_unknown");
+    }
+    let x = target[0] + target[2] / 2.0;
+    let y = target[1] + target[3] / 2.0;
+    Ok((x, y, x - window[0], y - window[1]))
+}
+
+fn unchanged(original: &ObservedTarget, data: &observation::Data, rect: [f64; 4]) -> bool {
+    !data.metadata_incomplete && data.enabled != Some(false)
+        && data.subrole.as_deref() != Some("AXSecureTextField")
+        && original.role == data.role && original.subrole == data.subrole && original.label == data.label
+        && original.identifier == data.identifier && original.value == data.value && original.rect == rect
+}
+
+fn covers_target(other: &crate::windows::WindowInfo, target_z: usize, x: f64, y: f64) -> bool {
+    // WindowInfo normalizes CG's front-to-back enumeration: larger is in front.
+    other.z_index > target_z && other.is_on_screen && other.on_current_space != Some(false)
+        && x >= other.bounds.x && y >= other.bounds.y
+        && x < other.bounds.x + other.bounds.width
+        && y < other.bounds.y + other.bounds.height
+}
+
+impl Context {
+    pub(super) fn click_target(
+        &self,
+        events: &mut Events,
+        reference: &str,
+    ) -> Result<(ActionRoute, bool), &'static str> {
+        if events.held() || events.dispatched {
+            return Err("segment_boundary_required");
+        }
+        let element = self.reference(reference)?;
+        let (generation, index) = parse_token(reference).ok_or("stale_session_observation")?;
+        let target = self.operation.session.native_window()?;
+        let cached = self.state.element_cache
+            .retained_snapshot(target.pid, u64::from(target.window_id), generation)
+            .ok_or("stale_session_observation")?;
+        let original = cached.targets.get(index).and_then(Option::as_ref)
+            .ok_or("target_geometry_unknown")?;
+        if matches!(original.role.as_str(), "AXWindow" | "AXApplication" | "AXWebArea" | "AXScrollArea") {
+            return Err("target_pointer_route_unsupported");
+        }
+        let window = cached.window_rect.ok_or("target_geometry_unknown")?;
+        let position = center(original.rect, window)?;
+        let foreground = self.foreground();
+        events.foreground = foreground;
+        let check = || {
+            self.input_check(foreground, false)?;
+            self.check_click_target(&cached, index, &element, position)
+        };
+        // Each primary independently checks current identity/geometry/hit.
+        // A change caused by pointer tracking stops before down. The existing
+        // Events owner releases an admitted down even on cancellation.
+        events.move_pointer(position, &check)?;
+        events.button_down(ComputerMouseButton::Left, 1, &check)?;
+        events.button_up(ComputerMouseButton::Left)?;
+        events.click_feedback();
+        Ok((ActionRoute::SyntheticEvents, foreground))
+    }
+
+    fn check_click_target(
+        &self,
+        cached: &CachedSnapshot,
+        selected: usize,
+        element: &RetainedElement,
+        position: (f64, f64, f64, f64),
+    ) -> Result<(), &'static str> {
+        // A removed retained handle may no longer answer AXWindow. Establish
+        // membership through the live tree first so replacement is reported as
+        // stale evidence, not an opaque native membership fault.
+        self.live()?;
+        let target = self.operation.session.native_window()?;
+        let native = Native { operation: &self.operation };
+        let tree = observation::scan_general(&native, native.general_input_window()?);
+        if !tree.structurally_complete() {
+            return Err("target_scope_incomplete");
+        }
+        let mut index = selected;
+        for depth in 0..=32 {
+            native.checkpoint()?;
+            let original = cached.targets.get(index).and_then(Option::as_ref)
+                .ok_or("target_geometry_unknown")?;
+            let ptr = *cached.elements.get(index).filter(|ptr| **ptr != 0)
+                .ok_or("stale_session_observation")?;
+            let row = tree.rows.iter().find(|row| unsafe {
+                core_foundation::base::CFEqual(ptr as CFTypeRef, row.element.as_ptr() as CFTypeRef) != 0
+            }).ok_or("stale_session_observation")?;
+            let rect = self.operation.primary(false, || unsafe {
+                bindings::element_screen_rect(row.element.as_ptr() as _)
+            })?.ok_or("target_geometry_unknown")?;
+            // Ancestor descriptions may change independently (e.g. a page
+            // title). Only the explicitly selected target binds descriptions.
+            if (index == selected && !unchanged(original, &row.data, rect))
+                || row.data.role != original.role || rect != original.rect
+            {
+                return Err("stale_session_observation");
+            }
+            match (original.parent, row.parent) {
+                (None, None) => break,
+                (Some(old), Some(now)) if depth < 32 => {
+                    let old_ptr = *cached.elements.get(old).filter(|ptr| **ptr != 0)
+                        .ok_or("stale_session_observation")?;
+                    let parent = tree.rows.get(now).ok_or("stale_session_observation")?;
+                    if unsafe { core_foundation::base::CFEqual(old_ptr as CFTypeRef, parent.element.as_ptr() as CFTypeRef) } == 0 {
+                        return Err("stale_session_observation");
+                    }
+                    index = old;
+                }
+                _ => return Err("stale_session_observation"),
+            }
+        }
+        let windows = self.operation.primary(false, crate::windows::general_visible_windows_with_space_snapshot)?;
+        let window = crate::windows::general_point_window_in(&windows.windows, target.pid, target.window_id,
+            cached.window_rect.ok_or("target_geometry_unknown")?)?;
+        if window.layer != 0 || !window.is_on_screen || window.on_current_space != Some(true) {
+            return Err("target_pointer_route_unsupported");
+        }
+        if windows.windows.iter().any(|other| {
+            covers_target(other, window.z_index, position.0, position.1)
+        }) {
+            return Err("target_occluded");
+        }
+        let hit = self.operation.primary(false, || unsafe {
+            bindings::element_at_screen_position(target.pid, position.0, position.1)
+        })?.ok_or("pointer_hit_unknown")?;
+        let hit = unsafe {
+            let owned = RetainedElement::retain(hit as usize);
+            CFRelease(hit as CFTypeRef);
+            owned
+        };
+        // Initial candidate requires the exact hit, not merely a containing
+        // group. This cannot silently click a different descendant or overlay.
+        if !native.same(element, &hit) {
+            return Err("pointer_hit_changed");
+        }
+        self.member(element)
+    }
+}
