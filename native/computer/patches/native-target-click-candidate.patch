+//! Exact observed native target; no pixel fallback or identity reconstruction.
+use super::*;
+use crate::ax::cache::{CachedSnapshot, ObservedTarget};
+use cua_driver_core::element_token::parse_token;
+
+fn center(target: [f64; 4], window: [f64; 4]) -> Result<(f64, f64, f64, f64), &'static str> {
+    if !ObservedTarget::valid_rect(target) || !ObservedTarget::valid_rect(window)
+        || target[0] < window[0] || target[1] < window[1]
+        || target[0] + target[2] > window[0] + window[2]
+        || target[1] + target[3] > window[1] + window[3]
+    {
+        return Err("target_geometry_unknown");
+    }
+    let x = target[0] + target[2] / 2.0;
+    let y = target[1] + target[3] / 2.0;
+    Ok((x, y, x - window[0], y - window[1]))
+}
+
+fn unchanged(original: &ObservedTarget, data: &observation::Data, rect: [f64; 4]) -> bool {
+    !data.metadata_incomplete && data.enabled != Some(false)
+        && data.subrole.as_deref() != Some("AXSecureTextField")
+        && original.role == data.role && original.subrole == data.subrole && original.label == data.label
+        && original.identifier == data.identifier && original.value == data.value && original.rect == rect
+}
+
+fn covers_target(other: &crate::windows::WindowInfo, target_z: usize, x: f64, y: f64) -> bool {
+    // WindowInfo normalizes CG's front-to-back enumeration: larger is in front.
+    other.z_index > target_z && other.is_on_screen && other.on_current_space != Some(false)
+        && x >= other.bounds.x && y >= other.bounds.y
+        && x < other.bounds.x + other.bounds.width
+        && y < other.bounds.y + other.bounds.height
+}
+
+fn observed_text_child(targets: &[Option<ObservedTarget>], selected: usize, x: f64, y: f64) -> Option<usize> {
+    let parent = targets.get(selected)?.as_ref()?;
+    if !matches!(parent.role.as_str(), "AXLink" | "AXButton" | "AXRadioButton") {
+        return None;
+    }
+    let mut matches = targets.iter().enumerate().filter_map(|(index, target)| {
+        let child = target.as_ref()?;
+        (child.parent == Some(selected) && child.role == "AXStaticText"
+            && ObservedTarget::valid_rect(child.rect)
+            && x >= child.rect[0] && y >= child.rect[1]
+            && x < child.rect[0] + child.rect[2] && y < child.rect[1] + child.rect[3])
+            .then_some(index)
+    });
+    let first = matches.next()?;
+    matches.next().is_none().then_some(first)
+}
+
+impl Context {
+    pub(super) fn click_target(
+        &self,
+        events: &mut Events,
+        reference: &str,
+    ) -> Result<(ActionRoute, bool), &'static str> {
+        if events.held() || events.dispatched {
+            return Err("segment_boundary_required");
+        }
+        let element = self.reference(reference)?;
+        let (generation, index) = parse_token(reference).ok_or("stale_session_observation")?;
+        let target = self.operation.session.native_window()?;
+        let cached = self.state.element_cache
+            .retained_snapshot(target.pid, u64::from(target.window_id), generation)
+            .ok_or("stale_session_observation")?;
+        let original = cached.targets.get(index).and_then(Option::as_ref)
+            .ok_or("target_geometry_unknown")?;
+        if matches!(original.role.as_str(), "AXWindow" | "AXApplication" | "AXWebArea" | "AXScrollArea") {
+            return Err("target_pointer_route_unsupported");
+        }
+        let window = cached.window_rect.ok_or("target_geometry_unknown")?;
+        let position = center(original.rect, window)?;
+        let foreground = self.foreground();
+        events.foreground = foreground;
+        let first_hit = std::cell::Cell::new(None);
+        let check = || {
+            self.input_check(foreground, false)?;
+            let hit = self.check_click_target(&cached, index, &element, position)?;
+            if first_hit.get().is_some_and(|original| original != hit) {
+                return Err("pointer_hit_changed");
+            }
+            first_hit.set(Some(hit));
+            Ok(())
+        };
+        // Each primary independently checks current identity/geometry/hit.
+        // A change caused by pointer tracking stops before down. The existing
+        // Events owner releases an admitted down even on cancellation.
+        events.move_pointer(position, &check)?;
+        events.button_down(ComputerMouseButton::Left, 1, &check)?;
+        events.button_up(ComputerMouseButton::Left)?;
+        events.click_feedback();
+        Ok((ActionRoute::SyntheticEvents, foreground))
+    }
+
+    fn check_click_target(
+        &self,
+        cached: &CachedSnapshot,
+        selected: usize,
+        element: &RetainedElement,
+        position: (f64, f64, f64, f64),
+    ) -> Result<usize, &'static str> {
+        // A removed retained handle may no longer answer AXWindow. Establish
+        // membership through the live tree first so replacement is reported as
+        // stale evidence, not an opaque native membership fault.
+        self.live()?;
+        let target = self.operation.session.native_window()?;
+        // Chromium may answer the first synchronous hit from approximate/cache
+        // data while scheduling a renderer hit. Start that read before the
+        // existing tree validation; never admit its result or wait/retry input.
+        // The final hit below remains a required check, not a freshness proof.
+        self.operation.primary(false, || unsafe {
+            if let Some(hit) = bindings::element_at_screen_position(target.pid, position.0, position.1) {
+                CFRelease(hit as CFTypeRef);
+            }
+        })?;
+        let native = Native { operation: &self.operation };
+        let tree = observation::scan_general(&native, native.general_input_window()?);
+        if !tree.structurally_complete() {
+            return Err("target_scope_incomplete");
+        }
+        let mut index = selected;
+        for depth in 0..=32 {
+            native.checkpoint()?;
+            let original = cached.targets.get(index).and_then(Option::as_ref)
+                .ok_or("target_geometry_unknown")?;
+            let ptr = *cached.elements.get(index).filter(|ptr| **ptr != 0)
+                .ok_or("stale_session_observation")?;
+            let row = tree.rows.iter().find(|row| unsafe {
+                core_foundation::base::CFEqual(ptr as CFTypeRef, row.element.as_ptr() as CFTypeRef) != 0
+            }).ok_or("stale_session_observation")?;
+            let rect = self.operation.primary(false, || unsafe {
+                bindings::element_screen_rect(row.element.as_ptr() as _)
+            })?.ok_or("target_geometry_unknown")?;
+            // Ancestor descriptions may change independently (e.g. a page
+            // title). Only the explicitly selected target binds descriptions.
+            if (index == selected && !unchanged(original, &row.data, rect))
+                || row.data.role != original.role || rect != original.rect
+            {
+                return Err("stale_session_observation");
+            }
+            match (original.parent, row.parent) {
+                (None, None) => break,
+                (Some(old), Some(now)) if depth < 32 => {
+                    let old_ptr = *cached.elements.get(old).filter(|ptr| **ptr != 0)
+                        .ok_or("stale_session_observation")?;
+                    let parent = tree.rows.get(now).ok_or("stale_session_observation")?;
+                    if unsafe { core_foundation::base::CFEqual(old_ptr as CFTypeRef, parent.element.as_ptr() as CFTypeRef) } == 0 {
+                        return Err("stale_session_observation");
+                    }
+                    index = old;
+                }
+                _ => return Err("stale_session_observation"),
+            }
+        }
+        let windows = self.operation.primary(false, crate::windows::general_visible_windows_with_space_snapshot)?;
+        let window = crate::windows::general_point_window_in(&windows.windows, target.pid, target.window_id,
+            cached.window_rect.ok_or("target_geometry_unknown")?)?;
+        if window.layer != 0 || !window.is_on_screen || window.on_current_space != Some(true) {
+            return Err("target_pointer_route_unsupported");
+        }
+        if windows.windows.iter().any(|other| {
+            covers_target(other, window.z_index, position.0, position.1)
+        }) {
+            return Err("target_occluded");
+        }
+        let hit = self.operation.primary(false, || unsafe {
+            bindings::element_at_screen_position(target.pid, position.0, position.1)
+        })?.ok_or("pointer_hit_unknown")?;
+        let hit = unsafe {
+            let owned = RetainedElement::retain(hit as usize);
+            CFRelease(hit as CFTypeRef);
+            owned
+        };
+        let hidden = cached.hit_children.iter().enumerate().find(|(_, (parent, _, _))| *parent == selected);
+        let hit_index = if let Some((index, (_, observed, original))) = hidden {
+            if cached.targets[selected].as_ref().is_none_or(|parent| parent.role != "AXButton")
+                || !native.same(observed, &hit) {
+                return Err("pointer_hit_changed");
+            }
+            let data = native.direct_text_child(element, &hit)?
+                .ok_or("stale_session_observation")?;
+            let rect = self.operation.primary(false, || unsafe {
+                bindings::element_screen_rect(hit.as_ptr() as _)
+            })?.ok_or("target_geometry_unknown")?;
+            if !unchanged(original, &data, rect) {
+                return Err("stale_session_observation");
+            }
+            cached.elements.len() + index
+        } else if native.same(element, &hit) {
+            selected
+        } else {
+            // Only one already-observed direct text child at the original
+            // center is admitted. Never infer identity from role or geometry.
+            let child_index = observed_text_child(&cached.targets, selected, position.0, position.1)
+                .ok_or("pointer_hit_changed")?;
+            let ptr = *cached.elements.get(child_index).filter(|ptr| **ptr != 0)
+                .ok_or("stale_session_observation")?;
+            if unsafe { core_foundation::base::CFEqual(ptr as CFTypeRef, hit.as_ptr() as CFTypeRef) } == 0 {
+                return Err("pointer_hit_changed");
+            }
+            let row = tree.rows.iter().find(|row| native.same(&row.element, &hit))
+                .ok_or("stale_session_observation")?;
+            let parent = row.parent.and_then(|index| tree.rows.get(index))
+                .ok_or("stale_session_observation")?;
+            if !native.same(&parent.element, element) {
+                return Err("stale_session_observation");
+            }
+            let rect = self.operation.primary(false, || unsafe {
+                bindings::element_screen_rect(hit.as_ptr() as _)
+            })?.ok_or("target_geometry_unknown")?;
+            let original = cached.targets[child_index].as_ref().ok_or("target_geometry_unknown")?;
+            if !unchanged(original, &row.data, rect) {
+                return Err("stale_session_observation");
+            }
+            child_index
+        };
+        self.member(element)?;
+        Ok(hit_index)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn target_click_text_child_is_direct_observed_unique_and_role_bounded() {
+        let parent = ObservedTarget { parent: None, role: "AXLink".into(), subrole: None,
+            label: Some("Target".into()), identifier: None, value: None, rect: [0.0, 0.0, 100.0, 40.0] };
+        let child = ObservedTarget { parent: Some(0), role: "AXStaticText".into(),
+            value: Some("Target".into()), rect: [20.0, 10.0, 60.0, 20.0], ..parent.clone() };
+        let mut targets = vec![Some(parent.clone()), Some(child.clone())];
+        assert_eq!(observed_text_child(&targets, 0, 50.0, 20.0), Some(1));
+        assert_eq!(observed_text_child(&targets, 0, 10.0, 20.0), None);
+        for role in ["AXButton", "AXRadioButton", "AXGroup", "AXWebArea", "AXTextField"] {
+            targets[0].as_mut().unwrap().role = role.into();
+            assert_eq!(observed_text_child(&targets, 0, 50.0, 20.0).is_some(),
+                matches!(role, "AXButton" | "AXRadioButton"));
+        }
+        targets[0] = Some(parent);
+        targets.push(Some(child.clone()));
+        assert_eq!(observed_text_child(&targets, 0, 50.0, 20.0), None);
+        targets.pop();
+        targets[1].as_mut().unwrap().parent = Some(2);
+        assert_eq!(observed_text_child(&targets, 0, 50.0, 20.0), None);
+        targets[1] = Some(child);
+        targets[1].as_mut().unwrap().role = "AXButton".into();
+        assert_eq!(observed_text_child(&targets, 0, 50.0, 20.0), None);
+        targets[1] = None;
+        assert_eq!(observed_text_child(&targets, 0, 50.0, 20.0), None);
+    }
+    #[test]
+    fn target_click_occlusion_uses_normalized_front_order_and_space() {
+        let mut other = crate::windows::WindowInfo {
+            window_id: 1, pid: 1, app_name: "owned".into(), title: String::new(),
+            bounds: crate::windows::WindowBounds { x: 10.0, y: 20.0, width: 100.0, height: 50.0 },
+            layer: 0, z_index: 9, is_on_screen: true,
+            current_space_id: Some(1), on_current_space: Some(true), space_ids: Some(vec![1]),
+        };
+        assert!(covers_target(&other, 8, 50.0, 40.0));
+        assert!(!covers_target(&other, 9, 50.0, 40.0));
+        assert!(!covers_target(&other, 10, 50.0, 40.0));
+        assert!(!covers_target(&other, 8, 110.0, 40.0));
+        other.on_current_space = Some(false);
+        assert!(!covers_target(&other, 8, 50.0, 40.0));
+        other.on_current_space = None;
+        assert!(covers_target(&other, 8, 50.0, 40.0));
+        other.is_on_screen = false;
+        assert!(!covers_target(&other, 8, 50.0, 40.0));
+    }
+    #[test]
+    fn target_click_center_uses_original_geometry_and_never_clamps() {
+        let window = [-100.0, 20.0, 200.0, 100.0];
+        assert_eq!(center([-80.0, 30.0, 40.0, 20.0], window), Ok((-60.0, 40.0, 40.0, 20.0)));
+        for rect in [[-101.0, 30.0, 40.0, 20.0], [-80.0, 19.0, 40.0, 20.0],
+            [90.0, 30.0, 40.0, 20.0], [-80.0, 110.0, 40.0, 20.0],
+            [f64::NAN, 30.0, 40.0, 20.0], [-80.0, 30.0, 0.0, 20.0]] {
+            assert!(center(rect, window).is_err());
+        }
+    }
+    #[test]
+    fn target_click_description_and_geometry_changes_do_not_retarget() {
+        let original = ObservedTarget { parent: Some(0), role: "AXButton".into(), subrole: None,
+            label: Some("Accept".into()), identifier: Some("accept".into()), value: None, rect: [10.0, 20.0, 80.0, 25.0] };
+        let data = observation::Data { role: original.role.clone(), label: original.label.clone(),
+            identifier: original.identifier.clone(), enabled: Some(true), ..Default::default() };
+        assert!(unchanged(&original, &data, original.rect));
+        for fault in 0..8 {
+            let mut changed = data.clone();
+            let mut rect = original.rect;
+            match fault {
+                0 => changed.role = "AXTextField".into(),
+                1 => changed.label = Some("Reject".into()),
+                2 => changed.identifier = Some("other".into()),
+                3 => changed.enabled = Some(false),
+                4 => changed.metadata_incomplete = true,
+                5 => changed.subrole = Some("AXSecureTextField".into()),
+                6 => changed.value = Some("different displayed text".into()),
+                _ => rect[0] += 1.0,
+            }
+            assert!(!unchanged(&original, &changed, rect));
+        }
+    }
+}
