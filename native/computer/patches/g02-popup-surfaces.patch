+/// General discovery and exact point lookup retain Space metadata on every layer.
+pub(crate) fn general_windows_with_space_snapshot() -> WindowEnumeration {
+    enumerate_windows(kCGWindowListExcludeDesktopElements, LayerFilter::General)
+}
+
+pub(crate) fn general_window_in(windows: &[WindowInfo], pid: i32, id: u32) -> Option<&WindowInfo> {
+    let mut matching = windows.iter().filter(|w| w.pid == pid && w.window_id == id);
+    let window = matching.next()?;
+    if matching.next().is_some() || general_window_metadata(window).is_err() {
+        return None;
+    }
+    Some(window)
+}
+
+pub(crate) fn general_point_window_in(
+    windows: &[WindowInfo],
+    pid: i32,
+    id: u32,
+    expected: [f64; 4],
+) -> Result<&WindowInfo, &'static str> {
+    let window = general_window_in(windows, pid, id).ok_or("controlled_target_stale")?;
+    let bounds = &window.bounds;
+    if [bounds.x, bounds.y, bounds.width, bounds.height] != expected {
+        return Err("stale_image_geometry");
+    }
+    Ok(window)
+}
+
+fn general_application_identity(pid: i32, app_name: &str, bundle_id: Option<&str>) -> bool {
+    pid > 0 && !app_name.trim().is_empty()
+        && bundle_id.is_some_and(|id| !id.trim().is_empty() && id.len() <= 256)
+}
+
+pub(crate) fn general_window_metadata(window: &WindowInfo) -> Result<(), &'static str> {
+    if window.pid <= 0 || window.window_id == 0 || window.app_name.trim().is_empty() {
+        return Err("discovery_window_identity_unproved");
+    }
+    if window.title.len() > 2048 || window.app_name.len() > 256 {
+        return Err("discovery_metadata_limit_exceeded");
+    }
+    if ![window.bounds.x, window.bounds.y, window.bounds.width, window.bounds.height]
+        .iter().all(|v| v.is_finite())
+        || window.bounds.width <= 0.0 || window.bounds.height <= 0.0
+    {
+        return Err("discovery_window_geometry_unproved");
+    }
+    // Preserve normal-window catalog behavior. Accessory surfaces must be
+    // visible and cannot be known to belong only to another Space.
+    if window.layer != 0 && (!window.is_on_screen || window.on_current_space == Some(false)) {
+        return Err("discovery_window_identity_unproved");
+    }
+    Ok(())
+}
