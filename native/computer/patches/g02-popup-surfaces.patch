+use super::*;
+
+#[test]
+fn popup_discovery_reselection_rejects_stale_geometry_identity_and_birth() {
+    let mut popup = tests::window(9, 259.);
+    popup.layer = 101;
+    popup.bounds.x = 886.;
+    popup.bounds.y = 655.;
+    popup.bounds.height = 437.;
+    let (rows, omitted) = catalog_rows(vec![popup.clone()], |_| Some((100, 2)), || Ok(())).unwrap();
+    assert_eq!(omitted, 0);
+    let selected: cua_driver_contract::WindowInfo =
+        serde_json::from_value(rows[0].clone()).unwrap();
+    assert_eq!(
+        revalidate_in(&selected, (100, 2), &[popup.clone()], |_| Some((100, 2))),
+        Ok(())
+    );
+    for field in 0..11 {
+        let mut changed = popup.clone();
+        match field {
+            0 => changed.pid += 1,
+            1 => changed.window_id += 1,
+            2 => changed.bounds.x += 1.,
+            3 => changed.bounds.y += 1.,
+            4 => changed.bounds.width += 1.,
+            5 => changed.bounds.height += 1.,
+            6 => changed.title.push('x'),
+            7 => changed.app_name.push('x'),
+            8 => changed.is_on_screen = false,
+            9 => changed.on_current_space = Some(false),
+            _ => changed.layer = 102,
+        }
+        assert_eq!(
+            revalidate_in(&selected, (100, 2), &[changed], |_| Some((100, 2))),
+            Err("discovery_target_stale")
+        );
+    }
+    assert_eq!(
+        revalidate_in(&selected, (100, 2), &[], |_| Some((100, 2))),
+        Err("discovery_target_stale")
+    );
+    assert_eq!(
+        revalidate_in(&selected, (100, 2), &[popup.clone()], |_| Some((101, 2))),
+        Err("discovery_target_stale")
+    );
+    let mut calls = 0;
+    assert_eq!(
+        revalidate_in(&selected, (100, 2), &[popup], |_| {
+            calls += 1;
+            Some((if calls == 1 { 100 } else { 101 }, 2))
+        }),
+        Err("discovery_target_stale")
+    );
+}
+
+#[test]
+fn popup_unproved_rows_are_omitted_without_erasing_eligible_popup() {
+    let mut popup = tests::window(9, 259.);
+    popup.layer = 101;
+    let mut system = popup.clone();
+    system.window_id = 10;
+    system.app_name.clear();
+    let mut hidden = popup.clone();
+    hidden.window_id = 11;
+    hidden.is_on_screen = false;
+    let (rows, omitted) =
+        catalog_rows(vec![system, hidden, popup], |_| Some((100, 2)), || Ok(())).unwrap();
+    assert_eq!(omitted, 2);
+    assert_eq!(rows.len(), 1);
+    assert_eq!(rows[0]["window_id"], 9);
+}
+
+#[test]
+fn popup_eligible_candidates_fit_unchanged_catalog_budget() {
+    let candidates = crate::windows::popup_tests::popup_budget_candidates();
+    let result = catalog_rows(candidates, |_| Some((100, 2)), || Ok(()));
+    assert!(
+        result.is_ok(),
+        "eligible candidate catalog refused: {result:?}"
+    );
+    let (rows, omitted) = result.unwrap();
+    assert_eq!(rows.len(), 241);
+    assert_eq!(omitted, 0);
+    assert!(rows
+        .iter()
+        .any(|row| row["window_id"] == 218 && row["layer"] == 101));
+}
