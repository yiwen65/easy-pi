+use super::*;
+
+#[test]
+fn popup_system_rows_need_application_identity() {
+    for bundle in [None, Some(""), Some(" ")] {
+        assert!(!general_application_identity(42, "Window Server", bundle));
+    }
+    assert!(!general_application_identity(
+        0,
+        "Fixture",
+        Some("org.example.Fixture")
+    ));
+    assert!(!general_application_identity(
+        42,
+        "",
+        Some("org.example.Fixture")
+    ));
+    assert!(!general_application_identity(
+        42,
+        "Fixture",
+        Some(&"x".repeat(257))
+    ));
+    assert!(general_application_identity(
+        42,
+        "Fixture",
+        Some("org.example.Fixture")
+    ));
+}
+
+#[test]
+fn popup_point_lookup_rejects_stale_geometry_and_parent_identity() {
+    let mut w = tests::window(9, 42, "Fixture");
+    w.layer = 101;
+    let expected = [w.bounds.x, w.bounds.y, w.bounds.width, w.bounds.height];
+    let windows = [w];
+    assert!(general_point_window_in(&windows, 42, 9, expected).is_ok());
+    for index in 0..4 {
+        let mut stale = expected;
+        stale[index] += 1.;
+        assert_eq!(
+            general_point_window_in(&windows, 42, 9, stale).unwrap_err(),
+            "stale_image_geometry"
+        );
+    }
+    for (pid, id) in [(43, 9), (42, 7)] {
+        assert_eq!(
+            general_point_window_in(&windows, pid, id, expected).unwrap_err(),
+            "controlled_target_stale"
+        );
+    }
+}
+
+#[test]
+fn popup_general_layer101_is_admitted_but_legacy_stays_zero() {
+    assert!(admits_window(LayerFilter::ZeroOnly, 0, Some(true), false));
+    assert!(!admits_window(
+        LayerFilter::ZeroOnly,
+        101,
+        Some(true),
+        false
+    ));
+    assert!(admits_window(LayerFilter::General, 101, Some(true), false));
+}
+
+#[test]
+fn popup_general_has_no_arbitrary_layer_cap_and_excludes_owned_renderer() {
+    for layer in [i32::MIN, -1, 0, 101, 102, i32::MAX] {
+        assert!(!admits_window(
+            LayerFilter::General,
+            layer,
+            Some(true),
+            true
+        ));
+        assert!(admits_window(
+            LayerFilter::General,
+            layer,
+            Some(true),
+            false
+        ));
+        assert!(admits_window(
+            LayerFilter::AnyLayer,
+            layer,
+            Some(true),
+            false
+        ));
+        assert_eq!(
+            admits_window(LayerFilter::ZeroOnly, layer, Some(true), false),
+            layer == 0
+        );
+    }
+}
