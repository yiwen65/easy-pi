+fn action_metadata_error(
+    error: AXError,
+    general: bool,
+    incomplete: &mut bool,
+) -> Result<(), &'static str> {
+    if error == kAXErrorAttributeUnsupported || error == kAXErrorNoValue {
+        return Ok(());
+    }
+    // A readable node with unknown advertised actions is still observable.
+    // General scans retain the incomplete marker and no action claims; legacy
+    // scans and permission denial remain failures.
+    metadata::<()>(Err(if error == kAXErrorAPIDisabled {
+        "accessibility_permission_denied"
+    } else {
+        "observation_read_failed"
+    }), general, incomplete).map(|_| ())
+}
