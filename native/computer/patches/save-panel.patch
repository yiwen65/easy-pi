+//! Prove a host-side AX proxy belongs to its nearest explicitly selected sheet.
+//! This never grants a remote process or a same-PID sibling window authority.
+use super::*;
+use core_foundation::{
+    array::CFArray,
+    base::{CFEqual, CFGetTypeID, TCFType},
+    string::CFString,
+};
+
+fn sheet_step(
+    pid: i32,
+    remote: u32,
+    actual_pid: Option<i32>,
+    window: Option<u32>,
+    role: &str,
+) -> Result<Option<u32>, ()> {
+    if actual_pid != Some(pid) {
+        return Err(());
+    }
+    if role == "AXSheet" {
+        return window
+            .filter(|id| *id != 0 && *id != remote)
+            .map(Some)
+            .ok_or(());
+    }
+    if matches!(
+        role,
+        "AXWindow" | "AXApplication" | "AXWebArea" | "AXDocumentWeb" | "AXDocument"
+    ) || window != Some(remote)
+    {
+        return Err(());
+    }
+    Ok(None)
+}
+
+unsafe fn has_child(parent: AXUIElementRef, child: AXUIElementRef) -> bool {
+    let key = CFString::new("AXChildren");
+    let mut value = std::ptr::null();
+    let error = AXUIElementCopyAttributeValue(parent, key.as_concrete_TypeRef(), &mut value);
+    if error != kAXErrorSuccess || value.is_null() {
+        if !value.is_null() {
+            CFRelease(value);
+        }
+        return false;
+    }
+    if CFGetTypeID(value) != CFArray::<CFTypeRef>::type_id() {
+        CFRelease(value);
+        return false;
+    }
+    let children = CFArray::<CFTypeRef>::wrap_under_create_rule(value as _);
+    children.len() <= 512
+        && children.iter().any(|item| {
+            !item.is_null()
+                && CFGetTypeID(*item) == AXUIElementGetTypeID()
+                && CFEqual(*item, child as CFTypeRef) != 0
+        })
+}
+
+pub(super) unsafe fn resolve(element: AXUIElementRef, pid: i32, direct: u32) -> Option<u32> {
+    let crate::windows::WindowOwner::ForeignPid { owner_pid, .. } =
+        crate::windows::resolve_window_owner(pid, direct)
+    else {
+        return None;
+    };
+    let stamp = super::super::enablement::process_start_stamp(owner_pid)?;
+    let mut current = RetainedElement::retain(element as usize);
+    for _ in 0..40 {
+        let ptr = current.as_ptr() as AXUIElementRef;
+        if !bounded(ptr) {
+            return None;
+        }
+        let role = copy_string_attr(ptr, "AXRole")?;
+        if let Some(sheet) =
+            sheet_step(pid, direct, element_pid(ptr), ax_get_window_id(ptr), &role).ok()?
+        {
+            if !matches!(
+                crate::windows::resolve_window_owner(pid, sheet),
+                crate::windows::WindowOwner::SamePid
+            ) || super::super::enablement::process_start_stamp(owner_pid) != Some(stamp)
+                || !matches!(crate::windows::resolve_window_owner(pid,direct),crate::windows::WindowOwner::ForeignPid {owner_pid: current, ..} if current==owner_pid)
+            {
+                return None;
+            }
+            return Some(sheet);
+        }
+        let parent = own(copy_element_attr(ptr, "AXParent")?)?;
+        if !bounded(parent.as_ptr() as _) || !has_child(parent.as_ptr() as _, ptr) {
+            return None;
+        }
+        current = parent;
+    }
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn controlled_remote_sheet_proxy_requires_nearest_sheet_and_same_host_identity() {
+        // Captured AppKit path: field -> split group (remote 17584), sheet 17583.
+        assert_eq!(
+            sheet_step(15295, 17584, Some(15295), Some(17584), "AXTextField"),
+            Ok(None)
+        );
+        assert_eq!(
+            sheet_step(15295, 17584, Some(15295), Some(17584), "AXSplitGroup"),
+            Ok(None)
+        );
+        assert_eq!(
+            sheet_step(15295, 17584, Some(15295), Some(17583), "AXSheet"),
+            Ok(Some(17583))
+        );
+        for role in [
+            "AXWindow",
+            "AXApplication",
+            "AXWebArea",
+            "AXDocumentWeb",
+            "AXDocument",
+        ] {
+            assert_eq!(
+                sheet_step(15295, 17584, Some(15295), Some(17584), role),
+                Err(())
+            );
+        }
+        assert_eq!(
+            sheet_step(15295, 17584, Some(15296), Some(17584), "AXTextField"),
+            Err(())
+        );
+        assert_eq!(
+            sheet_step(15295, 17584, Some(15295), Some(17582), "AXTextField"),
+            Err(())
+        );
+        assert_eq!(
+            sheet_step(15295, 17584, Some(15295), None, "AXSheet"),
+            Err(())
+        );
+        assert_eq!(
+            sheet_step(15295, 17584, Some(15295), Some(17584), "AXSheet"),
+            Err(())
+        );
+    }
+}
