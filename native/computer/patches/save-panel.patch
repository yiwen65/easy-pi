+//! Selection delivery is not selection effect. Never type over an unproved range.
+use super::*;
+
+fn complete(
+    original: Option<&str>,
+    value: Option<&str>,
+    selected: Option<&str>,
+    focused: bool,
+) -> bool {
+    focused && original.is_some() && original == value && value == selected
+}
+
+impl Context {
+    pub(super) fn confirm_replacement_selection(
+        &self,
+        element: &RetainedElement,
+        original: Option<&str>,
+        foreground: bool,
+    ) -> Result<(), &'static str> {
+        let deadline = Instant::now() + Duration::from_millis(200);
+        loop {
+            self.input_check(foreground, true)?;
+            self.member(element)?;
+            let target = self.operation.session.native_window()?;
+            let focused =
+                crate::ax::general_surface::focused(target.pid).is_some_and(|current| unsafe {
+                    core_foundation::base::CFEqual(current.as_ptr() as _, element.as_ptr() as _)
+                        != 0
+                });
+            let ptr = element.as_ptr() as bindings::AXUIElementRef;
+            let value = unsafe { bindings::copy_string_attr(ptr, "AXValue") };
+            let selected = unsafe { bindings::copy_string_attr(ptr, "AXSelectedText") };
+            if complete(original, value.as_deref(), selected.as_deref(), focused) {
+                return Ok(());
+            }
+            if Instant::now() >= deadline {
+                return Err("replacement_selection_unproved");
+            }
+            // Read-only settling, never repeat Command+A or any input.
+            std::thread::sleep(Duration::from_millis(10));
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn controlled_replacement_requires_exact_focused_complete_unchanged_value() {
+        assert!(complete(Some("old🦀"), Some("old🦀"), Some("old🦀"), true));
+        assert!(complete(Some(""), Some(""), Some(""), true));
+        assert!(!complete(Some("old"), Some("old"), Some(""), true));
+        assert!(!complete(Some("old"), Some("old"), Some("ol"), true));
+        assert!(!complete(Some("old"), Some("new"), Some("new"), true));
+        assert!(!complete(Some("old"), Some("old"), Some("old"), false));
+        assert!(!complete(None, None, None, true));
+        assert!(!complete(Some(""), Some(""), None, true));
+    }
+}
