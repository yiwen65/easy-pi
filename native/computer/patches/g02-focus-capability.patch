 //! Focus acknowledgement can precede the target application's AX update.
 //! Poll only identity; never repeat the focus mutation or synthesize another click.
+pub(super) fn semantic_focus_route(
+    capability: Result<bool, &'static str>,
+    editable_without_press: bool,
+) -> Result<bool, &'static str> {
+    match capability {
+        Ok(true) => Ok(true),
+        Ok(false) if editable_without_press => Ok(false),
+        Ok(false) => Err("focus_not_supported"),
+        Err(code) => Err(code),
+    }
+}
