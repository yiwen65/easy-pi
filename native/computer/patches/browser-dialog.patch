+#[test]
+fn controlled_browser_page_dialog_role_requires_exact_open_html_node() {
+    let good = json!({"node":{"backendNodeId":10,"nodeName":"DIALOG","attributes":["open",""]}});
+    assert_eq!(describe_dialog(&good, 10), Ok(()));
+    for bad in [
+        json!({"node":{"backendNodeId":11,"nodeName":"DIALOG","attributes":["open",""]}}),
+        json!({"node":{"backendNodeId":10,"nodeName":"DIV","attributes":["role","dialog","open",""]}}),
+        json!({"node":{"backendNodeId":10,"nodeName":"DIALOG","attributes":[]}}),
+        json!({"node":{"backendNodeId":10,"nodeName":"DIALOG","attributes":["open"]}}),
+    ] {
+        assert_eq!(describe_dialog(&bad, 10), Err("unexpected_modal_surface"));
+    }
+}
