+            .all(|value| value.as_str().is_some_and(|value| value.len() <= 16 * 1024))
+        || !attributes.chunks_exact(2).any(|pair| pair[0] == "open")
+    {
+        return Err("unexpected_modal_surface");
+    }
+    Ok(())
 }
 
