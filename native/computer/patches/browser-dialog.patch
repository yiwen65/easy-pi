 #[test]
+fn controlled_browser_page_single_dialog_scopes_inputs_to_its_subtree() {
+    let mut raw = tree();
+    raw["nodes"][0]["childIds"] = json!(["2", "3"]);
+    raw["nodes"].as_array_mut().unwrap().extend([
+        json!({"nodeId":"3","ignored":false,"role":{"value":"dialog"},"backendDOMNodeId":10,"childIds":["4"]}),
+        json!({"nodeId":"4","ignored":false,"role":{"value":"textbox"},"name":{"value":"Comment"},"backendDOMNodeId":11}),
+    ]);
+    let (rows, snapshot) = ax_snapshot(&raw, &frame(), 512, 32).unwrap();
+    assert!(!snapshot.nodes[1].enabled && !snapshot.nodes[1].fillable);
+    assert_eq!(rows[1]["enabled"], false);
+    assert!(snapshot.nodes[3].enabled && snapshot.nodes[3].fillable);
+    raw["nodes"][1]["role"]["value"] = json!("dialog");
+    assert!(matches!(
+        ax_snapshot(&raw, &frame(), 512, 32),
+        Err("unexpected_modal_surface")
+    ));
+    raw["nodes"][1]["role"]["value"] = json!("textbox");
+    raw["nodes"][2]["backendDOMNodeId"] = Value::Null;
+    assert!(matches!(
+        ax_snapshot(&raw, &frame(), 512, 32),
+        Err("unexpected_modal_surface")
+    ));
+}
