+fn read_executable(pid: i32) -> Result<PathBuf, &'static str> {
+    let mut bytes = [0u8; 4096];
+    let count = unsafe {
+        *libc::__error() = 0;
+        libc::proc_pidpath(pid, bytes.as_mut_ptr().cast(), bytes.len() as u32)
+    };
+    let errno = io::Error::last_os_error().raw_os_error();
+    if count <= 0 && errno == Some(libc::ESRCH) {
+        // Exit can occur after BSD identity was read. This catalog is now
+        // incomplete, not empty: callers may re-read within their existing
+        // budget and must still obtain two identical complete catalogs.
+        return Err("image_catalog_changed");
+    }
+    let end = bytes
+        .iter()
+        .position(|byte| *byte == 0)
+        .ok_or("image_path_unavailable")?;
+    if count <= 0
+        || count as usize >= bytes.len()
+        || end == 0
+        || !(end..=end + 1).contains(&(count as usize))
+    {
+        return Err("image_path_unavailable");
+    }
+    let path = PathBuf::from(OsString::from_vec(bytes[..end].to_vec()));
+    if !path.is_absolute() {
+        return Err("image_path_unavailable");
+    }
+    Ok(path)
