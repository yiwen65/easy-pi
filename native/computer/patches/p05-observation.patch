+
+#[test]
+fn controlled_image_complete_catalog_attests_unreaped_zombie_without_hiding_live_members() {
+    struct Reap(std::process::Child);
+    impl Drop for Reap {
+        fn drop(&mut self) {
+            self.0.wait().expect("reap only the private exited child");
+        }
+    }
+    let child = Reap(Command::new("/usr/bin/true").spawn().unwrap());
+    let pid = child.0.id();
+    let mut exit = unsafe { std::mem::zeroed::<libc::siginfo_t>() };
+    assert_eq!(
+        unsafe { libc::waitid(libc::P_PID, pid, &mut exit, libc::WEXITED | libc::WNOWAIT) },
+        0
+    );
+    assert_eq!(exit.si_pid, pid as i32);
+    // Keep the child unreaped throughout both complete catalogs. Waiting longer
+    // cannot fix a reader that omits the kernel's zombie-info request flag.
+    let deadline = std::time::Instant::now() + Duration::from_secs(1);
+    let (before, after) = loop {
+        let observed = catalog().and_then(|before| catalog().map(|after| (before, after)));
+        if let Ok((before, after)) = observed {
+            if before == after {
+                break (before, after);
+            }
+        }
+        assert!(
+            std::time::Instant::now() < deadline,
+            "unreaped zombie prevents a complete catalog"
+        );
+        std::thread::sleep(Duration::from_millis(10));
+    };
+    let zombie = before
+        .get(&pid)
+        .expect("zombie must remain represented, not skipped");
+    assert!(zombie.started.0 > 0);
+    assert_eq!(zombie.executable, None);
+    let own = before.get(&std::process::id()).unwrap();
+    let executable = std::env::current_exe().unwrap();
+    assert_eq!(own.executable.as_ref(), Some(&executable));
+    let members = stable_members(executable.parent().unwrap(), before, after).unwrap();
+    assert!(members
+        .iter()
+        .any(|row| row.pid == std::process::id() && row.executable == executable));
+    assert!(!members.iter().any(|row| row.pid == pid));
+}
