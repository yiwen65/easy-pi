+#[test]
+fn controlled_image_exit_between_identity_and_path_read_is_catalog_change() {
+    struct Reap(std::process::Child);
+    impl Drop for Reap {
+        fn drop(&mut self) {
+            self.0.stdin.take();
+            self.0.wait().expect("reap private process");
+        }
+    }
+    let mut child = Reap(
+        Command::new("/bin/cat")
+            .stdin(Stdio::piped())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .spawn()
+            .unwrap(),
+    );
+    let pid = child.0.id();
+    assert!(read_executable(pid as i32).is_ok());
+    let mut info = unsafe { std::mem::zeroed::<libc::proc_bsdinfo>() };
+    let size = std::mem::size_of_val(&info) as i32;
+    assert_eq!(
+        unsafe {
+            libc::proc_pidinfo(
+                pid as i32,
+                libc::PROC_PIDTBSDINFO,
+                1,
+                (&mut info as *mut libc::proc_bsdinfo).cast(),
+                size,
+            )
+        },
+        size
+    );
+    assert_eq!(info.pbi_pid, pid);
+    assert_ne!(info.pbi_status, libc::SZOMB);
+    // The exact transition that can occur between the catalog's identity read
+    // and executable read. EOF, not a guessed sleep or external process signal.
+    child.0.stdin.take();
+    let mut exit = unsafe { std::mem::zeroed::<libc::siginfo_t>() };
+    assert_eq!(
+        unsafe { libc::waitid(libc::P_PID, pid, &mut exit, libc::WEXITED | libc::WNOWAIT) },
+        0
+    );
+    let result = read_executable(pid as i32);
+    assert_eq!(result, Err("image_catalog_changed"));
+}
 
