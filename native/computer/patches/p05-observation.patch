+//! Bounded in-process plist projection with the unchanged legacy reader as a compatibility fallback.
+use super::AppInfo;
+use core_foundation::{
+    base::{CFType, TCFType},
+    data::CFData,
+    dictionary::CFDictionary,
+    propertylist::{create_with_data, kCFPropertyListImmutable, CFPropertyList},
+    string::CFString,
+};
+use std::io::Read;
+use std::path::Path;
+
+const MAX_PLIST_BYTES: u64 = 1024 * 1024;
+
+pub(super) fn read(path: &Path, legacy: impl FnOnce(&Path) -> Option<AppInfo>) -> Option<AppInfo> {
+    match read_native(path) {
+        Ok(value) => value,
+        // Preserve the established reader for large, unusual or unreadable
+        // files. No cached identity, skipped manifest check or focus change.
+        Err(()) => legacy(path),
+    }
+}
+
+fn read_native(path: &Path) -> Result<Option<AppInfo>, ()> {
+    path.to_str().ok_or(())?;
+    let file = std::fs::File::open(path).map_err(|_| ())?;
+    let metadata = file.metadata().map_err(|_| ())?;
+    if !metadata.is_file() || metadata.len() > MAX_PLIST_BYTES {
+        return Err(());
+    }
+    let mut bytes = Vec::new();
+    file.take(MAX_PLIST_BYTES + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|_| ())?;
+    if bytes.len() > MAX_PLIST_BYTES as usize {
+        return Err(());
+    }
+    let (raw, _) =
+        create_with_data(CFData::from_buffer(&bytes), kCFPropertyListImmutable).map_err(|_| ())?;
+    // create_with_data returns a nonnull +1 CFPropertyList on success. This
+    // owning wrapper releases it on every exit, including failed downcasts.
+    let plist = unsafe { CFPropertyList::wrap_under_create_rule(raw) };
+    let dictionary = plist.downcast::<CFDictionary>().ok_or(())?;
+    let string = |name: &str| -> Result<Option<String>, ()> {
+        let key = CFString::new(name);
+        let Some(raw) = dictionary.find(key.as_CFTypeRef()) else {
+            return Ok(None);
+        };
+        // Values of a parsed property-list dictionary are valid CF objects;
+        // retain while testing the runtime type, rather than assuming strings.
+        let value = unsafe { CFType::wrap_under_get_rule(*raw) };
+        let string = value.downcast::<CFString>().ok_or(())?;
+        Ok(Some(string.to_string().trim().to_owned()))
+    };
+    let Some(bundle_id) = string("CFBundleIdentifier")?.filter(|value| !value.is_empty()) else {
+        return Ok(None);
+    };
+    let name = match string("CFBundleDisplayName")?.filter(|value| !value.is_empty()) {
+        Some(name) => name,
+        None => string("CFBundleName")?
+            .filter(|value| !value.is_empty())
+            .unwrap_or_else(|| {
+                path.parent()
+                    .and_then(Path::parent)
+                    .and_then(Path::file_stem)
+                    .and_then(|value| value.to_str())
+                    .unwrap_or("")
+                    .to_owned()
+            }),
+    };
+    if name.is_empty() {
+        return Ok(None);
+    }
+    Ok(Some(AppInfo {
+        name,
+        pid: 0,
+        bundle_id: Some(bundle_id),
+        running: false,
+        active: false,
+        launch_path: None,
+        kind: None,
+        last_used: None,
+    }))
+}
