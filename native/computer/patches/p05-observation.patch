+fn wait_root_image(
+    pid: u32,
+    executable: &Path,
+    mut observe: impl FnMut() -> Result<Vec<ImageProcess>, &'static str>,
+    mut checkpoint: impl FnMut() -> Result<(), &'static str>,
+    deadline: Instant,
+) -> Result<(u64, u64), &'static str> {
+    loop {
+        checkpoint()?;
+        let members = match observe() {
+            // Startup itself changes the process catalog. Read again only
+            // within the existing readiness budget; never repeat spawn/input.
+            Err("image_catalog_changed") if Instant::now() < deadline => {
+                std::thread::sleep(
+                    Duration::from_millis(20)
+                        .min(deadline.saturating_duration_since(Instant::now())),
+                );
+                checkpoint()?;
+                if Instant::now() >= deadline {
+                    return Err("image_catalog_changed");
+                }
+                continue;
+            }
+            value => value?,
+        };
+        let root = members
+            .iter()
+            .find(|member| member.pid == pid && member.executable == executable)
+            .ok_or("browser_process_identity_unproved")?;
+        checkpoint()?;
+        return Ok(root.started);
     }
 }
 
