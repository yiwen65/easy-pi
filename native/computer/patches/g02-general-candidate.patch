+//! Per-event segment admission with preallocated, owned, unwind-safe releases.
+//! One transport: private-source CGEventPostToPid. Never warp the hardware
+//! pointer, suppress physical events, or retry an unknown delivered event.
+use crate::computer_renderer::{Channel, Cue, Kind};
+use core_graphics::{
+    event::{
+        CGEvent, CGEventField, CGEventFlags, CGEventType, CGMouseButton, EventField,
+        ScrollEventUnit,
+    },
+    event_source::{CGEventSource, CGEventSourceStateID},
+    geometry::CGPoint,
+};
+use cua_driver_contract::computer_segment::{
+    ComputerModifier, ComputerMouseButton, ComputerScrollUnit,
+};
+use cua_driver_core::controlled::Operation;
+use foreign_types::ForeignType;
+use std::sync::Arc;
+use std::{cell::Cell, rc::Rc};
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Hold {
+    Key(u16),
+    Button(ComputerMouseButton),
+}
+
+struct OwnedRelease<T> {
+    value: Option<T>,
+    release: Box<dyn Fn(T) -> Result<(), &'static str>>,
+}
+impl<T> OwnedRelease<T> {
+    fn run(&mut self) -> Result<(), &'static str> {
+        match self.value.take() {
+            Some(value) => (self.release)(value),
+            None => Ok(()),
+        }
+    }
+}
+impl<T> Drop for OwnedRelease<T> {
+    fn drop(&mut self) {
+        let _ = self.run();
+    }
+}
+
+pub struct Events {
+    pub dispatched: bool,
+    renderer: Option<Arc<Channel>>,
+    last_cue: Rc<Cell<Option<Cue>>>,
+    operation: Arc<Operation>,
+    source: CGEventSource,
+    releases: Vec<(Hold, OwnedRelease<CGEvent>)>,
+    pub position: Option<(f64, f64, f64, f64)>,
+    pub foreground: bool,
+}
+
+pub fn key_code(key: &str) -> Result<u16, &'static str> {
+    super::super::keyboard::key_name_to_code(key).map_err(|_| "unsupported_key")
+}
+
+pub fn text_chunks(text: &str) -> Vec<String> {
+    let mut chunks = Vec::new();
+    let mut chunk = String::new();
+    let mut units = 0;
+    for ch in text.chars() {
+        if units + ch.len_utf16() > 20 {
+            chunks.push(std::mem::take(&mut chunk));
+            units = 0;
+        }
+        chunk.push(ch);
+        units += ch.len_utf16();
+    }
+    if !chunk.is_empty() {
+        chunks.push(chunk);
+    }
+    chunks
+}
+
+fn modifier(modifier: ComputerModifier) -> (u16, CGEventFlags) {
+    match modifier {
+        ComputerModifier::Command => (55, CGEventFlags::CGEventFlagCommand),
+        ComputerModifier::Control => (59, CGEventFlags::CGEventFlagControl),
+        ComputerModifier::Option => (58, CGEventFlags::CGEventFlagAlternate),
+        ComputerModifier::Shift => (56, CGEventFlags::CGEventFlagShift),
+        ComputerModifier::Function => (63, CGEventFlags::CGEventFlagSecondaryFn),
+    }
+}
+
+impl Events {
+    pub fn new(
+        operation: Arc<Operation>,
+        renderer: Option<Arc<Channel>>,
+    ) -> Result<Self, &'static str> {
+        Ok(Self {
+            dispatched: false,
+            renderer,
+            last_cue: Rc::new(Cell::new(None)),
+            operation,
+            source: CGEventSource::new(CGEventSourceStateID::Private)
+                .map_err(|_| "event_source_unavailable")?,
+            releases: Vec::with_capacity(16),
+            position: None,
+            foreground: false,
+        })
+    }
+
+    pub fn held(&self) -> bool {
+        !self.releases.is_empty()
+    }
+
+    fn flags(&self) -> CGEventFlags {
+        let mut flags = CGEventFlags::empty();
+        for value in [
+            ComputerModifier::Command,
+            ComputerModifier::Control,
+            ComputerModifier::Option,
+            ComputerModifier::Shift,
+            ComputerModifier::Function,
+        ] {
+            let (code, flag) = modifier(value);
+            if self
+                .releases
+                .iter()
+                .any(|(hold, _)| *hold == Hold::Key(code))
+            {
+                flags |= flag;
+            }
+        }
+        flags
+    }
+
+    fn keyboard_pair(
+        &self,
+        code: u16,
+        text: Option<&str>,
+        flags: CGEventFlags,
+    ) -> Result<(CGEvent, CGEvent), &'static str> {
+        let make = |down| {
+            let event = CGEvent::new_keyboard_event(self.source.clone(), code, down)
+                .map_err(|_| "event_allocation_failed")?;
+            event.set_flags(flags);
+            if let Some(text) = text {
+                event.set_string(text);
+            }
+            Ok::<_, &'static str>(event)
+        };
+        Ok((make(true)?, make(false)?))
+    }
+
+    fn down(
+        &mut self,
+        hold: Hold,
+        down: CGEvent,
+        up: CGEvent,
+        check: &impl Fn() -> Result<(), &'static str>,
+    ) -> Result<(), &'static str> {
+        if self.releases.iter().any(|(owned, _)| *owned == hold) {
+            return Err("input_already_held");
+        }
+        if self.foreground {
+            let physically_held = unsafe {
+                match hold {
+                    Hold::Key(code) => super::CGEventSourceKeyState(1, code),
+                    Hold::Button(button) => super::CGEventSourceButtonState(
+                        1,
+                        match button {
+                            ComputerMouseButton::Left => 0,
+                            ComputerMouseButton::Right => 1,
+                            ComputerMouseButton::Middle => 2,
+                        },
+                    ),
+                }
+            };
+            if physically_held {
+                return Err("physical_input_held_at_target");
+            }
+        }
+        // Allocation (including vector capacity) precedes admission. Drop owns
+        // the release before posting, even if a panic interrupts the post.
+        self.releases
+            .try_reserve(1)
+            .map_err(|_| "event_allocation_failed")?;
+        check()?;
+        let target = self.operation.session.native_window()?;
+        let operation = self.operation.clone();
+        let renderer = self.renderer.clone();
+        let last_cue = self.last_cue.clone();
+        let release = Box::new(move |up: CGEvent| {
+            if target.process_stamp.is_none()
+                || crate::tools::computer_process_stamp(target.pid) != target.process_stamp
+            {
+                operation.quarantine();
+                return Err("release_target_stale");
+            }
+            up.post_to_pid(target.pid);
+            if matches!(hold, Hold::Button(_)) {
+                if let (Some(renderer), Some(mut cue)) = (&renderer, last_cue.get()) {
+                    cue.kind = Kind::Up;
+                    renderer.publish(cue);
+                }
+            }
+            Ok(())
+        });
+        self.operation.segment_primary(|| {
+            self.releases.push((
+                hold,
+                OwnedRelease {
+                    value: Some(up),
+                    release,
+                },
+            ));
+            down.post_to_pid(target.pid);
+            self.dispatched = true;
+            if matches!(hold, Hold::Button(_)) {
+                if let (Some(renderer), Some(mut cue)) = (&self.renderer, self.last_cue.get()) {
+                    cue.kind = Kind::Down;
+                    renderer.publish(cue);
+                }
+            }
+        })
+    }
+
+    fn release(&mut self, hold: Hold) -> Result<(), &'static str> {
+        let index = self
+            .releases
+            .iter()
+            .rposition(|(owned, _)| *owned == hold)
+            .ok_or("input_not_owned")?;
+        let (_, mut up) = self.releases.remove(index);
+        if let Some(event) = &up.value {
+            event.set_flags(self.flags());
+        }
+        // A matching up is cleanup, allowed after cancellation/revoke. Target
+        // PID + incarnation stay fixed; focus changes never redirect release.
+        up.run()
+    }
+
+    pub fn key_down(
+        &mut self,
+        key: &str,
+        check: &impl Fn() -> Result<(), &'static str>,
+    ) -> Result<(), &'static str> {
+        let code = key_code(key)?;
+        let flag = [
+            ComputerModifier::Command,
+            ComputerModifier::Control,
+            ComputerModifier::Option,
+            ComputerModifier::Shift,
+            ComputerModifier::Function,
+        ]
+        .into_iter()
+        .find_map(|m| {
+            let (c, f) = modifier(m);
+            (c == code).then_some(f)
+        })
+        .unwrap_or(CGEventFlags::empty());
+        let (down, up) = self.keyboard_pair(code, None, self.flags() | flag)?;
+        up.set_flags(self.flags());
+        if !flag.is_empty() {
+            down.set_type(CGEventType::FlagsChanged);
+            up.set_type(CGEventType::FlagsChanged);
+        }
+        self.down(Hold::Key(code), down, up, check)
+    }
+
+    pub fn key_up(&mut self, key: &str) -> Result<(), &'static str> {
+        self.release(Hold::Key(key_code(key)?))
+    }
+
+    pub fn key(
+        &mut self,
+        key: &str,
+        modifiers: &[ComputerModifier],
+        check: &impl Fn() -> Result<(), &'static str>,
+    ) -> Result<(), &'static str> {
+        let code = key_code(key)?;
+        if self
+            .releases
+            .iter()
+            .any(|(hold, _)| *hold == Hold::Key(code))
+        {
+            return Err("input_already_held");
+        }
+        let mut added = Vec::new();
+        // Entire chord including releases is allocated before its first down.
+        let mut flags = self.flags();
+        let mut prepared = Vec::new();
+        for m in modifiers {
+            let (code, flag) = modifier(*m);
+            if self
+                .releases
+                .iter()
+                .any(|(hold, _)| *hold == Hold::Key(code))
+            {
+                continue;
+            }
+            let (down, up) = self.keyboard_pair(code, None, flags | flag)?;
+            up.set_flags(flags);
+            down.set_type(CGEventType::FlagsChanged);
+            up.set_type(CGEventType::FlagsChanged);
+            flags |= flag;
+            prepared.push((code, down, up));
+        }
+        let (down, up) = self.keyboard_pair(code, None, flags)?;
+        for (modifier, down, up) in prepared {
+            self.down(Hold::Key(modifier), down, up, check)?;
+            added.push(modifier);
+        }
+        self.down(Hold::Key(code), down, up, check)?;
+        self.release(Hold::Key(code))?;
+        for code in added.into_iter().rev() {
+            self.release(Hold::Key(code))?;
+        }
+        Ok(())
+    }
+
+    pub fn text(
+        &mut self,
+        text: &str,
+        check: &impl Fn() -> Result<(), &'static str>,
+    ) -> Result<(), &'static str> {
+        if self.held() {
+            return Err("text_with_held_input");
+        }
+        for chunk in text_chunks(text) {
+            let (down, up) = self.keyboard_pair(0, Some(&chunk), CGEventFlags::empty())?;
+            self.down(Hold::Key(0), down, up, check)?;
+            self.release(Hold::Key(0))?;
+        }
+        Ok(())
+    }
+
+    fn mouse(
+        &self,
+        kind: CGEventType,
+        button: ComputerMouseButton,
+        count: i64,
+    ) -> Result<CGEvent, &'static str> {
+        let (x, y, local_x, local_y) = self.position.ok_or("pointer_position_required")?;
+        let button_code = match button {
+            ComputerMouseButton::Left => CGMouseButton::Left,
+            ComputerMouseButton::Right => CGMouseButton::Right,
+            ComputerMouseButton::Middle => CGMouseButton::Center,
+        };
+        let event =
+            CGEvent::new_mouse_event(self.source.clone(), kind, CGPoint::new(x, y), button_code)
+                .map_err(|_| "event_allocation_failed")?;
+        event.set_flags(self.flags());
+        self.stamp(&event, local_x, local_y)?;
+        event.set_integer_value_field(EventField::MOUSE_EVENT_CLICK_STATE, count);
+        Ok(event)
+    }
+
+    fn stamp(&self, event: &CGEvent, x: f64, y: f64) -> Result<(), &'static str> {
+        let target = self.operation.session.native_window()?;
+        let ptr = event.as_ptr() as *mut std::ffi::c_void;
+        if !super::super::skylight::set_window_location(ptr, x, y) && !self.foreground {
+            return Err("pointer_route_unavailable");
+        }
+        for (field, value) in [
+            (40, target.pid as i64),
+            (51, target.window_id as i64),
+            (91, target.window_id as i64),
+            (92, target.window_id as i64),
+        ] {
+            if !super::super::skylight::set_integer_field(ptr, field, value) && !self.foreground {
+                return Err("pointer_route_unavailable");
+            }
+        }
+        Ok(())
+    }
+
+    pub fn move_pointer(
+        &mut self,
+        point: (f64, f64, f64, f64),
+        check: &impl Fn() -> Result<(), &'static str>,
+    ) -> Result<(), &'static str> {
+        self.position = Some(point);
+        let button = self.releases.iter().find_map(|(h, _)| {
+            if let Hold::Button(b) = h {
+                Some(*b)
+            } else {
+                None
+            }
+        });
+        let kind = match button {
+            Some(ComputerMouseButton::Left) => CGEventType::LeftMouseDragged,
+            Some(ComputerMouseButton::Right) => CGEventType::RightMouseDragged,
+            Some(ComputerMouseButton::Middle) => CGEventType::OtherMouseDragged,
+            None => CGEventType::MouseMoved,
+        };
+        let event = self.mouse(kind, button.unwrap_or(ComputerMouseButton::Left), 0)?;
+        check()?;
+        let target = self.operation.session.native_window()?;
+        self.operation.segment_primary(|| {
+            // Release at the last admitted position, never an unadmitted future
+            // drag endpoint. Re-stamping mutates preallocated release events.
+            for (hold, up) in &self.releases {
+                if matches!(hold, Hold::Button(_)) {
+                    let up = up.value.as_ref().expect("owned release has its event");
+                    unsafe {
+                        super::CGEventSetLocation(up.as_ptr() as _, point.0, point.1);
+                    }
+                    if !super::super::skylight::set_window_location(
+                        up.as_ptr() as _,
+                        point.2,
+                        point.3,
+                    ) && !self.foreground
+                    {
+                        self.operation.quarantine();
+                    }
+                }
+            }
+            event.post_to_pid(target.pid);
+            self.dispatched = true;
+            let cue = Cue {
+                target_pid: target.pid,
+                window_id: target.window_id,
+                x: point.2,
+                y: point.3,
+                kind: Kind::Move,
+            };
+            self.last_cue.set(Some(cue));
+            if let Some(renderer) = &self.renderer {
+                renderer.publish(cue);
+            }
+        })
+    }
+
+    pub fn button_down(
+        &mut self,
+        button: ComputerMouseButton,
+        count: i64,
+        check: &impl Fn() -> Result<(), &'static str>,
+    ) -> Result<(), &'static str> {
+        let (down, up) = match button {
+            ComputerMouseButton::Left => (CGEventType::LeftMouseDown, CGEventType::LeftMouseUp),
+            ComputerMouseButton::Right => (CGEventType::RightMouseDown, CGEventType::RightMouseUp),
+            ComputerMouseButton::Middle => (CGEventType::OtherMouseDown, CGEventType::OtherMouseUp),
+        };
+        self.down(
+            Hold::Button(button),
+            self.mouse(down, button, count)?,
+            self.mouse(up, button, count)?,
+            check,
+        )
+    }
+    pub fn button_up(&mut self, button: ComputerMouseButton) -> Result<(), &'static str> {
+        self.release(Hold::Button(button))
+    }
+
+    pub fn click_feedback(&self) {
+        if let (Some(renderer), Some(mut cue)) = (&self.renderer, self.last_cue.get()) {
+            cue.kind = Kind::Click;
+            renderer.publish(cue);
+        }
+    }
+
+    pub fn scroll(
+        &mut self,
+        dx: f64,
+        dy: f64,
+        unit: ComputerScrollUnit,
+        check: &impl Fn() -> Result<(), &'static str>,
+    ) -> Result<(), &'static str> {
+        let (x, y, lx, ly) = self.position.ok_or("pointer_position_required")?;
+        let native_unit = match unit {
+            ComputerScrollUnit::Line => ScrollEventUnit::LINE,
+            ComputerScrollUnit::Pixel => ScrollEventUnit::PIXEL,
+        };
+        let event = CGEvent::new_scroll_event(
+            self.source.clone(),
+            native_unit,
+            2,
+            dy.round() as i32,
+            dx.round() as i32,
+            0,
+        )
+        .map_err(|_| "event_allocation_failed")?;
+        // Preserve sub-unit deltas in the public fixed-point fields; integer
+        // wheel fields alone would silently drop e.g. a 0.25-pixel scroll.
+        for (field, delta) in scroll_deltas(dx, dy, unit) {
+            event.set_double_value_field(field, delta);
+        }
+        unsafe {
+            super::CGEventSetLocation(event.as_ptr() as _, x, y);
+        }
+        event.set_flags(self.flags());
+        self.stamp(&event, lx, ly)?;
+        check()?;
+        let target = self.operation.session.native_window()?;
+        self.operation.segment_primary(|| {
+            event.post_to_pid(target.pid);
+            self.dispatched = true;
+        })
+    }
+}
+
+fn scroll_deltas(dx: f64, dy: f64, unit: ComputerScrollUnit) -> Vec<(CGEventField, f64)> {
+    let mut fields = vec![
+        (EventField::SCROLL_WHEEL_EVENT_FIXED_POINT_DELTA_AXIS_1, dy),
+        (EventField::SCROLL_WHEEL_EVENT_FIXED_POINT_DELTA_AXIS_2, dx),
+    ];
+    if unit == ComputerScrollUnit::Pixel {
+        fields.extend([
+            (EventField::SCROLL_WHEEL_EVENT_POINT_DELTA_AXIS_1, dy),
+            (EventField::SCROLL_WHEEL_EVENT_POINT_DELTA_AXIS_2, dx),
+        ]);
+    }
+    fields
+}
+
+impl Drop for Events {
+    fn drop(&mut self) {
+        let hide = self.held() || self.operation.is_cancelled();
+        while let Some((hold, _)) = self.releases.last() {
+            let hold = *hold;
+            if self.release(hold).is_err() {
+                self.operation.quarantine();
+            }
+        }
+        if hide {
+            if let (Some(renderer), Some(mut cue)) = (&self.renderer, self.last_cue.get()) {
+                cue.kind = Kind::Hide;
+                renderer.publish(cue);
+            }
+        }
+    }
+}
