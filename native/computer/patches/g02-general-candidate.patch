+                .with_file_name("emergency-helper");
+        let renderer = Renderer::start(&helper).unwrap();
+        let cancelled = operation.clone();
+        renderer.channel.on_stop(Arc::new(move || {
+            gate.revoke();
+            cancelled.cancel();
+        }));
+        let releases = Arc::new(Mutex::new(Vec::new()));
+        {
