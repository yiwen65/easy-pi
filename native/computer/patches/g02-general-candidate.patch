+#[test]
+fn controlled_renderer_contended_release_never_waits_and_reconciles_hide() {
+    let (sender, receiver) = pair();
+    let channel = Channel {
+        emergency: AtomicBool::new(false),
+        callback: Mutex::new(StopCallback::default()),
+        sender: Mutex::new(sender),
+        failure: AtomicUsize::new(0),
+        reconcile_hide: AtomicBool::new(false),
+        stop: AtomicBool::new(false),
+        dropped: AtomicU64::new(0),
+    };
+    channel.publish(cue(Kind::Down));
+    assert_eq!(packet(&receiver)["kind"], "down");
+    let guard = channel.sender.lock().unwrap();
+    channel.publish(cue(Kind::Up)); // must return despite an already held lock
+    assert!(channel.reconcile_hide.load(Ordering::Acquire));
+    assert_eq!(channel.dropped.load(Ordering::Relaxed), 1);
+    drop(guard);
+    channel.publish(Cue {
+        x: 100.,
+        ..cue(Kind::Move)
+    });
+    assert_eq!(packet(&receiver)["kind"], "hide");
+    assert_eq!(packet(&receiver)["x"], 100.);
+    assert!(!channel.reconcile_hide.load(Ordering::Acquire));
+    channel.hide(); // ancestor/host revocation uses only the last actual point
+    channel
+        .reconcile(&mut channel.sender.lock().unwrap())
+        .unwrap();
+    let hidden = packet(&receiver);
+    assert_eq!(hidden["kind"], "hide");
+    assert_eq!(hidden["x"], 100.);
+    assert_eq!(hidden["target_pid"], 123);
+}
