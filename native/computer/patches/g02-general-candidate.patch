+/// Physical macOS key positions, shared with the real Events key mapping.
+pub fn emergency_chord(
+    key: &str,
+    modifiers: &[cua_driver_contract::computer_segment::ComputerModifier],
+) -> Result<(u16, u64), &'static str> {
+    use cua_driver_contract::computer_segment::ComputerModifier;
+    if key.is_empty()
+        || key.len() > 32
+        || !key.is_ascii()
+        || modifiers.is_empty()
+        || modifiers.len() > 4
+    {
+        return Err("invalid_emergency_chord");
+    }
+    let code = crate::input::controlled::general::key_code(key)
+        .map_err(|_| "unsupported_emergency_key")?;
+    if matches!(code, 55..=63) {
+        return Err("unsupported_emergency_key");
+    }
+    let mut flags = 0;
+    for modifier in modifiers {
+        let bit = match modifier {
+            ComputerModifier::Shift => 1 << 17,
+            ComputerModifier::Control => 1 << 18,
+            ComputerModifier::Option => 1 << 19,
+            ComputerModifier::Command => 1 << 20,
+            ComputerModifier::Function => return Err("unsupported_emergency_modifier"),
+        };
+        if flags & bit != 0 {
+            return Err("invalid_emergency_chord");
+        }
+        flags |= bit;
+    }
+    Ok((code, flags))
+}
+
+const EMERGENCY_SIGNAL: &[u8] = b"{\"event\":\"emergency_stop\",\"version\":3}\n";
+const HEARTBEAT_SIGNAL: &[u8] = b"{\"event\":\"heartbeat\",\"version\":3}\n";
+const HEARTBEAT_TIMEOUT: Duration = Duration::from_secs(1);
+
+struct StopSignal {
+    offset: usize,
+    candidates: u8,
+    deadline: Instant,
+}
+impl Default for StopSignal {
+    fn default() -> Self {
+        Self::new(Instant::now())
+    }
+}
+impl StopSignal {
+    fn new(accepted_at: Instant) -> Self {
+        Self {
+            offset: 0,
+            candidates: 3,
+            deadline: accepted_at + HEARTBEAT_TIMEOUT,
+        }
+    }
+
+    fn read(&mut self, input: &mut impl Read) -> Result<bool, &'static str> {
+        self.read_at(input, Instant::now())
+    }
+
+    fn read_at(&mut self, input: &mut impl Read, now: Instant) -> Result<bool, &'static str> {
+        // Match two fixed lines without retaining bodies. A full read budget is
+        // a flood, not progress; partial packets and EINTR never renew liveness.
+        // Stop takes priority over heartbeat/deadline in this bounded batch.
+        let mut heartbeat = false;
+        for _ in 0..128 {
+            let mut byte = [0];
+            match input.read(&mut byte) {
+                Ok(0) => return Err("renderer_stdout_closed"),
+                Ok(1) => {
+                    if EMERGENCY_SIGNAL.get(self.offset) != Some(&byte[0]) {
+                        self.candidates &= !1;
+                    }
+                    if HEARTBEAT_SIGNAL.get(self.offset) != Some(&byte[0]) {
+                        self.candidates &= !2;
+                    }
+                    if self.candidates == 0 {
+                        return Err("renderer_invalid_signal");
+                    }
+                    self.offset += 1;
+                    if self.candidates & 1 != 0 && self.offset == EMERGENCY_SIGNAL.len() {
+                        return Ok(true);
+                    }
+                    if self.candidates & 2 != 0 && self.offset == HEARTBEAT_SIGNAL.len() {
+                        heartbeat = true;
+                        self.offset = 0;
+                        self.candidates = 3;
+                    }
+                }
+                Err(e) if e.kind() == io::ErrorKind::WouldBlock => {
+                    // Queued bytes cannot revive an already expired lease.
+                    if now >= self.deadline {
+                        return Err("renderer_heartbeat_timeout");
+                    }
+                    if heartbeat {
+                        self.deadline = now + HEARTBEAT_TIMEOUT;
+                    }
+                    return Ok(false);
+                }
+                Err(e) if e.kind() == io::ErrorKind::Interrupted => continue,
+                _ => return Err("renderer_invalid_signal"),
+            }
+        }
+        Err("renderer_invalid_signal")
+    }
+}
