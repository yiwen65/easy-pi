+        }
+        assert!(
+            releases.lock().unwrap().as_slice()
+                == [Hold::Key(0), Hold::Button(ComputerMouseButton::Left)]
+        );
+        operation.finish();
+        let terminal = operation.terminal().await.unwrap();
+        assert!(terminal.cancelled && terminal.input_committed);
