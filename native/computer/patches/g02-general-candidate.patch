+use super::*;
+
+fn cue(kind: Kind) -> Cue {
+    Cue {
+        target_pid: 123,
+        window_id: 456,
+        x: 12.5,
+        y: 30.25,
+        kind,
+    }
+}
+fn pair() -> (Sender, UnixDatagram) {
+    let (socket, receiver) = UnixDatagram::pair().unwrap();
+    socket.set_nonblocking(true).unwrap();
+    receiver.set_nonblocking(true).unwrap();
+    (
+        Sender {
+            socket,
+            sequence: 0,
+            transition: None,
+            latest: None,
+            last: None,
+        },
+        receiver,
+    )
+}
+fn packet(receiver: &UnixDatagram) -> serde_json::Value {
+    let mut bytes = [0; 512];
+    let n = receiver.recv(&mut bytes).unwrap();
+    serde_json::from_slice(&bytes[..n]).unwrap()
+}
