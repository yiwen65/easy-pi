@@ -0,0 +1,163 @@
+use super::{
+    refused, segment::*, ComputerCondition, ComputerDispatch, ComputerError, ComputerOperation,
+    ComputerResult,
+};
+use std::{sync::Arc, time::Duration};
+
+#[uniffi::export]
+impl ComputerOperation {
+    /// Consume the selected session's current observation/image. Evidence from
+    /// another session or an earlier replacement cannot be rebound by ID.
+    pub fn start_segment(self: Arc<Self>, segment: ComputerSegment) -> Result<(), ComputerError> {
+        super::segment::validate(&segment).map_err(refused)?;
+        self.session.gate.native_window().map_err(refused)?;
+        #[cfg(not(target_os = "macos"))]
+        {
+            Err(refused("unsupported_platform"))
+        }
+        #[cfg(target_os = "macos")]
+        {
+            let limits =
+                platform_macos::tools::computer::segment::budgets(&segment).map_err(refused)?;
+            let timeout = Duration::from_millis(u64::from(segment.max_duration_ms));
+            let worker = self.clone();
+            self.launch_bounded(None, Some((limits, timeout)), async move {
+                worker.execute_segment(segment).await
+            })
+        }
+    }
+}
+
+#[cfg(target_os = "macos")]
+impl ComputerOperation {
+    async fn execute_segment(
+        &self,
+        segment: ComputerSegment,
+    ) -> Result<ComputerResult, ComputerError> {
+        let state = self
+            .session
+            .native
+            .computer_state()
+            .ok_or_else(|| refused("controlled_state_unavailable"))?;
+        let observation = self
+            .session
+            .observation
+            .lock()
+            .map_err(|_| self.session.host.quarantine())?
+            .take();
+        let image = self
+            .session
+            .image_reference
+            .lock()
+            .map_err(|_| self.session.host.quarantine())?
+            .take();
+        let valid_observation = observation.as_ref().and_then(|o| o.snapshot_id.as_deref())
+            == Some(segment.observation_ref.as_str());
+        let valid_image = image
+            .as_ref()
+            .is_some_and(|image| image.addresses(&segment.observation_ref, 0, 0).is_ok());
+        if !valid_observation && !valid_image {
+            return Err(refused("stale_session_observation"));
+        }
+        for action in &segment.actions {
+            let points = match action {
+                ComputerInput::PointerMove { point }
+                | ComputerInput::Click { point, .. }
+                | ComputerInput::Scroll { point, .. } => vec![point],
+                ComputerInput::Drag { from, to, .. } => vec![from, to],
+                _ => Vec::new(),
+            };
+            for point in points {
+                image
+                    .as_ref()
+                    .ok_or_else(|| refused("image_reference_required"))?
+                    .addresses(&point.image_ref, point.x as u32, point.y as u32)
+                    .map_err(refused)?;
+            }
+        }
+        let native = self.session.native.clone();
+        self.core
+            .bind_segment_intent(&segment.intent_ref)
+            .map_err(refused)?;
+        let context = platform_macos::tools::computer::segment::Context {
+            renderer: self
+                .session
+                .host
+                .renderer
+                .as_ref()
+                .map(|renderer| renderer.channel.clone()),
+            operation: self.core.clone(),
+            state,
+            observation_ref: segment.observation_ref.clone(),
+            intent_ref: segment.intent_ref.clone(),
+            image,
+        };
+        let input = segment.clone();
+        let execution = self
+            .core
+            .blocking(move || {
+                context.execute(input, |tool, args| {
+                    native.computer_segment_authorize(tool, args)
+                })
+            })
+            .await
+            .map_err(|_| ComputerError::Quarantined)?;
+        self.core.reset_snapshot();
+        let mut first_unfinished_action = None;
+        let actions = execution
+            .actions
+            .into_iter()
+            .enumerate()
+            .map(|(index, row)| {
+                if !row.complete && first_unfinished_action.is_none() {
+                    first_unfinished_action = Some(index as u32);
+                }
+                ComputerInputResult {
+                    index: index as u32,
+                    dispatch: if row.complete {
+                        ComputerDispatch::Dispatched
+                    } else if row.committed {
+                        ComputerDispatch::Unknown
+                    } else {
+                        ComputerDispatch::NotDispatched
+                    },
+                    action: row.action,
+                    code: row.code,
+                }
+            })
+            .collect::<Vec<_>>();
+        if first_unfinished_action.is_none() && actions.len() < segment.actions.len() {
+            first_unfinished_action = Some(actions.len() as u32);
+        }
+        let condition = match execution.condition {
+            Some(true) => ComputerCondition::Satisfied,
+            Some(false) => ComputerCondition::Unsatisfied,
+            None => ComputerCondition::Unknown,
+        };
+        let status = if execution.cancelled {
+            ComputerSegmentStatus::Cancelled
+        } else if condition == ComputerCondition::Satisfied {
+            ComputerSegmentStatus::Confirmed
+        } else if condition == ComputerCondition::Unknown
+            && actions
+                .iter()
+                .any(|row| row.dispatch == ComputerDispatch::Unknown)
+        {
+            ComputerSegmentStatus::OutcomeUnknown
+        } else if condition == ComputerCondition::Unknown {
+            ComputerSegmentStatus::NeedsObservation
+        } else {
+            ComputerSegmentStatus::Paused
+        };
+        let value = ComputerSegmentResult {
+            status,
+            actions,
+            condition,
+            first_unfinished_action,
+            recovery_attempts: execution.recovery_attempts,
+            elapsed_ms: execution.elapsed_ms,
+        };
+        super::segment::validate_result(&segment, &value).map_err(refused)?;
+        Ok(ComputerResult::Segment { value })
+    }
+}
