@@ -0,0 +1,746 @@
+//! Owned rendering-only child. No desktop APIs, input, model commands or shell.
+//! The input lane only publishes bounded state; the monitor retries visual
+//! state and owns EOF, process exit, reaping and private-directory cleanup.
+use serde::{Deserialize, Serialize};
+use std::{
+    fs::{self, DirBuilder},
+    io::{self, Read},
+    os::{
+        fd::AsRawFd,
+        unix::{
+            fs::{DirBuilderExt, FileTypeExt, MetadataExt},
+            net::UnixDatagram,
+        },
+    },
+    path::{Component, Path, PathBuf},
+    process::{Child, Command, Stdio},
+    sync::{
+        atomic::{AtomicBool, AtomicU64, AtomicUsize, Ordering},
+        Arc, Mutex, OnceLock, TryLockError,
+    },
+    thread::{self, JoinHandle},
+    time::{Duration, Instant},
+};
+
+#[derive(Clone, Copy, Debug, Serialize, PartialEq)]
+#[serde(rename_all = "lowercase")]
+pub enum Kind {
+    Move,
+    Down,
+    Up,
+    Click,
+    Hide,
+}
+
+#[derive(Clone, Copy, Debug, Serialize)]
+pub struct Cue {
+    pub target_pid: i32,
+    pub window_id: u32,
+    pub x: f64,
+    pub y: f64,
+    pub kind: Kind,
+}
+
+#[derive(Serialize)]
+struct Packet {
+    version: u8,
+    sequence: u64,
+    #[serde(flatten)]
+    cue: Cue,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Ready {
+    ready: bool,
+    version: u8,
+    window_id: u32,
+    emergency_stop: bool,
+}
+
+fn ready(bytes: &[u8]) -> Result<u32, &'static str> {
+    let value: Ready = serde_json::from_slice(bytes).map_err(|_| "renderer_invalid_readiness")?;
+    if !value.ready || value.version != 3 || value.window_id == 0 || !value.emergency_stop {
+        return Err("renderer_invalid_readiness");
+    }
+    Ok(value.window_id)
+}
+
+fn owned() -> &'static Mutex<Vec<(i32, u32)>> {
+    static OWNED: OnceLock<Mutex<Vec<(i32, u32)>>> = OnceLock::new();
+    OWNED.get_or_init(|| Mutex::new(Vec::new()))
+}
+
+pub fn is_owned_window(pid: i32, window: u32) -> bool {
+    owned()
+        .lock()
+        .map_or(true, |ids| ids.contains(&(pid, window)))
+}
+
+fn blocked(error: &io::Error) -> bool {
+    matches!(error.raw_os_error(), Some(code) if code == libc::EAGAIN || code == libc::EWOULDBLOCK || code == libc::ENOBUFS)
+}
+
+struct Sender {
+    socket: UnixDatagram,
+    sequence: u64,
+    // Two slots: a dropped transition always precedes the latest position.
+    transition: Option<Cue>,
+    latest: Option<Cue>,
+    last: Option<Cue>,
+}
+
+impl Sender {
+    fn send(&mut self, cue: Cue) -> Result<bool, &'static str> {
+        if cue.target_pid <= 0
+            || cue.window_id == 0
+            || ![cue.x, cue.y]
+                .iter()
+                .all(|x| x.is_finite() && (0.0..=1_000_000.0).contains(x))
+        {
+            return Err("renderer_invalid_cue");
+        }
+        let sequence = self.sequence;
+        self.sequence = sequence
+            .checked_add(1)
+            .ok_or("renderer_sequence_exhausted")?;
+        let packet = serde_json::to_vec(&Packet {
+            version: 1,
+            sequence,
+            cue,
+        })
+        .map_err(|_| "renderer_invalid_cue")?;
+        if packet.len() > 512 {
+            return Err("renderer_invalid_cue");
+        }
+        match self.socket.send(&packet) {
+            Ok(n) if n == packet.len() => Ok(true),
+            Err(error) if blocked(&error) => Ok(false),
+            _ => Err("renderer_transport_failed"),
+        }
+    }
+
+    fn flush(&mut self) -> Result<(), &'static str> {
+        if let Some(cue) = self.transition {
+            if !self.send(cue)? {
+                return Ok(());
+            }
+            self.transition = None;
+        }
+        if let Some(cue) = self.latest {
+            if self.send(cue)? {
+                self.latest = None;
+            }
+        }
+        Ok(())
+    }
+
+    fn publish(&mut self, cue: Cue) -> Result<(), &'static str> {
+        self.last = Some(cue);
+        if cue.kind == Kind::Move {
+            self.latest = Some(cue);
+        } else {
+            self.transition = Some(cue);
+            self.latest = None;
+        }
+        self.flush()
+    }
+}
+
+/// Shared with Events. The monitor never holds the sender lock over sleep,
+/// process wait, filesystem operations or blocking I/O.
+#[derive(Default)]
+struct StopCallback {
+    observed: bool,
+    delivered: bool,
+    callback: Option<Arc<dyn Fn() + Send + Sync>>,
+}
+
+pub struct Channel {
+    emergency: AtomicBool,
+    callback: Mutex<StopCallback>,
+    sender: Mutex<Sender>,
+    failure: AtomicUsize,
+    reconcile_hide: AtomicBool,
+    stop: AtomicBool,
+    dropped: AtomicU64,
+}
+
+const FAILURES: &[&str] = &[
+    "renderer_state_failed",
+    "renderer_invalid_cue",
+    "renderer_sequence_exhausted",
+    "renderer_transport_failed",
+    "renderer_exited",
+    "renderer_directory_changed",
+    "renderer_socket_cleanup_failed",
+    "renderer_directory_not_empty",
+    "renderer_exit_failed",
+    "renderer_reap_failed",
+    "renderer_monitor_failed",
+    "renderer_invalid_signal",
+    "renderer_stdout_closed",
+    "renderer_heartbeat_timeout",
+];
+
+impl Channel {
+    /// Install once after host construction. The closure must hold only a Weak
+    /// host. A failure observed before installation is delivered exactly once.
+    pub fn on_stop(&self, callback: Arc<dyn Fn() + Send + Sync>) {
+        let invoke = {
+            let mut state = self.callback.lock().unwrap_or_else(|e| e.into_inner());
+            assert!(state.callback.is_none(), "stop callback already installed");
+            state.callback = Some(callback.clone());
+            if state.observed && !state.delivered {
+                state.delivered = true;
+                true
+            } else {
+                false
+            }
+        };
+        if invoke {
+            callback();
+        }
+    }
+
+    fn notify_stop(&self) {
+        let callback = {
+            let mut state = self.callback.lock().unwrap_or_else(|e| e.into_inner());
+            state.observed = true;
+            if state.delivered {
+                None
+            } else {
+                let callback = state.callback.clone();
+                state.delivered = callback.is_some();
+                callback
+            }
+        };
+        // No callback/sender mutex may span host reentry or process wait.
+        if let Some(callback) = callback {
+            callback();
+        }
+    }
+
+    /// Ancestor/host revocation invalidates descendant visuals too. This only
+    /// hides our one owned cursor, using its last actual dispatch position.
+    pub fn hide(&self) {
+        self.reconcile_hide.store(true, Ordering::Release);
+    }
+
+    pub fn check(&self) -> Result<(), &'static str> {
+        if self.emergency.load(Ordering::Acquire) {
+            return Err("emergency_stop");
+        }
+        let failure = self.failure.load(Ordering::Acquire);
+        if failure != 0 {
+            return Err(FAILURES[failure - 1]);
+        }
+        if self.stop.load(Ordering::Acquire) {
+            return Err("renderer_closed");
+        }
+        Ok(())
+    }
+    fn reconcile(&self, sender: &mut Sender) -> Result<(), &'static str> {
+        if self.reconcile_hide.swap(false, Ordering::AcqRel) {
+            if let Some(mut cue) = sender.last {
+                cue.kind = Kind::Hide;
+                sender.publish(cue)?;
+            }
+        }
+        Ok(())
+    }
+    fn fail(&self, code: &'static str) {
+        let code = FAILURES
+            .iter()
+            .position(|known| *known == code)
+            .unwrap_or(0)
+            + 1;
+        let _ = self
+            .failure
+            .compare_exchange(0, code, Ordering::AcqRel, Ordering::Acquire);
+    }
+    pub fn publish(&self, cue: Cue) {
+        // No renderer mutex wait on the primary input lane. A dropped state
+        // transition latches hide, reconciled by the next sender/monitor tick.
+        if self.check().is_err() {
+            return;
+        }
+        match self.sender.try_lock() {
+            Ok(mut sender) => {
+                if let Err(code) = self
+                    .reconcile(&mut sender)
+                    .and_then(|()| sender.publish(cue))
+                {
+                    self.fail(code);
+                }
+                if sender.transition.is_some() || sender.latest.is_some() {
+                    self.dropped.fetch_add(1, Ordering::Relaxed);
+                }
+            }
+            Err(TryLockError::WouldBlock) => {
+                if cue.kind != Kind::Move {
+                    self.reconcile_hide.store(true, Ordering::Release);
+                }
+                self.dropped.fetch_add(1, Ordering::Relaxed);
+            }
+            Err(TryLockError::Poisoned(_)) => self.fail("renderer_state_failed"),
+        }
+    }
+}
+
+pub struct Renderer {
+    pub channel: Arc<Channel>,
+    pub window_id: u32,
+    pub pid: i32,
+    monitor: Mutex<Option<JoinHandle<Result<(), &'static str>>>>,
+    closed: OnceLock<Result<(), &'static str>>,
+}
+
+/// Walk every component; neither helper nor socket paths accept symlinks.
+fn real_path(path: &Path) -> Result<(), &'static str> {
+    if !path.is_absolute()
+        || path
+            .to_str()
+            .is_none_or(|path| path.split('/').any(|part| part == "." || part == ".."))
+    {
+        return Err("renderer_path_invalid");
+    }
+    let mut current = PathBuf::new();
+    for component in path.components() {
+        match component {
+            Component::RootDir | Component::Normal(_) => current.push(component),
+            _ => return Err("renderer_path_invalid"),
+        }
+        if fs::symlink_metadata(&current)
+            .map_err(|_| "renderer_path_unavailable")?
+            .file_type()
+            .is_symlink()
+        {
+            return Err("renderer_path_symlink");
+        }
+    }
+    Ok(())
+}
+
+struct Process {
+    child: Child,
+    directory: PathBuf,
+    identity: (u64, u64),
+    socket_identity: Option<(u64, u64)>,
+    reaped: bool,
+}
+
+impl Process {
+    fn close(&mut self) -> Result<(), &'static str> {
+        drop(self.child.stdin.take()); // EOF, never a command byte
+        let deadline = Instant::now() + Duration::from_secs(2);
+        let success = loop {
+            match self.child.try_wait() {
+                Ok(Some(status)) => break status.success(),
+                Ok(None) if Instant::now() < deadline => thread::sleep(Duration::from_millis(5)),
+                Ok(None) => {
+                    // A deadline permits escalation, never a terminal receipt.
+                    let _ = self.child.kill();
+                    let status = self.child.wait().map_err(|_| "renderer_reap_failed")?;
+                    break status.success();
+                }
+                // ECHILD (e.g. an external reaper) is not authority to signal
+                // a possibly reused PID. Keep the failed ownership proof.
+                Err(_) => return Err("renderer_reap_failed"),
+            }
+        };
+        self.reaped = true;
+        let meta =
+            fs::symlink_metadata(&self.directory).map_err(|_| "renderer_directory_changed")?;
+        if meta.file_type().is_symlink() || (meta.dev(), meta.ino()) != self.identity {
+            return Err("renderer_directory_changed");
+        }
+        // Normal EOF lets the helper unlink. After a crash/escalation remove
+        // only the exact socket inode verified during readiness, never a replacement.
+        let socket = self.directory.join("s");
+        if let (Some(identity), Ok(meta)) = (self.socket_identity, fs::symlink_metadata(&socket)) {
+            if meta.file_type().is_socket() && (meta.dev(), meta.ino()) == identity {
+                fs::remove_file(socket).map_err(|_| "renderer_socket_cleanup_failed")?;
+            }
+        }
+        fs::remove_dir(&self.directory).map_err(|_| "renderer_directory_not_empty")?;
+        if success {
+            Ok(())
+        } else {
+            Err("renderer_exit_failed")
+        }
+    }
+}
+impl Drop for Process {
+    fn drop(&mut self) {
+        let _ = self.close();
+    }
+}
+
+impl Renderer {
+    pub fn start(helper: &Path) -> Result<Self, &'static str> {
+        Self::start_with_chord(
+            helper,
+            "escape",
+            &[
+                cua_driver_contract::computer_segment::ComputerModifier::Control,
+                cua_driver_contract::computer_segment::ComputerModifier::Option,
+            ],
+        )
+    }
+
+    pub fn start_with_chord(
+        helper: &Path,
+        key: &str,
+        modifiers: &[cua_driver_contract::computer_segment::ComputerModifier],
+    ) -> Result<Self, &'static str> {
+        let (key, flags) = emergency_chord(key, modifiers)?;
+        real_path(helper)?;
+        let metadata = fs::metadata(helper).map_err(|_| "renderer_path_unavailable")?;
+        if !metadata.is_file()
+            || metadata.mode() & 0o111 == 0
+            || metadata.mode() & 0o022 != 0
+            || (metadata.uid() != 0 && metadata.uid() != unsafe { libc::getuid() })
+        {
+            return Err("renderer_executable_untrusted");
+        }
+        let mut command = Command::new(helper);
+        command
+            .arg("--emergency-keycode")
+            .arg(key.to_string())
+            .arg("--emergency-modifiers")
+            .arg(flags.to_string());
+        Self::spawn(command)
+    }
+
+    fn spawn(mut command: Command) -> Result<Self, &'static str> {
+        let directory = PathBuf::from(format!(
+            "/private/tmp/pi-renderer-{}",
+            uuid::Uuid::new_v4().simple()
+        ));
+        real_path(Path::new("/private/tmp"))?;
+        DirBuilder::new()
+            .mode(0o700)
+            .create(&directory)
+            .map_err(|_| "renderer_directory_failed")?;
+        let metadata = fs::symlink_metadata(&directory).map_err(|_| "renderer_directory_failed")?;
+        if metadata.uid() != unsafe { libc::getuid() } || metadata.mode() & 0o777 != 0o700 {
+            let _ = fs::remove_dir(&directory);
+            return Err("renderer_directory_invalid");
+        }
+        let socket_path = directory.join("s");
+        let child = command
+            .arg("--socket")
+            .arg(&socket_path)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .spawn();
+        let child = match child {
+            Ok(child) => child,
+            Err(_) => {
+                let _ = fs::remove_dir(&directory);
+                return Err("renderer_spawn_failed");
+            }
+        };
+        let mut process = Process {
+            child,
+            directory,
+            identity: (metadata.dev(), metadata.ino()),
+            socket_identity: None,
+            reaped: false,
+        };
+        let mut stdout = process
+            .child
+            .stdout
+            .take()
+            .ok_or("renderer_stdout_missing")?;
+        let flags = unsafe { libc::fcntl(stdout.as_raw_fd(), libc::F_GETFL) };
+        if flags < 0
+            || unsafe { libc::fcntl(stdout.as_raw_fd(), libc::F_SETFL, flags | libc::O_NONBLOCK) }
+                < 0
+        {
+            return Err("renderer_pipe_failed");
+        }
+        let deadline = Instant::now() + Duration::from_secs(3);
+        let mut line = Vec::with_capacity(128);
+        let readiness = loop {
+            if Instant::now() >= deadline {
+                break Err("renderer_startup_failed");
+            }
+            let mut byte = [0];
+            match stdout.read(&mut byte) {
+                Ok(1) if byte[0] == b'\n' => break ready(&line),
+                Ok(1) if line.len() < 128 => line.push(byte[0]),
+                Err(error)
+                    if error.kind() == io::ErrorKind::WouldBlock && Instant::now() < deadline =>
+                {
+                    thread::sleep(Duration::from_millis(5))
+                }
+                _ => break Err("renderer_startup_failed"),
+            }
+        };
+        let accepted_at = Instant::now();
+        // Even a silent/malformed child may already have bound its socket.
+        // Capture only the verified inode in our private directory for cleanup;
+        // readiness failure is still returned, never promoted to admission.
+        if real_path(&socket_path).is_ok() {
+            if let Ok(meta) = fs::symlink_metadata(&socket_path) {
+                if meta.file_type().is_socket() && meta.uid() == unsafe { libc::getuid() } {
+                    process.socket_identity = Some((meta.dev(), meta.ino()));
+                }
+            }
+        }
+        let window_id = readiness?;
+        real_path(&socket_path)?;
+        let socket_metadata =
+            fs::symlink_metadata(&socket_path).map_err(|_| "renderer_socket_missing")?;
+        if !socket_metadata.file_type().is_socket()
+            || socket_metadata.uid() != unsafe { libc::getuid() }
+            || socket_metadata.mode() & 0o777 != 0o600
+        {
+            return Err("renderer_socket_invalid");
+        }
+        process.socket_identity = Some((socket_metadata.dev(), socket_metadata.ino()));
+        let socket = UnixDatagram::unbound().map_err(|_| "renderer_socket_failed")?;
+        socket
+            .set_nonblocking(true)
+            .map_err(|_| "renderer_socket_failed")?;
+        socket
+            .connect(&socket_path)
+            .map_err(|_| "renderer_socket_failed")?;
+        if process
+            .child
+            .try_wait()
+            .map_err(|_| "renderer_wait_failed")?
+            .is_some()
+        {
+            return Err("renderer_exited");
+        }
+        let pid = process.child.id() as i32;
+        let channel = Arc::new(Channel {
+            emergency: AtomicBool::new(false),
+            callback: Mutex::new(StopCallback::default()),
+            sender: Mutex::new(Sender {
+                socket,
+                sequence: 0,
+                transition: None,
+                latest: None,
+                last: None,
+            }),
+            failure: AtomicUsize::new(0),
+            reconcile_hide: AtomicBool::new(false),
+            stop: AtomicBool::new(false),
+            dropped: AtomicU64::new(0),
+        });
+        owned()
+            .lock()
+            .map_err(|_| "renderer_registry_failed")?
+            .push((pid, window_id));
+        let monitor_channel = channel.clone();
+        let monitor = thread::Builder::new()
+            .name("computer-renderer".into())
+            .spawn(move || {
+                let mut signal = StopSignal::new(accepted_at);
+                loop {
+                    if monitor_channel.stop.load(Ordering::Acquire) {
+                        break;
+                    }
+                    match signal.read(&mut stdout) {
+                        Ok(true) => {
+                            monitor_channel.emergency.store(true, Ordering::Release);
+                            break;
+                        }
+                        Ok(false) => {}
+                        Err(code) => {
+                            monitor_channel.fail(code);
+                            break;
+                        }
+                    }
+                    match process.child.try_wait() {
+                        Ok(None) => {}
+                        _ => {
+                            monitor_channel.fail("renderer_exited");
+                            break;
+                        }
+                    }
+                    if let Ok(mut sender) = monitor_channel.sender.try_lock() {
+                        if let Err(code) = monitor_channel
+                            .reconcile(&mut sender)
+                            .and_then(|()| sender.flush())
+                        {
+                            monitor_channel.fail(code);
+                        }
+                    }
+                    if monitor_channel.check().is_err() {
+                        break;
+                    }
+                    thread::sleep(Duration::from_millis(16));
+                }
+                if monitor_channel.check().is_err() && !monitor_channel.stop.load(Ordering::Acquire)
+                {
+                    monitor_channel.notify_stop();
+                }
+                let result = process.close();
+                if let Err(code) = result {
+                    monitor_channel.fail(code);
+                }
+                if process.reaped {
+                    if let Ok(mut ids) = owned().lock() {
+                        ids.retain(|id| *id != (pid, window_id));
+                    }
+                }
+                // Diagnostic directory debris is not a live child/input obligation.
+                // Keep its failure visible without stranding the desktop host.
+                if process.reaped {
+                    Ok(())
+                } else {
+                    result
+                }
+            })
+            .map_err(|_| {
+                if let Ok(mut ids) = owned().lock() {
+                    ids.retain(|id| *id != (pid, window_id));
+                }
+                "renderer_monitor_failed"
+            })?;
+        Ok(Self {
+            channel,
+            pid,
+            window_id,
+            monitor: Mutex::new(Some(monitor)),
+            closed: OnceLock::new(),
+        })
+    }
+
+    pub fn close(&self) -> Result<(), &'static str> {
+        self.channel.stop.store(true, Ordering::Release);
+        let mut monitor = self.monitor.lock().map_err(|_| "renderer_monitor_failed")?;
+        if let Some(monitor) = monitor.take() {
+            let result = monitor.join().unwrap_or(Err("renderer_monitor_failed"));
+            let _ = self.closed.set(result);
+        }
+        self.closed
+            .get()
+            .copied()
+            .unwrap_or(Err("renderer_monitor_failed"))
+    }
+}
+impl Drop for Renderer {
+    fn drop(&mut self) {
+        let _ = self.close();
+    }
+}
