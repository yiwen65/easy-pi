+#[test]
+fn controlled_renderer_full_queue_retains_release_before_latest_move() {
+    let (mut sender, receiver) = pair();
+    for _ in 0..10000 {
+        if !sender.send(cue(Kind::Move)).unwrap() {
+            break;
+        }
+    }
+    sender.publish(cue(Kind::Down)).unwrap();
+    sender.publish(cue(Kind::Up)).unwrap();
+    sender
+        .publish(Cue {
+            x: 999.,
+            ..cue(Kind::Move)
+        })
+        .unwrap();
+    assert_eq!(sender.transition.unwrap().kind, Kind::Up);
+    assert_eq!(sender.latest.unwrap().x, 999.);
+    let mut bytes = [0; 512];
+    while receiver.recv(&mut bytes).is_ok() {}
+    sender.flush().unwrap();
+    let release = packet(&receiver);
+    let position = packet(&receiver);
+    assert_eq!(release["kind"], "up");
+    assert_eq!(position["x"], 999.);
+    assert!(release["sequence"].as_u64() < position["sequence"].as_u64());
+    assert!(sender.transition.is_none() && sender.latest.is_none());
+    for code in [libc::ENOBUFS, libc::EAGAIN, libc::EWOULDBLOCK] {
+        assert!(blocked(&io::Error::from_raw_os_error(code)));
+    }
+    assert!(!blocked(&io::Error::from_raw_os_error(libc::ECONNREFUSED)));
+}
