+#[test]
+fn controlled_renderer_protocol_sequence_and_window_local_coordinates() {
+    let (mut sender, receiver) = pair();
+    for (sequence, kind) in [Kind::Move, Kind::Down, Kind::Up, Kind::Click, Kind::Hide]
+        .into_iter()
+        .enumerate()
+    {
+        sender.publish(cue(kind)).unwrap();
+        let value = packet(&receiver);
+        assert_eq!(value.as_object().unwrap().len(), 7);
+        assert_eq!(value["sequence"], sequence);
+        assert_eq!(value["version"], 1);
+        assert_eq!(value["target_pid"], 123);
+        assert_eq!(value["window_id"], 456);
+        assert_eq!(value["x"], 12.5);
+        assert_eq!(value["y"], 30.25);
+    }
+    for coordinate in [f64::NAN, f64::INFINITY, -1., 1_000_001.] {
+        assert!(sender
+            .send(Cue {
+                x: coordinate,
+                ..cue(Kind::Move)
+            })
+            .is_err());
+    }
+    sender.sequence = u64::MAX;
+    assert_eq!(
+        sender.send(cue(Kind::Move)),
+        Err("renderer_sequence_exhausted")
+    );
+}
