+        output.first_unfinished_action = Some(1);
+        assert_eq!(validate_result(&input, &output), Ok(()));
+        output.actions[0].index = 1;
+        assert!(validate_result(&input, &output).is_err());
+        output.actions[0].index = 0;
+        output.actions[0].dispatch = ComputerDispatch::Unknown;
+        output.first_unfinished_action = Some(0);
+        assert_eq!(validate_result(&input, &output), Ok(()));
+        output.actions.push(delivered(1));
+        assert!(validate_result(&input, &output).is_err());
+        output.actions = vec![delivered(0), delivered(1), delivered(2)];
+        assert!(validate_result(&input, &output).is_err());
+    }
+    #[test]
+    fn controlled_segment_result_rejects_false_route_and_effect_facts() {
+        let input = segment(vec![ComputerInput::TypeText { text: "x".into() }]);
+        for fault in 0..8 {
