+            for hold in [Hold::Key(0), Hold::Button(ComputerMouseButton::Left)] {
+                let releases = releases.clone();
+                operation
+                    .segment_primary(|| {
+                        owned.push(OwnedRelease {
+                            value: Some(hold),
+                            release: Box::new(move |hold| {
+                                releases.lock().unwrap().push(hold);
+                                Ok(())
+                            }),
+                        });
+                    })
+                    .unwrap();
+            }
+            let deadline = Instant::now() + Duration::from_secs(5);
+            while operation.checkpoint().is_ok() && Instant::now() < deadline {
+                std::thread::sleep(Duration::from_millis(5));
+            }
+            assert!(operation.is_cancelled());
+            assert!(operation
