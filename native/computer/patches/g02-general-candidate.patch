+#[test]
+fn controlled_emergency_signal_is_fixed_bounded_and_incremental() {
+    use std::io::Cursor;
+    assert!(StopSignal::default()
+        .read(&mut Cursor::new(EMERGENCY_SIGNAL))
+        .unwrap());
+    for body in [
+        b"secret".as_slice(),
+        b"{\"event\":\"emergency_stop\",\"version\":1}\n",
+        b" ",
+        b"",
+        &[b'x'; 4096],
+    ] {
+        assert!(StopSignal::default().read(&mut Cursor::new(body)).is_err());
+    }
+    struct Fragment {
+        byte: Option<u8>,
+    }
+    impl Read for Fragment {
+        fn read(&mut self, out: &mut [u8]) -> io::Result<usize> {
+            match self.byte.take() {
+                Some(byte) => {
+                    out[0] = byte;
+                    Ok(1)
+                }
+                None => Err(io::ErrorKind::WouldBlock.into()),
+            }
+        }
+    }
+    let mut parser = StopSignal::default();
+    for (index, byte) in EMERGENCY_SIGNAL.iter().enumerate() {
+        assert_eq!(
+            parser.read(&mut Fragment { byte: Some(*byte) }).unwrap(),
+            index + 1 == EMERGENCY_SIGNAL.len()
+        );
+    }
