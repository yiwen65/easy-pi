@@ -0,0 +1,230 @@
+use super::{Operation, Session};
+use std::time::{Duration, Instant};
+
+impl Session {
+    pub fn intent_state(&self, intent: &str) -> Result<(u8, bool, bool), &'static str> {
+        let mut states = self
+            .recovery
+            .lock()
+            .map_err(|_| "recovery_state_poisoned")?;
+        if intent.is_empty() || intent.len() > 128 {
+            return Err("invalid_intent_reference");
+        }
+        if !states.contains_key(intent) && states.len() >= 256 {
+            return Err("unresolved_intent_limit");
+        }
+        Ok(*states.entry(intent.into()).or_default())
+    }
+
+    pub fn recover_intent(&self, intent: &str) -> Result<u8, &'static str> {
+        self.intent_state(intent)?;
+        let mut states = self
+            .recovery
+            .lock()
+            .map_err(|_| "recovery_state_poisoned")?;
+        let state = states.get_mut(intent).ok_or("invalid_intent_reference")?;
+        if state.0 >= 2 {
+            return Err("recovery_exhausted");
+        }
+        state.0 += 1;
+        Ok(state.0)
+    }
+
+    pub fn record_intent(
+        &self,
+        intent: &str,
+        committed: bool,
+        confirmed: bool,
+    ) -> Result<(), &'static str> {
+        let mut states = self
+            .recovery
+            .lock()
+            .map_err(|_| "recovery_state_poisoned")?;
+        let state = states.get_mut(intent).ok_or("invalid_intent_reference")?;
+        state.1 |= committed;
+        state.2 |= confirmed;
+        Ok(())
+    }
+}
+
+impl Operation {
+    pub fn bind_segment_intent(&self, intent: &str) -> Result<(), &'static str> {
+        self.session.intent_state(intent)?;
+        let mut state = self.state();
+        if state.segment_limits.is_none() || state.next_step != 0 || state.segment_intent.is_some()
+        {
+            return Err("invalid_segment_intent");
+        }
+        state.segment_intent = Some(intent.into());
+        Ok(())
+    }
+
+    /// Distinct compound budget; never widens ordinary primary/pointer/plan
+    /// limits. Each entry is the maximum admitted OS calls for one action.
+    pub fn configure_segment(
+        &self,
+        limits: Vec<u32>,
+        timeout: Duration,
+    ) -> Result<(), &'static str> {
+        let closed = self.session.gate.guard();
+        let mut state = self.state();
+        if *closed || !self.session.live() || state.cancelled || state.producer_done {
+            return Err("cancelled");
+        }
+        if state.started
+            || state.plan_steps.is_some()
+            || state.segment_limits.is_some()
+            || limits.is_empty()
+            || limits.len() > 64
+            || limits.iter().any(|limit| *limit == 0 || *limit > 2048)
+            || limits.iter().sum::<u32>() > 8192
+            || timeout.is_zero()
+            || timeout > Duration::from_secs(30)
+        {
+            return Err("invalid_segment_budget");
+        }
+        state.segment_limits = Some(limits);
+        state.deadline = Some(Instant::now() + timeout);
+        Ok(())
+    }
+
+    pub fn is_segment(&self) -> bool {
+        self.state().segment_limits.is_some()
+    }
+
+    /// Serial executor only, including while its one tracked worker owns held
+    /// releases. A step cannot be restarted to reset a consumed allowance.
+    pub fn begin_segment_action(&self, index: u32) -> Result<(), &'static str> {
+        let closed = self.session.gate.guard();
+        let mut state = self.state();
+        if *closed || !self.session.live() || state.cancelled || state.producer_done {
+            return Err("cancelled");
+        }
+        if !state.started
+            || index != state.next_step
+            || !state
+                .segment_limits
+                .as_ref()
+                .is_some_and(|limits| (index as usize) < limits.len())
+        {
+            return Err("invalid_segment_action");
+        }
+        state.next_step += 1;
+        state.step_inputs = 0;
+        state.step_input_limit = None;
+        Ok(())
+    }
+
+    pub fn segment_primary<T>(&self, call: impl FnOnce() -> T) -> Result<T, &'static str> {
+        let limit = {
+            let state = self.state();
+            state
+                .next_step
+                .checked_sub(1)
+                .and_then(|index| state.segment_limits.as_ref()?.get(index as usize).copied())
+                .ok_or("invalid_segment_action")?
+        };
+        self.primary_with_limit(true, limit, call)
+    }
+
+    pub fn segment_action_inputs(&self) -> u32 {
+        self.state().step_inputs
+    }
+}
