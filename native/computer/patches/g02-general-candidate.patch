+#[test]
+fn controlled_renderer_heartbeat_deadline_partial_flood_and_stop_priority() {
+    let start = Instant::now();
+    let mut parser = StopSignal::new(start);
+    for tick in 1..=8 {
+        let now = start + Duration::from_millis(tick * 250);
+        assert_eq!(
+            parser.read_at(&mut Available(HEARTBEAT_SIGNAL), now),
+            Ok(false)
+        );
+        assert_eq!(parser.deadline, now + HEARTBEAT_TIMEOUT);
+    }
+    let deadline = parser.deadline;
+    assert_eq!(
+        parser.read_at(&mut Available(b"{"), deadline - Duration::from_millis(1)),
+        Ok(false)
+    );
+    assert_eq!(parser.deadline, deadline);
+    assert_eq!(
+        parser.read_at(&mut Available(b""), deadline),
+        Err("renderer_heartbeat_timeout")
+    );
+    // Even a complete queued heartbeat cannot revive a missed deadline.
+    let mut late = StopSignal::new(start);
+    assert_eq!(
+        late.read_at(&mut Available(HEARTBEAT_SIGNAL), start + HEARTBEAT_TIMEOUT),
+        Err("renderer_heartbeat_timeout")
+    );
+    assert_eq!(late.deadline, start + HEARTBEAT_TIMEOUT);
+    let mut flooded = StopSignal::new(start);
+    assert_eq!(
+        flooded.read_at(&mut Available(&HEARTBEAT_SIGNAL.repeat(100)), start),
+        Err("renderer_invalid_signal")
+    );
+    assert_eq!(flooded.deadline, start + HEARTBEAT_TIMEOUT);
+    let mut stopped = StopSignal::new(start);
+    let bytes = [
+        HEARTBEAT_SIGNAL,
+        EMERGENCY_SIGNAL,
+        b"invalid trailing flood",
+    ]
+    .concat();
+    assert_eq!(
+        stopped.read_at(&mut Available(&bytes), start + HEARTBEAT_TIMEOUT),
+        Ok(true)
+    );
+    for bytes in [
+        b"{\"event\":\"heartbeat\",\"version\":2}\n".as_slice(),
+        b"{\"event\":\"heartbeat\",\"version\":3,\"extra\":0}\n",
+        b"{\"event\":\"heartbeat\",\"version\":3.0}\n",
+    ] {
+        assert_eq!(
+            StopSignal::new(start).read_at(&mut Available(bytes), start),
+            Err("renderer_invalid_signal")
+        );
+    }
+    let mut fragmented = StopSignal::new(start);
+    for (i, byte) in HEARTBEAT_SIGNAL.iter().enumerate() {
+        let now = start + Duration::from_millis(500);
+        assert_eq!(fragmented.read_at(&mut Available(&[*byte]), now), Ok(false));
+        assert_eq!(
+            fragmented.deadline,
+            if i + 1 == HEARTBEAT_SIGNAL.len() {
+                now + HEARTBEAT_TIMEOUT
+            } else {
+                start + HEARTBEAT_TIMEOUT
+            }
+        );
+    }
+    assert_eq!(
+        fragmented.read_at(&mut io::Cursor::new(b"{"), start),
+        Err("renderer_stdout_closed")
+    );
+}
