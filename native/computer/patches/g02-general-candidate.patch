+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::controlled::Gate;
+    use std::sync::Arc;
+
+    #[tokio::test]
+    async fn controlled_segment_budget_orders_actions_and_counts_every_event() {
+        let gate = Gate::new();
+        let session = gate.session(None, Arc::new(|| true), 1, 2, None).unwrap();
+        let op = session.new_operation().unwrap();
+        op.configure_segment(vec![3; 64], Duration::from_secs(30))
+            .unwrap();
+        assert!(op.configure_plan(8, Duration::from_secs(1)).is_err());
+        op.begin().unwrap();
+        assert!(op.segment_primary(|| panic!("before action")).is_err());
+        for index in 0..64 {
+            assert!(op.begin_segment_action(index + 1).is_err());
+            op.begin_segment_action(index).unwrap();
+            assert!(op.begin_segment_action(index).is_err());
+            for _ in 0..3 {
+                op.segment_primary(|| ()).unwrap();
+            }
+            assert!(op.segment_primary(|| panic!("over budget")).is_err());
+        }
+        op.cancel();
+        assert!(op.segment_primary(|| panic!("cancelled")).is_err());
+        op.finish();
+        assert!(op.terminal().await.unwrap().input_committed);
+    }
+
+    #[test]
+    fn controlled_segment_budget_keeps_legacy_caps_and_total_bound() {
+        let gate = Gate::new();
+        let session = gate.session(None, Arc::new(|| true), 1, 2, None).unwrap();
+        for limits in [vec![], vec![1; 65], vec![0], vec![2049], vec![2048; 5]] {
+            assert!(session
+                .new_operation()
+                .unwrap()
+                .configure_segment(limits, Duration::from_secs(1))
+                .is_err());
+        }
+        let op = session.new_operation().unwrap();
+        assert!(op.configure_plan(9, Duration::from_secs(1)).is_err());
+        op.begin().unwrap();
+        op.primary(true, || ()).unwrap();
+        assert!(op.primary(true, || panic!("legacy widened")).is_err());
+        assert!(op.pointer_primary(|| panic!("mixed budgets")).is_err());
+        op.finish();
+    }
+
+    #[test]
+    fn controlled_segment_recovery_budget_survives_operations_and_retains_unknown_input() {
+        let gate = Gate::new();
+        let session = gate.session(None, Arc::new(|| true), 1, 2, None).unwrap();
+        assert_eq!(session.intent_state("task"), Ok((0, false, false)));
+        session.record_intent("task", true, false).unwrap();
+        assert_eq!(session.recover_intent("task"), Ok(1));
+        drop(session.new_operation().unwrap());
+        assert_eq!(session.intent_state("task"), Ok((1, true, false)));
+        assert_eq!(session.recover_intent("task"), Ok(2));
+        assert_eq!(session.recover_intent("task"), Err("recovery_exhausted"));
+        session.record_intent("task", false, false).unwrap();
+        assert_eq!(session.intent_state("task"), Ok((2, true, false)));
+        session.record_intent("task", false, true).unwrap();
+        assert_eq!(
+            session.intent_state("task"),
+            Ok((2, true, true)),
+            "confirmed result loss must not enable replay"
+        );
+    }
+
+    #[test]
+    fn controlled_segment_admission_records_intent_before_an_unwind() {
+        let gate = Gate::new();
+        let session = gate.session(None, Arc::new(|| true), 1, 2, None).unwrap();
+        for cancelled in [false, true] {
+            let intent = if cancelled { "cancelled" } else { "unwind" };
+            let op = session.new_operation().unwrap();
+            op.configure_segment(vec![1], Duration::from_secs(1))
+                .unwrap();
+            op.bind_segment_intent(intent).unwrap();
+            op.begin().unwrap();
+            op.begin_segment_action(0).unwrap();
+            if cancelled {
+                op.cancel();
+            }
+            let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                op.segment_primary(|| panic!("after admitted input"))
+            }));
+            assert_eq!(outcome.is_err(), !cancelled);
+            assert_eq!(session.intent_state(intent), Ok((0, !cancelled, false)));
+            op.finish();
+        }
+    }
+}
