+    async fn controlled_segment_owned_release_survives_cancel_revoke_and_panic() {
+        use cua_driver_core::controlled::Gate;
+        use std::sync::atomic::{AtomicUsize, Ordering};
+        for mode in 0..4 {
+            let gate = Gate::new();
+            let session = gate.session(None, Arc::new(|| true), 1, 2, None).unwrap();
+            let op = session.new_operation().unwrap();
+            op.configure_segment(vec![1], std::time::Duration::from_secs(30))
+                .unwrap();
+            op.begin().unwrap();
+            op.begin_segment_action(0).unwrap();
+            let count = Arc::new(AtomicUsize::new(0));
+            let released = count.clone();
+            let callback = Box::new(move |value: usize| {
+                released.fetch_add(value, Ordering::SeqCst);
+                Ok(())
+            });
+            if mode == 0 {
+                op.cancel();
+            }
+            let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                op.segment_primary(|| {
+                    let _owned = OwnedRelease {
+                        value: Some(1),
+                        release: callback,
+                    };
+                    if mode == 1 {
+                        op.cancel();
+                    }
+                    if mode == 2 {
+                        session.revoke();
+                    }
+                    if mode == 3 {
+                        panic!("injected after down");
+                    }
+                })
+            }));
+            assert_eq!(count.load(Ordering::SeqCst), usize::from(mode != 0));
+            assert_eq!(result.is_err(), mode == 3);
+            op.finish();
+            assert_eq!(op.terminal().await.unwrap().input_committed, mode != 0);
+        }
+    }
