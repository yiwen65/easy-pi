+//! Synthetic runtime/gate only; never ComputerHost::create, desktop lease or OS input.
+use super::*;
+
+fn rendered_fixture() -> (Arc<ComputerHost>, i32) {
+    let mut host = host();
+    let helper =
+        std::env::var_os("CUA_RENDERER_TEST_HELPER").expect("explicit headless fixture required");
+    let renderer = Arc::new(
+        platform_macos::computer_renderer::Renderer::start(std::path::Path::new(&helper)).unwrap(),
+    );
+    let pid = renderer.pid;
+    Arc::get_mut(&mut host).unwrap().renderer = Some(renderer);
+    host.bind_renderer_stop();
+    (host, pid)
+}
+
+#[tokio::test]
+async fn controlled_renderer_host_close_reaps_even_with_quarantined_input_proof() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let (host, pid) = rendered_fixture();
+    assert!(matches!(
+        host.renderer_status(),
+        ComputerRendererStatus::Ready { window_id: 42, .. }
+    ));
+    let operation = session(&host, None).new_operation().unwrap();
+    operation.core.begin().unwrap();
+    drop(operation); // synthetic missing producer: retain native quarantine
+    assert!(matches!(
+        host.clone().close().await,
+        Err(ComputerError::Quarantined)
+    ));
+    assert!(!platform_macos::computer_renderer::is_owned_window(pid, 42));
+    assert!(host.gate.is_quarantined());
+    assert!(matches!(
+        host.renderer_status(),
+        ComputerRendererStatus::Failed { .. }
+    ));
+}
+
+#[tokio::test]
+async fn controlled_renderer_host_close_waits_for_actual_operation_drain() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let (host, pid) = rendered_fixture();
+    let operation = session(&host, None).new_operation().unwrap();
+    operation.core.begin().unwrap();
+    let callback = operation.core.track_callback().unwrap();
+    operation.core.finish();
+    let mut close = Box::pin(host.clone().close());
+    assert!(close
+        .as_mut()
+        .poll(&mut Context::from_waker(Waker::noop()))
+        .is_pending());
+    drop(close); // foreign waiter does not own cleanup
+    assert!(platform_macos::computer_renderer::is_owned_window(pid, 42));
+    drop(callback);
+    host.clone().close().await.unwrap();
+    assert!(!platform_macos::computer_renderer::is_owned_window(pid, 42));
+    assert!(!host.gate.is_quarantined());
+}
+
+#[tokio::test]
+async fn controlled_renderer_timeout_keeps_missing_producer_quarantined() {
+    let _test = TEST_RUNTIME_LOCK.lock().unwrap();
+    let mut host = host();
+    let helper = std::path::PathBuf::from(std::env::var_os("CUA_RENDERER_TEST_HELPER").unwrap())
+        .with_file_name("stalled-helper");
+    let renderer = Arc::new(platform_macos::computer_renderer::Renderer::start(&helper).unwrap());
+    let pid = renderer.pid;
+    Arc::get_mut(&mut host).unwrap().renderer = Some(renderer);
+    host.bind_renderer_stop();
+    let operation = session(&host, None).new_operation().unwrap();
+    operation.core.begin().unwrap();
+    drop(operation); // missing producer cannot be repaired by helper timeout/reap
+    tokio::time::timeout(Duration::from_secs(5), async {
+        while host.renderer.as_ref().unwrap().channel.check().is_ok() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    for _ in 0..2 {
+        assert!(matches!(
+            host.clone().close().await,
+            Err(ComputerError::Quarantined)
+        ));
+    }
+    assert!(host.gate.is_quarantined());
+    assert!(!platform_macos::computer_renderer::is_owned_window(pid, 42));
+    assert!(
+        matches!(host.renderer_status(), ComputerRendererStatus::Failed { code } if code == "renderer_heartbeat_timeout")
+    );
+}
