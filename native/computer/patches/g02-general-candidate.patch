+use super::*;
+struct SurfaceReader { error: &'static str }
+impl Reader for SurfaceReader {
+    type Element = u8;
+    fn checkpoint(&self) -> Result<(), &'static str> { Ok(()) }
+    fn same(&self, a: &u8, b: &u8) -> bool { a == b }
+    fn data(&self, element: &u8) -> Result<Data, &'static str> {
+        if *element == 1 { return Err(self.error); }
+        Ok(Data { role: "AXTextField".into(), ..Data::default() })
+    }
+    fn children(&self, element: &u8) -> Result<Vec<u8>, &'static str> {
+        match element { 0 => Ok(vec![1, 2]), 1 => panic!("foreign surface children must not be read"), _ => Ok(vec![]) }
+    }
+}
+#[test]
+fn controlled_surface_scan_excludes_proven_foreign_boundary_and_keeps_siblings() {
+    let reader = SurfaceReader { error: "target_outside_selected_window" };
+    let scan = scan_general(&reader, 0);
+    assert!(scan.complete());
+    assert_eq!(scan.rows.iter().map(|r| r.element).collect::<Vec<_>>(), vec![0, 2]);
+}
+#[test]
+fn controlled_surface_scan_unknown_membership_still_fails_closed() {
+    let reader = SurfaceReader { error: "target_membership_unknown" };
+    let scan = scan_general(&reader, 0);
+    assert_eq!(scan.failure, Some("target_membership_unknown"));
+    assert!(!scan.complete());
+}
+#[test]
+fn controlled_surface_scan_foreign_root_and_legacy_are_not_silently_empty() {
+    let reader = SurfaceReader { error: "target_outside_selected_window" };
+    assert!(!scan_general(&reader, 1).complete());
+    assert!(!scan(&reader, 0, 512, 32).complete());
+}
