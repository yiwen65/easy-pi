+++ b/libs/cua-driver/rust/crates/platform-macos/src/ax/general_surface.rs
@@ -0,0 +1,213 @@
+//! General-only exact surface identity. Never extends a parent's authority to
+//! a separately mapped focused surface. Legacy exact_target is unchanged.
+use super::{bindings::*, cache::RetainedElement};
+use core_foundation::base::{CFRelease, CFTypeRef};
+
+#[link(name = "ApplicationServices", kind = "framework")]
+extern "C" {
+    fn AXUIElementGetPid(element: AXUIElementRef, pid: *mut i32) -> AXError;
+    fn GetFrontProcess(psn: *mut std::ffi::c_void) -> i32;
+    fn GetProcessPID(psn: *const std::ffi::c_void, pid: *mut i32) -> i32;
+}
+
+fn frontmost_pid() -> Option<i32> {
+    // Node does not run an AppKit notification loop. Query WindowServer's
+    // process identity rather than relying on cached NSWorkspace state.
+    let read = || unsafe {
+        let mut psn = [0u32; 2];
+        let mut pid = 0;
+        (GetFrontProcess(psn.as_mut_ptr().cast()) == 0
+            && GetProcessPID(psn.as_ptr().cast(), &mut pid) == 0
+            && pid > 0)
+            .then_some(pid)
+    };
+    match cua_driver_core::controlled::current() {
+        Some(operation) => operation.primary(false, read).ok().flatten(),
+        None => read(),
+    }
+}
+
+unsafe fn own(element: AXUIElementRef) -> Option<RetainedElement> {
+    if element.is_null() {
+        return None;
+    }
+    let owned = RetainedElement::retain(element as usize);
+    CFRelease(element as CFTypeRef);
+    Some(owned)
+}
+
+unsafe fn bounded(element: AXUIElementRef) -> bool {
+    AXUIElementSetMessagingTimeout(element, 0.2) == kAXErrorSuccess
+}
+
+/// Numeric PID identity only; no role, title, value or sibling content.
+pub unsafe fn element_pid(element: AXUIElementRef) -> Option<i32> {
+    let mut pid = 0;
+    let mut read = || AXUIElementGetPid(element, &mut pid);
+    let error = match cua_driver_core::controlled::current() {
+        Some(operation) => operation.primary(false, read).ok()?,
+        None => read(),
+    };
+    (error == kAXErrorSuccess && pid > 0).then_some(pid)
+}
+
+pub fn matches_identity(
+    pid: i32,
+    window: u32,
+    actual_pid: Option<i32>,
+    direct: Option<u32>,
+    ancestry: impl FnOnce() -> Option<u32>,
+) -> bool {
+    pid > 0 && window != 0 && actual_pid == Some(pid) && direct.or_else(ancestry) == Some(window)
+}
+
+pub fn current_owner(
+    expected: Option<(u64, u64)>,
+    current: Option<(u64, u64)>,
+    owner: crate::windows::WindowOwner,
+) -> bool {
+    expected.is_some()
+        && expected == current
+        && matches!(owner, crate::windows::WindowOwner::SamePid)
+}
+
+/// A known direct mapping wins even when AXWindow/AXParent names a different
+/// surface. Unknown direct mapping may use the existing bounded ancestry proof.
+pub unsafe fn member(element: AXUIElementRef, pid: i32, window: u32) -> bool {
+    bounded(element)
+        && matches_identity(
+            pid,
+            window,
+            element_pid(element),
+            ax_get_window_id(element),
+            || super::exact_target::element_window_id(element),
+        )
+}
+
+pub fn focused(pid: i32) -> Option<RetainedElement> {
+    unsafe {
+        let app = own(AXUIElementCreateApplication(pid))?;
+        let ptr = app.as_ptr() as AXUIElementRef;
+        if !bounded(ptr) {
+            return None;
+        }
+        let element = own(copy_element_attr(ptr, "AXFocusedUIElement")?)?;
+        let ptr = element.as_ptr() as AXUIElementRef;
+        if !bounded(ptr) || element_pid(ptr) != Some(pid) {
+            return None;
+        }
+        Some(element)
+    }
+}
+
+/// Retained exact member; callers cannot read a foreign focused object's content.
+pub unsafe fn focused_in_window(pid: i32, window: u32) -> Option<AXUIElementRef> {
+    let element = focused(pid)?;
+    let ptr = element.as_ptr() as AXUIElementRef;
+    if !member(ptr, pid, window) {
+        return None;
+    }
+    core_foundation::base::CFRetain(ptr as CFTypeRef);
+    Some(ptr)
+}
+
+pub fn keyboard_window(pid: i32) -> Option<u32> {
+    let element = focused(pid)?;
+    unsafe {
+        let ptr = element.as_ptr() as AXUIElementRef;
+        ax_get_window_id(ptr).or_else(|| super::exact_target::element_window_id(ptr))
+    }
+}
+
+pub fn foreground_match(front: Option<bool>, focused: Option<u32>, selected: u32) -> Option<bool> {
+    match front {
+        Some(false) => Some(false),
+        Some(true) => focused.map(|window| window == selected),
+        None => None,
+    }
+}
+
+/// One foreground application, one focused element, numeric identities only.
+/// No AX enablement or per-catalog-window AX probes. Any uncertainty stays None.
+pub fn foreground_identity() -> Option<(i32, u32, (u64, u64))> {
+    let pid = frontmost_pid()?;
+    let stamp = super::enablement::process_start_stamp(pid)?;
+    let element = focused(pid)?;
+    let window = unsafe { ax_get_window_id(element.as_ptr() as AXUIElementRef) }?;
+    if crate::input::skylight::front_process_matches(pid, window) != Some(true)
+        || !matches!(
+            crate::windows::resolve_window_owner(pid, window),
+            crate::windows::WindowOwner::SamePid
+        )
+        || super::enablement::process_start_stamp(pid) != Some(stamp)
+    {
+        return None;
+    }
+    Some((pid, window, stamp))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn controlled_surface_exact_direct_mapping_needs_correct_pid_and_window() {
+        assert!(matches_identity(42, 7206, Some(42), Some(7206), || panic!(
+            "no ancestry read"
+        )));
+        assert!(!matches_identity(42, 7206, Some(43), Some(7206), || None));
+        assert!(!matches_identity(42, 7206, None, Some(7206), || None));
+        assert!(!matches_identity(42, 7206, Some(42), None, || None));
+    }
+    #[test]
+    fn controlled_surface_known_child_never_inherits_parent_or_reverse() {
+        assert!(!matches_identity(
+            42,
+            7202,
+            Some(42),
+            Some(7206),
+            || panic!("parent must not override child")
+        ));
+        assert!(!matches_identity(42, 7206, Some(42), Some(7202), || Some(
+            7206
+        )));
+        assert!(matches_identity(42, 7202, Some(42), None, || Some(7202)));
+    }
+    #[test]
+    fn controlled_surface_current_incarnation_and_window_ownership_are_required() {
+        use crate::windows::WindowOwner;
+        assert!(current_owner(
+            Some((1, 2)),
+            Some((1, 2)),
+            WindowOwner::SamePid
+        ));
+        assert!(!current_owner(None, None, WindowOwner::SamePid));
+        assert!(!current_owner(Some((1, 2)), None, WindowOwner::SamePid));
+        assert!(!current_owner(
+            Some((1, 2)),
+            Some((1, 3)),
+            WindowOwner::SamePid
+        ));
+        assert!(!current_owner(
+            Some((1, 2)),
+            Some((1, 2)),
+            WindowOwner::Unknown
+        ));
+        assert!(!current_owner(
+            Some((1, 2)),
+            Some((1, 2)),
+            WindowOwner::ForeignPid {
+                owner_pid: 43,
+                owner_app_name: String::new()
+            }
+        ));
+    }
+
+    #[test]
+    fn controlled_surface_foreground_unknown_is_not_false_or_parent_permission() {
+        assert_eq!(foreground_match(Some(true), Some(7206), 7206), Some(true));
+        assert_eq!(foreground_match(Some(true), Some(7206), 7202), Some(false));
+        assert_eq!(foreground_match(Some(true), None, 7206), None);
+        assert_eq!(foreground_match(None, Some(7206), 7206), None);
+        assert_eq!(foreground_match(Some(false), Some(7206), 7206), Some(false));
+    }
+}
