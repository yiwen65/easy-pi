+            )
+        if variant == 5:
+            return ComputerInput.KEY_DOWN(
+                _UniffiFfiConverterString.read(buf),
+            )
+        if variant == 6:
+            return ComputerInput.KEY_UP(
+                _UniffiFfiConverterString.read(buf),
+            )
+        if variant == 7:
+            return ComputerInput.POINTER_MOVE(
+                _UniffiFfiConverterTypeComputerPoint.read(buf),
+            )
+        if variant == 8:
+            return ComputerInput.BUTTON_DOWN(
+                _UniffiFfiConverterTypeComputerMouseButton.read(buf),
+            )
+        if variant == 9:
+            return ComputerInput.BUTTON_UP(
