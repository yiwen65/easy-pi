+++ b/libs/cua-driver/rust/crates/platform-macos/src/tools/computer/segment/focus.rs
@@ -0,0 +1,104 @@
+//! Focus acknowledgement can precede the target application's AX update.
+//! Poll only identity; never repeat the focus mutation or synthesize another click.
+pub(super) fn activate_unless_current(
+    current: bool,
+    activate: impl FnOnce() -> Result<(), &'static str>,
+) -> Result<(), &'static str> {
+    if current {
+        Ok(())
+    } else {
+        activate()
+    }
+}
+
+pub(super) fn confirm_focus(
+    mut current: impl FnMut() -> Result<bool, &'static str>,
+    mut pause: impl FnMut() -> bool,
+) -> Result<(), &'static str> {
+    loop {
+        if current()? {
+            return Ok(());
+        }
+        if !pause() {
+            return Err("focus_effect_unknown");
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::confirm_focus;
+    use std::cell::Cell;
+
+    #[test]
+    fn controlled_focus_explicit_current_surface_never_activates_or_raises_parent() {
+        assert_eq!(
+            super::activate_unless_current(true, || panic!("must preserve focused editor")),
+            Ok(())
+        );
+        let calls = Cell::new(0);
+        assert_eq!(
+            super::activate_unless_current(false, || {
+                calls.set(calls.get() + 1);
+                Err("foreground_activation_unknown")
+            }),
+            Err("foreground_activation_unknown")
+        );
+        assert_eq!(calls.get(), 1);
+    }
+
+    #[test]
+    fn controlled_focus_waits_for_delayed_application_identity() {
+        let reads = Cell::new(0);
+        let pauses = Cell::new(0);
+        let result = confirm_focus(
+            || {
+                reads.set(reads.get() + 1);
+                Ok(reads.get() == 3)
+            },
+            || {
+                pauses.set(pauses.get() + 1);
+                pauses.get() <= 2
+            },
+        );
+        assert_eq!(result, Ok(()));
+        assert_eq!(reads.get(), 3);
+        assert_eq!(pauses.get(), 2);
+    }
+
+    #[test]
+    fn controlled_focus_stops_at_budget_without_replay() {
+        let reads = Cell::new(0);
+        let result = confirm_focus(
+            || {
+                reads.set(reads.get() + 1);
+                Ok(false)
+            },
+            || false,
+        );
+        assert_eq!(result, Err("focus_effect_unknown"));
+        assert_eq!(reads.get(), 1);
+    }
+
+    #[test]
+    fn controlled_focus_cancel_or_target_change_never_waits_again() {
+        let result = confirm_focus(
+            || Err("cancelled"),
+            || panic!("must not wait after cancellation"),
+        );
+        assert_eq!(result, Err("cancelled"));
+        let result = confirm_focus(
+            || Err("controlled_target_stale"),
+            || panic!("must not wait after target loss"),
+        );
+        assert_eq!(result, Err("controlled_target_stale"));
+    }
+
+    #[test]
+    fn controlled_focus_already_current_has_no_delay() {
+        assert_eq!(
+            confirm_focus(|| Ok(true), || panic!("unnecessary delay")),
+            Ok(())
+        );
+    }
+}
diff --git a/libs/cua-driver/rust/crates/platform-macos/src/tools/computer/segment/order_tests.rs b/libs/cua-driver/rust/crates/platform-macos/src/tools/computer/segment/order_tests.rs
