+            return ComputerInput.CLICK(
+                _UniffiFfiConverterTypeComputerPoint.read(buf),
+                _UniffiFfiConverterTypeComputerMouseButton.read(buf),
+                _UniffiFfiConverterUInt8.read(buf),
+            )
+        if variant == 11:
+            return ComputerInput.SCROLL(
+                _UniffiFfiConverterTypeComputerPoint.read(buf),
+                _UniffiFfiConverterFloat64.read(buf),
+                _UniffiFfiConverterFloat64.read(buf),
+                _UniffiFfiConverterTypeComputerScrollUnit.read(buf),
+            )
+        if variant == 12:
+            return ComputerInput.DRAG(
