 impl RuntimeSession {
+    /// Closed typed segment execution currently supports the explicitly
+    /// unrestricted Computer profile only. Each action still applies current
+    /// policy and hard invariants under its canonical tool name; manifests are
+    /// not weakened into an unrestricted compound operation.
+    pub(crate) fn computer_segment_authorize(
+        &self,
+        tool: &str,
+        args: &Value,
+    ) -> Result<(), &'static str> {
+        if self.runtime.computer_sessions.is_none()
+            || !self.computer_authority_live()
+            || self.context.mode() != PermissionMode::Unrestricted
+            || self.context.capability_manifest().is_some()
+        {
+            return Err("segment_full_access_required");
+        }
+        cua_driver_core::authorization::authorize_tool_call_with_context(tool, args, &self.context)
+            .map_err(|_| "permission_denied")?;
+        self.context
+            .commit_authorized_dispatch()
+            .map_err(|_| "authorization_revoked")
+    }
+
+    #[cfg(target_os = "macos")]
+    pub(crate) fn computer_state(&self) -> Option<Arc<platform_macos::tools::ToolState>> {
+        self.runtime.computer_state.clone()
