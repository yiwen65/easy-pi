+fn controlled_renderer_owned_sigstop_times_out_without_timeout_reap_proof() {
+    let renderer = fake("").unwrap();
+    let (tx, rx) = std::sync::mpsc::channel();
+    renderer.channel.on_stop(Arc::new(move || {
+        tx.send(()).unwrap();
+    }));
+    // Only the directly spawned and still waitable inert fixture is signalled.
+    assert_eq!(unsafe { libc::kill(renderer.pid, libc::SIGSTOP) }, 0);
+    rx.recv_timeout(Duration::from_secs(3)).unwrap();
+    assert_eq!(renderer.channel.check(), Err("renderer_heartbeat_timeout"));
+    assert_eq!(unsafe { libc::kill(renderer.pid, 0) }, 0);
+    assert!(is_owned_window(renderer.pid, renderer.window_id));
+    renderer.close().unwrap(); // EOF, owned escalation, actual wait/reap
+    assert_eq!(unsafe { libc::kill(renderer.pid, 0) }, -1);
+    assert!(!is_owned_window(renderer.pid, renderer.window_id));
+}
