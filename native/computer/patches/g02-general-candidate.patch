+// Nonblocking pipe model: supplied bytes then WouldBlock, never fake EOF.
+struct Available<'a>(&'a [u8]);
+impl Read for Available<'_> {
+    fn read(&mut self, out: &mut [u8]) -> io::Result<usize> {
+        if self.0.is_empty() {
+            return Err(io::ErrorKind::WouldBlock.into());
+        }
+        out[0] = self.0[0];
+        self.0 = &self.0[1..];
+        Ok(1)
+    }
+}
