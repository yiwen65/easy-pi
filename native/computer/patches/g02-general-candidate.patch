+use super::*;
+
+struct MetadataFixture {
+    broken_children: bool,
+}
+impl Reader for MetadataFixture {
+    type Element = usize;
+    fn checkpoint(&self) -> Result<(), &'static str> {
+        Ok(())
+    }
+    fn same(&self, a: &usize, b: &usize) -> bool {
+        a == b
+    }
+    fn data(&self, element: &usize) -> Result<Data, &'static str> {
+        if *element == 1 {
+            return Err("observation_read_failed");
+        }
+        Ok(Data {
+            role: if *element == 0 {
+                "AXWindow"
+            } else {
+                "AXButton"
+            }
+            .into(),
+            ..Default::default()
+        })
+    }
+    fn general_data(&self, element: &usize) -> Result<Data, &'static str> {
+        if *element == 1 {
+            // TextEdit: AXDescription=-25200, AXEnabled=-25205, but role,
+            // children, value and positive AXValue writability are readable.
+            Ok(Data {
+                role: "AXTextArea".into(),
+                metadata_incomplete: true,
+                value: Some("Initial 稿\n".into()),
+                settable: true,
+                ..Default::default()
+            })
+        } else {
+            self.data(element)
+        }
+    }
+    fn children(&self, element: &usize) -> Result<Vec<usize>, &'static str> {
+        if *element == 1 && self.broken_children {
+            return Err("observation_read_failed");
+        }
+        Ok(if *element == 0 { vec![1, 2] } else { vec![] })
+    }
+}
+
+#[test]
+fn controlled_general_missing_description_retains_nodes_without_claiming_complete_metadata() {
+    let tree = scan_general(
+        &MetadataFixture {
+            broken_children: false,
+        },
+        0,
+    );
+    assert_eq!(tree.rows.len(), 3);
+    assert!(!tree.complete());
+    assert!(tree.structurally_complete());
+    assert_eq!(tree.failure, Some("observation_metadata_incomplete"));
+    assert!(tree
+        .general_elements(1)
+        .iter()
+        .all(|row| row.get("element_token").is_some()));
+    assert_eq!(tree.rows[1].data.value.as_deref(), Some("Initial 稿\n"));
+}
+
+#[test]
+fn controlled_general_metadata_tolerance_never_hides_unreadable_children_or_changes_legacy_scan() {
+    let tree = scan_general(
+        &MetadataFixture {
+            broken_children: true,
+        },
+        0,
+    );
+    assert_eq!(tree.rows.len(), 2);
+    assert!(!tree.structurally_complete());
+    let legacy = scan(
+        &MetadataFixture {
+            broken_children: false,
+        },
+        0,
+        512,
+        32,
+    );
+    assert_eq!(legacy.rows.len(), 1);
+    assert_eq!(legacy.failure, Some("observation_read_failed"));
+    assert!(!legacy.complete());
+}
+
+#[test]
+fn controlled_general_native_text_uses_positive_writability_not_missing_enabled_as_true() {
+    let mut data = Data {
+        role: "AXTextArea".into(),
+        settable: true,
+        ..Default::default()
+    };
+    assert!(!data.fillable()); // historical bounded policy stays unchanged
+    assert!(data.general_fillable());
+    data.enabled = Some(false);
+    assert!(!data.general_fillable());
+    data.enabled = None;
+    data.settable = false;
+    assert!(!data.general_fillable());
+    data.settable = true;
+    data.subrole = Some("AXSecureTextField".into());
+    assert!(!data.general_fillable());
+    data.subrole = None;
+    data.role = "AXButton".into();
+    assert!(!data.general_fillable());
+}
