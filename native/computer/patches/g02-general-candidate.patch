+#[test]
+fn controlled_emergency_early_duplicate_callback_reentry_and_reap() {
+    let renderer = fake("early").unwrap();
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while renderer.channel.check().is_ok() && Instant::now() < deadline {
+        thread::sleep(Duration::from_millis(5));
+    }
+    assert_eq!(renderer.channel.check(), Err("emergency_stop"));
+    let calls = Arc::new(AtomicUsize::new(0));
+    let observed = calls.clone();
+    let weak = Arc::downgrade(&renderer.channel);
+    renderer.channel.on_stop(Arc::new(move || {
+        let channel = weak.upgrade().unwrap();
+        assert_eq!(channel.check(), Err("emergency_stop"));
+        // Reentry cannot deadlock on callback mutex and cannot redeliver.
+        channel.notify_stop();
+        observed.fetch_add(1, Ordering::SeqCst);
+    }));
+    renderer.channel.notify_stop();
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    renderer.close().unwrap();
+    assert_eq!(renderer.channel.check(), Err("emergency_stop"));
+    assert!(!is_owned_window(renderer.pid, renderer.window_id));
+    let weak = Arc::downgrade(&renderer.channel);
+    drop(renderer);
+    assert!(weak.upgrade().is_none());
+}
