+        ComputerSegment {
+            intent_ref: "intent-1".into(),
+            observation_ref: "frame-1".into(),
+            actions,
+            postcondition: ComputerPostcondition::Visual {
+                description: "Expected task result".into(),
+            },
+            max_duration_ms: 30_000,
+        }
+    }
+    fn p() -> ComputerPoint {
+        ComputerPoint {
+            image_ref: "frame-1".into(),
+            x: 0.0,
+            y: 1.0,
+        }
+    }
+    fn delivered(index: u32) -> ComputerInputResult {
+        ComputerInputResult {
+            index,
+            dispatch: ComputerDispatch::Dispatched,
+            action: Some(ActionResult {
+                effect: ActionEffect::Unverifiable,
+                route: ActionRoute::SyntheticEvents,
+                delivery: Some(cua_driver_contract::ActionDelivery {
+                    mode: ActionDeliveryMode::Background,
+                    delivered_count: Some(2),
+                }),
+                evidence: None,
+                escalation: None,
+            }),
+            code: None,
+        }
+    }
+    fn result() -> ComputerSegmentResult {
+        ComputerSegmentResult {
+            status: ComputerSegmentStatus::NeedsObservation,
+            actions: vec![delivered(0)],
+            condition: ComputerCondition::Unknown,
+            first_unfinished_action: None,
+            recovery_attempts: 0,
+            elapsed_ms: 12,
+        }
