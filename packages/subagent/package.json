{
	"name": "@easy-pi/subagent",
	"version": "0.84.2",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js"
		},
		"./collaboration-contract": {
			"types": "./dist/collaboration-contract.d.ts",
			"development": "./src/collaboration-contract.ts",
			"import": "./dist/collaboration-contract.js"
		},
		"./collaboration-controller": {
			"types": "./dist/collaboration-controller.d.ts",
			"development": "./src/collaboration-controller.ts",
			"import": "./dist/collaboration-controller.js"
		},
		"./collaboration-mailbox": {
			"types": "./dist/collaboration-mailbox.d.ts",
			"development": "./src/collaboration-mailbox.ts",
			"import": "./dist/collaboration-mailbox.js"
		},
		"./collaboration-store": {
			"types": "./dist/collaboration-store.d.ts",
			"development": "./src/collaboration-store.ts",
			"import": "./dist/collaboration-store.js"
		},
		"./context-fork": {
			"types": "./dist/context-fork.d.ts",
			"development": "./src/context-fork.ts",
			"import": "./dist/context-fork.js"
		},
		"./session-host": {
			"types": "./dist/session-host.d.ts",
			"development": "./src/session-host.ts",
			"import": "./dist/session-host.js"
		}
	},
	"files": [
		"dist/index.*",
		"dist/collaboration-contract.*",
		"dist/collaboration-controller.*",
		"dist/collaboration-mailbox.*",
		"dist/collaboration-store.*",
		"dist/context-fork.*",
		"dist/session-host.*"
	],
	"scripts": {
		"build": "tsgo -p tsconfig.build.json"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@easy-pi/permissions": "0.84.2",
		"@earendil-works/pi-tui": "0.84.2",
		"typebox": "1.3.7",
		"@earendil-works/pi-ai": "0.84.2"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.84.2",
		"@earendil-works/pi-agent-core": "0.84.2"
	}
}
